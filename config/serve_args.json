 "defaults_in_code": {
  "spec_disable_by_batch_size": "17: decode steps with 17 or more scheduled requests run without draft tokens (0 = never pause)",
  "mimo_expert_replica_min_tokens": 8192,
  "mimo_moe_tkg_hits_max_rows": 4,
  "mimo_moe_prefill_accumulation_dtype": "bfloat16",
  "mimo_prompt_logprobs": true,
  "mimo_router_dtype": "bfloat16 (unset: the checkpoint's moe_router_dtype, as vLLM on GPU)",
  "kv_admission": "actual_blocks_reserve",
  "mimo_fp8_linear": "block",
  "max_logprobs": "20 (vLLM default; do not set 0: structured outputs and host-side sampling need gathered logits)"
