+    # "sliding_attention" / "full_attention" per layer
+    layer_types: list[str] = field(default_factory=list)
+    # "dense" / "moe" per layer
+    mlp_types: list[str] = field(default_factory=list)
+    rope_dim: int = 0  # rotated dims per head
+    checkpoint_format: str = CHECKPOINT_BF16_REFERENCE
+    # Checkpoint quantization_config (verbatim) or None for the reference checkpoint.
+    hf_quantization_config: dict | None = None
+    # quantization_config.ignored_layers (kept in BF16).
+    ignored_layers: list[str] = field(default_factory=list)
+
+    # ── Precision and MiMo options (from NeuronConfig) ───────────────────
+    mimo_precision: str = "bf16"  # "bf16" | "fp8"
+    mimo_fp8_linear: str = "block"
+    mimo_attn_kernel: str = "torch"
+    mtp_debug_random_draft: bool = False
+    # FP8 serving: MoE layers whose experts stay BF16 (rows not exactly FP8-encodable)
+    mimo_bf16_expert_layers: tuple[int, ...] = ()
+    # MoE router weight / correction bias / logits dtype (see the module docstring)
+    mimo_router_dtype: str = "float32"
+    # Static EP expert placement (T53b): JSON path, its EP size and expert slots per rank
+    # (0 = linear placement, no file)
+    mimo_expert_placement: str | None = None
+    mimo_expert_placement_ep: int = 0
+    mimo_expert_slots: int = 0
+    # MoE kernel options (T54a M2): decode graphs of at most this many rows run
+    # moe_tkg_hits; FP8 prefill expert kernel cross-expert accumulation dtype
+    mimo_moe_tkg_hits_max_rows: int = MOE_TKG_HITS_MAX_ROWS_DEFAULT
+    mimo_moe_prefill_accumulation_dtype: str = MOE_PREFILL_ACCUMULATION_DTYPE_DEFAULT
+    # prefill graphs of at least this many tokens use the placement's replicas (T54a O9)
+    mimo_expert_replica_min_tokens: int = EXPERT_REPLICA_MIN_TOKENS_DEFAULT
+    # MTP speculative decoding: draft tokens per step (0 = off; T36, design 15.2)
+    num_speculative_tokens: int = 0
+
+    # ── Framework config (not model-specific) ────────────────────────────
+    neuron_config: NeuronConfig | None = None
+
+    @classmethod
+    def from_configs(
+        cls, hf_config: PretrainedConfig, neuron_config: NeuronConfig | None = None,
+        speculative_config=_AMBIENT,
+    ) -> "MiMoV2NeuronConfig":
+        """Build from the HF config (+ NeuronConfig). Raises ValueError on bad input.
+
+        ``speculative_config``: vLLM ``SpeculativeConfig`` (or None); by default the one of
+        the current vLLM config, if any (``resolve_num_speculative_tokens``).
+        """
+        if isinstance(hf_config, (str, bytes)):
+            with open(hf_config) as f:
+                config_dict = json.load(f)
+        elif isinstance(hf_config, PretrainedConfig):
+            config_dict = hf_config.to_dict()
+        else:
+            config_dict = dict(hf_config)
+
+        missing = [k for k in _REQUIRED_HF_FIELDS if config_dict.get(k) is None]
+        if missing:
+            raise ValueError(f"MiMo-V2 hf_config is missing required fields: {missing}")
+
+        field_names = {f.name for f in cls.__dataclass_fields__.values()}
+        derived = {
+            "layer_types",
+            "mlp_types",
+            "rope_dim",
+            "checkpoint_format",
+            "hf_quantization_config",
+            "ignored_layers",
+            "mimo_precision",
+            "mimo_fp8_linear",
+            "mimo_attn_kernel",
+            "mtp_debug_random_draft",
+            "mimo_bf16_expert_layers",
+            "mimo_router_dtype",
+            "mimo_expert_placement",
+            "mimo_expert_placement_ep",
+            "mimo_expert_slots",
+            "mimo_moe_tkg_hits_max_rows",
+            "mimo_moe_prefill_accumulation_dtype",
+            "mimo_expert_replica_min_tokens",
+            "num_speculative_tokens",
+            "neuron_config",
+            "torch_dtype",
+        }
+        kw = {
+            k: v
+            for k, v in config_dict.items()
+            if k in field_names and k not in derived and v is not None
+        }
+        scaling = config_dict.get("routed_scaling_factor")
+        kw["routed_scaling_factor"] = 1.0 if scaling is None else float(scaling)
+        # transformers 5.x stores the dtype under "dtype"; older under "torch_dtype".
+        dtype = config_dict.get("dtype") or config_dict.get("torch_dtype") or "bfloat16"
+        kw["torch_dtype"] = getattr(torch, dtype) if isinstance(dtype, str) else dtype
+
+        n_layers = int(config_dict["num_hidden_layers"])
+        kw["layer_types"] = [
+            "sliding_attention" if v == 1 else "full_attention"
+            for v in _check_layer_list(
+                "hybrid_layer_pattern", config_dict["hybrid_layer_pattern"], n_layers
+            )
+        ]
+        kw["mlp_types"] = [
+            "moe" if v == 1 else "dense"
+            for v in _check_layer_list(
+                "moe_layer_freq", config_dict["moe_layer_freq"], n_layers
+            )
+        ]
+        kw["hybrid_layer_pattern"] = list(config_dict["hybrid_layer_pattern"])
+        kw["moe_layer_freq"] = list(config_dict["moe_layer_freq"])
+
+        kw["rope_dim"] = _rope_dim(config_dict)
+
+        qc = config_dict.get("quantization_config")
+        if qc:
+            kw["checkpoint_format"] = CHECKPOINT_FP8_MXFP4
+            kw["hf_quantization_config"] = dict(qc)
+            kw["ignored_layers"] = list(qc.get("ignored_layers") or [])
+        else:
+            kw["checkpoint_format"] = CHECKPOINT_BF16_REFERENCE
+
+        kw.update(_precision_options(kw["checkpoint_format"], neuron_config))
+        kw["mimo_bf16_expert_layers"] = _bf16_expert_layers(
+            neuron_config, kw["mimo_precision"], kw["mlp_types"])
+        kw["mimo_router_dtype"] = _router_dtype(config_dict, neuron_config)
+        kw.update(_expert_placement(config_dict, neuron_config, kw["mlp_types"]))
+        kw.update(_moe_kernel_options(neuron_config))
+        if speculative_config is _AMBIENT:
+            speculative_config = _ambient_speculative_config()
+        kw["num_speculative_tokens"] = resolve_num_speculative_tokens(speculative_config)
+        kw["neuron_config"] = neuron_config
+        return cls(**kw)
+
+    def is_swa_layer(self, layer_idx: int) -> bool:
+        return self.layer_types[layer_idx] == "sliding_attention"
+
+    def is_moe_layer(self, layer_idx: int) -> bool:
+        return self.mlp_types[layer_idx] == "moe"
+
+    def check_nki_attention(self, tp_size: int, block_size: int | None = None,
+                            tokens_per_request: int | None = None) -> None:
+        """``mimo_attn_kernel="nki"`` limits (design 15.2); ValueError lists every violation.
+
+        The decode kernel (the position-major kernel, T54 rule LL) takes one KV head per rank
+        (``tp_size >= num_kv_heads`` for the SWA and the global layers), a QK head dim in
+        (128, 256] and a V head dim <= 128, at most ``NKI_ATTN_MAX_ROWS`` rows (requests of
+        the largest decode bucket x ``nq_per_rank * tokens_per_request`` query columns) and a
+        ``block_size`` that is a multiple of ``NKI_ATTN_POS_PER_PARTITION`` (the consecutive
+        cache rows one partition reads). ``block_size`` is checked once the KV cache is bound;
+        ``tokens_per_request`` is ``1 + num_speculative_tokens`` (the default; the MTP ``1+k``
+        verify graph, D-121 N1).
+
+        The prefill kernel (T33) also needs ``nq_per_rank x bucket <= NKI_PREFILL_MAX_ROWS``
+        per kernel call (buckets padded to ``NKI_PREFILL_PAD``; a longer bucket runs as calls
+        over query parts of a multiple of ``NKI_PREFILL_SPLIT_ALIGN`` tokens, so only
+        ``nq_per_rank x NKI_PREFILL_SPLIT_ALIGN > NKI_PREFILL_MAX_ROWS`` is rejected), an SWA
+        window that is a multiple of ``NKI_PREFILL_TILE`` and ``block_size % 4 == 0`` (a fold
+        of 128 blocks splits into 512-key score tiles).
+        """
+        if self.mimo_attn_kernel != "nki":
+            return
+        if tokens_per_request is None:
+            tokens_per_request = 1 + self.num_speculative_tokens
+        errors = []
+        nc = self.neuron_config
+        seqs = list(nc.num_seqs_buckets or []) if nc is not None else []
+        for kind, n_q, n_kv, d, dv in (
+            ("global", self.num_attention_heads, self.num_key_value_heads, self.head_dim,
+             self.v_head_dim),
+            ("swa", self.swa_num_attention_heads, self.swa_num_key_value_heads,
+             self.swa_head_dim, self.swa_v_head_dim),
+        ):
+            if tp_size < n_kv:
+                errors.append(f"{kind} layers: {n_kv} KV heads need tp >= {n_kv} for one KV "
+                              f"head per rank, got tp={tp_size}")
+            if not 128 < d <= 256 or dv > 128:
+                errors.append(f"{kind} layers: head dims QK {d} / V {dv} outside (128, 256] / "
+                              "<= 128")
+            cols = max(1, n_q // tp_size) * tokens_per_request
+            if seqs and max(seqs) * cols > NKI_ATTN_MAX_ROWS:
+                errors.append(f"{kind} layers: {max(seqs)} requests x {cols} query columns "
+                              f"= {max(seqs) * cols} decode rows > {NKI_ATTN_MAX_ROWS}")
+        if block_size is not None and block_size % NKI_ATTN_POS_PER_PARTITION:
+            errors.append(f"block_size {block_size} must be a multiple of "
+                          f"{NKI_ATTN_POS_PER_PARTITION} for the decode kernel")
+        # prefill kernel
+        if self.sliding_window % NKI_PREFILL_TILE:
+            errors.append(f"sliding_window {self.sliding_window} must be a multiple of "
+                          f"{NKI_PREFILL_TILE} for the prefill kernel")
+        if block_size is not None and block_size % 4:
+            errors.append(f"block_size {block_size} must be a multiple of 4 for the prefill "
+                          "kernel")
+        tok = list(nc.num_batched_tokens_buckets or []) if nc is not None else []
+        nq_max = max(max(1, self.num_attention_heads // tp_size),
+                     max(1, self.swa_num_attention_heads // tp_size))
+        # rows of one kernel call: a bucket over the limit is split into query parts
+        split = (NKI_PREFILL_MAX_ROWS // nq_max) // NKI_PREFILL_SPLIT_ALIGN
+        split *= NKI_PREFILL_SPLIT_ALIGN
+        for b in tok:
+            rows = nq_max * (-(-b // NKI_PREFILL_PAD) * NKI_PREFILL_PAD)
+            if rows > NKI_PREFILL_MAX_ROWS and split:
+                rows = nq_max * split
+            if rows > NKI_PREFILL_MAX_ROWS:
+                errors.append(f"num_batched_tokens bucket {b} x {nq_max} Q heads per rank = "
+                              f"{rows} prefill rows > {NKI_PREFILL_MAX_ROWS} (a part of "
+                              f"{NKI_PREFILL_SPLIT_ALIGN} tokens is already over)")
+        if errors:
+            raise ValueError("neuron_config.mimo_attn_kernel='nki' is not supported here: "
+                             + "; ".join(errors))
+
+
+def _ambient_speculative_config():
+    """``speculative_config`` of the current vLLM config (None outside a vLLM config)."""
+    from vllm.config import get_current_vllm_config_or_none
+
+    vllm_config = get_current_vllm_config_or_none()
+    return getattr(vllm_config, "speculative_config", None)
+
+
+def resolve_num_speculative_tokens(speculative_config) -> int:
+    """Draft tokens per step of an MTP ``speculative_config`` (0 when not MTP).
+
+    Design 15.2: ``num_speculative_tokens`` must be 1, 2 or 3 for ``method="mtp"``
+    (``s_active = 1 + k <= 4``), else ``ValueError``. Other methods (eagle3, dflash)
+    are not checked here: MiMo-V2 serves only MTP (the runner rejects the others,
+    the model returns no auxiliary hidden states).
+    """
+    if speculative_config is None or getattr(speculative_config, "method", None) != "mtp":
+        return 0
+    k = getattr(speculative_config, "num_speculative_tokens", None)
+    if type(k) is not int or k not in MTP_NUM_SPECULATIVE_TOKENS:
+        raise ValueError(
+            f"MiMo-V2 MTP needs --speculative-config num_speculative_tokens in "
+            f"{list(MTP_NUM_SPECULATIVE_TOKENS)} (design 15.2), got {k!r}")
+    return k
+
+
+def _check_layer_list(name: str, values, n_layers: int) -> list[int]:
+    values = list(values)
+    if len(values) != n_layers:
+        raise ValueError(
+            f"{name} has length {len(values)}, expected num_hidden_layers={n_layers}"
+        )
+    bad = [(i, v) for i, v in enumerate(values) if not (type(v) is int and v in (0, 1))]
+    if bad:
+        raise ValueError(f"{name} must contain only 0/1, got (index, value) {bad}")
+    return [int(v) for v in values]
+
+
+def _bf16_expert_layers(neuron_config: NeuronConfig | None, precision: str,
+                        mlp_types: list[str]) -> tuple[int, ...]:
+    """``neuron_config.mimo_bf16_expert_layers``: distinct MoE layer indices, FP8 only."""
+    values = tuple(neuron_config.mimo_bf16_expert_layers) if neuron_config is not None else ()
+    if not values:
+        return ()
+    if precision != "fp8":
+        raise ValueError(
+            "neuron_config.mimo_bf16_expert_layers is only used with quantization='fp8', "
+            f"got {list(values)} with precision {precision!r}")
+    bad = [v for v in values if not (type(v) is int and 0 <= v < len(mlp_types)
+                                     and mlp_types[v] == "moe")]
+    if bad or len(set(values)) != len(values):
+        raise ValueError(
+            "neuron_config.mimo_bf16_expert_layers must list distinct MoE layer indices, "
+            f"got {list(values)} (invalid: {bad})")
+    return tuple(sorted(values))
+
+
+def _router_dtype(config_dict: dict, neuron_config: NeuronConfig | None) -> str:
+    """MoE router dtype: ``neuron_config.mimo_router_dtype``, unset -> hf ``moe_router_dtype``
+    (vLLM GPU default "float32" when the checkpoint has none)."""
+    value = None if neuron_config is None else neuron_config.mimo_router_dtype
+    if value is None:
+        value = config_dict.get("moe_router_dtype") or "float32"
+    if value not in MIMO_ROUTER_DTYPE_VALUES:
+        raise ValueError(
+            f"neuron_config.mimo_router_dtype (or hf_config moe_router_dtype) must be one of "
+            f"{MIMO_ROUTER_DTYPE_VALUES}, got {value!r}")
+    return value
+
+
+def _expert_placement(config_dict: dict, neuron_config: NeuronConfig | None,
+                      mlp_types: list[str]) -> dict:
+    """``neuron_config.mimo_expert_placement`` (T53b): checked placement file -> path, EP size,
+    slots per rank; unset -> linear placement (no slots)."""
+    path = None if neuron_config is None else neuron_config.mimo_expert_placement
+    if path is None:
+        return {"mimo_expert_placement": None, "mimo_expert_placement_ep": 0, "mimo_expert_slots": 0}
+    from .expert_placement import load_expert_placement
+
+    p = load_expert_placement(path, n_experts=int(config_dict["n_routed_experts"]),
+                              moe_layers=[i for i, t in enumerate(mlp_types) if t == "moe"])
+    return {"mimo_expert_placement": p.path, "mimo_expert_placement_ep": p.ep_size,
+            "mimo_expert_slots": p.slots_per_rank}
+
+
+def _moe_kernel_options(neuron_config: NeuronConfig | None) -> dict:
+    """``neuron_config.mimo_moe_tkg_hits_max_rows`` / ``mimo_moe_prefill_accumulation_dtype``
+    (T54a M2) / ``mimo_expert_replica_min_tokens`` (T54a O9), unset -> the defaults above;
+    ValueError on a bad value."""
+    rows = None if neuron_config is None else neuron_config.mimo_moe_tkg_hits_max_rows
+    acc = None if neuron_config is None else neuron_config.mimo_moe_prefill_accumulation_dtype
+    rows = MOE_TKG_HITS_MAX_ROWS_DEFAULT if rows is None else rows
+    acc = MOE_PREFILL_ACCUMULATION_DTYPE_DEFAULT if acc is None else acc
+    if type(rows) is not int or rows < 0:
+        raise ValueError("neuron_config.mimo_moe_tkg_hits_max_rows must be an integer >= 0 "
+                         f"(0 = decode always runs moe_tkg all-expert), got {rows!r}")
+    if acc not in MOE_PREFILL_ACCUMULATION_DTYPE_VALUES:
+        raise ValueError("neuron_config.mimo_moe_prefill_accumulation_dtype must be one of "
+                         f"{MOE_PREFILL_ACCUMULATION_DTYPE_VALUES}, got {acc!r}")
+    rep = None if neuron_config is None else neuron_config.mimo_expert_replica_min_tokens
+    rep = EXPERT_REPLICA_MIN_TOKENS_DEFAULT if rep is None else rep
+    if type(rep) is not int or rep < 0:
+        raise ValueError("neuron_config.mimo_expert_replica_min_tokens must be an integer >= 0 "
+                         f"(0 = every prefill graph uses the replicas), got {rep!r}")
+    return {"mimo_moe_tkg_hits_max_rows": rows, "mimo_moe_prefill_accumulation_dtype": acc,
+            "mimo_expert_replica_min_tokens": rep}
+
+
+def _rope_dim(config_dict: dict) -> int:
+    head_dim = int(config_dict["head_dim"])
+    factor = float(config_dict["partial_rotary_factor"])
+    rope_dim = int(head_dim * factor)
+    if rope_dim <= 0 or rope_dim % 2 != 0:
+        raise ValueError(
+            "int(head_dim * partial_rotary_factor) must be a positive even number, got "
+            f"head_dim={head_dim}, partial_rotary_factor={factor}, rope_dim={rope_dim}"
+        )
+    return rope_dim
+
+
+def _precision_options(checkpoint_format: str, neuron_config: NeuronConfig | None) -> dict:
+    """Resolve device precision and validate the MiMo NeuronConfig options."""
+    if neuron_config is None:
+        quantization = None
+        opts = {
+            "mimo_fp8_linear": "block",
+            "mimo_attn_kernel": "torch",
+            "mtp_debug_random_draft": False,
+        }
+    else:
+        quantization = neuron_config.quantization
+        opts = {
+            "mimo_fp8_linear": neuron_config.mimo_fp8_linear,
+            "mimo_attn_kernel": neuron_config.mimo_attn_kernel,
+            "mtp_debug_random_draft": neuron_config.mtp_debug_random_draft,
+        }
+
+    if quantization not in QUANTIZATION_VALUES:
+        raise ValueError(
+            f"neuron_config.quantization must be one of {QUANTIZATION_VALUES} for "
+            f"MiMo-V2, got {quantization!r} (checkpoint format {checkpoint_format})"
+        )
+    if checkpoint_format == CHECKPOINT_FP8_MXFP4 and quantization is None:
+        raise ValueError(
+            "neuron_config.quantization must be set to 'bf16' or 'fp8' for the original "
+            "FP8/MXFP4 MiMo-V2 checkpoint (hf_config has quantization_config), got None"
+        )
+    if checkpoint_format == CHECKPOINT_BF16_REFERENCE and quantization == "fp8":
+        raise ValueError(
+            "neuron_config.quantization='fp8' needs the original FP8/MXFP4 checkpoint; "
+            "this checkpoint has no quantization_config (BF16 reference format)"
+        )
+
+    for key, allowed in (
+        ("mimo_fp8_linear", MIMO_FP8_LINEAR_VALUES),
+        ("mimo_attn_kernel", MIMO_ATTN_KERNEL_VALUES),
+    ):
+        if opts[key] not in allowed:
+            raise ValueError(
+                f"neuron_config.{key} must be one of {allowed}, got {opts[key]!r}"
+            )
+    if not isinstance(opts["mtp_debug_random_draft"], bool):
+        raise ValueError(
+            "neuron_config.mtp_debug_random_draft must be a bool, got "
+            f"{opts['mtp_debug_random_draft']!r}"
+        )
+
+    opts["mimo_precision"] = "fp8" if quantization == "fp8" else "bf16"
+    return opts
