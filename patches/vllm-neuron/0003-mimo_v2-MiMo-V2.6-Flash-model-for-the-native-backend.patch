+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 attention through the NKI kernels (``mimo_attn_kernel="nki"``): decode (T32) and
+prefill / segmented prefill (T33, section "prefill" at the end of this file).
+
+``vllm_neuron/_kernels/mimo_v2/attention_decode.py`` streams the prior keys (the paged
+cache through the block table) and returns per-program online-softmax partials; this
+module prepares its inputs and folds the partials together with this step's ``S`` keys
+and the per-head sink (``combine``), which gives exactly the masked softmax that
+``attention.attend`` computes for the decode path:
+
+* prior key at table position ``rel`` (``= t * block_size + j``, absolute position
+  ``rel + offset``) is visible to query ``(b, s)`` iff ``rel + offset < q_start[b]`` and,
+  for SWA layers, ``swa_visible(q_pos, rel + offset, window)``;
+* this step's keys follow ``layer_visible`` among themselves;
+* the sink is one extra softmax column with a zero value vector.
+
+``prior_partials_torch`` is the torch statement of the kernel contract (CPU mode, unit
+tests and the simulator reference); on device the kernel runs through ``wrap_nki``.
+"""
+
+import torch
+
+from vllm_neuron._kernels.mimo_v2.attention_decode import (
+    KERNEL_REV,
+    M_FLOOR,
+    MASK_PENALTY,
+    P_MAX,
+    mimo_decode_attn_prior,
+)
+from vllm_neuron._kernels.mimo_v2.attention_decode_pm import DYN_CHUNK, SWA_CHUNK
+from vllm_neuron._kernels.mimo_v2.attention_decode_pm import KERNEL_REV as PM_KERNEL_REV
+from vllm_neuron._kernels.mimo_v2.attention_decode_pm import mimo_decode_attn_prior_pm
+from vllm_neuron._kernels.mimo_v2.attention_prefill import KERNEL_REV as PREFILL_KERNEL_REV
+from vllm_neuron._kernels.mimo_v2.attention_prefill import KT_MAX, mimo_prefill_attn
+
+from .attention import layer_visible
+from .config import NKI_PREFILL_MAX_ROWS
+from .moe import round_to_bf16
+
+FOLD_BLOCKS = P_MAX  # dynamic (global-layer) fold: one block per partition
+# The position-major kernel (attention_decode_pm.py, T54 rule LL) is the decode kernel of every
+# layer, configuration, context and batch size; the T32 fold kernel (mimo_decode_attn_prior,
+# prepare_inputs / prior_partials_torch / _launch_kernel) stays only as a test reference.
+_LO_NONE = -1.0e9  # "no lower bound" for global layers (positions are < 2^21)
+# Global layers (``dyn``): a small batch leaves most of the kernel's rows idle and its rounds run
+# one after another, so each request is split into ``KS`` context segments that run as separate
+# kernel rows of the same rounds (interleaved by round, merged in ``combine`` like the programs).
+# ``KS`` is the largest power of two with ``B * KS <= PM_SPLIT_ROWS`` (and ``B * KS * G <= 128``,
+# ``KS`` <= the table's rounds); a trace-time tiling choice of the one kernel (T54 rule LL, D-303).
+PM_SPLIT_ROWS = 32
+# one request (B = 1): at most 4 segments. Each kernel row costs ~2.9 us per round, so at short
+# contexts the empty rows of a 32-way split cost more than the split saves (D-303 bench: 8K
+# context 0.185 ms at KS=32 vs 0.082 ms fold); KS=4 keeps 8K / 128K / 1M within ~10 % of fold
+# (D-304 ②, orchestrator; round 3 may change this rule)
+PM_SPLIT_MAX_B1 = 4
+
+
+def n_programs() -> int:
+    from vllm_neuron.utils.hardware_config import get_logical_nc_config
+
+    return int(get_logical_nc_config())
+
+
+def prepare_inputs(q: torch.Tensor, q_pos: torch.Tensor, block_table: torch.Tensor,
+                   kpos_offset: torch.Tensor | None, window: int | None, block_size: int,
+                   n_prg: int, dynamic: bool):
+    """Kernel inputs from the decode tensors.
+
+    Args:
+        q: ``[B, nq, S, D]`` post-RoPE queries.
+        q_pos: ``[B, S]`` int64 absolute positions (``q_pos[:, 0]`` = first query).
+        block_table: ``[B, NB]`` int32 (sentinels < 0 allowed).
+        kpos_offset: ``[B]`` absolute position of table column 0 (SWA trimmed table) or None.
+
+    Returns:
+        ``q_t [B, D, G]``, ``bt [B, NBp]`` int32, ``n_iter [1, B]`` int32, ``thr [B, 2G]`` fp32.
+    """
+    B, nq, S, D = q.shape
+    G = nq * S
+    q_t = q.reshape(B, G, D).transpose(1, 2).contiguous()
+    off = (torch.zeros(B, dtype=torch.int64, device=q.device) if kpos_offset is None
+           else kpos_offset.reshape(B).to(torch.int64))
+    q_start = q_pos[:, 0].to(torch.int64)
+    hi = (q_start - off).to(torch.float32).view(B, 1).expand(B, G)
+    if window is not None:
+        lo = (q_pos.to(torch.int64) - window - off.view(B, 1)).to(torch.float32)  # [B, S]
+        lo = lo.view(B, 1, S).expand(B, nq, S).reshape(B, G)
+    else:
+        lo = torch.full((B, G), _LO_NONE, dtype=torch.float32, device=q.device)
+    thr = torch.cat([hi, lo], dim=1).contiguous()
+    # every entry a real block: sentinels read the null block (masked by position)
+    bt = block_table.to(torch.int32).clamp(min=0)
+    NB = bt.shape[1]
+    unit = (FOLD_BLOCKS if dynamic else 1) * n_prg
+    if not dynamic and NB > P_MAX * n_prg:
+        unit = P_MAX * n_prg
+    NBp = -(-NB // unit) * unit
+    if NBp != NB:
+        bt = torch.nn.functional.pad(bt, (0, NBp - NB), value=0)
+    span = block_size * FOLD_BLOCKS * n_prg
+    n_iter = torch.div(q_start - off + (span - 1), span, rounding_mode="floor")
+    n_iter = n_iter.clamp(min=0).to(torch.int32).view(1, B)
+    return q_t, bt.contiguous(), n_iter, thr
+
+
+def pm_mode(window: int | None) -> str:
+    """Mode of the position-major kernel: ``swa1`` for SWA layers, ``dyn`` for global layers."""
+    return "swa1" if window is not None else "dyn"
+
+
+def pm_split(B: int, G: int, n_rounds_table: int) -> int:
+    """Segments per request of a ``dyn`` call (see ``PM_SPLIT_ROWS``): the largest power of two
+    ``KS`` with ``B * KS <= PM_SPLIT_ROWS``, ``B * KS * G <= 128`` and ``KS <= n_rounds_table``
+    (rounds of the whole table, so no kernel request is empty for every context); at most
+    ``PM_SPLIT_MAX_B1`` for one request."""
+    cap = PM_SPLIT_MAX_B1 if B == 1 else n_rounds_table
+    ks = 1
+    while (2 * ks * B <= PM_SPLIT_ROWS and 2 * ks * B * G <= P_MAX
+           and 2 * ks <= min(n_rounds_table, cap)):
+        ks *= 2
+    return ks
+
+
+def merge_split(acc: torch.Tensor, ml: torch.Tensor, B: int):
+    """Kernel partials ``[n_prg, B*KS, G, .]`` -> the ``combine`` layout ``[n_prg*KS, B, G, .]``
+    (each segment of a request is one more partial, like a program)."""
+    n_prg, Bk, G = acc.shape[:3]
+    ks = Bk // B
+
+    def fold(x):
+        return x.view(n_prg, B, ks, G, x.shape[-1]).transpose(1, 2).reshape(n_prg * ks, B, G,
+                                                                              x.shape[-1])
+
+    return fold(acc), fold(ml)
+
+
+def prepare_inputs_pm(q: torch.Tensor, q_pos: torch.Tensor, block_table: torch.Tensor,
+                      kpos_offset: torch.Tensor | None, window: int | None, block_size: int,
+                      n_prg: int, mode: str):
+    """Inputs of ``mimo_decode_attn_prior_pm`` (batched rounds, see attention_decode_pm.py).
+
+    Returns:
+        ``q_t [Bk, D, G]``, ``slots [Bk, W]`` int32 (``swa1``: cache row of each window position;
+        ``dyn``: compact, cache row of every ``R``-th table position (``R = chunk / 128``
+        consecutive rows per kernel partition) plus one padding round of zeros),
+        ``n_round [1, 3]`` int32 (rounds, rounds // 2, rounds % 2), ``thr [n_prg, Bk*G, 2]`` fp32
+        (hi, lo; rows a program does not own: hi = -1), ``chunk``. ``Bk = B * KS`` kernel requests: ``dyn`` splits request ``b``
+        into ``KS`` segments (``pm_split``), kernel request ``b * KS + s`` holds rounds
+        ``r * KS + s`` of request ``b``; ``swa1`` has ``KS = 1``. ``merge_split`` turns the
+        kernel partials back into the ``combine`` layout.
+    """
+    B, nq, S, D = q.shape
+    G = nq * S
+    dev = q.device
+    q_t = q.reshape(B, G, D).transpose(1, 2).contiguous()
+    off = (torch.zeros(B, dtype=torch.int64, device=dev) if kpos_offset is None
+           else kpos_offset.reshape(B).to(torch.int64))
+    q_start = q_pos[:, 0].to(torch.int64)
+    bt = block_table.to(torch.int64).clamp(min=0)
+    NB = bt.shape[1]
+    if mode == "swa1":
+        CH = SWA_CHUNK
+        c0 = (q_start - off - CH).clamp(min=0)  # [B]
+        rel = (c0.view(B, 1) + torch.arange(CH, dtype=torch.int64, device=dev).view(1, CH))
+        rel = rel.clamp(max=NB * block_size - 1)
+        blk = torch.gather(bt, 1, torch.div(rel, block_size, rounding_mode="floor"))
+        slots = (blk * block_size + rel % block_size).to(torch.int32).contiguous()
+        hi = (q_start - off - c0).to(torch.float32).view(B, 1).expand(B, G)
+        lo = (q_pos.to(torch.int64) - window - off.view(B, 1) - c0.view(B, 1)).to(torch.float32)
+        lo = lo.view(B, 1, S).expand(B, nq, S).reshape(B, G)
+        n_round = torch.tensor([[1, 0, 1]], dtype=torch.int32, device=dev)
+        own = (torch.arange(B, device=dev).view(1, B) % n_prg
+               == torch.arange(n_prg, device=dev).view(n_prg, 1))  # [n_prg, B]
+        hi_p = torch.where(own.view(n_prg, B, 1), hi.view(1, B, G),
+                           torch.full_like(hi.view(1, B, G), -1.0))
+        thr = torch.stack([hi_p, lo.view(1, B, G).expand(n_prg, B, G)], dim=-1)
+        thr = thr.reshape(n_prg, B * G, 2).contiguous()
+    else:
+        if window is not None:
+            raise ValueError("dyn mode is for global layers (no window)")
+        CH = DYN_CHUNK
+        NS = CH // P_MAX  # consecutive positions per kernel partition
+        span = CH * n_prg  # positions per round (all programs)
+        unit = span // block_size  # blocks per round
+        KS = pm_split(B, G, -(-NB // unit))
+        NBp = -(-NB // (unit * KS)) * unit * KS
+        if NBp != NB:
+            bt = torch.nn.functional.pad(bt, (0, NBp - NB), value=0)
+        # compact slots: the first cache row of each NS-position run (NS | block_size)
+        sub = torch.arange(0, block_size, NS, dtype=torch.int64, device=dev)
+        slots = (bt.view(B, NBp, 1) * block_size + sub.view(1, 1, -1)).view(B, -1)
+        span_c = span // NS  # compact columns per round = 128 * n_prg
+        if KS > 1:
+            # kernel request (b, s) round r = round r * KS + s of request b
+            slots = slots.view(B, -1, KS, span_c).transpose(1, 2).reshape(B * KS, -1)
+        # one padding round (the pipelined kernel loads one round ahead)
+        slots = torch.nn.functional.pad(slots, (0, span_c), value=0).to(torch.int32).contiguous()
+        h = (q_start - off).clamp(min=0).view(B, 1)
+        if KS > 1:
+            # visible: table position < h; kernel request (b, s) sees whole rounds r with
+            # r * KS + s < h // span and, in round (h // span) // KS of segment (h // span) % KS,
+            # the first h % span positions; its threshold counts its own positions below h
+            sg = torch.arange(KS, dtype=torch.int64, device=dev).view(1, KS)
+            g, rem = torch.div(h, span, rounding_mode="floor"), h % span
+            full = torch.div(g - sg + (KS - 1), KS, rounding_mode="floor")
+            h = full * span + torch.where(g % KS == sg, rem, torch.zeros_like(rem))
+            q_t = q_t.repeat_interleave(KS, dim=0)
+        hk = h.reshape(B * KS)
+        B = B * KS
+        nr = torch.div(hk.max() + (span - 1), span, rounding_mode="floor")
+        n_round = torch.stack([nr, torch.div(nr, 2, rounding_mode="floor"), nr % 2])
+        n_round = n_round.to(torch.int32).view(1, 3)
+        # global layers: no lower bound (the kernel reads lo only with a window)
+        hi = hk.to(torch.float32).view(1, B, 1, 1).expand(n_prg, B, G, 1)
+        thr = torch.cat([hi, torch.zeros_like(hi)], dim=-1).reshape(n_prg, B * G, 2).contiguous()
+    return q_t, slots, n_round, thr, CH
+
+
+def prior_partials_torch_pm(q_t, k_cache, v_cache, slots, n_round, thr, scale: float,
+                            window: int | None, mode: str, chunk: int, n_prg: int):
+    """Torch statement of the batched position-major kernel (same rounds, same program split).
+
+    Returns ``acc [n_prg, B, G, Dv]``, ``ml [n_prg, B, G, 2]`` (the combine layout)."""
+    B, D, G = q_t.shape
+    Dv = v_cache.shape[3]
+    k_rows = k_cache.reshape(-1, D)
+    v_rows = v_cache.reshape(-1, Dv)
+    acc = torch.zeros(n_prg, B, G, Dv, dtype=torch.float32, device=q_t.device)
+    ml = torch.zeros(n_prg, B, G, 2, dtype=torch.float32, device=q_t.device)
+    ml[..., 0] = M_FLOOR
+    j = torch.arange(chunk, device=q_t.device, dtype=torch.float32)
+    th = thr.view(n_prg, B, G, 2)
+    n_r = 1 if mode == "swa1" else int(n_round.reshape(-1)[0])
+    for p in range(n_prg):
+        for b in range(B):
+            if mode == "swa1" and b % n_prg != p:
+                continue
+            m = torch.full((G,), M_FLOOR, dtype=torch.float32, device=q_t.device)
+            l = torch.zeros(G, dtype=torch.float32, device=q_t.device)
+            a = torch.zeros(G, Dv, dtype=torch.float32, device=q_t.device)
+            for r in range(n_r):
+                st = 0 if mode == "swa1" else (r * n_prg + p) * chunk
+                if mode == "swa1":
+                    rows = slots[b, :chunk].to(torch.int64)
+                else:  # compact: run starts of NS consecutive rows
+                    ns = chunk // P_MAX
+                    c0 = st // ns
+                    rows = (slots[b, c0:c0 + P_MAX].to(torch.int64).view(-1, 1)
+                            + torch.arange(ns, device=q_t.device).view(1, -1)).reshape(-1)
+                k = k_rows[rows].to(torch.float32)
+                v = v_rows[rows].to(torch.float32)
+                s = q_t[b].to(torch.float32).T @ k.T  # [G, CH]
+                rel = j + float(st)
+                vis = rel[None, :] < th[p, b, :, 0:1]
+                if window:
+                    vis = vis & (rel[None, :] > th[p, b, :, 1:2])
+                s = torch.where(vis, s, s + MASK_PENALTY)
+                m_new = torch.maximum(m, s.amax(dim=1))
+                alpha = torch.exp(scale * (m - m_new))
+                pr = torch.exp(scale * (s - m_new[:, None]))
+                l = l * alpha + pr.sum(dim=1)
+                a = a * alpha[:, None] + pr.to(v_cache.dtype).to(torch.float32) @ v
+                m = m_new
+            acc[p, b] = a
+            ml[p, b, :, 0] = m
+            ml[p, b, :, 1] = l
+    return acc, ml
+
+
+def prior_partials_torch(q_t, k_cache, v_cache, bt, n_iter, thr, scale: float,
+                         window: int | None, dynamic: bool, n_prg: int):
+    """Torch statement of the kernel contract (same folds, same per-program shares)."""
+    B, D, G = q_t.shape
+    _, _, bs, _ = k_cache.shape
+    Dv = v_cache.shape[3]
+    NB = bt.shape[1]
+    FB = FOLD_BLOCKS if dynamic else min(P_MAX, NB // n_prg)
+    acc = torch.zeros(n_prg, B, G, Dv, dtype=torch.float32, device=q_t.device)
+    ml = torch.zeros(n_prg, B, G, 2, dtype=torch.float32, device=q_t.device)
+    rel_fold = torch.arange(FB * bs, device=q_t.device, dtype=torch.float32)
+    for p in range(n_prg):
+        for b in range(B):
+            n_fold = int(n_iter[0, b]) if dynamic else NB // (FB * n_prg)
+            m = torch.full((G,), M_FLOOR, dtype=torch.float32, device=q_t.device)
+            l = torch.zeros(G, dtype=torch.float32, device=q_t.device)
+            a = torch.zeros(G, Dv, dtype=torch.float32, device=q_t.device)
+            for it in range(n_fold):
+                f = it * n_prg + p
+                blocks = bt[b, f * FB:(f + 1) * FB].to(torch.int64)
+                k = k_cache[blocks, 0].reshape(FB * bs, D).to(torch.float32)
+                v = v_cache[blocks, 0].reshape(FB * bs, Dv).to(torch.float32)
+                rel = rel_fold + f * FB * bs
+                s = q_t[b].to(torch.float32).T @ k.T  # [G, L]
+                vis = rel[None, :] < thr[b, :G, None]
+                if window is not None:
+                    vis = vis & (rel[None, :] > thr[b, G:, None])
+                s = torch.where(vis, s, s + MASK_PENALTY)
+                m_new = torch.maximum(m, s.amax(dim=1))
+                alpha = torch.exp(scale * (m - m_new))
+                pr = torch.exp(scale * (s - m_new[:, None]))
+                l = l * alpha + pr.sum(dim=1)
+                a = a * alpha[:, None] + pr.to(v_cache.dtype).to(torch.float32) @ v
+                m = m_new
+            acc[p, b] = a
+            ml[p, b, :, 0] = m
+            ml[p, b, :, 1] = l
+    return acc, ml
+
+
+def combine(acc, ml, q, k_act, v_act, q_pos, window, sink, scale):
+    """Fold the program partials, this step's keys and the sink -> ``[B, nq, S, Dv]`` FP32.
+
+    P·V dtype (rule AA, T54a M4): the probabilities of this step's keys are rounded to BF16
+    before they multiply V (``round_to_bf16``, which the compiler keeps, T49 D-219), as the
+    kernel does for the prior keys (``p_sb`` in the V dtype) and as GPU FlashAttention does
+    for every key (P converted to the V dtype, FP32 accumulation); the denominator sums the
+    FP32 probabilities, as the kernel's ``l`` and FlashAttention's row sum."""
+    B, nq, S, D = q.shape
+    n_prg = acc.shape[0]
+    Dv = acc.shape[3]
+    acc = acc.view(n_prg, B, nq, S, Dv)
+    m_p = ml[..., 0].reshape(n_prg, B, nq, S) * scale
+    l_p = ml[..., 1].reshape(n_prg, B, nq, S)
+    groups = nq // k_act.shape[1]
+    kf = k_act.to(torch.float32)
+    vf = v_act.to(torch.float32)
+    if groups > 1:
+        kf = kf.repeat_interleave(groups, dim=1)
+        vf = vf.repeat_interleave(groups, dim=1)
+    s_act = torch.matmul(q.to(torch.float32), kf.transpose(-1, -2)) * scale  # [B, nq, S, S]
+    vis = layer_visible(q_pos[:, :, None], q_pos[:, None, :], window)[:, None]
+    s_act = s_act.masked_fill(~vis, torch.finfo(torch.float32).min)
+    m_all = torch.maximum(m_p.amax(dim=0), s_act.amax(dim=-1))
+    if sink is not None:
+        m_all = torch.maximum(m_all, sink.to(torch.float32).view(1, nq, 1))
+    w = torch.exp(m_p - m_all[None])  # [n_prg, B, nq, S]
+    p_act = torch.exp(s_act - m_all[..., None]) * vis.to(torch.float32)
+    num = (w[..., None] * acc).sum(dim=0) + torch.matmul(round_to_bf16(p_act), vf)
+    den = (w * l_p).sum(dim=0) + p_act.sum(dim=-1)
+    if sink is not None:
+        den = den + torch.exp(sink.to(torch.float32).view(1, nq, 1) - m_all)
+    return num / den[..., None]
+
+
+def kernel_operand(x: torch.Tensor) -> torch.Tensor:
+    """A bit-identical new tensor for a BF16 operand computed in the graph (T54 D-304).
+
+    On device, when one elementwise result feeds both a decode kernel operand (``q_t``, through
+    its transpose) and a later matmul (``combine``), the kernel can read wrong data at S > 1
+    (kernel partials cos ~0.4; S = 1 is right; compiler problem of the upstream issue #3 kind,
+    reports/upstream-issues #3; probes tools/mimo/t54/chain_s4_probe3-6.py). Rounding the BF16
+    values to BF16 again (``round_to_bf16``, three FP32 ops the compiler keeps) gives the kernel
+    its own tensor and returns the same bits for finite ``|x| < 2^111``."""
+    return round_to_bf16(x.to(torch.float32)).to(x.dtype)
+
+
+def _isolate(kwargs: dict, names) -> dict:
+    """``kernel_operand`` on the named operands (the graph-computed BF16 inputs of a kernel)."""
+    for n in names:
+        kwargs[n] = kernel_operand(kwargs[n])
+    return kwargs
+
+
+def _launch_kernel(n_prg: int, **kwargs):
+    """``wrap_nki`` launch on the LNC grid (tests swap in ``nki.simulate``); ``q_t`` isolated."""
+    from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+
+    return wrap_nki(mimo_decode_attn_prior)[n_prg](**_isolate(kwargs, ("q_t",)))
+
+
+def _launch_kernel_pm(n_prg: int, **kwargs):
+    """``wrap_nki`` launch of the position-major kernel (tests swap in ``nki.simulate``); every
+    caller's ``q_t`` goes through ``kernel_operand`` (D-304)."""
+    from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+    return wrap_nki(mimo_decode_attn_prior_pm)[n_prg](**_isolate(kwargs, ("q_t",)))
+
+
+def decode_attention(q, k_act, v_act, k_cache, v_cache, block_table, q_pos, kpos_offset,
+                     window, sink, scale, block_size, use_kernel: bool):
+    """Decode attention ``[B, nq, S, Dv]`` FP32 (prior keys from the cache + this step's)."""
+    n_prg = n_programs() if use_kernel else 1
+    mode = pm_mode(window)
+    q_t, slots, n_round, thr, chunk = prepare_inputs_pm(q, q_pos, block_table, kpos_offset,
+                                                         window, block_size, n_prg, mode)
+    if use_kernel:
+        acc, ml = _launch_kernel_pm(
+            n_prg, q_t=q_t, k_cache=k_cache, v_cache=v_cache, slots=slots, n_round=n_round, thr=thr,
+            scale=float(scale), window=int(window or 0), mode=mode, chunk=chunk, rev=PM_KERNEL_REV)
+        Bk, _, G = q_t.shape
+        acc = acc.view(n_prg, Bk, G, acc.shape[-1])
+        ml = ml.view(n_prg, Bk, G, 2)
+    else:
+        acc, ml = prior_partials_torch_pm(q_t, k_cache, v_cache, slots, n_round, thr, scale, window,
+                                          mode, chunk, n_prg)
+    acc, ml = merge_split(acc, ml, q.shape[0])
+    return combine(acc, ml, q, k_act, v_act, q_pos, window, sink, scale)
+
+
+# ---------------------------------------------------------------- prefill (T33)
+#
+# ``vllm_neuron/_kernels/mimo_v2/attention_prefill.py`` computes the whole prefill /
+# segmented-prefill attention of a layer (paged prior keys of global layers with a run-time
+# fold count, the SWA window before the segment, the segment's own keys, the sink) and
+# returns the normalised output; ``prefill_inputs`` builds its inputs from the
+# ``forward_prefill`` tensors and ``prefill_attn_torch`` states the same contract in torch
+# (CPU mode and the unit tests).
+
+PREFILL_FOLD_BLOCKS = P_MAX  # paged prior: one block per partition
+PREFILL_MAX_ROWS = NKI_PREFILL_MAX_ROWS  # rows per kernel call; longer prefills are split
+
+
+def prefill_inputs(q, k, v, k_cache, v_cache, block_table, prior, window, sink, scale,
+                   block_size, n_prg, fold_blocks=PREFILL_FOLD_BLOCKS, pre=None):
+    """Kernel inputs from the prefill tensors of one layer (batch 1).
+
+    Args:
+        q: ``[T, nq, D]`` post-RoPE queries; ``k [T, 1, D]`` / ``v [T, 1, Dv]`` this
+            segment's keys / scaled values (relative positions ``0 .. T-1``).
+        block_table: ``[1, NB]`` int32 (sentinels < 0 allowed) or None (no prior).
+        prior: ``[1]`` int64 cached_seq_len (segmented prefill) or None.
+        pre: SWA layers, ``(k_pre [n, 1, D], v_pre [n, 1, Dv])``: the ``n`` keys right before
+            the segment, all existing (a later part of a split prefill, ``prefill_attention``),
+            instead of the window read from the cache.
+
+    Returns:
+        ``(kwargs, Tp)``: the kernel's tensor arguments and scalars, and the padded
+        segment length (a multiple of ``128 * n_prg``; rows ``t >= T`` are padding).
+    """
+    from .attention import gather_positions
+
+    T, nq, D = q.shape
+    Dv = v.shape[-1]
+    dev = q.device
+    unit = P_MAX * n_prg
+    Tp = -(-T // unit) * unit
+    if Tp != T:  # padded keys come after every real query: causally invisible to them
+        q = torch.nn.functional.pad(q, (0, 0, 0, 0, 0, Tp - T))
+        k = torch.nn.functional.pad(k, (0, 0, 0, 0, 0, Tp - T))
+        v = torch.nn.functional.pad(v, (0, 0, 0, 0, 0, Tp - T))
+    k_seg, v_seg = k[:, 0], v[:, 0]
+    pen_dtype = k.dtype
+    segmented = prior is not None
+    paged = segmented and window is None
+    n_pre = 0
+    if pre is not None:
+        # SWA, later part of a split prefill: the keys before the part are the segment's own
+        if window is None or segmented:
+            raise ValueError("pre keys are for the SWA parts of a split prefill (prior=None)")
+        n_pre = pre[0].shape[0]
+        if n_pre % P_MAX:
+            raise ValueError(f"{n_pre} pre keys must be a multiple of {P_MAX}")
+        k_all = torch.cat([pre[0][:, 0].to(k.dtype), k_seg], dim=0)
+        v_all = torch.cat([pre[1][:, 0].to(v.dtype), v_seg], dim=0)
+        pen = torch.zeros(n_pre + Tp, dtype=pen_dtype, device=dev)
+    elif segmented and window is not None:
+        # the SWA window before the segment, read from the cache (positions < 0 do not exist)
+        if window % P_MAX:
+            raise ValueError(f"SWA window {window} must be a multiple of {P_MAX}")
+        n_pre = window
+        pos = prior.reshape(1).to(torch.int64) - window + torch.arange(
+            window, dtype=torch.int64, device=dev)
+        k_pre = gather_positions(k_cache, block_table[0], pos, block_size)[0, 0]
+        v_pre = gather_positions(v_cache, block_table[0], pos, block_size)[0, 0]
+        pen_pre = torch.where(pos >= 0, 0.0, MASK_PENALTY).to(pen_dtype)
+        k_all = torch.cat([k_pre.to(k.dtype), k_seg], dim=0)
+        v_all = torch.cat([v_pre.to(v.dtype), v_seg], dim=0)
+        pen = torch.cat([pen_pre, torch.zeros(Tp, dtype=pen_dtype, device=dev)])
+    else:
+        k_all, v_all = k_seg, v_seg
+        pen = torch.zeros(Tp, dtype=pen_dtype, device=dev)
+    R = nq * Tp
+    q_rows = q.transpose(0, 1).reshape(R, D).contiguous()  # row r = h * Tp + t
+    if sink is not None:
+        m0 = (sink.to(torch.float32) / scale).view(nq, 1).expand(nq, Tp).reshape(R)
+        l0 = torch.ones(R, dtype=torch.float32, device=dev)
+    else:
+        m0 = torch.full((R,), M_FLOOR, dtype=torch.float32, device=dev)
+        l0 = torch.zeros(R, dtype=torch.float32, device=dev)
+    m0l0 = torch.stack([m0, l0], dim=1).contiguous()
+    if paged:
+        bt = block_table.to(torch.int32).clamp(min=0)
+        NB = bt.shape[1]
+        NBp = -(-NB // fold_blocks) * fold_blocks
+        if NBp != NB:
+            bt = torch.nn.functional.pad(bt, (0, NBp - NB), value=0)
+        span = block_size * fold_blocks
+        p64 = prior.reshape(1, 1).to(torch.int64)
+        n_iter = torch.div(p64 + (span - 1), span, rounding_mode="floor").clamp(min=0)
+        n_iter = n_iter.to(torch.int32)
+        prior_f = p64.to(torch.float32)
+    else:
+        bt = torch.zeros(1, fold_blocks, dtype=torch.int32, device=dev)
+        n_iter = torch.zeros(1, 1, dtype=torch.int32, device=dev)
+        prior_f = torch.zeros(1, 1, dtype=torch.float32, device=dev)
+        # The kernel reads the paged cache only for the global prefix; elsewhere it gets a
+        # one-block stand-in of the same layout, so the graph never hands the (up to 1M
+        # positions) cache to the kernel without need.
+        k_cache = torch.zeros(1, 1, block_size, D, dtype=k_cache.dtype, device=dev)
+        v_cache = torch.zeros(1, 1, block_size, Dv, dtype=v_cache.dtype, device=dev)
+    kwargs = dict(q=q_rows, k=k_all.contiguous(), v=v_all.contiguous(), kpen=pen.view(1, -1),
+                  m0l0=m0l0, k_cache=k_cache,
+                  v_cache=v_cache, block_table=bt.contiguous(), n_iter=n_iter, prior=prior_f,
+                  scale=float(scale), n_pre=int(n_pre), window=int(window or 0),
+                  paged=bool(paged), fold_blocks=int(fold_blocks))
+    return kwargs, Tp
+
+
+def prefill_attn_torch(q, k, v, kpen, m0l0, k_cache, v_cache, block_table, n_iter, prior,
+                       scale=1.0, n_pre=0, window=0, paged=False, fold_blocks=PREFILL_FOLD_BLOCKS,
+                       rev=""):
+    """Torch statement of the kernel contract -> ``out [R, Dv]`` FP32: exact softmax
+    with the probabilities rounded to BF16 before P·V (the kernel's ``p_sb`` has the Q dtype;
+    GPU FlashAttention converts P to the V dtype; rule AA, T54a M4) and the FP32 sum as the
+    denominator."""
+    R, D = q.shape
+    L = k.shape[0]
+    T = L - n_pre
+    dev = q.device
+    qf = q.to(torch.float32)
+    t = torch.arange(R, device=dev) % T
+    kp = torch.arange(L, device=dev) - n_pre
+    vis = kp[None, :] <= t[:, None]
+    if window:
+        vis = vis & (kp[None, :] > t[:, None] - window)
+    s_cur = qf @ k.to(torch.float32).T + kpen.to(torch.float32)
+    s_list = [torch.where(vis, s_cur, float("-inf"))]
+    v_list = [v.to(torch.float32)]
+    if paged:
+        n_keys = int(n_iter[0, 0]) * fold_blocks * k_cache.shape[2]
+        if n_keys:
+            blocks = block_table[0, :n_keys // k_cache.shape[2]].to(torch.int64)
+            kk = k_cache[blocks, 0].reshape(n_keys, D).to(torch.float32)
+            vv = v_cache[blocks, 0].reshape(n_keys, -1).to(torch.float32)
+            sp = qf @ kk.T
+            valid = torch.arange(n_keys, device=dev).to(torch.float32) < prior.reshape(1, 1)
+            s_list.insert(0, torch.where(valid, sp, float("-inf")))
+            v_list.insert(0, vv)
+    s = torch.cat(s_list, dim=1) * scale
+    vals = torch.cat(v_list, dim=0)
+    m0 = m0l0[:, 0] * scale
+    m = torch.maximum(m0, s.amax(dim=1))
+    p = torch.exp(s - m[:, None])
+    den = m0l0[:, 1] * torch.exp(m0 - m) + p.sum(dim=1)
+    return (round_to_bf16(p) @ vals) / den.clamp(min=1e-30)[:, None]
+
+
+def _launch_prefill_kernel(n_prg: int, **kwargs):
+    """``wrap_nki`` launch on the LNC grid (tests swap in ``nki.simulate``)."""
+    from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+
+    return wrap_nki(mimo_prefill_attn)[n_prg](**kwargs)
+
+
+def prefill_split_tokens(nq: int) -> int:
+    """Queries per kernel call of a long prefill: the most multiple of 512 (one key tile) with
+    ``nq x tokens <= PREFILL_MAX_ROWS`` (the kernel's Q tiles + softmax state in SBUF); 0 when
+    ``nq x 512`` is already over (``check_nki_attention`` rejects that layout)."""
+    return (PREFILL_MAX_ROWS // nq) // KT_MAX * KT_MAX
+
+
+def prefill_attention(q, k, v, k_cache, v_cache, block_table, prior, window, sink, scale,
+                      block_size, use_kernel: bool):
+    """Prefill attention of one layer -> ``[nq, T, Dv]`` FP32 (see ``prefill_inputs``).
+
+    A prefill of more than ``PREFILL_MAX_ROWS`` rows (``nq x`` padded ``T``; the 131072-token
+    bucket, T54 D-302) runs as kernel calls over consecutive query parts of
+    ``prefill_split_tokens(nq)`` tokens. Part ``[t0, t1)`` of a global layer reads the keys
+    before ``t0`` as paged prior keys (``prior + t0``; ``forward_prefill`` wrote the segment's
+    keys to the cache first), part 0 is the unsplit call's first part. A SWA layer's part takes
+    the segment keys before ``t0`` that its window needs as ``pre`` keys, starting on a 512-key
+    tile of the unsplit call, so each of its query tiles meets the same key tiles in the same
+    order as in one call."""
+    T, nq, _ = q.shape
+    n_prg = n_programs() if use_kernel else 1
+    unit = P_MAX * n_prg
+    Ts = prefill_split_tokens(nq)
+    if nq * (-(-T // unit) * unit) <= PREFILL_MAX_ROWS or Ts == 0:
+        return _prefill_call(q, k, v, k_cache, v_cache, block_table, prior, window, sink, scale,
+                             block_size, use_kernel, n_prg)
+    outs = []
+    for t0 in range(0, T, Ts):
+        t1 = min(T, t0 + Ts)
+        part = (q[t0:t1], k[t0:t1], v[t0:t1])
+        if t0 == 0:
+            o = _prefill_call(*part, k_cache, v_cache, block_table, prior, window, sink, scale,
+                              block_size, use_kernel, n_prg)
+        elif window is None:
+            if block_table is None:
+                raise ValueError(f"a {T}-token NKI prefill split needs the block table")
+            p0 = (torch.zeros(1, dtype=torch.int64, device=q.device) if prior is None
+                  else prior.reshape(1).to(torch.int64))
+            o = _prefill_call(*part, k_cache, v_cache, block_table, p0 + t0, None, sink, scale,
+                              block_size, use_kernel, n_prg)
+        else:
+            # keys from the 512-key tile (of the unsplit call's key list: the cache window of
+            # a segmented prefill, then the segment) that holds query t0's first window key
+            n_pre0 = window if prior is not None else 0
+            a = max(0, (n_pre0 + t0 - window + 1) // KT_MAX * KT_MAX)
+            s0 = a - n_pre0  # first segment key of the part
+            if s0 < 0:
+                raise ValueError(f"SWA window {window} reaches before a {Ts}-token part")
+            o = _prefill_call(*part, k_cache, v_cache, block_table, None, window, sink, scale,
+                              block_size, use_kernel, n_prg, pre=(k[s0:t0], v[s0:t0]))
+        outs.append(o)
+    return torch.cat(outs, dim=1)
+
+
+def _prefill_call(q, k, v, k_cache, v_cache, block_table, prior, window, sink, scale,
+                  block_size, use_kernel, n_prg, pre=None):
+    T, nq, _ = q.shape
+    kw, Tp = prefill_inputs(q, k, v, k_cache, v_cache, block_table, prior, window, sink, scale,
+                            block_size, n_prg, pre=pre)
+    if use_kernel:
+        out = _launch_prefill_kernel(n_prg, rev=PREFILL_KERNEL_REV, **kw)
+    else:
+        out = prefill_attn_torch(**kw)
+    return out.view(nq, Tp, -1)[:, :T]
