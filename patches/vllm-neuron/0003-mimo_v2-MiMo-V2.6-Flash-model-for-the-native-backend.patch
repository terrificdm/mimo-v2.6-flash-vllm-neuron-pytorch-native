+    moe_intermediate_size: int = 2048
+    n_routed_experts: int = 256
+    num_experts_per_tok: int = 8
+    n_group: int = 1
+    topk_group: int = 1
+    norm_topk_prob: bool = True
+    routed_scaling_factor: float = 1.0  # hf null -> 1.0
+    scoring_func: str = "sigmoid"
+    topk_method: str = "noaux_tc"
