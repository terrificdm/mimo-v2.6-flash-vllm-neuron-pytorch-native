+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 DFlash draft (``dflash/`` of the checkpoint, T63)
+=========================================================
+
+``DFlashDraftModel`` with model_type qwen3: 5 non-causal SWA layers (window 1024),
+block size 8 (one forward pass drafts 7 tokens), context features from target layers
+``target_layer_ids = [0, 11, 23, 35, 47]``. The generic Qwen3 drafter
+(``qwen3/dflash_model.py``) lacks what this checkpoint was trained with, so this file
+follows vLLM GPU ``qwen3_dflash.py`` (0.29) plus vLLM PR #57784 (value scale, upstream
+main 2026-09-20; decisions D-139):
+
+* per-head attention sink logit (``attention_sink_bias``), an extra softmax column;
+* partial RoPE: neox ``rotate_half`` on the first ``head_dim * partial_rotary_factor``
+  (= 64) dims of Q and K, theta 1e4 (vLLM ``get_rope`` with ``rope_parameters``);
+* sliding window 1024, non-causal (``is_causal: false``): key ``k`` is visible to query
+  ``q`` iff ``q - k <= window - 1`` (FlashAttention window ``(w - 1, w - 1)``; inside a
+  block every key is visible);
+* V scaled by ``dflash_config.attention_value_scale`` (0.612) for context and query
+  K/V alike (PR #57784 ``v * v_scale`` / ``all_v.mul_(v_scale)``);
+* ``mask_embedding.pt``: the embedding of ``mask_token_id`` is replaced by this vector.
+
+Data flow per step (the wrapper ``DFlashQwen3ForCausalLM.forward`` contract, reused):
+``ctx = hidden_norm(fc(target_aux_hidden [T, 5H]))``, every layer's K/V of ``ctx``
+(k_norm, RoPE at the target positions, value scale) go into that layer's KV cache; then
+the block ``[bonus, mask x 7]`` at positions ``seq_len .. seq_len + 7`` runs through the
+5 layers (each writes its own block K/V and attends over the window); ``norm`` -> the
+target's lm_head -> greedy drafts.
+
+KV cache: one SWA (1024) layer each, ``layers.48 .. layers.52``. K is stored padded to
+the target's K width (192; V 128) so that every KV page has the target's size and vLLM's
+hybrid KV manager groups the draft layers without padded pages (the 5 draft layers form
+one group, the runner's DFlash branch keeps ``head_size_v`` and the window). Keys are
+read through the full block table: a window of ``(window - 1 + 7) // block_size + 2``
+blocks per request, gathered in the graph.
+
+Parallelism (TP group): Q heads ``64 / tp``, KV heads ``max(1, 8 / tp)`` (replicated when
+tp > 8, Q head ``h`` reads KV head ``h // 8``), MLP columns ``16384 / tp``; o_proj and
+down_proj partials all-reduced; fc column-parallel and all-gathered (``[T, 5H] -> [T, H]``).
+Tokens are replicated on every rank (the target hands over all-gathered features).
+
+``MIMO_DFLASH_DEBUG_RANDOM_DRAFT=1`` (tests only, as ``mtp_debug_random_draft``) replaces
+every draft token with a deterministic token that differs from the greedy one.
+"""
+
+import dataclasses
+import json
+import logging
+import os
+
+import torch
+from torch import nn
+from transformers import PretrainedConfig
+from vllm.distributed.parallel_state import get_tp_group
+
+import vllm_neuron.nn as neuron_nn
+from vllm_neuron.model.kv_cache import KVSpec, LayerSpec
+from vllm_neuron.model.neuron_config import NeuronConfig
+from vllm_neuron.model.qwen3.dflash_model import DFlashQwen3ForCausalLM
+from vllm_neuron.nn.embedding import VocabDimShardedEmbedding
+from vllm_neuron.nn.sampler import Sampler
+
+from .attention import apply_partial_rope, gather_paged, rope_cos_sin
+from .model import MiMoV2RMSNorm
+from .mtp_model import debug_random_draft
+
+logger = logging.getLogger(__name__)
+
+MASK_EMBEDDING_FILE = "mask_embedding.pt"
+DEBUG_RANDOM_DRAFT_ENV = "MIMO_DFLASH_DEBUG_RANDOM_DRAFT"
+_NEG = torch.finfo(torch.float32).min
+_SLIDING = "sliding_attention"
+
+
+@dataclasses.dataclass
+class MiMoV2DFlashConfig:
+    """Draft config (from the ``dflash/config.json`` hf_config, vLLM GPU lookups)."""
+
+    hidden_size: int
+    intermediate_size: int
+    num_hidden_layers: int
+    num_attention_heads: int
+    num_key_value_heads: int
+    head_dim: int
+    rms_norm_eps: float
+    rope_theta: float
+    rope_dim: int
+    sliding_window: int
+    block_size: int
+    mask_token_id: int
+    target_layer_ids: list
+    value_scale: float | None
+    vocab_size: int
+    kv_head_size: int  # stored K width (>= head_dim; the target's K width)
+    torch_dtype: torch.dtype = torch.bfloat16
+    neuron_config: NeuronConfig | None = None
+
+    @classmethod
+    def from_hf(cls, hf_config: PretrainedConfig, neuron_config: NeuronConfig | None = None,
+                kv_head_size: int | None = None) -> "MiMoV2DFlashConfig":
+        c = hf_config
+        dflash = dict(getattr(c, "dflash_config", None) or {})
+        n = c.num_hidden_layers
+        # causality as vLLM GPU _dflash_layer_causal: is_causal, else dflash_config.causal,
+        # else causal for SWA layers
+        is_causal = getattr(c, "is_causal", None)
+        if is_causal is None:
+            is_causal = dflash.get("causal")
+        layer_types = list(getattr(c, "layer_types", None) or [])
+        if is_causal is None:
+            is_causal = bool(layer_types) and any(t == _SLIDING for t in layer_types)
+        if is_causal:
+            raise NotImplementedError("MiMo-V2 DFlash drafter: only non-causal layers are "
+                                      "implemented (config is_causal must be false)")
+        if len(layer_types) != n or any(t != _SLIDING for t in layer_types):
+            raise NotImplementedError(f"MiMo-V2 DFlash drafter: every layer must be "
+                                      f"{_SLIDING}, got layer_types={layer_types}")
+        window = dflash.get("swa_window_size", getattr(c, "sliding_window", None))
+        if not window:
+            raise ValueError("MiMo-V2 DFlash drafter needs sliding_window")
+        if getattr(c, "attention_bias", False):
+            raise NotImplementedError("MiMo-V2 DFlash drafter: attention_bias is not supported")
+        if getattr(c, "hidden_act", "silu") != "silu":
+            raise NotImplementedError(f"hidden_act={c.hidden_act} is not supported")
+        head_dim = getattr(c, "head_dim", None) or c.hidden_size // c.num_attention_heads
+        rope = dict(getattr(c, "rope_parameters", None) or {})
+        theta = rope.get("rope_theta", getattr(c, "rope_theta", None))
+        factor = rope.get("partial_rotary_factor", getattr(c, "partial_rotary_factor", 1.0))
+        if rope.get("rope_type", "default") != "default" or theta is None:
+            raise NotImplementedError(f"MiMo-V2 DFlash drafter: rope {rope} is not supported")
+        rope_dim = int(head_dim * factor)
+        if rope_dim <= 0 or rope_dim % 2:
+            raise ValueError(f"rope_dim {rope_dim} must be positive and even")
+        block_size = dflash.get("block_size", getattr(c, "block_size", None))
+        mask_token_id = dflash.get("mask_token_id", getattr(c, "mask_token_id", None))
+        target_layer_ids = dflash.get("target_layer_ids", getattr(c, "target_layer_ids", None))
+        if block_size is None or mask_token_id is None or not target_layer_ids:
+            raise ValueError("DFlash draft config needs block_size, mask_token_id and "
+                             "target_layer_ids")
+        if kv_head_size is None:
+            kv_head_size = _target_k_head_size(head_dim)
+        if kv_head_size < head_dim:
+            raise ValueError(f"kv_head_size {kv_head_size} < head_dim {head_dim}")
+        dtype = getattr(c, "torch_dtype", None) or getattr(c, "dtype", None) or torch.bfloat16
+        if isinstance(dtype, str):
+            dtype = getattr(torch, dtype)
+        return cls(
+            hidden_size=c.hidden_size, intermediate_size=c.intermediate_size,
+            num_hidden_layers=n, num_attention_heads=c.num_attention_heads,
+            num_key_value_heads=c.num_key_value_heads, head_dim=head_dim,
+            rms_norm_eps=c.rms_norm_eps, rope_theta=float(theta), rope_dim=rope_dim,
+            sliding_window=int(window), block_size=int(block_size),
+            mask_token_id=int(mask_token_id), target_layer_ids=list(target_layer_ids),
+            value_scale=dflash.get("attention_value_scale"), vocab_size=c.vocab_size,
+            kv_head_size=int(kv_head_size), torch_dtype=dtype, neuron_config=neuron_config)
+
+
+def _target_k_head_size(head_dim: int) -> int:
+    """K width of the target's KV pages (MiMo-V2: 192 for both layer types), so the draft's
+    pages match them; the draft's own ``head_dim`` when no target config is current."""
+    from vllm.config import get_current_vllm_config
+
+    model_config = getattr(get_current_vllm_config(), "model_config", None)
+    if model_config is None:
+        return head_dim
+    target = model_config.hf_config
+    widths = {getattr(target, "head_dim", head_dim), getattr(target, "swa_head_dim", head_dim)}
+    return max(max(widths), head_dim)
+
+
+# =============================================================================
+# KV head sharding (same rule as the target attention: replicate when tp > n_kv)
+# =============================================================================
+def head_split(n_q: int, n_kv: int, tp: int, rank: int) -> tuple[range, range]:
+    """(Q heads, KV heads) of ``rank``: ``n_q / tp`` Q heads, ``max(1, n_kv / tp)`` KV heads;
+    Q head ``h`` uses KV head ``h // (n_q / n_kv)``."""
+    if n_q % tp or not (n_kv % tp == 0 or tp % n_kv == 0):
+        raise ValueError(f"{n_q} Q / {n_kv} KV heads incompatible with tp={tp}")
+    nq = n_q // tp
+    q = range(rank * nq, (rank + 1) * nq)
+    if n_kv >= tp:
+        nkv = n_kv // tp
+        return q, range(rank * nkv, (rank + 1) * nkv)
+    group = n_q // n_kv
+    kv = q.start // group
+    return q, range(kv, kv + 1)
+
+
+# =============================================================================
+# Layers
+# =============================================================================
+class MiMoV2DFlashAttention(nn.Module):
+    def __init__(self, config: MiMoV2DFlashConfig, layer_idx: int):
+        super().__init__()
+        self.layer_idx = layer_idx
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        tp = self.world_size
+        D = config.head_dim
+        q_heads, kv_heads = head_split(config.num_attention_heads, config.num_key_value_heads,
+                                       tp, 0)
+        self.num_heads_per_rank = len(q_heads)
+        self.num_kv_heads_per_rank = len(kv_heads)
+        self.head_dim = D
+        self.kv_head_size = config.kv_head_size
+        self.rope_dim = config.rope_dim
+        self.rope_theta = config.rope_theta
+        self.window = config.sliding_window
+        self.value_scale = config.value_scale
+        self.scaling = D**-0.5
+        self.dtype = config.torch_dtype
+        self.q_size = self.num_heads_per_rank * D
+        self.kv_size = self.num_kv_heads_per_rank * D
+        H = config.hidden_size
+        self.qkv_proj_weight = nn.Parameter(
+            torch.empty(H, self.q_size + 2 * self.kv_size, dtype=self.dtype), requires_grad=False)
+        self.o_proj_weight = nn.Parameter(
+            torch.empty(self.q_size, H, dtype=self.dtype), requires_grad=False)
+        self.attention_sink_bias = nn.Parameter(
+            torch.empty(self.num_heads_per_rank, dtype=torch.float32), requires_grad=False)
+        self.q_norm = MiMoV2RMSNorm(D, config.rms_norm_eps, self.dtype)
+        self.k_norm = MiMoV2RMSNorm(D, config.rms_norm_eps, self.dtype)
+        self.k_cache = None
+        self.v_cache = None
+
+    # ── K/V shared by the context pass and the block ──────────────────────
+    def project_kv(self, x: torch.Tensor, positions: torch.Tensor, cos_sin=None):
+        """``x [T, H]`` -> K ``[T, nkv, D]`` (k_norm, RoPE), V ``[T, nkv, D]`` (value scale)."""
+        T = x.shape[0]
+        kv = torch.matmul(x.to(self.dtype), self.qkv_proj_weight[:, self.q_size:])
+        k, v = torch.split(kv, [self.kv_size, self.kv_size], dim=-1)
+        k = self.k_norm(k.reshape(T, self.num_kv_heads_per_rank, self.head_dim))
+        cos, sin = cos_sin if cos_sin is not None else rope_cos_sin(
+            positions, self.rope_dim, self.rope_theta)
+        k = apply_partial_rope(k, cos, sin, self.rope_dim)
+        v = v.reshape(T, self.num_kv_heads_per_rank, self.head_dim)
+        if self.value_scale is not None:
+            v = v * self.value_scale
+        return k, v
+
+    def write_kv(self, k: torch.Tensor, v: torch.Tensor, slots: torch.Tensor) -> None:
+        """Paged write of ``k, v [T, nkv, D]`` at ``slots [T]`` (K zero-padded to the
+        cache's K width)."""
+        bs = self.k_cache.shape[2]
+        T, nkv, D = k.shape
+        if self.k_cache.shape[3] > D:
+            k = nn.functional.pad(k, (0, self.k_cache.shape[3] - D))
+        slots = slots.to(torch.int64)
+        blk = torch.div(slots, bs, rounding_mode="floor")
+        off = slots - blk * bs
+        head = torch.arange(nkv, dtype=torch.int64, device=k.device).repeat_interleave(T)
+        blk = blk.repeat(nkv)
+        off = off.repeat(nkv)
+        self.k_cache.index_put_((blk, head, off),
+                                k.transpose(0, 1).reshape(nkv * T, -1).to(self.k_cache.dtype))
+        self.v_cache.index_put_((blk, head, off),
+                                v.transpose(0, 1).reshape(nkv * T, -1).to(self.v_cache.dtype))
+
+    def forward(self, x: torch.Tensor, positions: torch.Tensor, cos_sin, meta: dict,
+                batch_size: int) -> torch.Tensor:
+        """Block ``x [B*S, H]`` at ``positions [B*S]`` -> o_proj partials ``[B*S, H]``."""
+        B = batch_size
+        N = x.shape[0]
+        S = N // B
+        D, nq, nkv = self.head_dim, self.num_heads_per_rank, self.num_kv_heads_per_rank
+        q = torch.matmul(x.to(self.dtype), self.qkv_proj_weight[:, :self.q_size])
+        q = self.q_norm(q.reshape(N, nq, D))
+        cos, sin = cos_sin
+        q = apply_partial_rope(q, cos, sin, self.rope_dim)
+        k, v = self.project_kv(x, positions, cos_sin)
+        self.write_kv(k, v, meta["slot_mapping"])
+
+        # window of every request: keys q0 - (w - 1) .. q0 + S - 1, read from the cache
+        bs = self.k_cache.shape[2]
+        table = meta["block_table_tensor"]  # full table [>= B, width]
+        width = table.shape[1]
+        nbw = (self.window - 1 + S - 1) // bs + 2
+        qpos = positions.reshape(B, S).to(torch.int64)
+        first = torch.clamp(torch.div(qpos[:, 0] - (self.window - 1), bs, rounding_mode="floor"),
+                            min=0)
+        cols = first[:, None] + torch.arange(nbw, dtype=torch.int64, device=x.device)[None]
+        blocks = torch.gather(table[:B].to(torch.int64), 1, torch.clamp(cols, max=width - 1))
+        kc = gather_paged(self.k_cache, blocks)[..., :D]  # [B, nkv, nbw*bs, D]
+        vc = gather_paged(self.v_cache, blocks)
+        kpos = (cols[:, :, None] * bs
+                + torch.arange(bs, dtype=torch.int64, device=x.device)[None, None]).reshape(B, -1)
+        in_table = (cols < width)[:, :, None].expand(B, nbw, bs).reshape(B, -1)
+        valid = in_table & (kpos <= qpos[:, -1:])  # written: context + this block
+        vis = valid[:, None, :] & (kpos[:, None, :] >= qpos[:, :, None] - (self.window - 1))
+
+        qh = q.reshape(B, S, nq, D).permute(0, 2, 1, 3).to(torch.float32)  # [B, nq, S, D]
+        groups = nq // nkv
+        kf = kc.to(torch.float32)
+        vf = vc.to(torch.float32)
+        if groups > 1:
+            kf = kf.repeat_interleave(groups, dim=1)
+            vf = vf.repeat_interleave(groups, dim=1)
+        scores = torch.matmul(qh, kf.transpose(-1, -2)) * self.scaling  # [B, nq, S, L]
+        scores = scores.masked_fill(~vis[:, None], _NEG)
+        sink = self.attention_sink_bias.to(torch.float32).view(1, nq, 1, 1).expand(B, nq, S, 1)
+        probs = torch.softmax(torch.cat([scores, sink], dim=-1), dim=-1)[..., :-1]
+        out = torch.matmul(probs, vf)  # [B, nq, S, D]
+        out = out.permute(0, 2, 1, 3).reshape(N, nq * D).to(self.dtype)
+        return torch.matmul(out, self.o_proj_weight)
+
+
+class MiMoV2DFlashMLP(nn.Module):
+    def __init__(self, config: MiMoV2DFlashConfig):
+        super().__init__()
+        tp = get_tp_group().world_size
+        if config.intermediate_size % tp:
+            raise ValueError(f"intermediate_size {config.intermediate_size} % tp {tp}")
+        i = config.intermediate_size // tp
+        H, dt = config.hidden_size, config.torch_dtype
+        self.gate_proj_weight = nn.Parameter(torch.empty(H, i, dtype=dt), requires_grad=False)
+        self.up_proj_weight = nn.Parameter(torch.empty(H, i, dtype=dt), requires_grad=False)
+        self.down_proj_weight = nn.Parameter(torch.empty(i, H, dtype=dt), requires_grad=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        g = torch.matmul(x, self.gate_proj_weight)
+        u = torch.matmul(x, self.up_proj_weight)
+        return torch.matmul(nn.functional.silu(g) * u, self.down_proj_weight)
+
+
+class MiMoV2DFlashDecoderLayer(nn.Module):
+    def __init__(self, config: MiMoV2DFlashConfig, layer_idx: int):
+        super().__init__()
+        H, eps, dt = config.hidden_size, config.rms_norm_eps, config.torch_dtype
+        self.tp_group = get_tp_group()
+        self.input_layernorm = MiMoV2RMSNorm(H, eps, dt)
+        self.self_attn = MiMoV2DFlashAttention(config, layer_idx)
+        self.post_attention_layernorm = MiMoV2RMSNorm(H, eps, dt)
+        self.mlp = MiMoV2DFlashMLP(config)
+
+    def _reduce(self, x: torch.Tensor) -> torch.Tensor:
+        return self.tp_group.all_reduce(x) if self.tp_group.world_size > 1 else x
+
+    def forward(self, hidden: torch.Tensor, positions: torch.Tensor, cos_sin, meta: dict,
+                batch_size: int) -> torch.Tensor:
+        h = self._reduce(self.self_attn(self.input_layernorm(hidden), positions, cos_sin, meta,
+                                        batch_size))
+        hidden = hidden + h
+        h = self._reduce(self.mlp(self.post_attention_layernorm(hidden)))
+        return hidden + h
+
+
+class MiMoV2DFlashModel(nn.Module):
+    """Backbone: context K/V from the target features, then the block forward."""
+
+    def __init__(self, config: MiMoV2DFlashConfig, start_layer_idx: int):
+        super().__init__()
+        self.config = config
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        H, dt = config.hidden_size, config.torch_dtype
+        if H % self.world_size:
+            raise ValueError(f"hidden_size {H} % tp {self.world_size}")
+        self.layers = nn.ModuleList(MiMoV2DFlashDecoderLayer(config, start_layer_idx + i)
+                                    for i in range(config.num_hidden_layers))
+        n_feat = len(config.target_layer_ids)
+        # fc column-parallel over its H outputs (all-gathered); x @ W layout
+        self.fc_weight = nn.Parameter(
+            torch.empty(n_feat * H, H // self.world_size, dtype=dt), requires_grad=False)
+        self.hidden_norm = MiMoV2RMSNorm(H, config.rms_norm_eps, dt)
+        self.norm = MiMoV2RMSNorm(H, config.rms_norm_eps, dt)
+        self.mask_embedding = nn.Parameter(torch.zeros(H, dtype=dt), requires_grad=False)
+        self.has_separate_mask_embedding = False
+        # replaced by the target's embedding (alias_target_head)
+        self.embed_tokens = VocabDimShardedEmbedding(
+            vocab_size=config.vocab_size, embed_dim=H, dtype=dt,
+            tp_group=self.tp_group.device_group)
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        # the rank as the SPMD rank tensor (not a Python int), so every rank traces the
+        # same graph (one draft NEFF, not one per rank)
+        emb = self.embed_tokens(input_ids, scatter_tokens=False,
+                                rank=self.tp_group.rank_in_group_tensor)
+        if self.has_separate_mask_embedding:
+            is_mask = (input_ids == self.config.mask_token_id)[:, None]
+            emb = torch.where(is_mask, self.mask_embedding.to(emb.dtype)[None], emb)
+        return emb
+
+    def context_features(self, context_states: torch.Tensor) -> torch.Tensor:
+        """``hidden_norm(fc(target features [T, n*H]))`` -> ``[T, H]``."""
+        x = torch.matmul(context_states.to(self.fc_weight.dtype), self.fc_weight)
+        if self.world_size > 1:
+            x = self.tp_group.all_gather(x, dim=1)
+        return self.hidden_norm(x)
+
+    @torch.no_grad()
+    def precompute_and_store_context_kv(self, context_states: torch.Tensor,
+                                        context_positions: torch.Tensor,
+                                        context_slot_mapping: torch.Tensor) -> None:
+        ctx = self.context_features(context_states)
+        attn0 = self.layers[0].self_attn
+        cos_sin = rope_cos_sin(context_positions, attn0.rope_dim, attn0.rope_theta)
+        for layer in self.layers:
+            k, v = layer.self_attn.project_kv(ctx, context_positions, cos_sin)
+            layer.self_attn.write_kv(k, v, context_slot_mapping)
+
+    @torch.no_grad()
+    def forward(self, input_ids: torch.Tensor, positions: torch.Tensor,
+                attn_metadata: dict) -> torch.Tensor:
+        """Block ``[bonus, mask...]`` per request (``[B*S]`` ids / positions)."""
+        attn0 = self.layers[0].self_attn
+        meta = attn_metadata[f"layers.{attn0.layer_idx}.self_attn"]
+        B = meta["block_table_tensor"].shape[0]
+        hidden = self.embed_input_ids(input_ids)
+        cos_sin = rope_cos_sin(positions, attn0.rope_dim, attn0.rope_theta)
+        for layer in self.layers:
+            hidden = layer(hidden, positions, cos_sin, meta, B)
+        return self.norm(hidden)
+
+
+# =============================================================================
+# Draft wrapper (DFlashProposer contract)
+# =============================================================================
+class MiMoV2DFlashDraftModel(DFlashQwen3ForCausalLM):
+    """MiMo-V2 DFlash drafter; the proposal preparation, sampling of the block and the
+    target-head aliasing are the generic DFlash wrapper's (``DFlashQwen3ForCausalLM``)."""
+
+    has_own_embed_tokens = False
+    has_own_lm_head = False
+    # the target returns the aux hidden states as separate [T, H] parts (T54 D-313); this
+    # graph concatenates them (DFlashProposer builds the warmup inputs the same way)
+    target_hidden_parts = True
+
+    def __init__(self, config: MiMoV2DFlashConfig, start_layer_idx: int = 0):
+        nn.Module.__init__(self)
+        self.config = config
+        self.model = MiMoV2DFlashModel(config, start_layer_idx)
+        self.num_speculative_tokens = config.block_size - 1
+        self.layer_names = [f"layers.{start_layer_idx + i}.self_attn"
+                            for i in range(config.num_hidden_layers)]
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        nc = config.neuron_config
+        self.on_device_sampling_config = nc.on_device_sampling_config if nc else None
+        self._return_logits = nc is not None and nc.debug_logits_dir is not None
+        self.debug_random_draft = os.environ.get(DEBUG_RANDOM_DRAFT_ENV, "0") == "1"
+        if self.debug_random_draft:
+            logger.warning("%s=1: DFlash drafts replaced by non-greedy tokens (tests only)",
+                           DEBUG_RANDOM_DRAFT_ENV)
+        self.lm_head = neuron_nn.ColumnParallelLinear(
+            config.hidden_size, config.vocab_size, bias=False, dtype=config.torch_dtype,
+            gather_output=self.on_device_sampling_config is None,
+            tp_group=self.tp_group.device_group)
+        if self.on_device_sampling_config is not None:
+            self.sampler = Sampler(self.on_device_sampling_config,
+                                   process_group=self.tp_group.device_group)
+
+    @classmethod
+    def from_configs(cls, config: PretrainedConfig, start_layer_idx: int = 0,
+                     neuron_config: NeuronConfig | None = None,
+                     kv_head_size: int | None = None):
+        return cls(MiMoV2DFlashConfig.from_hf(config, neuron_config, kv_head_size),
+                   start_layer_idx=start_layer_idx)
+
+    # ── forward ───────────────────────────────────────────────────────────
+
+    def _prepare_proposal_inputs(self, *, attn_metadata: dict, **kwargs):
+        """The generic preparation on the **full** block table: the draft group is SWA, so
+        the runner's decode table is trimmed to the window of ``num_computed_tokens`` (it
+        can miss the block of later draft positions); slots and the in-graph window
+        gather use the full table."""
+        meta = dict(attn_metadata[self.layer_names[0]])
+        full = meta.get("full_block_table_tensor")
+        if full is not None:
+            meta["block_table_tensor"] = full
+            meta["max_blocks_per_seq"] = full.shape[1]
+        return super()._prepare_proposal_inputs(attn_metadata={self.layer_names[0]: meta},
+                                                **kwargs)
+
+    @torch.no_grad()
+    def forward(self, target_positions, target_hidden_states, last_token_indices,
+                attn_metadata, raw_sampled_token_ids, prev_sampled_token_ids,
+                prev_num_draft_tokens, req_indices_per_token, cur_num_draft_tokens):
+        """One block-parallel proposal (``DFlashQwen3ForCausalLM.forward`` contract)."""
+        if isinstance(target_hidden_states, (tuple, list)):
+            # T54 D-313: the target's aux hidden parts, concatenated in this graph (the same
+            # [T, 5H] BF16 values the target graph used to concatenate)
+            target_hidden_states = torch.cat(list(target_hidden_states), dim=-1)
+        (input_ids, positions, draft_meta, keep_idx, context_positions,
+         context_slot_mapping, bonus_token_ids) = self._prepare_proposal_inputs(
+            target_positions=target_positions, target_hidden_states=target_hidden_states,
+            last_token_indices=last_token_indices, attn_metadata=attn_metadata,
+            raw_sampled_token_ids=raw_sampled_token_ids,
+            prev_sampled_token_ids=prev_sampled_token_ids,
+            prev_num_draft_tokens=prev_num_draft_tokens,
+            req_indices_per_token=req_indices_per_token,
+            cur_num_draft_tokens=cur_num_draft_tokens)
+        self.model.precompute_and_store_context_kv(target_hidden_states, context_positions,
+                                                   context_slot_mapping)
+        hidden = self.model(input_ids, positions, draft_meta)
+        drafts_hidden = torch.index_select(hidden, 0, keep_idx)
+        logits = self.lm_head(drafts_hidden.to(self.config.torch_dtype))
+        drafts = self._sample_draft_tokens(logits)
+        if self.debug_random_draft:
+            drafts = debug_random_draft(drafts, torch.index_select(positions, 0, keep_idx),
+                                        self.config.vocab_size)
+        B = last_token_indices.shape[0]
+        drafts = drafts.view(B, self.config.block_size - 1).to(torch.int32)
+        draft_and_bonus = torch.cat([bonus_token_ids.view(B, 1), drafts], dim=1)
+        if self._return_logits:
+            return draft_and_bonus, drafts, logits
+        return draft_and_bonus, drafts
+
+    # ── KV cache ──────────────────────────────────────────────────────────
+
+    def get_kv_spec(self) -> KVSpec:
+        """One SWA layer per draft layer: K stored ``kv_head_size`` wide (padded), V
+        ``head_dim``, the window of the checkpoint."""
+        layers = []
+        for name, layer in zip(self.layer_names, self.model.layers):
+            attn = layer.self_attn
+            layers.append(LayerSpec(
+                name=name, num_kv_heads=attn.num_kv_heads_per_rank,
+                head_size=attn.kv_head_size, head_size_v=attn.head_dim, dtype=attn.dtype,
+                sliding_window_size=attn.window, chunk_size=None))
+        return KVSpec(layers=layers)
+
+    def bind_kv_cache(self, kv_caches: dict) -> None:
+        for name, layer in zip(self.layer_names, self.model.layers):
+            if name not in kv_caches:
+                raise RuntimeError(f"KV cache for layer {name} not initialized")
+            k_cache, v_cache = kv_caches[name]
+            attn = layer.self_attn
+            want_k = (attn.num_kv_heads_per_rank, attn.kv_head_size)
+            want_v = (attn.num_kv_heads_per_rank, attn.head_dim)
+            if (k_cache.dim() != 4 or v_cache.dim() != 4
+                    or (k_cache.shape[1], k_cache.shape[3]) != want_k
+                    or (v_cache.shape[1], v_cache.shape[3]) != want_v):
+                raise ValueError(f"{name}: KV cache K {tuple(k_cache.shape)} V "
+                                 f"{tuple(v_cache.shape)} do not match [nb, {want_k[0]}, bs, "
+                                 f"{want_k[1]}] / [nb, {want_v[0]}, bs, {want_v[1]}]")
+            attn.k_cache = k_cache
+            attn.v_cache = v_cache
+
+    # ── weights ───────────────────────────────────────────────────────────
+
+    def load_weights(self, checkpoint_path: str, device: torch.device,
+                     cache_dir: str | None = None) -> None:
+        """Rank shard of the ``dflash/`` checkpoint (``load_dflash_rank_state``) plus
+        ``mask_embedding.pt``; embedding and lm_head come from the target."""
+        if not os.path.isdir(checkpoint_path):
+            raise ValueError(f"MiMo-V2 DFlash draft: {checkpoint_path!r} must be a local "
+                             "directory (the checkpoint's dflash/ folder)")
+        rank = self.tp_group.rank_in_group
+        state = load_dflash_rank_state(checkpoint_path, self.config, self.world_size, rank)
+        mask = read_mask_embedding(checkpoint_path, self.config.mask_token_id)
+        if mask is not None:
+            state["model.mask_embedding"] = mask.to(self.config.torch_dtype)
+            self.model.has_separate_mask_embedding = True
+            logger.info("Loaded DFlash mask embedding for mask_token_id %d from %s",
+                        self.config.mask_token_id, MASK_EMBEDDING_FILE)
+        params = dict(self.named_parameters())
+        absent = {"model.embed_tokens.weight", "lm_head.weight"}
+        if mask is None:
+            absent.add("model.mask_embedding")
+        missing = sorted(set(params) - set(state) - absent)
+        unknown = sorted(set(state) - set(params))
+        if missing or unknown:
+            raise KeyError(f"MiMo-V2 DFlash draft: missing {missing[:5]}, unknown {unknown[:5]}")
+        for name, t in state.items():
+            p = params[name]
+            if tuple(p.shape) != tuple(t.shape) or p.dtype != t.dtype:
+                raise ValueError(f"{name}: parameter {tuple(p.shape)} {p.dtype} vs loaded "
+                                 f"{tuple(t.shape)} {t.dtype}")
+        self.load_state_dict({k: v.to(device) for k, v in state.items()}, strict=False,
+                             assign=True)
+        with torch.no_grad():
+            for mod, attr in ((self.model.embed_tokens, "weight"), (self.lm_head, "weight")):
+                w = getattr(mod, attr)
+                if w.is_meta:
+                    setattr(mod, attr, nn.Parameter(torch.empty_like(w, device=device),
+                                                    requires_grad=False))
+            if mask is None and self.model.mask_embedding.is_meta:
+                self.model.mask_embedding = nn.Parameter(
+                    torch.zeros_like(self.model.mask_embedding, device=device),
+                    requires_grad=False)
+
+
+def read_mask_embedding(checkpoint_dir: str, mask_token_id: int) -> torch.Tensor | None:
+    """``mask_embedding.pt`` (dict ``{"embedding", "mask_token_id"}`` or a tensor) as
+    ``[H]``, None when absent (vLLM GPU ``_read_mask_embedding``)."""
+    path = os.path.join(checkpoint_dir, MASK_EMBEDDING_FILE)
+    if not os.path.isfile(path):
+        return None
+    state = torch.load(path, weights_only=True, map_location="cpu")
+    if isinstance(state, dict):
+        if state.get("mask_token_id", mask_token_id) != mask_token_id:
+            raise ValueError(f"{MASK_EMBEDDING_FILE} mask_token_id {state.get('mask_token_id')}"
+                             f" != dflash_config.mask_token_id {mask_token_id}")
+        state = state["embedding"]
+    return state.reshape(-1)
+
+
+def _checkpoint_files(checkpoint_dir: str) -> dict:
+    """tensor name -> safetensors file of the draft checkpoint."""
+    index = os.path.join(checkpoint_dir, "model.safetensors.index.json")
+    if os.path.isfile(index):
+        with open(index) as f:
+            wm = json.load(f)["weight_map"]
+        return {k: os.path.join(checkpoint_dir, v) for k, v in wm.items()}
+    from safetensors import safe_open
+
+    out = {}
+    for fn in sorted(os.listdir(checkpoint_dir)):
+        if fn.endswith(".safetensors"):
+            path = os.path.join(checkpoint_dir, fn)
+            with safe_open(path, "pt") as f:
+                out.update({k: path for k in f.keys()})
+    return out
+
+
+def load_dflash_rank_state(checkpoint_dir: str, config: MiMoV2DFlashConfig, tp_size: int,
+                           tp_rank: int) -> dict:
+    """Parameters of ``MiMoV2DFlashDraftModel`` on ``tp_rank`` (names of the module), read
+    from the HF ``dflash/`` checkpoint (``fc``, ``hidden_norm``, ``norm``,
+    ``layers.<i>.{self_attn.{q,k,v,o}_proj, q_norm, k_norm, attention_sink_bias},
+    mlp.{gate,up,down}_proj, input_layernorm, post_attention_layernorm}``).
+
+    Linear weights are stored ``[in, out]`` (``x @ W``); the sink is FP32. Every tensor of
+    the checkpoint must be used (no embed_tokens / lm_head: the target's are shared).
+    """
+    from safetensors import safe_open
+
+    files = _checkpoint_files(checkpoint_dir)
+    used = set()
+    handles = {}
+    dt = config.torch_dtype
+
+    def get(name, dim=None, start=0, length=None):
+        used.add(name)
+        path = files[name]
+        if path not in handles:
+            handles[path] = safe_open(path, "pt")
+        sl = handles[path].get_slice(name)
+        if dim is None:
+            return sl[:]
+        idx = [slice(None)] * len(sl.get_shape())
+        idx[dim] = slice(start, start + length)
+        return sl[tuple(idx)]
+
+    H, D, I = config.hidden_size, config.head_dim, config.intermediate_size
+    q_heads, kv_heads = head_split(config.num_attention_heads, config.num_key_value_heads,
+                                   tp_size, tp_rank)
+    nq, nkv = len(q_heads), len(kv_heads)
+    i_r = I // tp_size
+    h_r = H // tp_size
+    st = {
+        "model.fc_weight": get("fc.weight", 0, tp_rank * h_r, h_r).t().contiguous().to(dt),
+        "model.hidden_norm.weight": get("hidden_norm.weight").to(dt),
+        "model.norm.weight": get("norm.weight").to(dt),
+    }
+    for i in range(config.num_hidden_layers):
+        c, m = f"layers.{i}.", f"model.layers.{i}."
+        q = get(c + "self_attn.q_proj.weight", 0, q_heads.start * D, nq * D)
+        k = get(c + "self_attn.k_proj.weight", 0, kv_heads.start * D, nkv * D)
+        v = get(c + "self_attn.v_proj.weight", 0, kv_heads.start * D, nkv * D)
+        st[m + "self_attn.qkv_proj_weight"] = torch.cat([q, k, v], 0).t().contiguous().to(dt)
+        st[m + "self_attn.o_proj_weight"] = get(
+            c + "self_attn.o_proj.weight", 1, q_heads.start * D, nq * D).t().contiguous().to(dt)
+        st[m + "self_attn.attention_sink_bias"] = get(
+            c + "self_attn.attention_sink_bias", 0, q_heads.start, nq).to(torch.float32)
+        for nm in ("q_norm", "k_norm"):
+            st[m + f"self_attn.{nm}.weight"] = get(c + f"self_attn.{nm}.weight").to(dt)
+        for nm in ("gate_proj", "up_proj"):
+            st[m + f"mlp.{nm}_weight"] = get(
+                c + f"mlp.{nm}.weight", 0, tp_rank * i_r, i_r).t().contiguous().to(dt)
+        st[m + "mlp.down_proj_weight"] = get(
+            c + "mlp.down_proj.weight", 1, tp_rank * i_r, i_r).t().contiguous().to(dt)
+        for nm in ("input_layernorm", "post_attention_layernorm"):
+            st[m + f"{nm}.weight"] = get(c + f"{nm}.weight").to(dt)
+    unused = sorted(set(files) - used)
+    if unused:
+        raise KeyError(f"MiMo-V2 DFlash checkpoint tensors not used: {unused[:5]}")
+    return st
diff --git a/vllm_neuron/model/mimo_v2/expert_placement.py b/vllm_neuron/model/mimo_v2/expert_placement.py
