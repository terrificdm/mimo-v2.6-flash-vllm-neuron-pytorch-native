index 0000000..f132766
--- /dev/null
+++ b/vllm_neuron/_kernels/mimo_v2/attention_decode_pm.py
@@ -0,0 +1,346 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 decode attention over the paged KV cache: batched position-major kernel (NKI, T54 rule LL).
+
+The decode kernel of every layer, configuration, context and batch size (T54 rule LL, user
+2026-11-13). The T32 block-per-partition kernel (``attention_decode.py``) stays as a test reference.
+
+Why (T54 D-303): the T32 kernel walks the requests one after another and, inside a request, the 32
+slots of a block, so a request costs about 430 dependent instructions per layer and program. A
+one-core bench and the device trace show the time is the latency of that chain, about 14 us (SWA)
+/ 22 us (global) per request and layer whatever the context, which at 32 requests is ~24 ms per
+decode step. A per-request position-major version (round 1) cut the instruction count ~20x but
+kept the per-request chain and ran at the same speed. This kernel removes the chain: the requests
+of a batch are processed together in *rounds*.
+
+Round ``r`` of program ``p`` covers ``CH`` table positions of every request (``dyn``: table
+positions ``(r * n_prg + p) * CH ..``, the same for all requests; ``swa1``: one round, each
+request's own 128-position window chunk, the requests split over the programs):
+
+* the cache rows of the chunk positions (``slots``, built by the caller) are gathered
+  position-major with ``R = CH / 128`` consecutive positions per partition (``R`` cache rows of
+  one block, so each DMA row is ``R * 384`` / ``R * 256`` contiguous bytes), one indirect DMA per
+  request for K and one for V; score column ``k * 128 + p`` is chunk position ``R * p + k``;
+* K^T by one PE transpose per 128 positions and d-tile (128 + 64);
+* scores ``s [B*G, CH]`` with all query columns of the batch on partitions: request ``b``'s
+  matmul has the stationary ``Q_pad_b`` (``[d, B*G]``, zero outside ``b``'s columns) and its
+  own K^T moving, all accumulated in one PSUM tile, so row ``(b, g)`` holds ``q_bg . k_b``;
+* one mask (per-row thresholds against an iota of the chunk), max, exp + row sum and running
+  state update for the whole batch;
+* P^T by one PE transpose per 128 positions; request ``b``'s PV matmul has P^T masked to ``b``'s
+  columns stationary and its own V moving, all accumulated in one PSUM tile.
+
+The instructions of different requests in a round are independent (separate slices of the round
+tiles), so their latencies overlap; the dependent chain is per round, not per request.
+
+Round 3 (T54 D-304): the ``dyn`` slots are compact (one entry per partition run, 1/R of the
+table), and when the K / V tiles of one round are small (``len(rows) * R * (D + Dv) * 2 <=
+PF_BYTES``, i.e. one request split in at most 4 segments) the rounds run in pairs with two buffer
+sets, so round ``r + 1``'s index and K / V DMAs are issued before round ``r``'s compute (a
+trace-time pipelining choice of this kernel by shape; numerics unchanged).
+
+Numerics are those of the T32 kernel and of GPU FlashAttention (rule AA): QK^T in FP32 PSUM from
+BF16, the probabilities rounded to the V dtype before P.V, FP32 row sums, online softmax over the
+rounds (``attention_nki.combine`` merges the programs, this step's keys and the sink).
+
+Inputs: ``q_t [B, D, G]`` bf16, ``k_cache [nb, 1, bs, D]``, ``v_cache [nb, 1, bs, Dv]``,
+``slots [B, W]`` int32 (``swa1``: ``W = 128``, the cache row of each window position; ``dyn``:
+compact, ``slots[b, c]`` = cache row of table position ``R * c``, the first of the ``R`` consecutive
+rows one partition reads; ``W`` a multiple of ``128 * n_prg`` with one padding round after the
+last real one), ``n_round [1, 3]`` int32 (``dyn``: rounds, rounds // 2, rounds % 2),
+``thr [n_prg, B * G, 2]`` fp32 (``hi``, ``lo``
+per row and program; key ``j`` of the chunk is visible iff ``lo < pos(j) < hi``, positions
+chunk-relative for ``swa1`` and table positions for ``dyn``; rows a program does not own have
+``hi = -1``).
+Outputs: ``acc [n_prg, B * G, Dv]`` fp32, ``ml [n_prg, B * G, 2]`` fp32 (``m``, ``l``).
+"""
+
+import hashlib
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+
+P_MAX = 128
+with open(__file__, "rb") as _f:
+    KERNEL_REV = hashlib.sha256(_f.read()).hexdigest()[:16]
+M_FLOOR = -1.0e20
+MASK_PENALTY = -1.0e30
+SWA_CHUNK = 128
+DYN_CHUNK = 1024  # R = 8 positions per partition: 3 KB / 2 KB DMA rows (T54 D-303)
+PF_BYTES = 24 * 1024  # per-partition bytes of one round's K + V tiles up to which rounds are pipelined
+
+
+def kernel_assert(cond, msg):
+    if not cond:
+        raise AssertionError(f"[mimo_decode_attn_pm] {msg}")
+
+
+@nki.jit
+def mimo_decode_attn_prior_pm(q_t, k_cache, v_cache, slots, n_round, thr, scale=1.0, window=0,
+                              mode="dyn", chunk=DYN_CHUNK, rev=""):
+    """Prior-key decode attention partials, batched position-major (see module docstring).
+
+    ``rev``: pass ``KERNEL_REV`` (enters the NKI compile-cache key, see attention_decode.py).
+    """
+    B, D, G = q_t.shape
+    nb, nkv, bs, Dk = k_cache.shape
+    Dv = v_cache.shape[3]
+    W = slots.shape[1]
+    BG = B * G
+    kernel_assert(nkv == 1 and v_cache.shape[1] == 1, f"one KV head per rank, got {nkv}")
+    kernel_assert(Dk == D and P_MAX < D <= 2 * P_MAX, f"QK head dim {D} must be in (128, 256]")
+    kernel_assert(Dv <= P_MAX, f"V head dim {Dv} must be <= 128")
+    kernel_assert(BG <= P_MAX, f"{B} requests x {G} query columns > {P_MAX}")
+    kernel_assert(mode in ("dyn", "swa1"), f"mode {mode}")
+    kernel_assert(chunk % P_MAX == 0 and chunk <= 1024, f"chunk {chunk}")
+    D1 = D - P_MAX
+    CH = chunk
+    NS = CH // P_MAX  # R: consecutive positions per partition (one DMA row of NS cache rows)
+    kernel_assert(mode == "dyn" or NS == 1, "swa1 takes one position per partition")
+    kernel_assert(bs % NS == 0, f"block_size {bs} must be a multiple of {NS} positions per partition")
+    BGp = BG + (BG % 2)  # PSUM column stride of the P^T tiles (4-byte aligned bf16 writes)
+    n_prg = nl.num_programs(0) if nl.program_ndim() > 0 else 1
+    prg = nl.program_id(0) if nl.program_ndim() > 0 else 0
+    kernel_assert(tuple(thr.shape) == (n_prg, BG, 2), f"thr shape {thr.shape} != {(n_prg, BG, 2)}")
+    if mode == "swa1":
+        kernel_assert(W == CH, f"swa1 slots width {W} != chunk {CH}")
+    else:
+        kernel_assert(W % (P_MAX * n_prg) == 0 and W >= 2 * P_MAX * n_prg,
+                      f"compact slots width {W} must be a multiple of {P_MAX} x {n_prg}, >= 2 rounds")
+        kernel_assert(tuple(n_round.shape) == (1, 3), f"n_round shape {n_round.shape}")
+
+    acc_out = nl.ndarray((n_prg, BG, Dv), dtype=nl.float32, buffer=nl.shared_hbm)
+    ml_out = nl.ndarray((n_prg, BG, 2), dtype=nl.float32, buffer=nl.shared_hbm)
+    k_rows = k_cache.reshape((nb * bs, D))
+    v_rows = v_cache.reshape((nb * bs, Dv))
+    mine = [b for b in range(B) if mode == "dyn" or b % n_prg == prg]
+
+    # ── per-call constants ─────────────────────────────────────────────
+    # Q_pad[:, b, :] = request b's queries in its columns b*G .. b*G+G-1, zero elsewhere
+    qp_a = nl.ndarray((P_MAX, B * BG), dtype=q_t.dtype, buffer=nl.sbuf)
+    qp_b = nl.ndarray((D1, B * BG), dtype=q_t.dtype, buffer=nl.sbuf)
+    nisa.memset(dst=qp_a, value=0.0)
+    nisa.memset(dst=qp_b, value=0.0)
+    nisa.dma_copy(dst=qp_a.ap(pattern=[[B * BG, P_MAX], [BG + G, B], [1, G]], offset=0),
+                  src=q_t.ap(pattern=[[G, P_MAX], [D * G, B], [1, G]], offset=0))
+    nisa.dma_copy(dst=qp_b.ap(pattern=[[B * BG, D1], [BG + G, B], [1, G]], offset=0),
+                  src=q_t.ap(pattern=[[G, D1], [D * G, B], [1, G]], offset=P_MAX * G))
+    # bmask[:, b, c] = 1 iff column c belongs to request b
+    bmask = nl.ndarray((P_MAX, B * BG), dtype=v_cache.dtype, buffer=nl.sbuf)
+    nisa.memset(dst=bmask, value=0.0)
+    for b in range(B):
+        nisa.memset(dst=bmask[:, b * BG + b * G:b * BG + (b + 1) * G], value=1.0)
+    thr_cur = nl.ndarray((BG, 2), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=thr_cur, src=thr.ap(pattern=[[2, BG], [1, 2]], offset=prg * BG * 2))
+    # iota[c, k * 128 + p] = NS * p + k: the chunk position of score column (sub-slot k, partition p)
+    iota = nl.ndarray((BG, CH), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.iota(dst=iota, pattern=[[1, NS], [NS, P_MAX]], offset=0, channel_multiplier=0)
+
+    m_st = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    l_st = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    acc_st = nl.ndarray((BG, Dv), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.memset(dst=m_st, value=M_FLOOR)
+    nisa.memset(dst=l_st, value=0.0)
+    nisa.memset(dst=acc_st, value=0.0)
+
+    if mode == "swa1":
+        # each request's own window chunk: slots row b (no dynamic offset)
+        idx = nl.ndarray((P_MAX, B), dtype=nl.int32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=idx, src=slots.ap(pattern=[[1, P_MAX], [W, B]], offset=0))
+        if mine:  # a program without requests (B=1 on LNC=2) leaves m = M_FLOOR, l = 0
+            _round(idx, mine, thr_cur, qp_a, qp_b, bmask, iota, m_st, l_st, acc_st, k_rows, v_rows,
+                   scale, window, B, BG, BGp, G, NS, CH, D, D1, Dv)
+    else:
+        if prg:
+            nisa.tensor_scalar(dst=thr_cur, data=thr_cur, op0=nl.add, operand0=float(-prg * CH))
+        col_off = nl.ndarray((1, 1), dtype=nl.int32, buffer=nl.sbuf)
+        nisa.memset(dst=col_off, value=prg * P_MAX)
+        cnt_sb = nl.ndarray((1, 3), dtype=nl.int32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=cnt_sb, src=n_round)
+        step = n_prg * P_MAX  # compact columns per round (all programs)
+
+        def load_idx(idx):
+            # the round's compact slots of every request: partition p of request b reads the NS
+            # consecutive cache rows from slots[b, col_off + p] (chunks are block aligned, NS | bs)
+            nisa.dma_copy(dst=idx, src=slots.ap(
+                pattern=[[1, P_MAX], [W, B]], offset=0, scalar_offset=col_off, indirect_dim=1))
+
+        def next_round():
+            nisa.tensor_scalar(dst=col_off, data=col_off, op0=nl.add, operand0=step)
+
+        def next_thr():
+            nisa.tensor_scalar(dst=thr_cur, data=thr_cur, op0=nl.add, operand0=float(-n_prg * CH))
+
+        args = (mine, thr_cur, qp_a, qp_b, bmask, iota, m_st, l_st, acc_st, scale, window, B, BG,
+                BGp, G, NS, CH, D, D1, Dv, k_rows.dtype, v_rows.dtype)
+        if len(mine) * NS * (D + Dv) * 2 <= PF_BYTES:
+            # pipelined: buffer sets a / b, round r + 1's loads issued before round r's compute
+            bufs = []
+            for _ in range(2):
+                idx = nl.ndarray((P_MAX, B), dtype=nl.int32, buffer=nl.sbuf)
+                kb = {b: nl.ndarray((P_MAX, NS * D), dtype=k_rows.dtype, buffer=nl.sbuf)
+                      for b in mine}
+                vb = {b: nl.ndarray((P_MAX, NS * Dv), dtype=v_rows.dtype, buffer=nl.sbuf)
+                      for b in mine}
+                bufs.append((idx, kb, vb))
+            (idx_a, k_a, v_a), (idx_b, k_b, v_b) = bufs
+            load_idx(idx_a)
+            _load_kv(idx_a, mine, k_rows, v_rows, k_a, v_a, NS, D, Dv)
+
+            def pair(_it):
+                next_round()
+                load_idx(idx_b)
+                _load_kv(idx_b, mine, k_rows, v_rows, k_b, v_b, NS, D, Dv)
+                _compute(k_a.__getitem__, lambda b, t: v_a[b][:, t * Dv:(t + 1) * Dv], *args)
+                next_thr()
+                next_round()
+                load_idx(idx_a)  # reads the padding round after the last real one at most
+                _load_kv(idx_a, mine, k_rows, v_rows, k_a, v_a, NS, D, Dv)
+                _compute(k_b.__getitem__, lambda b, t: v_b[b][:, t * Dv:(t + 1) * Dv], *args)
+                next_thr()
+
+            def tail(_it):
+                _compute(k_a.__getitem__, lambda b, t: v_a[b][:, t * Dv:(t + 1) * Dv], *args)
+
+            pr_reg = nisa.register_alloc()
+            nisa.register_load(pr_reg, cnt_sb[0:1, 1:2])
+            nl.fori_loop(0, pr_reg, pair)
+            tl_reg = nisa.register_alloc()
+            nisa.register_load(tl_reg, cnt_sb[0:1, 2:3])
+            nl.fori_loop(0, tl_reg, tail)
+        else:
+            def body(_it):
+                idx = nl.ndarray((P_MAX, B), dtype=nl.int32, buffer=nl.sbuf)
+                load_idx(idx)
+                _round(idx, mine, thr_cur, qp_a, qp_b, bmask, iota, m_st, l_st, acc_st, k_rows,
+                       v_rows, scale, window, B, BG, BGp, G, NS, CH, D, D1, Dv)
+                next_round()
+                next_thr()
+
+            it_reg = nisa.register_alloc()
+            nisa.register_load(it_reg, cnt_sb[0:1, 0:1])
+            nl.fori_loop(0, it_reg, body)
+
+    ml_sb = nl.ndarray((BG, 2), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=ml_sb[:, 0:1], src=m_st)
+    nisa.tensor_copy(dst=ml_sb[:, 1:2], src=l_st)
+    nisa.dma_copy(dst=acc_out.ap(pattern=[[Dv, BG], [1, Dv]], offset=prg * BG * Dv), src=acc_st)
+    nisa.dma_copy(dst=ml_out.ap(pattern=[[2, BG], [1, 2]], offset=prg * BG * 2), src=ml_sb)
+    return acc_out, ml_out
+
+
+def _load_kv(idx, mine, k_rows, v_rows, kb, vb, NS, D, Dv):
+    """Indirect DMAs of one round: NS consecutive cache rows per partition, K and V per request."""
+    for b in mine:
+        nisa.dma_copy(dst=kb[b], src=k_rows.ap(
+            pattern=[[D, P_MAX], [1, NS * D]], offset=0, vector_offset=idx[:, b:b + 1], indirect_dim=0))
+        nisa.dma_copy(dst=vb[b], src=v_rows.ap(
+            pattern=[[Dv, P_MAX], [1, NS * Dv]], offset=0, vector_offset=idx[:, b:b + 1],
+            indirect_dim=0))
+
+
+def _round(idx, mine, thr_cur, qp_a, qp_b, bmask, iota, m_st, l_st, acc_st, k_rows, v_rows, scale,
+           window, B, BG, BGp, G, NS, CH, D, D1, Dv):
+    """One round: CH chunk positions of every request in ``mine``, merged into the running state.
+
+    The round-2 layout (D-303): each request's K tile is allocated, loaded and transposed in turn
+    (only a few are live at once), V of all requests in one tile."""
+    v_all = nl.ndarray((P_MAX, B * NS * Dv), dtype=v_rows.dtype, buffer=nl.sbuf)
+
+    def k_of(b):
+        # NS consecutive cache rows per partition: one DMA for K and one for V per request
+        k_pm = nl.ndarray((P_MAX, NS * D), dtype=k_rows.dtype, buffer=nl.sbuf)
+        nisa.dma_copy(dst=k_pm, src=k_rows.ap(
+            pattern=[[D, P_MAX], [1, NS * D]], offset=0, vector_offset=idx[:, b:b + 1], indirect_dim=0))
+        nisa.dma_copy(dst=v_all[:, b * NS * Dv:(b + 1) * NS * Dv], src=v_rows.ap(
+            pattern=[[Dv, P_MAX], [1, NS * Dv]], offset=0, vector_offset=idx[:, b:b + 1],
+            indirect_dim=0))
+        return k_pm
+
+    def v_of(b, t):  # request b, sub-slot t: rows NS * p + t
+        col = b * NS + t
+        return v_all[:, col * Dv:(col + 1) * Dv]
+
+    _compute(k_of, v_of, mine, thr_cur, qp_a, qp_b, bmask, iota, m_st, l_st, acc_st, scale, window,
+             B, BG, BGp, G, NS, CH, D, D1, Dv, k_rows.dtype, v_rows.dtype)
+
+
+def _compute(k_of, v_of, mine, thr_cur, qp_a, qp_b, bmask, iota, m_st, l_st, acc_st, scale, window,
+             B, BG, BGp, G, NS, CH, D, D1, Dv, kdt, vdt):
+    """Scores, softmax and PV of one round: ``k_of(b)`` gives request b's K tile (``[128, NS * D]``,
+    loaded), ``v_of(b, t)`` its V rows of sub-slot t (``[128, Dv]``)."""
+    s_ps = nl.ndarray((BG, CH), dtype=nl.float32, buffer=nl.psum)
+    # accumulate=None (compiler-inferred: the first matmul into s_ps overwrites, the rest
+    # accumulate), as in attention_decode.py (D-119: explicit flags into slices drop tiles on trn2)
+    for b in mine:
+        k_pm = k_of(b)
+        kta_ps = nl.ndarray((P_MAX, CH), dtype=kdt, buffer=nl.psum)
+        ktb_ps = nl.ndarray((D1, CH), dtype=kdt, buffer=nl.psum)
+        for t in range(NS):  # sub-slot t: positions NS * p + t, p = partition
+            nisa.nc_transpose(dst=kta_ps[:, t * P_MAX:(t + 1) * P_MAX],
+                              data=k_pm[:, t * D:t * D + P_MAX])
+            nisa.nc_transpose(dst=ktb_ps[:, t * P_MAX:(t + 1) * P_MAX],
+                              data=k_pm[:, t * D + P_MAX:(t + 1) * D])
+        kt_a = nl.ndarray((P_MAX, CH), dtype=kdt, buffer=nl.sbuf)
+        kt_b = nl.ndarray((D1, CH), dtype=kdt, buffer=nl.sbuf)
+        nisa.tensor_copy(dst=kt_a, src=kta_ps, engine=nisa.vector_engine)
+        nisa.tensor_copy(dst=kt_b, src=ktb_ps, engine=nisa.scalar_engine)
+        for h in range(0, CH, 512):  # moving free size <= 512 per matmul (one PSUM bank)
+            hw = min(512, CH - h)
+            nisa.nc_matmul(dst=s_ps[:, h:h + hw], stationary=qp_a[:, b * BG:(b + 1) * BG],
+                           moving=kt_a[:, h:h + hw])
+            nisa.nc_matmul(dst=s_ps[:, h:h + hw], stationary=qp_b[:, b * BG:(b + 1) * BG],
+                           moving=kt_b[:, h:h + hw])
+
+    # ── mask: s += MASK_PENALTY where pos >= hi or pos <= lo (per-row thresholds) ─
+    pen = nl.ndarray((BG, CH), dtype=nl.float32, buffer=nl.sbuf)
+    s_sb = nl.ndarray((BG, CH), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=pen, data=iota, op0=nl.greater_equal, operand0=thr_cur[:, 0:1],
+                       op1=nl.multiply, operand1=MASK_PENALTY)
+    nisa.tensor_tensor(dst=s_sb, data1=s_ps, data2=pen, op=nl.add)
+    if window:
+        nisa.tensor_scalar(dst=pen, data=iota, op0=nl.less_equal, operand0=thr_cur[:, 1:2],
+                           op1=nl.multiply, operand1=MASK_PENALTY)
+        nisa.tensor_tensor(dst=s_sb, data1=s_sb, data2=pen, op=nl.add)
+
+    # ── online softmax state of every row ──────────────────────────────
+    m_f = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_reduce(dst=m_f, op=nl.maximum, data=s_sb, axis=1)
+    m_new = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_tensor(dst=m_new, data1=m_st, data2=m_f, op=nl.maximum)
+    d_m = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_tensor(dst=d_m, data1=m_st, data2=m_new, op=nl.subtract)
+    alpha = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.activation(dst=alpha, op=nl.exp, data=d_m, scale=scale)
+    nisa.tensor_copy(dst=m_st, src=m_new)
+    nbias = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=nbias, data=m_new, op0=nl.multiply, operand0=-scale)
+    p_sb = nl.ndarray((BG, CH), dtype=vdt, buffer=nl.sbuf)
+    l_f = nl.ndarray((BG, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.activation_reduce(dst=p_sb, op=nl.exp, data=s_sb, reduce_op=nl.add, reduce_res=l_f,
+                           bias=nbias, scale=scale)
+
+    # ── P^T per 128 positions; per request, P^T masked to its columns ──
+    pt_ps = nl.ndarray((P_MAX, NS * BGp), dtype=vdt, buffer=nl.psum)
+    for t in range(NS):
+        nisa.nc_transpose(dst=pt_ps[:, t * BGp:t * BGp + BG], data=p_sb[:, t * P_MAX:(t + 1) * P_MAX])
+    p_t = nl.ndarray((P_MAX, NS * BGp), dtype=vdt, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=p_t, src=pt_ps)
+    # pm[:, t, b, c] = p_t[:, t, c] * bmask[:, b, c]
+    pm = nl.ndarray((P_MAX, NS * B * BG), dtype=vdt, buffer=nl.sbuf)
+    nisa.tensor_tensor(
+        dst=pm,
+        data1=p_t.ap(pattern=[[NS * BGp, P_MAX], [BGp, NS], [0, B], [1, BG]], offset=0),
+        data2=bmask.ap(pattern=[[B * BG, P_MAX], [0, NS], [BG, B], [1, BG]], offset=0),
+        op=nl.multiply)
+    o_ps = nl.ndarray((BG, Dv), dtype=nl.float32, buffer=nl.psum)
+    for b in mine:
+        for t in range(NS):
+            nisa.nc_matmul(dst=o_ps, stationary=pm[:, (t * B + b) * BG:(t * B + b + 1) * BG],
+                           moving=v_of(b, t))
+
+    # ── state update: acc = acc * alpha + o; l = l * alpha + l_f ───────
+    nisa.scalar_tensor_tensor(dst=acc_st, data=acc_st, op0=nl.multiply, operand0=alpha, op1=nl.add,
+                              operand1=o_ps)
+    nisa.scalar_tensor_tensor(dst=l_st, data=l_st, op0=nl.multiply, operand0=alpha, op1=nl.add,
+                              operand1=l_f)
diff --git a/vllm_neuron/_kernels/mimo_v2/attention_prefill.py b/vllm_neuron/_kernels/mimo_v2/attention_prefill.py
