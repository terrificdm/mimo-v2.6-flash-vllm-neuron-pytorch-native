index 0000000..a42cfff
--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/factory.py
@@ -0,0 +1,332 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Factory: validate the MiMo-V2 config and select the implementation (design 3.1).
+
+vLLM rewrites the architecture ``MiMoV2ForCausalLM`` to ``MiMoV2OmniForCausalLM``
+when the config has a ``vision_config`` (design S19); both names are registered
+to this factory. The device precision comes from ``neuron_config.quantization``
+(``"bf16"`` / ``"fp8"``, design 3.1 X1). The text backbone is built in both
+precisions: FP8 linear layers (qkv, dense MLP) are T24, FP8 experts T25 (experts
+are BF16 until then), the vision tower T38 / T39 (built on the serving path when
+image or video inputs are enabled, ``vision_serving_config``), the audio towers
+T40 / T41, MTP T36.
+"""
+
+import logging
+
+import torch.nn as nn
+from transformers import PretrainedConfig
+
+from vllm_neuron.model.interfaces import SupportsEncoderBudget, SupportsSpatialMerge
+from vllm_neuron.model.neuron_config import EncoderNeuronConfig, NeuronConfig
+
+from .config import MiMoV2NeuronConfig
+
+logger = logging.getLogger(__name__)
+
+
+def _vision_get(vision_config, key, default=None):
+    if isinstance(vision_config, dict):
+        return vision_config.get(key, default)
+    return getattr(vision_config, key, default)
+
+
+def encoder_cache_blocks(vllm_config, cache_block_size: int,
+                         encoder_neuron_config: EncoderNeuronConfig) -> int:
+    """Block count of the runner's on-device encoder cache, computed the way
+    ``NeuronModelRunner._init_encoder_cache`` does (scheduler encoder-cache budget in
+    merged tokens / block + 1 scratch block, or ``encoder_cache_num_blocks`` if larger)."""
+    from vllm.multimodal import MULTIMODAL_REGISTRY
+    from vllm.multimodal.encoder_budget import MultiModalBudget
+
+    tokens = MultiModalBudget(vllm_config, MULTIMODAL_REGISTRY).encoder_cache_size
+    return max(encoder_neuron_config.encoder_cache_num_blocks or 0,
+               -(-tokens // cache_block_size) + 1)
+
+
+def vision_serving_config(hf_config: PretrainedConfig,
+                          encoder_neuron_config: EncoderNeuronConfig | None,
+                          vllm_config=None) -> dict | None:
+    """Vision tower settings of the serving path, or None when the tower is not built.
+
+    Built when vLLM gives an ``encoder_neuron_config`` (the platform generates one for
+    every config with a ``vision_config``) and the vLLM config enables image or video
+    inputs (vLLM's defaults do; ``--language-model-only`` or zero limits turn it off).
+    Checked at startup (``ValueError``, design 15.2): the largest frame group the
+    processor can produce (``processor_config`` ``image_max_pixels`` /
+    ``video_max_pixels``) and ``--mm-processor-kwargs`` fit the largest vision bucket
+    (``num_encoder_input_buckets``, multiples of 64), and ``encoder_attention_block_size``
+    is a multiple of the merge unit (4).
+
+    ``max_blocks`` (the runner's per-step encoder-block gather, T39 D-157):
+    ``min(ceil(max_model_len / cache block) + image + video (+ audio, T41) limit,
+    allocatable cache blocks)``. Both terms bound the blocks one prefill step can gather: the gather
+    reads only items resident in the device cache (at most its allocatable blocks), and
+    every item starts from a fresh block, so the items of one prompt use at most
+    ``ceil(max_model_len / block) + items`` blocks. The request check is per item
+    (``get_mm_request_validator``), like vLLM's. ``vllm_config`` defaults to the
+    current one; without a vLLM model config (offline tools, unit tests) the tower is
+    built and the vLLM-dependent parts are skipped.
+    """
+    if encoder_neuron_config is None or getattr(hf_config, "vision_config", None) is None:
+        return None
+    from vllm.config import get_current_vllm_config
+
+    from .vision_encoder import (MiMoVisionSpec, encoder_blocks_per_request,
+                                 pack_frame_groups, validate_mm_processor_kwargs)
+
+    spec = MiMoVisionSpec.from_hf(hf_config.vision_config)
+    buckets = tuple(sorted(encoder_neuron_config.num_encoder_input_buckets or ()))
+    if not buckets:
+        raise ValueError("MiMo-V2 vision: encoder_neuron_config.num_encoder_input_buckets "
+                         "is empty")
+    pack_frame_groups([], buckets, spec.group_align)  # buckets must be multiples of 64
+    block = encoder_neuron_config.encoder_attention_block_size
+    if block % spec.merge_unit:
+        raise ValueError(f"MiMo-V2 vision: encoder_attention_block_size={block} is not a "
+                         f"multiple of the merge unit {spec.merge_unit}")
+    cache_block_size = block // spec.merge_unit
+    vllm_config = vllm_config if vllm_config is not None else get_current_vllm_config()
+    model_config = vllm_config.model_config
+    mm_config = model_config.multimodal_config if model_config is not None else None
+    if mm_config is None:
+        largest = buckets[-1] // spec.merge_unit
+        return dict(spec=spec, buckets=buckets, cache_block_size=cache_block_size,
+                    max_items=1, max_blocks=-(-largest // cache_block_size) + 1)
+
+    items = mm_config.get_limit_per_prompt("image") + mm_config.get_limit_per_prompt("video")
+    if items == 0:
+        return None
+    pc = getattr(hf_config, "processor_config", None) or {}
+    unit = spec.patch_size * spec.spatial_merge_size
+    processor_pixels = {k: pc.get(k) or 4096 * unit * unit
+                        for k in ("image_max_pixels", "video_max_pixels")}
+    validate_mm_processor_kwargs(processor_pixels, spec, buckets)
+    validate_mm_processor_kwargs(mm_config.mm_processor_kwargs, spec, buckets)
+    allocatable = encoder_cache_blocks(vllm_config, cache_block_size, encoder_neuron_config) - 1
+    max_blocks = min(encoder_blocks_per_request(model_config.max_model_len, cache_block_size,
+                                                _gather_items(hf_config, mm_config)), allocatable)
+    return dict(spec=spec, buckets=buckets, cache_block_size=cache_block_size, max_items=items,
+                max_blocks=max_blocks)
+
+
+def _gather_items(hf_config: PretrainedConfig, mm_config) -> int:
+    """Items one prompt can carry over the towers this model builds: images + videos, and
+    audios when the config has audio towers (T41). Every item starts from a fresh encoder
+    cache block, so this bounds the partial blocks of one prompt (``max_blocks``)."""
+    items = mm_config.get_limit_per_prompt("image") + mm_config.get_limit_per_prompt("video")
+    if getattr(hf_config, "audio_config", None) is not None:
+        items += mm_config.get_limit_per_prompt("audio")
+    return items
+
+
+def audio_gather_config(hf_config: PretrainedConfig,
+                        encoder_neuron_config: EncoderNeuronConfig | None,
+                        vllm_config=None) -> dict | None:
+    """Encoder-cache settings of audio items (T41), or None when the audio towers are not
+    built: the config has no ``audio_config``, there is no ``encoder_neuron_config`` (no
+    on-device encoder cache), no vLLM multimodal config (offline use), or the audio limit
+    is 0 (``--language-model-only``, ``--limit-mm-per-prompt``; vLLM's default allows
+    audio, as on GPU). ``max_blocks``: the per-step gather bound, computed like the
+    vision one (``vision_serving_config``). Reads no checkpoint file, so the API server's
+    request check can use it."""
+    if encoder_neuron_config is None or getattr(hf_config, "audio_config", None) is None:
+        return None
+    from vllm.config import get_current_vllm_config
+
+    from .vision_encoder import encoder_blocks_per_request
+
+    vllm_config = vllm_config if vllm_config is not None else get_current_vllm_config()
+    model_config = vllm_config.model_config
+    mm_config = model_config.multimodal_config if model_config is not None else None
+    if mm_config is None or mm_config.get_limit_per_prompt("audio") == 0:
+        return None
+    merge = int(_vision_get(getattr(hf_config, "vision_config", None) or {},
+                            "spatial_merge_size", 2)) ** 2
+    block = encoder_neuron_config.encoder_attention_block_size
+    if block % merge:
+        raise ValueError(f"MiMo-V2 audio: encoder_attention_block_size={block} is not a "
+                         f"multiple of the vision merge unit {merge}")
+    cache_block_size = block // merge
+    allocatable = encoder_cache_blocks(vllm_config, cache_block_size, encoder_neuron_config) - 1
+    max_blocks = min(encoder_blocks_per_request(model_config.max_model_len, cache_block_size,
+                                                _gather_items(hf_config, mm_config)), allocatable)
+    return dict(cache_block_size=cache_block_size, max_blocks=max_blocks)
+
+
+def audio_serving_config(hf_config: PretrainedConfig,
+                         encoder_neuron_config: EncoderNeuronConfig | None,
+                         vllm_config=None) -> dict | None:
+    """Audio tower settings of the serving path (T41, decisions D-162..D-165), or None when
+    the towers are not built (``audio_gather_config``). Reads the tokenizer config from
+    ``<checkpoint>/audio_tokenizer`` (the same revision, D-004; downloaded with the
+    weights for a hub id) and checks at startup (``ValueError``) that the audio encoder
+    output width equals the encoder cache row width (the vision output width)."""
+    gather = audio_gather_config(hf_config, encoder_neuron_config, vllm_config)
+    if gather is None:
+        return None
+    import os
+
+    from vllm.config import get_current_vllm_config
+
+    from .audio_encoder import AUDIO_SEGMENT_BUCKETS, AudioEncoderSpec, AudioTokenizerSpec
+    from .model import resolve_checkpoint_dir
+
+    vllm_config = vllm_config if vllm_config is not None else get_current_vllm_config()
+    load_config = getattr(vllm_config, "load_config", None)
+    ckpt = resolve_checkpoint_dir(vllm_config.model_config.model,
+                                  getattr(load_config, "download_dir", None))
+    tspec = AudioTokenizerSpec.from_dir(os.path.join(ckpt, "audio_tokenizer"))
+    espec = AudioEncoderSpec.from_hf(hf_config.audio_config)
+    row = int(_vision_get(getattr(hf_config, "vision_config", None) or {}, "out_hidden_size",
+                          hf_config.hidden_size))
+    if espec.out_hidden_size != row:
+        raise ValueError(f"MiMo-V2 audio: out_hidden_size {espec.out_hidden_size} differs from "
+                         f"the encoder cache row width {row}")
+    if espec.channels > tspec.num_quantizers:
+        raise ValueError(f"MiMo-V2 audio: audio_channels {espec.channels} > tokenizer "
+                         f"num_quantizers {tspec.num_quantizers}")
+    return dict(gather, tokenizer_spec=tspec, encoder_spec=espec, buckets=AUDIO_SEGMENT_BUCKETS,
+                checkpoint_dir=ckpt)
+
+
+class MiMoV2OmniForCausalLM(nn.Module, SupportsSpatialMerge, SupportsEncoderBudget):
+    """Registry entry; ``from_configs`` returns the selected implementation directly."""
+
+    def __init__(self, hf_config: PretrainedConfig, neuron_config: NeuronConfig | None) -> None:
+        super().__init__()
+        self._model = self._select_implementation(hf_config, neuron_config, None)
+
+    def forward(self, *args, **kwargs):
+        return self._model(*args, **kwargs)
+
+    @classmethod
+    def from_configs(cls, hf_config: PretrainedConfig,
+                     text_neuron_config: NeuronConfig | None = None,
+                     encoder_neuron_config: EncoderNeuronConfig | None = None) -> nn.Module:
+        # Same signature as the multimodal factories (qwen3_vl): the platform
+        # auto-generates encoder_neuron_config because hf_config has a vision_config,
+        # and NeuronModelRunner.load_model then calls from_configs(hf_config=...,
+        # text_neuron_config=..., encoder_neuron_config=...); the V2 runner and the
+        # tests pass (hf_config, neuron_config) positionally (no vision tower).
+        return cls._select_implementation(hf_config, text_neuron_config, encoder_neuron_config)
+
+    @classmethod
+    def _select_implementation(cls, hf_config: PretrainedConfig,
+                               neuron_config: NeuronConfig | None,
+                               encoder_neuron_config: EncoderNeuronConfig | None) -> nn.Module:
+        # Validates the config (ValueError on bad fields / precision combinations).
+        config = MiMoV2NeuronConfig.from_configs(hf_config, neuron_config)
+        vision = vision_serving_config(hf_config, encoder_neuron_config)
+        audio = audio_serving_config(hf_config, encoder_neuron_config)
+        from .model import MiMoV2ForCausalLM as Model
+
+        # FP8 (quantization="fp8"): FP8 qkv / dense MLP per mimo_fp8_linear (T24); the
+        # layer classes raise NotImplementedError for modes without an implementation.
+        logger.info("[mimo_v2] model=model precision=%s checkpoint=%s mimo_fp8_linear=%s "
+                    "vision=%s audio=%s", config.mimo_precision, config.checkpoint_format,
+                    config.mimo_fp8_linear if config.mimo_precision == "fp8" else "-",
+                    "off" if vision is None else
+                    f"buckets={list(vision['buckets'])} cache_block={vision['cache_block_size']} "
+                    f"max_blocks_per_request={vision['max_blocks']}",
+                    "off" if audio is None else
+                    f"bf16 (rvq fp32) segment_buckets={list(audio['buckets'])} "
+                    f"cache_block={audio['cache_block_size']} "
+                    f"max_blocks_per_request={audio['max_blocks']}")
+        return Model.from_configs(hf_config, neuron_config, vision=vision,
+                                  encoder_neuron_config=encoder_neuron_config, audio=audio)
+
+    # ── runner / scheduler hooks (vllm_neuron.utils.mm_utils) ───────────────
+
+    @classmethod
+    def get_vision_token_merge_factor(cls, hf_config: PretrainedConfig) -> int:
+        return int(_vision_get(hf_config.vision_config, "spatial_merge_size", 2)) ** 2
+
+    @classmethod
+    def get_max_encoder_embed_budget(cls, hf_config: PretrainedConfig,
+                                     encoder_neuron_config: EncoderNeuronConfig) -> int | None:
+        # No cap (D-147): embed_multimodal splits the frame groups of a step over as many
+        # encoder calls as needed (each <= the largest bucket), so the per-step encoder
+        # work and the size of one video are not limited by one bucket (only by
+        # --max-model-len, as on GPU). A single frame group always fits the largest
+        # bucket (vision_serving_config checks the processor limits at startup).
+        return None
+
+    @classmethod
+    def get_default_encoder_input_buckets(cls, hf_config: PretrainedConfig) -> list[int]:
+        """Vision buckets when the user sets none (``NeuronPlatform``): the design 9.1
+        buckets up to the first one that holds the largest frame group the processor
+        produces (``processor_config`` pixel limits, the same defaults the GPU vLLM
+        processor uses), so the official serve command needs no encoder settings."""
+        from .vision_encoder import VISION_BUCKETS, MiMoVisionSpec, _align
+
+        spec = MiMoVisionSpec.from_hf(hf_config.vision_config)
+        pc = getattr(hf_config, "processor_config", None) or {}
+        unit = spec.patch_size * spec.spatial_merge_size
+        pixels = max(pc.get(k) or 4096 * unit * unit for k in ("image_max_pixels", "video_max_pixels"))
+        need = _align(pixels // (spec.patch_size * spec.patch_size), spec.group_align)
+        out = [b for b in VISION_BUCKETS if b < need]
+        out.append(next((b for b in VISION_BUCKETS if b >= need), _align(need, 1024)))
+        return out
+
+    @classmethod
+    def get_encoder_cache_manager_cls(cls, hf_config: PretrainedConfig) -> str | None:
+        """Scheduler-side encoder cache in whole blocks (T39, decisions D-154): the encoder
+        writes every item densely from a fresh cache block (``plan_cache_writes``), so the
+        scheduler must count ``ceil(tokens / block)`` blocks per item, not tokens."""
+        if getattr(hf_config, "vision_config", None) is None:
+            return None
+        return "vllm_neuron.vllm.core.encoder_cache_manager.BlockAlignedEncoderCacheManager"
+
+    @classmethod
+    def get_max_encoder_blocks_per_request(cls, hf_config: PretrainedConfig,
+                                           encoder_neuron_config: EncoderNeuronConfig) -> int:
+        vision = vision_serving_config(hf_config, encoder_neuron_config)
+        audio = audio_gather_config(hf_config, encoder_neuron_config)
+        return max(0 if vision is None else vision["max_blocks"],
+                   0 if audio is None else audio["max_blocks"])
+
+    @classmethod
+    def get_mm_request_validator(cls, vllm_config, encoder_neuron_config: EncoderNeuronConfig):
+        """Per-request multimodal check for ``NeuronPlatform.validate_request`` (T39): HTTP
+        400 instead of an engine failure for inputs this server cannot run -- a modality
+        without a tower here (video with its audio track, T42), and an image / video / audio
+        item that alone needs more encoder-cache blocks than ``max_blocks``
+        (``vision_serving_config`` / ``audio_gather_config``).
+
+        Per item, like vLLM's own check (``input_processor``: one item larger than the
+        encoder cache is rejected). The items of a request together may exceed the cache
+        (D-157): the scheduler (``BlockAlignedEncoderCacheManager``) keeps only the items
+        of the current prefill window resident and evicts finished ones, as on GPU."""
+        from vllm.exceptions import VLLMValidationError
+
+        hf_config = vllm_config.model_config.hf_config
+        towers = {"image": vision_serving_config(hf_config, encoder_neuron_config, vllm_config)}
+        towers["video"] = towers["image"]
+        towers["audio"] = audio_gather_config(hf_config, encoder_neuron_config, vllm_config)
+
+        def validate(processed_inputs) -> None:
+            placeholders = processed_inputs.get("mm_placeholders") or {}
+            for modality, items in placeholders.items():
+                if not items:
+                    continue
+                if modality not in towers:
+                    raise VLLMValidationError(
+                        f"MiMo-V2 on Neuron does not support {modality} inputs yet (T42)",
+                        parameter="messages")
+                tower = towers[modality]
+                if tower is None:
+                    raise VLLMValidationError(
+                        f"MiMo-V2 on Neuron: {modality} inputs are disabled on this server",
+                        parameter="messages")
+                cbs = tower["cache_block_size"]
+                for pos in items:
+                    blocks = -(-pos.get_num_embeds() // cbs)
+                    if blocks > tower["max_blocks"]:
+                        raise VLLMValidationError(
+                            f"A(n) {modality} item of this request has {pos.get_num_embeds()} "
+                            f"embedding tokens and needs {blocks} encoder-cache blocks of {cbs} "
+                            f"tokens; this server allows {tower['max_blocks']} per item "
+                            "(encoder_neuron_config.encoder_cache_num_blocks, --max-model-len). "
+                            "Send a smaller item.", parameter="messages")
+
+        return validate
