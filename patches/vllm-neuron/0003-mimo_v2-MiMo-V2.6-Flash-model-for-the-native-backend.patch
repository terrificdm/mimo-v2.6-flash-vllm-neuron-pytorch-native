+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 audio towers (design 9.2)
+=================================
+
+Reference: HF remote code ``modeling_mimo_v2.py`` (snapshot b12f557): audio tokenizer
+``AudioTokenizerEncoder`` L1374-1497, RVQ ``EuclideanCodebook``/``ResidualVectorQuantization``
+L1146-1219, ``tokenize_audio_batch`` L1537-1567; audio encoder ``MiMoAudioEncoder``
+L932-1036. The vLLM GPU port (``vllm/model_executor/models/mimo_audio.py``) has the same
+arithmetic and calls ``tokenize_audio_batch`` the same way.
+
+Two towers, both replicated on every rank (no collectives; serving runs them that way,
+D-162):
+
+* ``MiMoAudioTokenizerEncoder`` (``audio_tokenizer/model.safetensors``, ``encoder.*``):
+  log-mel ``[B, n_mels]`` -> conv1 (k3 s1 p1) + GELU -> conv2 (k3 s2 p1) + GELU
+  -> 24 pre-LN transformer layers (d 1024, 16 heads x 64, RoPE theta 10000 on all 64 dims,
+  causal; ``hybrid_attention``: layer i has a causal window of 128 previous keys when
+  ``i % swa_per_block < swa_per_block - 1`` (even layers), else full causal; HF mask
+  ``|i-j| > 128`` + causal) -> ``+=`` the output of layer ``encoder_skip_layer_id - 1``
+  (index 2) -> LayerNorm -> avg pool (Conv1d k2 s2 no bias + GELU) -> LayerNorm
+  -> 20-level residual VQ in FP32: ``dist = -(|x|^2 - 2 x.e + |e|^2)``, argmax, residual
+  -= codeword (codebooks 1024/1024/256/128 x 17). Convolutions run as matmuls over
+  shifted / strided slices; attention is ``tokenizer_attention``: ``NF.flash_attention``
+  (nkilib attention_cte, BF16 Q / K / V / P with FP32 softmax, as the GPU's flash-attn) with
+  its static causal / sliding-window masks (decisions D-164 / D-165; CPU mode: the kernel's
+  torch reference).
+* ``MiMoAudioEncoder`` (main checkpoint ``audio_encoder.*`` + ``speech_embeddings.*``):
+  codes ``[N, 20]`` gathered into groups of ``group_size`` (4) -> sum of 20 speech
+  embeddings -> 6 Qwen2 layers inside each group (full attention, qkv bias, RoPE theta
+  640000, RMSNorm eps 1e-6) -> final norm -> ``[G, 4 * 1024]`` -> MLP 4096 -> 16384
+  -> GELU -> 4096 (no bias). One output row per group = one ``<|audio_pad|>`` token.
+
+Host side (``plan_audio_segments`` / ``build_tokenizer_inputs`` / ``build_group_index`` /
+``encode_audio``): the mel of one audio item is cut into 6000-frame segments plus a
+shorter remainder (HF L1544-1548); each segment runs in the smallest segment bucket
+(``AUDIO_SEGMENT_BUCKETS``, mel frames) that holds it, zero padded. The transformer is
+causal, so padding never reaches a valid frame; the only frames that see padding are
+the last conv2 frame and the last pooled frame of a segment with odd length. HF fills
+those from its batch padding, which depends on the longest segment in the same
+``encode`` call (``_at_group_by_length``, 256000 frames): per segment, conv1 output
+past the end is either the conv of the zero padding (shorter than the longest) or zero
+(the longest), and the pooling pad frame is either a copy of the last frame or zero.
+``plan_audio_segments`` reproduces HF's grouping for one audio item and the host
+tensors ``conv_mask``/``pool_index``/``pool_scale`` select the matching value, so a
+single-item call gives HF's codes exactly (decisions D-159). Full segments give 1500
+codes, a multiple of ``group_size``, so the audio encoder can run per segment and its
+groups are the same as HF's per-item grouping (last group padded with the last code).
+
+mel: ``mel_spectrogram`` is the vLLM processor's ``preprocess_audio`` (torchaudio
+``MelSpectrogram`` power 1, center, ``log(clip(x, 1e-7))``); serving uses the vLLM
+processor itself.
+
+Serving (T41, decisions D-162..D-165): ``MiMoAudioCacheEncoder`` is one graph per segment
+bucket -- tokenizer, RVQ, audio encoder, and the scatter of the item's embedding rows
+into the runner's on-device encoder cache (the vision tower's contract, D-147). Both
+towers run in BF16 with the RVQ in FP32 -- the vLLM GPU dtype path (``mimo_audio.py``: the
+tokenizer ``.to(bfloat16)``, ``quantizer.float()`` on ``hidden_states.float()``; the audio
+encoder in the model dtype; decisions D-165) -- replicated on every rank with no collectives; the runner
+compiles it as an auxiliary encoder tower (``get_aux_encoder_attrs``) and the worker
+warms up every bucket. ``plan_audio_cache_writes`` builds the per-segment host inputs
+of one item; a long item takes one call per segment, so the audio length is limited
+only by ``--max-model-len`` and the encoder cache, as on GPU.
+"""
+
+import json
+import os
+from dataclasses import dataclass
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+import vllm_neuron.functional as NF
+from vllm_neuron.functional.argmax import argmax as distributed_argmax
+from vllm_neuron.model.mimo_v2.vision_encoder import gelu as _gelu_erf
+
+# Segment length of one tokenizer call (HF ``audio_segment_size``) and the segment
+# buckets in mel frames (design 9.2). Each bucket is a multiple of 4 (conv2 stride 2 x
+# pool 2), so a bucket of B frames gives B / 4 codes.
+AUDIO_SEGMENT_SIZE = 6000
+AUDIO_SEGMENT_BUCKETS = (1500, 3000, 6000)
+# HF/vLLM ``tokenize_audio_batch`` packs segments into encode calls of at most this
+# many mel frames (``_at_group_by_length(..., 256000)``); it decides the batch padding.
+HF_ENCODE_GROUP_FRAMES = 256000
+
+
+def _get(cfg, key, default=None):
+    if isinstance(cfg, dict):
+        return cfg.get(key, default)
+    return getattr(cfg, key, default)
+
+
+def _parse_maybe_list(value, length: int) -> tuple:
+    """HF ``_parse_maybe_list``: ``"a-b-c"`` -> per-channel values, else repeated."""
+    if isinstance(value, str) and "-" in value:
+        return tuple(int(s) for s in value.split("-"))
+    return (int(value),) * length
+
+
+# =============================================================================
+# Section 1: config
+# =============================================================================
+@dataclass(frozen=True)
+class AudioTokenizerSpec:
+    n_mels: int
+    d_model: int
+    num_heads: int
+    ffn_dim: int
+    num_layers: int
+    skip_layer_id: int | None
+    window_sizes: tuple      # per layer: causal window (keys i-w .. i), -1 = full causal
+    rope_theta: float
+    codebook_sizes: tuple    # one per RVQ level
+    kernel_size: int = 3
+    stride: int = 2
+    avg_pooler: int = 2
+    ln_eps: float = 1e-5
+
+    @property
+    def head_dim(self) -> int:
+        return self.d_model // self.num_heads
+
+    @property
+    def num_quantizers(self) -> int:
+        return len(self.codebook_sizes)
+
+    @property
+    def frames_per_code(self) -> int:
+        return self.stride * self.avg_pooler
+
+    def conv_len(self, n: int) -> int:
+        """HF ``get_output_length``: conv2 frames of ``n`` mel frames."""
+        k = self.kernel_size
+        return (n + 3 - k + 2 - k) // self.stride + 1
+
+    def code_len(self, n: int) -> int:
+        """Codes (pooled frames) of ``n`` mel frames (HF L1561-1564)."""
+        c = self.conv_len(n)
+        return c // self.avg_pooler + int(c % self.avg_pooler != 0)
+
+    @classmethod
+    def from_hf(cls, cfg) -> "AudioTokenizerSpec":
+        """``audio_tokenizer/config.json`` (dict) -> spec. Raises ``ValueError`` on values
+        this implementation does not support."""
+        checks = {"kernel_size": 3, "stride_size": 2, "avg_pooler": 2,
+                  "activation_function": "gelu", "ln_type": "LayerNorm",
+                  "position_embedding_type": "rope", "rope_type": "default",
+                  "encoder_causal": True}
+        defaults = {"kernel_size": 3, "stride_size": 2, "avg_pooler": 1,
+                    "activation_function": "gelu", "ln_type": "LayerNorm",
+                    "position_embedding_type": "rope", "rope_type": "default",
+                    "encoder_causal": False}
+        for key, want in checks.items():
+            got = _get(cfg, key, defaults[key])
+            if got != want:
+                # encoder_causal: padding a segment to its bucket is exact only for a
+                # causal transformer.
+                raise ValueError(f"audio tokenizer {key}={got!r}: only {want!r} is supported")
+        layers = int(_get(cfg, "encoder_layers", 8))
+        window = int((_get(cfg, "encoder_attn_window_size") or [-1, -1])[0])
+        if _get(cfg, "hybrid_attention", False):
+            per = int(_get(cfg, "swa_per_block", 2))
+            windows = tuple(window if i % per < per - 1 else -1 for i in range(layers))
+        else:
+            windows = (window,) * layers
+        windows = tuple(w if w > 0 else -1 for w in windows)
+        n_q = int(_get(cfg, "num_quantizers", 12))
+        sizes = _get(cfg, "codebook_size") or [1024]
+        sizes = [int(sizes)] * n_q if isinstance(sizes, int) else [int(s) for s in sizes]
+        if len(sizes) < n_q:  # HF ResidualVectorQuantization extends with the last size
+            sizes += [sizes[-1]] * (n_q - len(sizes))
+        if n_q <= 0:
+            raise ValueError("audio tokenizer num_quantizers must be > 0 (codes are the output)")
+        d_model = int(_get(cfg, "d_model", 768))
+        heads = int(_get(cfg, "encoder_attention_heads", 12))
+        if d_model % heads or (d_model // heads) % 2:
+            raise ValueError(f"audio tokenizer d_model={d_model} / heads={heads}: need an even "
+                             "head_dim")
+        skip = _get(cfg, "encoder_skip_layer_id")
+        if skip is not None and not 1 <= int(skip) <= layers:
+            raise ValueError(f"encoder_skip_layer_id={skip} out of range 1..{layers}")
+        return cls(n_mels=int(_get(cfg, "n_mels", 80)), d_model=d_model, num_heads=heads,
+                   ffn_dim=int(_get(cfg, "encoder_ffn_dim", 3072)), num_layers=layers,
+                   skip_layer_id=None if skip is None else int(skip), window_sizes=windows,
+                   rope_theta=float(_get(cfg, "rope_theta", 10000)),
+                   codebook_sizes=tuple(sizes[:n_q]))
+
+    @classmethod
+    def from_dir(cls, tokenizer_dir: str) -> "AudioTokenizerSpec":
+        with open(os.path.join(tokenizer_dir, "config.json")) as f:
+            return cls.from_hf(json.load(f))
+
+
+@dataclass(frozen=True)
+class AudioEncoderSpec:
+    channels: int
+    group_size: int
+    hidden_size: int
+    num_layers: int
+    num_heads: int
+    intermediate_size: int
+    out_hidden_size: int
+    rope_theta: float
+    vocab_sizes: tuple
+    full_attention: bool
+    post_norm: bool
+    projection_layers: int
+    segment_size: int
+    rms_norm_eps: float = 1e-6   # Qwen2Config default (HF passes no eps)
+
+    @property
+    def head_dim(self) -> int:
+        return self.hidden_size // self.num_heads
+
+    @classmethod
+    def from_hf(cls, audio_config) -> "AudioEncoderSpec":
+        """``hf_config.audio_config`` -> spec (HF ``MiMoAudioEncoder.__init__`` defaults)."""
+        if audio_config is None:
+            raise ValueError("audio_config is missing")
+        channels = int(_get(audio_config, "audio_channels"))
+        dim = int(_get(audio_config, "input_local_dim"))
+        heads = int(_get(audio_config, "input_local_attn_heads"))
+        if float(_get(audio_config, "partial_rotary_factor", 1.0)) != 1.0:
+            raise ValueError("audio encoder partial_rotary_factor != 1.0 is not supported")
+        proj = int(_get(audio_config, "projection_layers", 2))
+        if proj not in (1, 2):
+            raise ValueError(f"Unsupported projection_layers={proj}, expected 1 or 2.")
+        if dim % heads or (dim // heads) % 2:
+            raise ValueError(f"audio encoder input_local_dim={dim} / heads={heads}: need an "
+                             "even head_dim")
+        return cls(channels=channels, group_size=int(_get(audio_config, "group_size")),
+                   hidden_size=dim, num_layers=int(_get(audio_config, "input_local_layers")),
+                   num_heads=heads,
+                   intermediate_size=int(_get(audio_config, "input_local_intermediate_size")),
+                   out_hidden_size=int(_get(audio_config, "out_hidden_size")),
+                   rope_theta=float(_get(audio_config, "rope_theta", 640000.0)),
+                   vocab_sizes=_parse_maybe_list(_get(audio_config, "speech_vocab_size"),
+                                                 channels),
+                   full_attention=bool(_get(audio_config, "input_full_attention", True)),
+                   post_norm=bool(_get(audio_config, "add_post_norm", True)),
+                   projection_layers=proj,
+                   segment_size=int(_get(audio_config, "audio_segment_size",
+                                         AUDIO_SEGMENT_SIZE)))
+
+
+# =============================================================================
+# Section 2: building blocks
+# =============================================================================
+class _LayerNorm(nn.Module):
+    """``nn.LayerNorm`` (weight + bias) with FP32 statistics."""
+
+    def __init__(self, hidden_size: int, eps: float, dtype: torch.dtype):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size, dtype=dtype), requires_grad=False)
+        self.bias = nn.Parameter(torch.zeros(hidden_size, dtype=dtype), requires_grad=False)
+        self.eps = eps
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        h = F.layer_norm(x.to(torch.float32), (x.shape[-1],), self.weight.to(torch.float32),
+                         self.bias.to(torch.float32), self.eps)
+        return h.to(x.dtype)
+
+
+class _Qwen2RMSNorm(nn.Module):
+    """HF ``Qwen2RMSNorm``: FP32 statistics, weight multiplied in the input dtype."""
+
+    def __init__(self, hidden_size: int, eps: float, dtype: torch.dtype):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size, dtype=dtype), requires_grad=False)
+        self.eps = eps
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        h = x.to(torch.float32)
+        h = h * torch.rsqrt(h.pow(2).mean(-1, keepdim=True) + self.eps)
+        return self.weight * h.to(x.dtype)
+
+
+def rope_cos_sin(n: int, dim: int, theta: float, dtype: torch.dtype, device=None):
+    """Default RoPE for positions ``0..n-1`` (HF ``AudioTokenizerRotaryEmbedding`` and
+    ``Qwen2RotaryEmbedding``): FP32 angles, cos/sin cast to the activation dtype."""
+    inv_freq = 1.0 / (theta ** (torch.arange(0, dim, 2, dtype=torch.float32, device=device)
+                                / dim))
+    pos = torch.arange(n, dtype=torch.float32, device=device)
+    freqs = pos[:, None] * inv_freq[None, :]
+    emb = torch.cat((freqs, freqs), dim=-1)
+    return emb.cos().to(dtype), emb.sin().to(dtype)
+
+
+def apply_rope(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """``x * cos + rotate_half(x) * sin`` in the activation dtype (HF ``_at_apply_rotary_pos_emb``
+    / ``apply_rotary_pos_emb``). ``x`` ``[..., n, heads, d]``, cos/sin ``[n, d]``."""
+    half = x.shape[-1] // 2
+    rot = torch.cat((-x[..., half:], x[..., :half]), dim=-1)
+    return x * cos.unsqueeze(-2) + rot * sin.unsqueeze(-2)
+
+
+def gelu(x: torch.Tensor) -> torch.Tensor:
+    """Exact (erf) GELU evaluated in FP32 and rounded once to the activation dtype, like
+    PyTorch's ``F.gelu`` on BF16 (the HF towers' ``nn.GELU`` / ``ACT2FN["gelu"]``); the erf
+    formula evaluated step by step in BF16 adds several roundings."""
+    return _gelu_erf(x.to(torch.float32)).to(x.dtype)
+
+
+class _GELU(nn.Module):
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return gelu(x)
+
+
+def _conv_weight_as_linear(w: torch.Tensor) -> torch.Tensor:
+    """Conv1d weight ``[out, in, k]`` -> matmul weight ``[out, k * in]`` (column block j = tap j)."""
+    return w.permute(0, 2, 1).reshape(w.shape[0], -1)
+
+
+def tokenizer_attention(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, scale: float,
+                        window: int) -> torch.Tensor:
+    """Causal ``softmax(scale * q k^T + mask) v`` on q/k/v ``[H, n, D]``: query i sees keys
+    ``[i - window, i]`` (``window > 0``, the hybrid window layers) or ``[0, i]`` (``window`` -1).
+
+    ``NF.flash_attention`` (nkilib attention_cte: Q / K / V / P in BF16, FP32 scores and
+    softmax -- the arithmetic of the GPU's ``flash_attn_varlen_func``, D-165) with
+    ``causal_mask=True`` and, for window layers, ``sliding_window = window + 1``: the kernel's
+    static causal / SWA masks, which skip the fully masked key tiles and need no per-query
+    bounds (with bounds the kernel needs ``n`` a multiple of 128, D-164). CPU mode: the
+    kernel's torch reference with the same masks."""
+    return NF.flash_attention(q, k, v, scale=scale, causal_mask=True,
+                              sliding_window=window + 1 if window > 0 else 0, tp_q=True,
+                              tp_k=True, tp_out=False)
+
+
+# =============================================================================
+# Section 3: audio tokenizer encoder (mel -> RVQ codes)
+# =============================================================================
+class AudioTokenizerAttention(nn.Module):
+    def __init__(self, spec: AudioTokenizerSpec, dtype: torch.dtype):
+        super().__init__()
+        d = spec.d_model
+        self.num_heads = spec.num_heads
+        self.head_dim = spec.head_dim
+        self.scale = spec.head_dim ** -0.5
+        # <-- MODEL-SPECIFIC: k_proj has no bias (HF L1307-1310)
+        self.q_proj = nn.Linear(d, d, bias=True, dtype=dtype)
+        self.k_proj = nn.Linear(d, d, bias=False, dtype=dtype)
+        self.v_proj = nn.Linear(d, d, bias=True, dtype=dtype)
+        self.out_proj = nn.Linear(d, d, bias=True, dtype=dtype)
+
+    def forward(self, x, cos, sin, window):
+        """``x`` ``[n, d]``; ``window``: causal window of the layer (keys i-window..i), -1 =
+        full causal."""
+        n = x.shape[0]
+        H, D = self.num_heads, self.head_dim
+        q = apply_rope(self.q_proj(x).view(n, H, D), cos, sin)
+        k = apply_rope(self.k_proj(x).view(n, H, D), cos, sin)
+        v = self.v_proj(x).view(n, H, D)
+        q, k, v = (t.permute(1, 0, 2).contiguous() for t in (q, k, v))           # [H, n, D]
+        out = tokenizer_attention(q, k, v, self.scale, window)
+        return self.out_proj(out.permute(1, 0, 2).reshape(n, H * D))
+
+
+class AudioTokenizerLayer(nn.Module):
+    def __init__(self, spec: AudioTokenizerSpec, window: int, dtype: torch.dtype):
+        super().__init__()
+        self.window = window
+        self.self_attn = AudioTokenizerAttention(spec, dtype)
+        self.self_attn_layer_norm = _LayerNorm(spec.d_model, spec.ln_eps, dtype)
+        self.fc1 = nn.Linear(spec.d_model, spec.ffn_dim, bias=True, dtype=dtype)
+        self.fc2 = nn.Linear(spec.ffn_dim, spec.d_model, bias=True, dtype=dtype)
+        self.final_layer_norm = _LayerNorm(spec.d_model, spec.ln_eps, dtype)
+
+    def forward(self, x, cos, sin):
+        x = x + self.self_attn(self.self_attn_layer_norm(x), cos, sin, self.window)
+        return x + self.fc2(gelu(self.fc1(self.final_layer_norm(x))))
+
+
+class _Codebook(nn.Module):
+    """One RVQ level: FP32 codewords ``embed`` ``[K, d]`` (HF ``EuclideanCodebook.embed``)."""
+
+    def __init__(self, size: int, dim: int):
+        super().__init__()
+        self.register_buffer("embed", torch.zeros(size, dim, dtype=torch.float32))
+
+
+class MiMoAudioTokenizerEncoder(nn.Module):
+    """Audio tokenizer encoder for one segment bucket of ``B`` mel frames.
+
+    Inputs (``build_tokenizer_inputs``): ``mel`` ``[B, n_mels]`` (zero padded),
+    ``conv_mask`` ``[B]`` (1 / 0 on conv1 output frames), ``pool_index`` ``[B / 2]`` int32
+    and ``pool_scale`` ``[B / 2]`` (pooling input frame = ``h[pool_index] * pool_scale``).
+    Returns codes ``[B / 4, num_quantizers]`` int32; rows past the segment's code length
+    come from padding and are dropped by the host.
+
+    The RVQ argmax goes through ``vllm_neuron.functional.argmax`` with
+    ``rvq_process_group`` (a 1-rank group: the codebooks are not sharded); without a group
+    it is ``torch.argmax``, as in ``functional.sampling._argmax_sample``.
+    """
+
+    def __init__(self, spec: AudioTokenizerSpec, dtype: torch.dtype = torch.bfloat16):
+        super().__init__()
+        self.spec = spec
+        d = spec.d_model
+        self.conv1 = nn.Linear(spec.kernel_size * spec.n_mels, d, bias=True, dtype=dtype)
+        self.conv2 = nn.Linear(spec.kernel_size * d, d, bias=True, dtype=dtype)
+        self.layers = nn.ModuleList(AudioTokenizerLayer(spec, w, dtype) for w in spec.window_sizes)
+        self.layer_norm = _LayerNorm(d, spec.ln_eps, dtype)
+        self.down_sample = nn.Linear(spec.avg_pooler * d, d, bias=False, dtype=dtype)
+        self.down_sample_norm = _LayerNorm(d, spec.ln_eps, dtype)
+        self.quantizer = nn.ModuleList(_Codebook(k, d) for k in spec.codebook_sizes)
+        self.rvq_process_group = None
+        for p in self.parameters():
+            p.requires_grad_(False)
+
+    @property
+    def dtype(self) -> torch.dtype:
+        return self.conv1.weight.dtype
+
+    def set_rvq_process_group(self, group) -> None:
+        self.rvq_process_group = group
+
+    def features(self, mel, conv_mask, pool_index, pool_scale) -> torch.Tensor:
+        """Pooled hidden states ``[B / 4, d]`` (the RVQ input, activation dtype)."""
+        spec = self.spec
+        B = mel.shape[0]
+        T = B // spec.stride
+        d = spec.d_model
+        x = F.pad(mel.to(self.dtype), (0, 0, 1, 1))                      # [B + 2, n_mels]
+        # conv1, kernel 3 stride 1 pad 1: taps at t-1, t, t+1
+        y = gelu(self.conv1(torch.cat([x[0:B], x[1:B + 1], x[2:B + 2]], dim=-1)))
+        y = y * conv_mask.to(self.dtype).unsqueeze(-1)
+        y = F.pad(y, (0, 0, 1, 1))                                       # [B + 2, d]
+        # conv2, kernel 3 stride 2 pad 1: output o reads frames 2o-1, 2o, 2o+1
+        pair = y[0:B].reshape(T, 2, d)
+        h = gelu(self.conv2(torch.cat([pair[:, 0], pair[:, 1],
+                                       y[2:B + 2].reshape(T, 2, d)[:, 0]], dim=-1)))
+        cos, sin = rope_cos_sin(T, spec.head_dim, spec.rope_theta, self.dtype, h.device)
+        skip = None
+        for i, layer in enumerate(self.layers):
+            h = layer(h, cos, sin)
+            # <-- MODEL-SPECIFIC: skip connection from layer encoder_skip_layer_id - 1 (HF L1453)
+            if spec.skip_layer_id is not None and i == spec.skip_layer_id - 1:
+                skip = h
+        if skip is not None:
+            h = h + skip
+        h = self.layer_norm(h)
+        # avg pool: Conv1d(k=2, s=2, no bias) on the HF-padded frames, then GELU + LayerNorm
+        h = h.index_select(0, pool_index) * pool_scale.to(self.dtype).unsqueeze(-1)
+        h = gelu(self.down_sample(h.reshape(T // spec.avg_pooler, spec.avg_pooler * d)))
+        return self.down_sample_norm(h)
+
+    def _argmax(self, dist: torch.Tensor) -> torch.Tensor:
+        if self.rvq_process_group is not None:
+            return distributed_argmax(dist, dim=-1, gather_dim=-1, keepdim=False,
+                                      process_group=self.rvq_process_group)
+        return torch.argmax(dist, dim=-1)
+
+    def quantize(self, x: torch.Tensor) -> torch.Tensor:
+        """Residual VQ in FP32 (HF ``ResidualVectorQuantization.encode`` with
+        ``quantizer.float()``): ``[n, d]`` -> codes ``[n, num_quantizers]`` int32."""
+        residual = x.to(torch.float32)
+        codes = []
+        for level in self.quantizer:
+            codewords = level.embed.to(torch.float32)
+            embed = codewords.t()
+            # same expression and order as HF EuclideanCodebook.quantize
+            dist = -(residual.pow(2).sum(1, keepdim=True) - 2 * residual @ embed
+                     + embed.pow(2).sum(0, keepdim=True))
+            idx = self._argmax(dist)
+            residual = residual - F.embedding(idx, codewords)
+            codes.append(idx.to(torch.int32))
+        return torch.stack(codes, dim=-1)
+
+    def forward(self, mel, conv_mask, pool_index, pool_scale) -> torch.Tensor:
+        return self.quantize(self.features(mel, conv_mask, pool_index, pool_scale))
+
+
+# =============================================================================
+# Section 4: audio encoder (codes -> LLM embeddings)
+# =============================================================================
+class _Qwen2Attention(nn.Module):
+    def __init__(self, spec: AudioEncoderSpec, dtype: torch.dtype):
+        super().__init__()
+        d = spec.hidden_size
+        self.num_heads = spec.num_heads
+        self.head_dim = spec.head_dim
+        self.scale = spec.head_dim ** -0.5
+        self.causal = not spec.full_attention
+        self.q_proj = nn.Linear(d, d, bias=True, dtype=dtype)
+        self.k_proj = nn.Linear(d, d, bias=True, dtype=dtype)
+        self.v_proj = nn.Linear(d, d, bias=True, dtype=dtype)
+        self.o_proj = nn.Linear(d, d, bias=False, dtype=dtype)
+
+    def forward(self, x, cos, sin):
+        G, S, _ = x.shape
+        H, D = self.num_heads, self.head_dim
+        q = apply_rope(self.q_proj(x).view(G, S, H, D), cos, sin)
+        k = apply_rope(self.k_proj(x).view(G, S, H, D), cos, sin)
+        v = self.v_proj(x).view(G, S, H, D)
+        scores = torch.einsum("gqhd,gkhd->ghqk", q.to(torch.float32),
+                              k.to(torch.float32)) * self.scale
+        if self.causal:
+            i = torch.arange(S, device=x.device)
+            scores = scores.masked_fill(i[None, :] > i[:, None], torch.finfo(torch.float32).min)
+        probs = torch.softmax(scores, dim=-1).to(v.dtype)
+        out = torch.einsum("ghqk,gkhd->gqhd", probs, v)
+        return self.o_proj(out.reshape(G, S, H * D))
+
+
+class _Qwen2MLP(nn.Module):
+    def __init__(self, spec: AudioEncoderSpec, dtype: torch.dtype):
+        super().__init__()
+        d, f = spec.hidden_size, spec.intermediate_size
+        self.gate_proj = nn.Linear(d, f, bias=False, dtype=dtype)
+        self.up_proj = nn.Linear(d, f, bias=False, dtype=dtype)
+        self.down_proj = nn.Linear(f, d, bias=False, dtype=dtype)
+
+    def forward(self, x):
+        return self.down_proj(F.silu(self.gate_proj(x)) * self.up_proj(x))
+
+
+class _Qwen2Layer(nn.Module):
+    def __init__(self, spec: AudioEncoderSpec, dtype: torch.dtype):
+        super().__init__()
+        self.self_attn = _Qwen2Attention(spec, dtype)
+        self.mlp = _Qwen2MLP(spec, dtype)
+        self.input_layernorm = _Qwen2RMSNorm(spec.hidden_size, spec.rms_norm_eps, dtype)
+        self.post_attention_layernorm = _Qwen2RMSNorm(spec.hidden_size, spec.rms_norm_eps, dtype)
+
+    def forward(self, x, cos, sin):
+        x = x + self.self_attn(self.input_layernorm(x), cos, sin)
+        return x + self.mlp(self.post_attention_layernorm(x))
+
+
+class _Qwen2Stack(nn.Module):
+    """``input_local_transformer`` (HF ``Qwen2Model`` without ``embed_tokens``)."""
+
+    def __init__(self, spec: AudioEncoderSpec, dtype: torch.dtype):
+        super().__init__()
+        self.layers = nn.ModuleList(_Qwen2Layer(spec, dtype) for _ in range(spec.num_layers))
+        self.norm = (_Qwen2RMSNorm(spec.hidden_size, spec.rms_norm_eps, dtype)
+                     if spec.post_norm else nn.Identity())
+
+
+class MiMoAudioEncoder(nn.Module):
+    """Codes -> LLM embeddings. ``codes`` ``[N, >= channels]`` (e.g. the tokenizer output of
+    one segment bucket) and ``group_index`` ``[G, group_size]`` int32 rows of ``codes`` per
+    group (``build_group_index``). Returns ``[G, out_hidden_size]``; padded groups are
+    dropped by the host."""
+
+    def __init__(self, spec: AudioEncoderSpec, dtype: torch.dtype = torch.bfloat16):
+        super().__init__()
+        self.spec = spec
+        d = spec.hidden_size
+        self.speech_embeddings = nn.ModuleList(nn.Embedding(v, d, dtype=dtype)
+                                               for v in spec.vocab_sizes)
+        self.input_local_transformer = _Qwen2Stack(spec, dtype)
+        proj_in = d * spec.group_size
+        if spec.projection_layers == 1:
+            self.projection = nn.Linear(proj_in, spec.out_hidden_size, bias=False, dtype=dtype)
+        else:
+            self.projection = nn.Module()
+            self.projection.mlp = nn.Sequential(
+                nn.Linear(proj_in, proj_in * 4, bias=False, dtype=dtype),
+                _GELU(),
+                nn.Linear(proj_in * 4, spec.out_hidden_size, bias=False, dtype=dtype),
+            )
+        for p in self.parameters():
+            p.requires_grad_(False)
+
+    @property
+    def dtype(self) -> torch.dtype:
+        return self.speech_embeddings[0].weight.dtype
+
+    def forward(self, codes: torch.Tensor, group_index: torch.Tensor) -> torch.Tensor:
+        spec = self.spec
+        G, S = group_index.shape
+        g = codes[:, :spec.channels].index_select(0, group_index.reshape(-1))
+        g = g.reshape(G, S, spec.channels)
+        # HF _apply_speech_embeddings: zeros + per-channel adds in the embedding dtype
+        x = torch.zeros(G, S, spec.hidden_size, dtype=self.dtype, device=codes.device)
+        for i, emb in enumerate(self.speech_embeddings):
+            x = x + emb(g[..., i])
+        cos, sin = rope_cos_sin(S, spec.head_dim, spec.rope_theta, self.dtype, codes.device)
+        for layer in self.input_local_transformer.layers:
+            x = layer(x, cos, sin)
+        x = self.input_local_transformer.norm(x).reshape(G, S * spec.hidden_size)
+        if spec.projection_layers == 1:
+            return self.projection(x)
+        return self.projection.mlp(x)
+
+
+class MiMoAudioCacheEncoder(nn.Module):
+    """Serving graph of the two audio towers for one segment bucket (T41, decisions
+    D-162..D-165): tokenizer + RVQ + audio encoder on one segment, then the scatter of
+    the segment's embedding rows into the runner's on-device encoder cache, so codes and
+    embeddings never leave the device (the vision tower's contract, D-147).
+
+    Inputs (``plan_audio_cache_writes`` / ``audio_synthetic_inputs``): the tokenizer
+    inputs of the bucket (``mel``, ``conv_mask``, ``pool_index``, ``pool_scale``), the
+    audio-encoder ``group_index`` ``[G, group_size]``, and ``dst_block`` / ``dst_row``
+    ``[G]`` int64, the cache block and row of every group (padding groups go to the
+    scratch block). Returns ``(encoder_cache_buffer (aliased), codes [B / 4, 20] int32)``;
+    the codes are returned only so a diagnostic hook can read them."""
+
+    def __init__(self, tokenizer_spec: AudioTokenizerSpec, encoder_spec: AudioEncoderSpec,
+                 dtype: torch.dtype = torch.bfloat16):
+        super().__init__()
+        self.tokenizer = MiMoAudioTokenizerEncoder(tokenizer_spec, dtype=dtype)
+        self.encoder = MiMoAudioEncoder(encoder_spec, dtype=dtype)
+
+    def forward(self, mel, conv_mask, pool_index, pool_scale, group_index, dst_block, dst_row,
+                encoder_cache_buffer):
+        codes = self.tokenizer(mel, conv_mask, pool_index, pool_scale)
+        embeds = self.encoder(codes, group_index)
+        encoder_cache_buffer.index_put_((dst_block, dst_row),
+                                        embeds.to(encoder_cache_buffer.dtype))
+        return encoder_cache_buffer, codes
+
+
+# =============================================================================
+# Section 5: weights
+# =============================================================================
+def load_audio_tokenizer_state(tokenizer_dir: str, dtype: torch.dtype = torch.bfloat16) -> dict:
+    """``audio_tokenizer/model.safetensors`` ``encoder.*`` -> ``MiMoAudioTokenizerEncoder``
+    state dict (``load_state_dict(strict=True)``). Conv weights become matmul weights;
+    codebooks stay FP32 (stored FP32); RVQ training buffers (``cluster_size``,
+    ``embed_avg``, ``inited``) and the decoder are not used."""
+    from safetensors import safe_open
+
+    state = {}
+    with safe_open(os.path.join(tokenizer_dir, "model.safetensors"), framework="pt") as f:
+        names = [k for k in f.keys() if k.startswith("encoder.")]
+        if not names:
+            raise KeyError(f"no encoder.* tensors in {tokenizer_dir}/model.safetensors")
+        for name in names:
+            key = name[len("encoder."):]
+            if key.startswith("quantizer.vq.layers."):
+                level, _, rest = key[len("quantizer.vq.layers."):].partition(".")
+                if rest != "_codebook.embed":
+                    continue
+                state[f"quantizer.{level}.embed"] = f.get_tensor(name).to(torch.float32)
+                continue
+            t = f.get_tensor(name)
+            if key in ("conv1.weight", "conv2.weight"):
+                t = _conv_weight_as_linear(t)
+            elif key == "down_sample_layer.0.weight":
+                key = "down_sample.weight"
+                t = _conv_weight_as_linear(t)
+            state[key] = t.to(dtype)
+    return state
+
+
+def load_audio_encoder_state(checkpoint_dir: str, dtype: torch.dtype = torch.bfloat16) -> dict:
+    """Main checkpoint ``audio_encoder.*`` + ``speech_embeddings.*`` -> ``MiMoAudioEncoder``
+    state dict. ``audio_encoder.input_local_transformer.embed_tokens`` (unused, not in the
+    checkpoint; HF ``_keys_to_ignore_on_load_missing``) is skipped if present."""
+    from safetensors import safe_open
+
+    index_path = os.path.join(checkpoint_dir, "model.safetensors.index.json")
+    with open(index_path) as f:
+        weight_map = json.load(f)["weight_map"]
+    names = sorted(k for k in weight_map
+                   if k.startswith(("audio_encoder.", "speech_embeddings.")))
+    if not names:
+        raise KeyError(f"no audio_encoder.* / speech_embeddings.* tensors in {index_path}")
+    by_file: dict = {}
+    for name in names:
+        by_file.setdefault(weight_map[name], []).append(name)
+    state = {}
+    for fname, keys in sorted(by_file.items()):
+        with safe_open(os.path.join(checkpoint_dir, fname), framework="pt") as f:
+            for name in keys:
+                key = name[len("audio_encoder."):] if name.startswith("audio_encoder.") else name
+                if key.startswith("input_local_transformer.embed_tokens."):
+                    continue
+                state[key] = f.get_tensor(name).to(dtype)
+    return state
+
+
+def load_audio_cache_encoder_state(checkpoint_dir: str,
+                                   dtype: torch.dtype = torch.bfloat16) -> dict:
+    """``MiMoAudioCacheEncoder`` state dict: ``tokenizer.*`` from
+    ``<checkpoint>/audio_tokenizer`` and ``encoder.*`` from the main checkpoint."""
+    state = {"tokenizer." + k: v for k, v in load_audio_tokenizer_state(
+        os.path.join(checkpoint_dir, "audio_tokenizer"), dtype).items()}
+    state.update({"encoder." + k: v
+                  for k, v in load_audio_encoder_state(checkpoint_dir, dtype).items()})
+    return state
+
+
+# =============================================================================
+# Section 6: host side (mel, segments, bucket inputs, pipeline)
+# =============================================================================
+_MEL_DEFAULTS = {"audio_sampling_rate": 24000, "audio_nfft": 960, "audio_hop_length": 240,
+                 "audio_window_size": 960, "audio_fmin": 0.0, "audio_fmax": None,
+                 "audio_n_mels": 128}
+
+
+def mel_spectrogram(waveform, sample_rate: int, processor_config=None) -> torch.Tensor:
+    """Log-mel ``[frames, n_mels]`` FP32, the vLLM processor's ``preprocess_audio``
+    (``vllm/transformers_utils/processors/mimo_v2_omni.py``): resample to the processor rate
+    with torchaudio if needed, average channels, ``MelSpectrogram(power=1, center=True)``,
+    ``log(clip(x, 1e-7))``. ``processor_config``: the checkpoint's ``processor_config``."""
+    import torchaudio
+
+    p = dict(_MEL_DEFAULTS)
+    p.update({k: v for k, v in (processor_config or {}).items() if k in _MEL_DEFAULTS})
+    waveform = torch.as_tensor(waveform, dtype=torch.float32)
+    sr = int(p["audio_sampling_rate"])
+    if sample_rate != sr:
+        waveform = torchaudio.transforms.Resample(orig_freq=sample_rate, new_freq=sr)(waveform)
+    if waveform.ndim == 2:
+        waveform = waveform.mean(dim=0)
+    mel = torchaudio.transforms.MelSpectrogram(
+        sample_rate=sr, n_fft=p["audio_nfft"], hop_length=p["audio_hop_length"],
+        win_length=p["audio_window_size"], f_min=p["audio_fmin"], f_max=p["audio_fmax"],
+        n_mels=p["audio_n_mels"], power=1.0, center=True)
+    spec = mel(waveform[None, :])
+    return torch.log(torch.clip(spec, min=1e-7)).squeeze().transpose(0, 1)
+
+
+@dataclass(frozen=True)
+class AudioSegment:
+    start: int          # first mel frame of the segment in the item
+    length: int         # mel frames
+    bucket: int         # segment bucket (mel frames) of the tokenizer call
+    ref_len: int        # longest segment of the same HF encode call (sets HF's padding)
+    n_conv: int         # conv2 frames
+    n_codes: int        # codes of this segment
+    code_offset: int    # first code of the segment in the item
+    conv_tail_zero: bool   # HF: conv1 output past the end is 0 (segment is the longest)
+    pool_pad_zero: bool    # HF: pooling pad frame is 0 (else a copy of the last frame)
+
+
+def _hf_encode_groups(lengths, max_frames: int) -> list:
+    """HF ``_at_group_by_length``: consecutive segments, a new group when the running sum
+    would pass ``max_frames``. Returns the group number of each segment."""
+    group, current, out = 0, 0, []
+    for n in lengths:
+        if current + n > max_frames and current > 0:
+            group += 1
+            current = n
+        else:
+            current += n
+        out.append(group)
+    return out
+
+
+def plan_audio_segments(n_frames: int, spec: AudioTokenizerSpec,
+                        segment_size: int = AUDIO_SEGMENT_SIZE,
+                        buckets=AUDIO_SEGMENT_BUCKETS,
+                        group_frames: int = HF_ENCODE_GROUP_FRAMES) -> list:
+    """Segments of one audio item of ``n_frames`` mel frames (HF ``tokenize_audio_batch``
+    for a single mel): ``segment_size``-frame segments and a shorter remainder, each in the
+    smallest bucket that holds it."""
+    buckets = tuple(sorted(int(b) for b in buckets))
+    if n_frames < 1:
+        raise ValueError(f"audio has {n_frames} mel frames; need at least 1")
+    if not buckets or buckets[-1] < segment_size:
+        raise ValueError(f"segment buckets {buckets} must include one >= segment_size "
+                         f"{segment_size}")
+    if any(b % spec.frames_per_code for b in buckets):
+        raise ValueError(f"segment buckets {buckets} must be multiples of "
+                         f"{spec.frames_per_code}")
+    if segment_size % spec.frames_per_code:
+        raise ValueError(f"segment_size {segment_size} must be a multiple of "
+                         f"{spec.frames_per_code}")
+    lengths = [segment_size] * (n_frames // segment_size)
+    if n_frames % segment_size:
+        lengths.append(n_frames % segment_size)
+    groups = _hf_encode_groups(lengths, group_frames)
+    ref = {}
+    for g, n in zip(groups, lengths):
+        ref[g] = max(ref.get(g, 0), n)
+    segs, start, code_offset = [], 0, 0
+    for g, n in zip(groups, lengths):
+        m = ref[g]
+        n_conv = spec.conv_len(n)
+        n_codes = spec.code_len(n)
+        segs.append(AudioSegment(
+            start=start, length=n, bucket=next(b for b in buckets if b >= n), ref_len=m,
+            n_conv=n_conv, n_codes=n_codes, code_offset=code_offset,
+            conv_tail_zero=(n == m), pool_pad_zero=(n_conv == spec.conv_len(m))))
+        start += n
+        code_offset += n_codes
+    return segs
+
+
+def audio_code_count(n_frames: int, spec: AudioTokenizerSpec,
+                     segment_size: int = AUDIO_SEGMENT_SIZE) -> int:
+    full, rest = divmod(n_frames, segment_size)
+    return full * spec.code_len(segment_size) + (spec.code_len(rest) if rest else 0)
+
+
+def audio_token_count(n_frames: int, spec: AudioTokenizerSpec, group_size: int,
+                      segment_size: int = AUDIO_SEGMENT_SIZE) -> int:
+    """``<|audio_pad|>`` tokens of an item (= the vLLM processor's ``token_len``)."""
+    return -(-audio_code_count(n_frames, spec, segment_size) // group_size)
+
+
+def build_tokenizer_inputs(mel_segment: torch.Tensor, seg: AudioSegment,
+                           spec: AudioTokenizerSpec):
+    """Bucket tensors of one segment: ``(mel [bucket, n_mels], conv_mask [bucket],
+    pool_index [bucket / 2] int32, pool_scale [bucket / 2])`` (FP32 unless noted)."""
+    n, B = seg.length, seg.bucket
+    if mel_segment.shape[0] != n:
+        raise ValueError(f"mel segment has {mel_segment.shape[0]} frames, segment says {n}")
+    mel = torch.zeros(B, mel_segment.shape[1], dtype=torch.float32)
+    mel[:n] = mel_segment.to(torch.float32)
+    conv_mask = torch.ones(B, dtype=torch.float32)
+    if seg.conv_tail_zero:
+        conv_mask[n:] = 0.0
+    T = B // spec.stride
+    p = torch.arange(T, dtype=torch.int32)
+    pool_index = torch.clamp(p, max=seg.n_conv - 1)
+    pool_scale = torch.ones(T, dtype=torch.float32)
+    if seg.pool_pad_zero:
+        pool_scale[seg.n_conv:] = 0.0
+    return mel, conv_mask, pool_index, pool_scale
+
+
+def group_bucket(seg_bucket: int, spec: AudioTokenizerSpec, group_size: int) -> int:
+    """Audio-encoder groups of one segment bucket."""
+    return -(-spec.code_len(seg_bucket) // group_size)
+
+
+def build_group_index(n_codes: int, n_groups: int, group_size: int) -> torch.Tensor:
+    """``[n_groups, group_size]`` int32 code rows per group: rows ``0..n_codes-1`` in order,
+    the last real group padded with the last code (HF ``_pad_and_group_audio_codes``),
+    padding groups point at row 0."""
+    real = -(-n_codes // group_size)
+    if n_codes < 1 or real > n_groups:
+        raise ValueError(f"{n_codes} codes need {real} groups, bucket has {n_groups}")
+    idx = torch.zeros(n_groups * group_size, dtype=torch.int32)
+    idx[:real * group_size] = torch.clamp(torch.arange(real * group_size, dtype=torch.int32),
+                                          max=n_codes - 1)
+    return idx.reshape(n_groups, group_size)
+
+
+def encode_audio(tokenizer: MiMoAudioTokenizerEncoder, encoder: MiMoAudioEncoder,
+                 mel: torch.Tensor, segment_size: int | None = None,
+                 buckets=AUDIO_SEGMENT_BUCKETS):
+    """One audio item, mel ``[frames, n_mels]`` -> ``(codes [n_codes, num_quantizers] int32,
+    embeds [tokens, out_hidden_size])``, one bucketed tokenizer + encoder call per segment
+    (HF ``MiMoAudioEncoder.get_audio_feature`` for a single mel)."""
+    spec = tokenizer.spec
+    S = encoder.spec.group_size
+    segment_size = encoder.spec.segment_size if segment_size is None else segment_size
+    if spec.code_len(segment_size) % S:
+        raise ValueError(f"segment_size {segment_size} gives {spec.code_len(segment_size)} "
+                         f"codes, not a multiple of group_size {S}")
+    device = tokenizer.conv1.weight.device
+    codes, embeds = [], []
+    for seg in plan_audio_segments(mel.shape[0], spec, segment_size, buckets):
+        inputs = build_tokenizer_inputs(mel[seg.start:seg.start + seg.length], seg, spec)
+        seg_codes = tokenizer(*(t.to(device) for t in inputs))
+        gi = build_group_index(seg.n_codes, group_bucket(seg.bucket, spec, S), S)
+        e = encoder(seg_codes, gi.to(device))
+        codes.append(seg_codes[:seg.n_codes])
+        embeds.append(e[:-(-seg.n_codes // S)])
+    return torch.cat(codes, dim=0), torch.cat(embeds, dim=0)
+
+
+# =============================================================================
+# Section 7: serving -- on-device encoder cache (T41, decisions D-162..D-165)
+# =============================================================================
+def plan_audio_cache_writes(tokenizer_spec: AudioTokenizerSpec, encoder_spec: AudioEncoderSpec,
+                            mel: torch.Tensor, block_ids, cache_block_size: int,
+                            scratch_block_id: int, buckets=AUDIO_SEGMENT_BUCKETS) -> list:
+    """Host side of one audio item in ``embed_multimodal``: one ``MiMoAudioCacheEncoder``
+    call per segment (``plan_audio_segments``), so any length runs.
+
+    The item's ``audio_token_count`` embedding rows are stored densely from its first cache
+    block -- token ``k`` at block ``block_ids[k // cache_block_size]`` row
+    ``k % cache_block_size``, the layout ``EncoderCacheBlocks.dense_tokens_per_block``
+    describes and ``NeuronModelRunner._gather_mm_embeddings`` reads. A segment's rows start
+    at token ``code_offset / group_size`` (every full segment gives a multiple of
+    ``group_size`` codes, so the groups are HF's per-item groups); its padding groups write
+    to ``scratch_block_id``. Returns ``[(AudioSegment, inputs), ...]``, the inputs of the
+    call except the cache buffer."""
+    S = encoder_spec.group_size
+    segment_size = encoder_spec.segment_size
+    if tokenizer_spec.code_len(segment_size) % S:
+        raise ValueError(f"segment_size {segment_size} gives {tokenizer_spec.code_len(segment_size)} "
+                         f"codes, not a multiple of group_size {S}")
+    n_tokens = audio_token_count(mel.shape[0], tokenizer_spec, S, segment_size)
+    if len(block_ids) * cache_block_size < n_tokens:
+        raise ValueError(f"audio item: {n_tokens} embedding tokens do not fit {len(block_ids)} "
+                         f"cache blocks of {cache_block_size}")
+    blocks = torch.as_tensor(list(block_ids), dtype=torch.int64)
+    plans = []
+    for seg in plan_audio_segments(mel.shape[0], tokenizer_spec, segment_size, buckets):
+        mel_b, conv_mask, pool_index, pool_scale = build_tokenizer_inputs(
+            mel[seg.start:seg.start + seg.length], seg, tokenizer_spec)
+        G = group_bucket(seg.bucket, tokenizer_spec, S)
+        real = -(-seg.n_codes // S)
+        k = seg.code_offset // S + torch.arange(real, dtype=torch.int64)
+        dst_block = torch.full((G,), scratch_block_id, dtype=torch.int64)
+        dst_row = torch.arange(G, dtype=torch.int64) % cache_block_size
+        dst_block[:real] = blocks[k // cache_block_size]
+        dst_row[:real] = k % cache_block_size
+        plans.append((seg, {"mel": mel_b, "conv_mask": conv_mask, "pool_index": pool_index,
+                            "pool_scale": pool_scale,
+                            "group_index": build_group_index(seg.n_codes, G, S),
+                            "dst_block": dst_block, "dst_row": dst_row}))
+    return plans
+
+
+def audio_synthetic_inputs(tokenizer_spec: AudioTokenizerSpec, encoder_spec: AudioEncoderSpec,
+                           bucket: int, device) -> dict:
+    """Warmup inputs of ``MiMoAudioCacheEncoder`` for segment ``bucket`` (a silent segment
+    filling the bucket), with the shapes and dtypes ``plan_audio_cache_writes`` gives for
+    that bucket. The cache destinations are block 0, as for the vision warmup (the worker
+    passes the real buffer; real items overwrite the rows they own)."""
+    S = encoder_spec.group_size
+    seg = AudioSegment(start=0, length=bucket, bucket=bucket, ref_len=bucket,
+                       n_conv=tokenizer_spec.conv_len(bucket),
+                       n_codes=tokenizer_spec.code_len(bucket), code_offset=0,
+                       conv_tail_zero=True, pool_pad_zero=True)
+    mel, conv_mask, pool_index, pool_scale = build_tokenizer_inputs(
+        torch.zeros(bucket, tokenizer_spec.n_mels), seg, tokenizer_spec)
+    G = group_bucket(bucket, tokenizer_spec, S)
+    inputs = {"mel": mel, "conv_mask": conv_mask, "pool_index": pool_index,
+              "pool_scale": pool_scale, "group_index": build_group_index(seg.n_codes, G, S),
+              "dst_block": torch.zeros(G, dtype=torch.int64),
+              "dst_row": torch.zeros(G, dtype=torch.int64)}
+    return {k: t.to(device) for k, t in inputs.items()}
+
+
+def audio_item_mels(audio_features) -> list:
+    """Per-item log-mel ``[frames, n_mels]`` FP32 from the processor's ``audio_features``
+    (a list of tensors, or one stacked ``[items, frames, n_mels]`` tensor when the runner
+    batched equal-length items)."""
+    if isinstance(audio_features, torch.Tensor):
+        if audio_features.dim() == 2:
+            return [audio_features.to(torch.float32)]
+        return [m.to(torch.float32) for m in audio_features.unbind(0)]
+    return [torch.as_tensor(m).to(torch.float32) for m in audio_features]
