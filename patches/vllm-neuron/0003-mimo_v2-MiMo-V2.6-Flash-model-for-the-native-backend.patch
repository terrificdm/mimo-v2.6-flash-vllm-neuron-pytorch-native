+    # ── on-device prompt logprobs (T62) ────────────────────────────────────
+    # Kept at the end of the class and reached from forward() only through the return
+    # statements (prompt_logprob_token_ids arrives in **kwargs), so the earlier lines keep
+    # their numbers: the graph's HLO carries source-line metadata (XLA_HLO_DEBUG), and with
+    # the switch off the graphs stay byte-identical to the ones before T62 (NEFF cache hit).
+
+    def prompt_logprobs_width(self) -> int:
+        """Top-k width of the on-device prompt logprobs, 0 = off (the runner reads it once)."""
+        from vllm_neuron.model.neuron_config import prompt_logprobs_width
+
+        nc = self.config.neuron_config
+        width = 0 if nc is None else prompt_logprobs_width(nc.mimo_prompt_logprobs is True,
+                                                           nc.max_logprobs)
+        if width and self.on_device_sampling_config is None:
+            raise ValueError("mimo_prompt_logprobs needs on-device sampling (the prompt "
+                             "logprobs are an extra output of the sampling graphs); set "
+                             "neuron_config.mimo_prompt_logprobs=false")
+        if width and self.config.vocab_size % self.world_size:
+            raise ValueError(f"mimo_prompt_logprobs needs vocab_size ({self.config.vocab_size}) "
+                             f"divisible by the TP size ({self.world_size}): the on-device "
+                             "log-softmax must not include lm_head padding columns")
+        return width
+
+    def _plp(self, outputs: tuple, hidden_all: torch.Tensor, rank: torch.Tensor | None,
+             kwargs: dict) -> tuple:
+        """Append the packed prompt logprobs [T, 2k + 2] to ``outputs`` when the runner passed
+        ``prompt_logprob_token_ids`` (prefill steps with mimo_prompt_logprobs on): every
