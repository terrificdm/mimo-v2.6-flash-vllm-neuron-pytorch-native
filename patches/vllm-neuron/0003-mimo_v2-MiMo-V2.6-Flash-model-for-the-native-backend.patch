+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 (MiMo-V2.6-Flash) Configuration
+=======================================
+<-- MODEL-SPECIFIC: All fields in this config are MiMo-V2-specific.
+
+Architecture overview (text backbone):
+- 48 decoder layers; ``hybrid_layer_pattern[i]`` 1 = sliding-window (SWA), 0 = global.
+- QK head_dim 192, V head_dim 128; SWA layers have 8 KV heads, global layers 4.
+- Partial RoPE on the first ``int(head_dim * partial_rotary_factor)`` (= 64) dims;
+  global theta 1e7, SWA theta 1e4. SWA layers carry a per-head attention sink.
+- V is scaled by ``attention_value_scale`` before it is written to the KV cache.
+- ``moe_layer_freq[i]`` 0 = dense MLP (layer 0), 1 = MoE (256 experts, top-8,
+  sigmoid + correction-bias selection).
+
+Precision (design 3.1 / 3.5, decision D-033):
+- ``neuron_config.quantization`` selects the device precision: "bf16" or "fp8".
+- Checkpoint format comes from ``hf_config.quantization_config``: present -> the
+  original FP8 + MXFP4 checkpoint; absent -> the BF16 reference checkpoint.
+  The original checkpoint needs an explicit "bf16" or "fp8". The reference
+  checkpoint allows None (-> bf16) and rejects "fp8". The weight loader also
+  cross-checks the format against the checkpoint index.
+- MoE router dtype (``mimo_router_dtype``, T49 / D-215): ``neuron_config.mimo_router_dtype``,
+  unset -> the checkpoint's ``moe_router_dtype`` read like vLLM GPU (``mimo_v2.py``:
+  ``getattr(config, "moe_router_dtype", "float32")``; MiMo-V2.6-Flash: "bfloat16").
+- MoE kernel options (T54a M2, D-211): ``neuron_config.mimo_moe_tkg_hits_max_rows`` and
+  ``mimo_moe_prefill_accumulation_dtype`` (see ``moe.py``); the platform writes their resolved
+  values and a digest of the package's module constants (``graph_constants.py``) into
+  ``additional_config.neuron_config``, so they enter the compile fingerprint.
+- Static EP expert placement (T53b): ``neuron_config.mimo_expert_placement`` (JSON path, see
+  ``expert_placement.py``), unset -> linear placement; read and checked here, the slot count
+  per rank (``mimo_expert_slots``) shapes the expert parameters.
+"""
+
+import json
+from dataclasses import dataclass, field
+
+import torch
+from transformers import PretrainedConfig
+
+from vllm_neuron.model.neuron_config import NeuronConfig
+
+CHECKPOINT_FP8_MXFP4 = "fp8_mxfp4"  # original HF checkpoint
+CHECKPOINT_BF16_REFERENCE = "bf16_reference"  # dequant_checkpoint.py output
+
+QUANTIZATION_VALUES = (None, "bf16", "fp8")
+MIMO_FP8_LINEAR_VALUES = ("block", "row", "nki_block", "bf16_compute")
+MIMO_ATTN_KERNEL_VALUES = ("torch", "nki")
+MIMO_ROUTER_DTYPE_VALUES = ("float32", "bfloat16")
+# --speculative-config num_speculative_tokens of MTP (design 15.2): s_active = 1 + k <= 4
+MTP_NUM_SPECULATIVE_TOKENS = (1, 2, 3)
+# MoE kernel options (T54a M2, D-211): neuron_config values, so they enter the compile
+# fingerprint (a module constant that only changes its value reuses the cached graph,
+# upstream issue #10). Defaults below; moe.py documents what they choose.
+MOE_TKG_HITS_MAX_ROWS_DEFAULT = 4
+MOE_PREFILL_ACCUMULATION_DTYPE_VALUES = ("bfloat16", "float32")
+MOE_PREFILL_ACCUMULATION_DTYPE_DEFAULT = "bfloat16"
+# Static expert placement with replicas (T53b): prefill graphs of fewer tokens run the
+# primary copies only (T54a O9; D-263: the replica concatenation costs +0.9-1.3 ms per layer
+# at 1,024-4,096 tokens and is hidden at 8,192)
+EXPERT_REPLICA_MIN_TOKENS_DEFAULT = 8192
+
+# mimo_attn_kernel="nki" decode kernel limits (vllm_neuron/_kernels/mimo_v2/attention_decode_pm.py)
+NKI_ATTN_MAX_ROWS = 128  # requests x query columns per request: one partition each
+NKI_ATTN_POS_PER_PARTITION = 8  # DYN_CHUNK / 128 consecutive cache rows of one block
