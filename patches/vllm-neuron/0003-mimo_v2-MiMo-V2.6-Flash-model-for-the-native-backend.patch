--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/attention.py
@@ -0,0 +1,531 @@
+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 attention (design 3.4)
+==============================
+
+Hand-rolled torch attention for the native route. QK head_dim is 192 and V
+head_dim 128, above the 128 cap of the shared attention kernels
+(``NF.flash_attention`` silently falls back to torch for D > 128,
+``NF.segmented_attention`` raises, ``NF.attention_decode`` fuses o_proj and
+needs Q/K/V of one width), so the attention core is written here; projections
+use ``NF.qkv_proj`` (prefill; decode uses a plain BF16 matmul, see ``_project``) /
+``NF.o_proj``. The kernel choice table is in README.md.
+
+Per layer (``hybrid_layer_pattern``: 1 = SWA, 0 = global):
+
+* fused qkv -> partial RoPE on the first ``rope_dim`` (= 64) dims of Q and K
+  (neox ``rotate_half``; theta 1e4 SWA / 1e7 global) -> V * attention_value_scale
+  (0.707) -> paged KV cache write (K 192 wide, V 128 wide) -> attention -> o_proj.
+* SWA layers: window 128 and a per-head sink logit (an extra softmax column
+  that is dropped afterwards). Global layers: causal only, no sink.
+
+Visibility rules (one implementation each, used by every path):
+
+* ``swa_visible(q, k, w)``: ``q - w < k <= q``, i.e. keys ``max(0, q-127) .. q``
+  for w = 128 (HF ``sliding_window_overlay`` + causal; vLLM GPU window
+  ``(w - 1, 0)``). Decode and the ``1+k`` speculative verify apply it per query
+  position.
+* ``causal_visible(q, k)``: ``k <= q``.
+
+The core is an online softmax over key chunks (FP32 scores, FP32 accumulation),
+query chunks of ``QUERY_CHUNK`` and key chunks of ``KEY_CHUNK``; the sink is the
+initial running max with weight 1 and a zero value vector, which is exactly the
+"extra column" softmax. Paths:
+
+* prefill without prior context (``kv_segment_size == 0``, batch 1): keys are
+  this step's K/V; SWA query chunks only see ``[qs - 127, qe)``.
+* segmented prefill (``kv_segment_size > 0``, batch 1, prefix cache / chunked
+  prefill): prior keys come from the paged cache (global: the whole block span,
+  masked to ``< cached_seq_len``; SWA: only the 127 positions before the
+  segment), the segment's own keys from this step.
+* decode (``B`` requests x ``S = 1 + k`` tokens): this step's K/V are written to
+  the cache; prior keys (before each request's first query position) are read
+  from the cache through the (SWA-trimmed) block table, with
+  ``swa_kv_pos_offset`` giving the absolute position of the first trimmed slot,
+  and this step's ``S`` keys are taken from the projection (the trimmed table
+  ends at the block of ``num_computed_tokens``, so later speculative tokens can
+  fall into a block it does not list).
+"""
+
+import torch
+from torch import nn
+from vllm.distributed.parallel_state import get_tp_group
+
+import vllm_neuron.functional as NF
+from vllm_neuron.model.kv_cache import paged_slot_indices
+
+from .config import MiMoV2NeuronConfig
+
+QUERY_CHUNK = 1024
+KEY_CHUNK = 8192
+_NEG = torch.finfo(torch.float32).min
+# Score given to an invalid prior key (``before_all`` chunks). Finite so that a chunk with
+# no valid key yields p = exp(0) = 1 garbage that the next chunk with a valid key scales by
+# alpha = exp(_PRIOR_PAD - real) = 0, and a chunk with valid keys gives the pad keys
+# exp(_PRIOR_PAD - m) = 0 exactly; every global-layer query sees at least one valid key
+# (itself), so the result equals the masked softmax.
+_PRIOR_PAD = -1.0e30
+
+
+# ---------------------------------------------------------------- visibility
+
+def swa_visible(q_pos: torch.Tensor, k_pos: torch.Tensor, window: int) -> torch.Tensor:
+    """SWA rule: key ``k`` is visible to query ``q`` iff ``q - window < k <= q``.
+
+    The only implementation of the sliding-window boundary (design 3.4, N3);
+    prefill, segmented prefill, decode and the ``1+k`` verify all call it.
+    Inputs broadcast; returns a bool tensor.
+    """
+    return (k_pos <= q_pos) & (k_pos > q_pos - window)
+
+
+def causal_visible(q_pos: torch.Tensor, k_pos: torch.Tensor) -> torch.Tensor:
+    """Global-layer rule: ``k <= q``."""
+    return k_pos <= q_pos
+
+
+def layer_visible(q_pos: torch.Tensor, k_pos: torch.Tensor, window: int | None) -> torch.Tensor:
+    if window is None:
+        return causal_visible(q_pos, k_pos)
+    return swa_visible(q_pos, k_pos, window)
+
+
+# ---------------------------------------------------------------- partial RoPE
+
+def rope_cos_sin(positions: torch.Tensor, rope_dim: int, theta: float):
+    """FP32 ``cos, sin`` of shape ``[T, rope_dim]`` (HF ``MiMoV2RotaryEmbedding``).
+
+    Computed in forward (no buffer created in ``__init__``, which runs on meta).
+    """
+    exponent = (
+        torch.arange(0, rope_dim, 2, dtype=torch.int64, device=positions.device).to(
+            torch.float32
+        )
+        / rope_dim
+    )
+    inv_freq = 1.0 / (theta**exponent)
+    freqs = positions.to(torch.float32)[:, None] * inv_freq[None, :]
+    emb = torch.cat([freqs, freqs], dim=-1)
+    return emb.cos(), emb.sin()
+
+
+def apply_partial_rope(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor,
+                       rope_dim: int) -> torch.Tensor:
+    """Neox ``rotate_half`` RoPE on ``x[..., :rope_dim]`` of ``x [T, n, D]``, in FP32."""
+    x_rot = x[..., :rope_dim].to(torch.float32)
+    half = rope_dim // 2
+    rotated = torch.cat([-x_rot[..., half:], x_rot[..., :half]], dim=-1)
+    out = x_rot * cos[:, None, :] + rotated * sin[:, None, :]
+    return torch.cat([out.to(x.dtype), x[..., rope_dim:]], dim=-1)
+
+
+# ---------------------------------------------------------------- attention core
+
+def attend(q: torch.Tensor, key_chunks, q_pos: torch.Tensor, window: int | None,
+           sink: torch.Tensor | None, scale: float) -> torch.Tensor:
+    """Online-softmax attention over key chunks.
+
+    Args:
+        q: ``[B, nq, S, D]``.
+        key_chunks: iterable of ``(k [B, nkv, L, D], v [B, nkv, L, Dv],
+            k_pos [B, L] int64, k_valid [B, L] bool or None[, before_all])``;
+            Q head ``h`` uses KV head ``h // (nq // nkv)``. ``before_all=True``
+            (optional 5th item, global layers only, no sink) promises every key lies
+            before every query, so the causal rule is always true and visibility is
+            just ``k_valid``; it is folded into the scores as an extra contraction
+            column instead of a mask tensor (see ``_PRIOR_PAD``; T31 / D-116).
+        q_pos: ``[B, S]`` int64 absolute query positions.
+        window: SWA window (``swa_visible``) or None (causal).
+        sink: ``[nq]`` sink logits or None.
+        scale: softmax scale applied to ``q @ k^T``.
+
+    Returns:
+        ``[B, nq, S, Dv]`` FP32.
+    """
+    B, nq, S, _ = q.shape
+    qf = q.to(torch.float32)
+    if sink is not None:
+        m = sink.to(torch.float32).view(1, nq, 1).expand(B, nq, S)
+        denom = torch.ones(B, nq, S, dtype=torch.float32, device=q.device)
+    else:
+        m = torch.full((B, nq, S), _NEG, dtype=torch.float32, device=q.device)
+        denom = torch.zeros(B, nq, S, dtype=torch.float32, device=q.device)
+    acc = None
+    for k, v, k_pos, k_valid, *rest in key_chunks:
+        before_all = bool(rest and rest[0])
+        groups = nq // k.shape[1]
+        kf = k.to(torch.float32)
+        vf = v.to(torch.float32)
+        if groups > 1:
+            kf = kf.repeat_interleave(groups, dim=1)
+            vf = vf.repeat_interleave(groups, dim=1)
+        if before_all:
+            # Prior keys of a global layer: k < cached_seq_len <= q for every query, so
+            # causal_visible is all-true and only k_valid matters. It rides in the K data
+            # as an extra column (q gets a column of ones), so no position-only mask
+            # exists: such masks are shared by all 9 global layers and the compiler kept
+            # them live for the whole segmented-prefill graph, growing its scratchpad
+            # with max-model-len (T31, D-116).
+            pad = torch.where(k_valid, 0.0, _PRIOR_PAD / scale).to(torch.float32)  # [B, L]
+            kf = torch.cat([kf, pad[:, None, :, None].expand(B, kf.shape[1], -1, 1)], dim=-1)
+            q_aug = torch.cat([qf, torch.ones(B, nq, S, 1, dtype=torch.float32,
+                                              device=q.device)], dim=-1)
+            scores = torch.matmul(q_aug, kf.transpose(-1, -2)) * scale  # [B, nq, S, L]
+            m_new = torch.maximum(m, scores.amax(dim=-1))
+            alpha = torch.exp(m - m_new)
+            p = torch.exp(scores - m_new[..., None])
+        else:
+            scores = torch.matmul(qf, kf.transpose(-1, -2)) * scale  # [B, nq, S, L]
+            vis = layer_visible(q_pos[:, :, None], k_pos[:, None, :], window)  # [B, S, L]
+            if k_valid is not None:
+                vis = vis & k_valid[:, None, :]
+            vis = vis[:, None]
+            scores = scores.masked_fill(~vis, _NEG)
+            m_new = torch.maximum(m, scores.amax(dim=-1))
+            alpha = torch.exp(m - m_new)
+            p = torch.exp(scores - m_new[..., None]) * vis.to(torch.float32)
+        denom = denom * alpha + p.sum(dim=-1)
+        pv = torch.matmul(p, vf)
+        acc = pv if acc is None else acc * alpha[..., None] + pv
+        m = m_new
+    denom = torch.where(denom > 0, denom, torch.ones_like(denom))
+    return acc / denom[..., None]
+
+
+def gather_paged(cache: torch.Tensor, block_table: torch.Tensor) -> torch.Tensor:
+    """``cache [nb, nkv, bs, D]`` gathered through ``block_table [B, n]`` -> ``[B, nkv, n*bs, D]``.
+
+    Unused table entries (sentinels < 0) read block 0; callers mask them by position.
+    """
+    B, n = block_table.shape
+    _, nkv, bs, D = cache.shape
+    blocks = cache[block_table.clamp(min=0).to(torch.int64)]  # [B, n, nkv, bs, D]
+    return blocks.permute(0, 2, 1, 3, 4).reshape(B, nkv, n * bs, D)
+
+
+def gather_positions(cache: torch.Tensor, block_table_row: torch.Tensor,
+                     pos: torch.Tensor, block_size: int) -> torch.Tensor:
+    """Cache entries at absolute positions ``pos [L]`` (clamped >= 0) -> ``[1, nkv, L, D]``."""
+    p = pos.clamp(min=0)
+    blk = block_table_row.index_select(0, torch.div(p, block_size, rounding_mode="floor"))
+    off = p - torch.div(p, block_size, rounding_mode="floor") * block_size
+    g = cache[blk.clamp(min=0).to(torch.int64), :, off]  # [L, nkv, D]
+    return g.permute(1, 0, 2).unsqueeze(0)
+
+
+# ---------------------------------------------------------------- module
+
+class MiMoV2Attention(nn.Module):
+    """One MiMo-V2 attention layer.
+
+    >>> PARALLELISM: TP over the full TP group (gpt_oss pattern) <<<
+    Q heads ``n_q / tp`` per rank; KV heads ``max(1, n_kv // tp)`` per rank,
+    replicated when ``tp >= n_kv`` (the loader uses the same rule). Prefill
+    all-gathers the sequence-parallel input and reduce-scatters the o_proj
+    output; decode all-reduces it. EP does not change attention sharding.
+    """
+
+    def __init__(self, config: MiMoV2NeuronConfig, layer_idx: int):
+        super().__init__()
+        self.layer_idx = layer_idx
+        self.is_swa = config.is_swa_layer(layer_idx)
+        if self.is_swa:
+            n_q, n_kv = config.swa_num_attention_heads, config.swa_num_key_value_heads
+            d, dv = config.swa_head_dim, config.swa_v_head_dim
+            self.sliding_window = config.sliding_window
+            self.rope_theta = config.swa_rope_theta
+            has_sink = config.add_swa_attention_sink_bias
+        else:
+            n_q, n_kv = config.num_attention_heads, config.num_key_value_heads
+            d, dv = config.head_dim, config.v_head_dim
+            self.sliding_window = None
+            self.rope_theta = config.rope_theta
+            has_sink = config.add_full_attention_sink_bias
+        rope_dim = int(d * config.partial_rotary_factor)
+        if rope_dim <= 0 or rope_dim % 2:
+            raise ValueError(f"layer {layer_idx}: rope_dim {rope_dim} must be positive and even")
+        if config.attention_bias:
+            raise ValueError("MiMo-V2 attention_bias=True is not supported (checkpoint has none)")
+        self.rope_dim = rope_dim
+        self.head_dim = d
+        self.v_head_dim = dv
+        self.scaling = d**-0.5
+        self.v_scale = config.attention_value_scale
+        self.dtype = config.torch_dtype
+        self.hidden_size = config.hidden_size
+        self.attn_kernel = config.mimo_attn_kernel
+        self._mimo_config = config
+
+        # >>> PARALLELISM: TP group (also the collective group under EP) <<<
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        tp = self.world_size
+        config.check_nki_attention(tp)
+        if n_q % tp:
+            raise ValueError(f"layer {layer_idx}: {n_q} Q heads not divisible by tp={tp}")
+        if not (n_kv % tp == 0 or tp % n_kv == 0):
+            raise ValueError(f"layer {layer_idx}: {n_kv} KV heads incompatible with tp={tp}")
+        self.num_heads_per_rank = n_q // tp
+        self.num_kv_heads_per_rank = max(1, n_kv // tp)
+        self.q_size = self.num_heads_per_rank * d
+        self.k_size = self.num_kv_heads_per_rank * d
+        self.v_size = self.num_kv_heads_per_rank * dv
+
+        self.qkv_proj_weight = nn.Parameter(
+            torch.empty(self.hidden_size, self.q_size + self.k_size + self.v_size,
+                        dtype=self.dtype),
+            requires_grad=False,
+        )
+        self.o_proj_weight = nn.Parameter(
+            torch.empty(self.num_heads_per_rank * dv, self.hidden_size, dtype=self.dtype),
+            requires_grad=False,
+        )
+        if has_sink:
+            self.attention_sink_bias = nn.Parameter(
+                torch.empty(self.num_heads_per_rank, dtype=torch.float32),
+                requires_grad=False,
+            )
+        else:
+            self.attention_sink_bias = None
+
+        # Bound by bind_kv_cache(): K [nb, nkv, bs, d], V [nb, nkv, bs, dv].
+        self.k_cache = None
+        self.v_cache = None
+
+    def check_kv_block_size(self, block_size: int) -> None:
+        """``mimo_attn_kernel="nki"`` block_size limit, known once the KV cache is bound."""
+        self._mimo_config.check_nki_attention(self.world_size, block_size=block_size)
+
+    # ── helpers ───────────────────────────────────────────────────────────
+
+    def _project(self, hidden_states: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor,
+                 decode: bool = False):
+        """``[T, H]`` -> post-RoPE ``q [T, nq, d]``, ``k [T, nkv, d]``, scaled ``v [T, nkv, dv]``.
+
+        Decode graphs (``decode=True``: single-token decode and the ``1+k`` verify) use a
+        plain BF16 ``torch.matmul`` (FP32 accumulation, one rounding): on device the
+        ``NF.qkv_proj`` token-generation kernel added about 1.6x the error of one BF16
+        rounding to every decode q/k/v (T61 device capture, D-093), while its prefill
+        (CTE) path is exact to one rounding and stays in use.
+        """
+        T = hidden_states.shape[0]
+        if decode:
+            qkv = torch.matmul(hidden_states, self.qkv_proj_weight)
+        else:
+            qkv = NF.qkv_proj(
+                hidden=hidden_states.unsqueeze(0), qkv_weights=self.qkv_proj_weight
+            ).squeeze(0)
+        q, k, v = torch.split(qkv, [self.q_size, self.k_size, self.v_size], dim=-1)
+        q = q.reshape(T, self.num_heads_per_rank, self.head_dim)
+        k = k.reshape(T, self.num_kv_heads_per_rank, self.head_dim)
+        v = v.reshape(T, self.num_kv_heads_per_rank, self.v_head_dim)
+        # <-- MODEL-SPECIFIC: V is scaled before the cache write (HF / vLLM GPU).
+        v = v * self.v_scale
+        q = apply_partial_rope(q, cos, sin, self.rope_dim)
+        k = apply_partial_rope(k, cos, sin, self.rope_dim)
+        return q, k, v
+
+    def _write_kv(self, k: torch.Tensor, v: torch.Tensor, slot_mapping: torch.Tensor,
+                  block_size: int) -> None:
+        """Scatter ``k [T, nkv, d]`` / ``v [T, nkv, dv]`` at ``slot_mapping`` (PAD -> null block)."""
+        T = k.shape[0]
+        nkv = self.num_kv_heads_per_rank
+        blocks, offsets = paged_slot_indices(slot_mapping, block_size, self.k_cache.shape[0])
+        head_idx = torch.arange(nkv, dtype=blocks.dtype, device=blocks.device)
+        index = (
+            blocks.repeat(nkv),
+            head_idx.repeat_interleave(T),
+            offsets.repeat(nkv),
+        )
+        k_flat = k.transpose(0, 1).reshape(nkv * T, self.head_dim).to(self.k_cache.dtype)
+        v_flat = v.transpose(0, 1).reshape(nkv * T, self.v_head_dim).to(self.v_cache.dtype)
+        self.k_cache.index_put_(index, k_flat)
+        self.v_cache.index_put_(index, v_flat)
+
+    def _current_chunks(self, k: torch.Tensor, v: torch.Tensor, pos: torch.Tensor,
+                        qs: int, qe: int):
+        """Key chunks of this step's K/V visible to queries ``[qs, qe)`` (batch 1)."""
+        start = 0 if self.sliding_window is None else max(0, qs - self.sliding_window + 1)
+        chunks = []
+        for ks in range(start, qe, KEY_CHUNK):
+            ke = min(qe, ks + KEY_CHUNK)
+            chunks.append((
+                k[ks:ke].transpose(0, 1).unsqueeze(0),
+                v[ks:ke].transpose(0, 1).unsqueeze(0),
+                pos[ks:ke].unsqueeze(0),
+                None,
+            ))
+        return chunks
+
+    def _prior_chunks(self, block_table: torch.Tensor, prior: torch.Tensor,
+                      block_size: int):
+        """Key chunks of the cached prefix (segmented prefill, batch 1)."""
+        bt = block_table[0]
+        if self.sliding_window is not None:
+            n = self.sliding_window - 1
+            pos = prior - n + torch.arange(n, dtype=torch.int64, device=prior.device)
+            k = gather_positions(self.k_cache, bt, pos, block_size)
+            v = gather_positions(self.v_cache, bt, pos, block_size)
+            return [(k, v, pos.unsqueeze(0), (pos >= 0).unsqueeze(0))]
+        chunks = []
+        n_blocks = bt.shape[0]
+        per = max(1, KEY_CHUNK // block_size)
+        for b0 in range(0, n_blocks, per):
+            b1 = min(n_blocks, b0 + per)
+            sub = block_table[:, b0:b1]
+            pos = torch.arange(b0 * block_size, b1 * block_size, dtype=torch.int64,
+                               device=prior.device).unsqueeze(0)
+            chunks.append((
+                gather_paged(self.k_cache, sub),
+                gather_paged(self.v_cache, sub),
+                pos,
+                pos < prior,
+                True,  # every prior key precedes every query of the segment
+            ))
+        return chunks
+
+    def _o_proj(self, out: torch.Tensor) -> torch.Tensor:
+        """``out [nq, Dv, T]`` (FP32) -> ``[T, H]``."""
+        out = out.to(self.dtype).unsqueeze(0)  # [1, nq, Dv, T]
+        return NF.o_proj(out, self.o_proj_weight).squeeze(0)
+
+    # ── forward ───────────────────────────────────────────────────────────
+
+    def forward(self, hidden_states: torch.Tensor, positions: torch.Tensor,
+                cos_sin: tuple[torch.Tensor, torch.Tensor], attn_metadata: dict,
+                is_decode: bool) -> torch.Tensor:
+        if is_decode:
+            return self.forward_decode(hidden_states, positions, cos_sin, attn_metadata)
+        # >>> PARALLELISM: all-gather the sequence-parallel input <<<
+        if self.world_size > 1:
+            hidden_states = self.tp_group.all_gather(hidden_states, dim=0)
+        out = self.forward_prefill(hidden_states, cos_sin, attn_metadata)
+        # >>> PARALLELISM: reduce-scatter back to the sequence-parallel layout <<<
+        if self.world_size > 1:
+            out = self.tp_group.reduce_scatter(out, dim=0)
+        return out.contiguous()
+
+    def forward_prefill(self, hidden_states: torch.Tensor,
+                        cos_sin: tuple[torch.Tensor, torch.Tensor],
+                        attn_metadata: dict) -> torch.Tensor:
+        """Batch-1 prefill over ``T`` tokens (whole sequence on this rank)."""
+        meta = attn_metadata[f"layers.{self.layer_idx}.self_attn"]
+        slot_mapping = meta["slot_mapping"]
+        block_size = meta["block_size"]
+        kv_segment_size = meta.get("kv_segment_size")
+        cos, sin = cos_sin
+        T = hidden_states.shape[0]
+
+        q, k, v = self._project(hidden_states.to(self.dtype), cos, sin)
+        self._write_kv(k, v, slot_mapping, block_size)
+
+        if self.attn_kernel == "nki":
+            # The whole attention core in the NKI prefill kernel (T33): the global layers'
+            # prefix is streamed from the paged cache with a run-time fold count, so a
+            # segment's cost follows cached_seq_len, not the table width (max-model-len).
+            from vllm_neuron.utils.neuron_utils import can_run_kernel
+
+            from . import attention_nki
+
+            prior = (meta["cached_seq_len"].reshape(-1)[0:1].to(torch.int64)
+                     if kv_segment_size else None)
+            out = attention_nki.prefill_attention(
+                q, k, v, self.k_cache, self.v_cache, meta.get("block_table_tensor"), prior,
+                self.sliding_window, self.attention_sink_bias, self.scaling, block_size,
+                use_kernel=can_run_kernel(q))  # [nq, T, Dv]
+            return self._o_proj(out.transpose(1, 2))
+
+        idx = torch.arange(T, dtype=torch.int64, device=hidden_states.device)
+        if kv_segment_size:
+            prior = meta["cached_seq_len"].reshape(-1)[0:1].to(torch.int64)
+            pos = idx + prior
+            prior_chunks = self._prior_chunks(meta["block_table_tensor"], prior, block_size)
+        else:
+            pos = idx
+            prior_chunks = []
+
+        outs = []
+        for qs in range(0, T, QUERY_CHUNK):
+            qe = min(T, qs + QUERY_CHUNK)
+            chunks = prior_chunks + self._current_chunks(k, v, pos, qs, qe)
+            o = attend(
+                q[qs:qe].transpose(0, 1).unsqueeze(0),
+                chunks,
+                pos[qs:qe].unsqueeze(0),
+                self.sliding_window,
+                self.attention_sink_bias,
+                self.scaling,
+            )  # [1, nq, Sq, Dv]
+            outs.append(o[0])
+        out = torch.cat(outs, dim=1) if len(outs) > 1 else outs[0]  # [nq, T, Dv]
+        return self._o_proj(out.transpose(1, 2))
+
+    def forward_decode(self, hidden_states: torch.Tensor, positions: torch.Tensor,
+                       cos_sin: tuple[torch.Tensor, torch.Tensor],
+                       attn_metadata: dict) -> torch.Tensor:
+        """``B`` requests x ``S = 1 + k`` tokens.
+
+        Prior keys (positions before each request's first query) are read from the
+        paged cache through the block table; this step's ``S`` keys are used from
+        the projection directly (like the decode kernels' active K/V), because the
+        runner's trimmed SWA table ends at the block of ``num_computed_tokens`` and
+        may not contain the block the later speculative tokens are written to.
+        """
+        meta = attn_metadata[f"layers.{self.layer_idx}.self_attn"]
+        slot_mapping = meta["slot_mapping"]
+        block_size = meta["block_size"]
+        block_table = meta["block_table_tensor"]
+        cos, sin = cos_sin
+        B = block_table.shape[0]
+        T = hidden_states.shape[0]
+        S = T // B
+
+        q, k, v = self._project(hidden_states.to(self.dtype), cos, sin, decode=True)
+        self._write_kv(k, v, slot_mapping, block_size)
+
+        q = q.view(B, S, self.num_heads_per_rank, self.head_dim).transpose(1, 2)
+        q_pos = positions.view(B, S).to(torch.int64)
+        q_start = q_pos[:, :1]
+        offset = meta.get("swa_kv_pos_offset")
+        k_act = k.reshape(B, S, self.num_kv_heads_per_rank, self.head_dim).transpose(1, 2)
+        v_act = v.reshape(B, S, self.num_kv_heads_per_rank, self.v_head_dim).transpose(1, 2)
+        if self.attn_kernel == "nki":
+            # Prior keys through the NKI kernel (loop count follows the real context,
+            # T32); this step's keys and the sink are folded in by attention_nki.combine.
+            from vllm_neuron.utils.neuron_utils import can_run_kernel
+
+            from . import attention_nki
+
+            out = attention_nki.decode_attention(
+                q, k_act, v_act, self.k_cache, self.v_cache, block_table, q_pos, offset,
+                self.sliding_window, self.attention_sink_bias, self.scaling, block_size,
+                use_kernel=can_run_kernel(q))
+        else:
+            out = self._decode_attend_torch(q, k_act, v_act, block_table, q_pos, q_start,
+                                            offset, block_size)
+        out = out.permute(1, 3, 0, 2).reshape(self.num_heads_per_rank, self.v_head_dim, T)
+        out = self._o_proj(out)
+        # >>> PARALLELISM: sum o_proj partials over the TP group <<<
+        if self.world_size > 1:
+            out = self.tp_group.all_reduce(out)
+        return out
+
+    def _decode_attend_torch(self, q, k_act, v_act, block_table, q_pos, q_start, offset,
+                             block_size):
+        """Torch decode core (``mimo_attn_kernel="torch"``): gather the whole table."""
+        B = block_table.shape[0]
+        n_blocks = block_table.shape[1]
+        per = max(1, KEY_CHUNK // block_size)
+        chunks = []
+        for b0 in range(0, n_blocks, per):
+            b1 = min(n_blocks, b0 + per)
+            sub = block_table[:, b0:b1]
+            k_pos = torch.arange(b0 * block_size, b1 * block_size, dtype=torch.int64,
+                                 device=q_pos.device).unsqueeze(0).expand(B, -1)
+            if offset is not None:
+                k_pos = k_pos + offset.view(B, 1).to(torch.int64)
+            chunks.append((gather_paged(self.k_cache, sub), gather_paged(self.v_cache, sub),
+                           k_pos, k_pos < q_start))
+        chunks.append((k_act, v_act, q_pos, None))
+        return attend(q, chunks, q_pos, self.sliding_window, self.attention_sink_bias,
+                      self.scaling)  # [B, nq, S, Dv]
