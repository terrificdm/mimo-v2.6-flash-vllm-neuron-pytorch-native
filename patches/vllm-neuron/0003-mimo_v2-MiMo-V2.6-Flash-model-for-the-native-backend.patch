index 0000000..53f1648
--- /dev/null
+++ b/vllm_neuron/_kernels/mimo_v2/expert_dequant_dump.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: Apache-2.0
+"""FP8 expert weight dequantization dump (design 6.3 device level, T27).
+
+The FP8 experts run nkilib ``moe_cte`` ``shard_on_I`` with per-channel scales
+(``bwmm_shard_on_I.py``, per-channel branch): each FP8 weight tile is DMA'd into SBUF in
+the weight dtype, ``nisa.tensor_copy`` upcasts it to a BF16 tile, the BF16 tile enters
+``nisa.nc_matmul`` (FP32 PSUM), and the PSUM result is multiplied by the FP32 scale:
+``nisa.tensor_scalar`` with a ``[128, 1]`` per-partition scale for gate/up (output
+channels on partitions), ``nisa.tensor_tensor`` with a scale row broadcast over the
+partitions for down (output channels on the free dim).
+
+This kernel runs the same instruction sequence against an identity matrix instead of the
+activations, so it returns the dequantized weights themselves:
+
+* ``col_scale=True`` (gate/up layout ``w [K=H, N=2*I]``, ``scale [N, 1]``): the BF16 tile
+  ``[128 k, 128 n]`` is the stationary operand (as in the kernel), the identity the moving
+  one, so PSUM is ``[128 n, 128 k] = w^T`` (one non-zero product per sum, exact); then
+  ``tensor_scalar`` x ``scale[n]``. ``deq`` is ``[N, K]``, i.e. the checkpoint's
+  ``[out, in]`` orientation.
+* ``col_scale=False`` (down layout ``w [K=I, N=H]``, ``scale [1, N]``): identity stationary,
+  BF16 tile ``[128 k, 512 n]`` moving (as in the kernel), PSUM ``[128 k, 512 n] = w``; then
+  ``tensor_tensor`` x the broadcast scale row. ``deq`` is ``[K, N]`` (device layout).
+
+``codes`` (``[K, N]`` BF16) is the upcast tile written back as is (FP8 -> BF16 alone; the
+sub-normal test reads it bit by bit). Programs of the LNC grid split the 128-row K tiles.
+Outputs: ``codes [K, N]`` bf16, ``deq`` fp32 (shape above).
+"""
+
+import hashlib
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+
+P_MAX = 128
+DOWN_FREE = 512  # moving-operand / PSUM free size of the down tile in shard_on_I
+with open(__file__, "rb") as _f:
+    KERNEL_REV = hashlib.sha256(_f.read()).hexdigest()[:16]
+
+
+def kernel_assert(cond, msg):
+    if not cond:
+        raise AssertionError(f"[mimo_expert_dequant_dump] {msg}")
+
+
+@nki.jit
+def mimo_expert_dequant_dump(w, scale, col_scale=True, rev=""):
+    """Dequantize one expert weight tensor with the shard_on_I instruction sequence.
+
+    ``rev``: pass ``KERNEL_REV`` (enters the NKI compile-cache key, see attention_decode).
+    """
+    K, N = w.shape
+    kernel_assert(K % P_MAX == 0, f"K {K} must be a multiple of {P_MAX}")
+    if col_scale:
+        kernel_assert(N % P_MAX == 0, f"N {N} must be a multiple of {P_MAX}")
+        kernel_assert(tuple(scale.shape) == (N, 1), f"scale {scale.shape} != {(N, 1)}")
+    else:
+        kernel_assert(N % DOWN_FREE == 0, f"N {N} must be a multiple of {DOWN_FREE}")
+        kernel_assert(tuple(scale.shape) == (1, N), f"scale {scale.shape} != {(1, N)}")
+    n_prg = nl.num_programs(0) if nl.program_ndim() > 0 else 1
+    prg = nl.program_id(0) if nl.program_ndim() > 0 else 0
+
+    codes = nl.ndarray((K, N), dtype=nl.bfloat16, buffer=nl.shared_hbm)
+    if col_scale:
+        deq = nl.ndarray((N, K), dtype=nl.float32, buffer=nl.shared_hbm)
+    else:
+        deq = nl.ndarray((K, N), dtype=nl.float32, buffer=nl.shared_hbm)
+
+    ident = nl.shared_identity_matrix(P_MAX, dtype=nl.bfloat16)
+    n_tiles = N // P_MAX
+    if col_scale:
+        # sc[p, t] = scale[t * 128 + p]: one [128, 1] per-partition scale per n tile
+        sc = nl.ndarray((P_MAX, n_tiles), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=sc, src=scale.ap(pattern=[[1, P_MAX], [P_MAX, n_tiles]], offset=0))
+    else:
+        # the scale row on every partition
+        sc = nl.ndarray((P_MAX, N), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=sc, src=scale.ap(pattern=[[0, P_MAX], [1, N]], offset=0))
+
+    for kt in range(K // P_MAX):
+        if kt % n_prg != prg:
+            continue
+        w_sb = nl.ndarray((P_MAX, N), dtype=w.dtype, buffer=nl.sbuf)
+        nisa.dma_copy(dst=w_sb, src=w.ap(pattern=[[N, P_MAX], [1, N]], offset=kt * P_MAX * N))
+        w_bf = nl.ndarray((P_MAX, N), dtype=nl.bfloat16, buffer=nl.sbuf)
+        nisa.tensor_copy(dst=w_bf, src=w_sb)
+        nisa.dma_copy(dst=codes.ap(pattern=[[N, P_MAX], [1, N]], offset=kt * P_MAX * N),
+                      src=w_bf)
+        if col_scale:
+            for nt in range(n_tiles):
+                ps = nl.ndarray((P_MAX, P_MAX), dtype=nl.float32, buffer=nl.psum)
+                nisa.nc_matmul(dst=ps, stationary=w_bf[0:P_MAX, nt * P_MAX:(nt + 1) * P_MAX],
+                               moving=ident)
+                out = nl.ndarray((P_MAX, P_MAX), dtype=nl.float32, buffer=nl.sbuf)
+                nisa.tensor_scalar(dst=out, data=ps, op0=nl.multiply,
+                                   operand0=sc[0:P_MAX, nt:nt + 1])
+                nisa.dma_copy(dst=deq.ap(pattern=[[K, P_MAX], [1, P_MAX]],
+                                         offset=nt * P_MAX * K + kt * P_MAX), src=out)
+        else:
+            for ft in range(N // DOWN_FREE):
+                f0 = ft * DOWN_FREE
+                ps = nl.ndarray((P_MAX, DOWN_FREE), dtype=nl.float32, buffer=nl.psum)
+                nisa.nc_matmul(dst=ps, stationary=ident,
+                               moving=w_bf[0:P_MAX, f0:f0 + DOWN_FREE])
+                out = nl.ndarray((P_MAX, DOWN_FREE), dtype=nl.float32, buffer=nl.sbuf)
+                nisa.tensor_tensor(dst=out, data1=ps, data2=sc[0:P_MAX, f0:f0 + DOWN_FREE],
+                                   op=nl.multiply)
+                nisa.dma_copy(dst=deq.ap(pattern=[[N, P_MAX], [1, DOWN_FREE]],
+                                         offset=kt * P_MAX * N + f0), src=out)
+    return codes, deq
+
+
+def dequant_dump(w, scale, col_scale: bool, n_prg: int):
+    """``wrap_nki`` launch on the LNC grid (device tests)."""
+    from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+
+    return wrap_nki(mimo_expert_dequant_dump)[n_prg](w=w, scale=scale, col_scale=col_scale,
+                                                      rev=KERNEL_REV)
