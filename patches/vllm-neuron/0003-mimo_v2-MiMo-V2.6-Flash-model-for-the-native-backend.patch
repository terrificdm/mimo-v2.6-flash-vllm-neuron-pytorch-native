index 0000000..eee9094
--- /dev/null
+++ b/vllm_neuron/_kernels/mimo_v2/attention_prefill.py
@@ -0,0 +1,363 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 prefill / segmented-prefill attention (NKI, design 8.4, T33).
+
+QK head_dim 192 and V head_dim 128 are above the shared CTE kernels' limits
+(nkilib ``attention_cte`` / ``attention_segmented_cte`` need ``d <= 128`` and one width
+for Q/K/V), so this kernel is written for MiMo after their flash-attention structure:
+Q tiles of 128 queries stationary on the PE, 512-key score tiles in one PSUM bank (the
+192-wide QK contraction is two partition tiles, 128 + 65, accumulated in PSUM), online
+softmax per query row, P transposed per 128-key chunk and multiplied with V in its natural
+layout (128 wide). SWA windows and the causal diagonal are static band masks on the tiles
+that straddle them (``swa_fused_cte``'s rule ``q - window < k <= q``); tiles entirely
+outside are skipped at trace time. The (query tile, key tile) steps run as a software
+pipeline: the scores of step ``i`` are computed while the softmax of ``i - 1`` and the PV
+of ``i - 2`` are in flight, so the engines overlap instead of waiting on each other.
+
+Contract (one TP rank, one layer, one KV head per rank, batch 1, ``nq`` Q heads, ``T``
+queries of this segment at relative positions ``t = 0 .. T-1``; row ``r = h * T + t``,
+``R = nq * T``):
+
+* **contiguous keys** ``k [L, D]`` (``L = n_pre + T``): ``n_pre`` keys that precede the
+  segment (the SWA window read from the cache, relative positions ``-n_pre .. -1``), then
+  the segment's own ``T`` keys (relative positions ``0 .. T-1``). Key ``j`` (relative
+  position ``kp = j - n_pre``) is visible to row ``r`` iff ``kp <= t`` and, for
+  ``window > 0``, ``kp > t - window``. ``kpen [1, L]`` is a per-key additive score (0, or
+  ``MASK_PENALTY`` for keys that do not exist, e.g. the SWA window before position 0); it
+  rides in the QK contraction as a 65th row of the second d-tile (Q gets a row of ones).
+* **paged prior keys** (``paged=True``, global layers of a segmented prefill): the first
+  ``prior`` positions of the paged cache through ``block_table [1, NB]``, all visible to
+  every row (they precede every query). They are streamed in folds of ``fold_blocks``
+  blocks (one block per partition); the number of folds is read at run time from
+  ``n_iter[0, 0] = ceil(prior / (fold_blocks * block_size))``, so the work follows the
+  request's real prefix, not the table width (max-model-len). Both LNC programs walk the
+  same folds (queries are split between programs, not keys), so their dynamic trip counts
+  are equal (rule P). Keys of the last fold at or past ``prior`` get ``MASK_PENALTY`` in
+  the extra contraction row.
+* the running state of row ``r`` starts at ``m0l0[r] = (m, l)`` (raw score units): the
+  sink is ``(sink / scale, 1)`` (an extra softmax column with a zero value vector),
+  otherwise ``(M_FLOOR, 0)``.
+
+Inputs: ``q [R, D]``, ``k [L, D]``, ``v [L, Dv]``, ``kpen [1, L]`` bf16, ``m0l0 [R, 2]``
+fp32, ``k_cache [nb, 1, bs, D]`` / ``v_cache [nb, 1, bs, Dv]`` bf16 (read only when
+``paged``), ``block_table [1, NB]`` int32 (valid block ids, ``NB % fold_blocks == 0``),
+``n_iter [1, 1]`` int32, ``prior [1, 1]`` fp32. ``R``, ``T``, ``n_pre`` multiples of 128.
+Output: ``out [R, Dv]`` fp32 (normalised).
+"""
+
+import hashlib
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+
+P_MAX = 128
+KT_MAX = 512  # keys per score tile: one PSUM bank of fp32
+# sha256 of this file: the launch passes it as ``rev`` (NKI's compile cache keys only the
+# top-level function source, see attention_decode.KERNEL_REV)
+with open(__file__, "rb") as _f:
+    KERNEL_REV = hashlib.sha256(_f.read()).hexdigest()[:16]
+M_FLOOR = -1.0e20
+MASK_PENALTY = -1.0e30
+
+
+def kernel_assert(cond, msg):
+    if not cond:
+        raise AssertionError(f"[mimo_prefill_attn] {msg}")
+
+
+@nki.jit
+def mimo_prefill_attn(q, k, v, kpen, m0l0, k_cache, v_cache, block_table, n_iter, prior,
+                      scale=1.0, n_pre=0, window=0, paged=False, fold_blocks=128, rev=""):
+    """Prefill attention (see module docstring). ``rev``: pass ``KERNEL_REV``."""
+    R, D = q.shape
+    L = k.shape[0]
+    Dv = v.shape[1]
+    T = L - n_pre
+    nb, nkv, bs, Dk = k_cache.shape
+    NB = block_table.shape[1]
+    D2 = D - P_MAX  # second d-tile of the data
+    D1 = D2 + 1  # second contraction tile incl. the extra row
+    kernel_assert(k.shape[1] == D and Dk == D, f"QK dims q {D} k {k.shape[1]} cache {Dk}")
+    kernel_assert(P_MAX < D < 2 * P_MAX, f"QK head dim {D} must be in (128, 256)")
+    kernel_assert(Dv <= P_MAX and v.shape[0] == L and tuple(kpen.shape) == (1, L),
+                  f"V {tuple(v.shape)} kpen {tuple(kpen.shape)} vs L {L}")
+    kernel_assert(R % P_MAX == 0 and T % P_MAX == 0 and n_pre % P_MAX == 0 and R % T == 0,
+                  f"R {R}, T {T}, n_pre {n_pre} must be multiples of {P_MAX}, R of T")
+    kernel_assert(tuple(m0l0.shape) == (R, 2), f"m0l0 {tuple(m0l0.shape)}")
+    FB = fold_blocks
+    if paged:
+        kernel_assert(nkv == 1 and v_cache.shape[1] == 1, f"one KV head per rank, got {nkv}")
+        kernel_assert(FB <= P_MAX and NB % FB == 0, f"table width {NB} vs fold {FB}")
+        KTP = min(KT_MAX, bs * FB)
+        kernel_assert(KTP % FB == 0 and (bs * FB) % KTP == 0, f"fold {FB} x block {bs}")
+
+    n_prg = nl.num_programs(0) if nl.program_ndim() > 0 else 1
+    prg = nl.program_id(0) if nl.program_ndim() > 0 else 0
+    n_qt = R // P_MAX
+    kernel_assert(n_qt >= n_prg, f"{n_qt} query tiles for {n_prg} programs")
+    own = [i for i in range(n_qt) if i % n_prg == prg]  # interleaved: balances the causal work
+    n_own = len(own)
+    dt = q.dtype
+
+    out = nl.ndarray((R, Dv), dtype=nl.float32, buffer=nl.shared_hbm)
+
+    # ── per-call state: this program's Q^T tiles and running softmax state ──
+    # running max kept as nb = -scale * m (the exp bias), denominators l, accumulators acc
+    qa = nl.ndarray((P_MAX, n_own, P_MAX), dtype=dt, buffer=nl.sbuf)
+    qb = nl.ndarray((D1, n_own, P_MAX), dtype=dt, buffer=nl.sbuf)
+    nb_st = nl.ndarray((P_MAX, n_own), dtype=nl.float32, buffer=nl.sbuf)
+    l_st = nl.ndarray((P_MAX, n_own), dtype=nl.float32, buffer=nl.sbuf)
+    acc = nl.ndarray((P_MAX, n_own, Dv), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.memset(dst=acc, value=0.0)
+    nisa.memset(dst=qb[D2:D1, :, :], value=1.0)
+    m0 = nl.ndarray((P_MAX, n_own), dtype=nl.float32, buffer=nl.sbuf)
+    for li, i in enumerate(own):
+        r0 = i * P_MAX
+        q_ld = nl.ndarray((P_MAX, D), dtype=dt, buffer=nl.sbuf)
+        nisa.dma_copy(dst=q_ld, src=q.ap(pattern=[[D, P_MAX], [1, D]], offset=r0 * D))
+        tq = nl.ndarray((P_MAX, 2 * P_MAX), dtype=dt, buffer=nl.psum)
+        nisa.nc_transpose(dst=tq[:, 0:P_MAX], data=q_ld[:, 0:P_MAX])
+        nisa.nc_transpose(dst=tq[0:D2, P_MAX:2 * P_MAX], data=q_ld[:, P_MAX:D])
+        nisa.tensor_copy(dst=qa[:, li, :], src=tq[:, 0:P_MAX], engine=nisa.vector_engine)
+        nisa.tensor_copy(dst=qb[0:D2, li, :], src=tq[0:D2, P_MAX:2 * P_MAX],
+                         engine=nisa.scalar_engine)
+        nisa.dma_copy(dst=m0[:, li:li + 1], src=m0l0.ap(pattern=[[2, P_MAX], [1, 1]],
+                                                        offset=r0 * 2))
+        nisa.dma_copy(dst=l_st[:, li:li + 1], src=m0l0.ap(pattern=[[2, P_MAX], [1, 1]],
+                                                          offset=r0 * 2 + 1))
+    nisa.tensor_scalar(dst=nb_st, data=m0, op0=nl.multiply, operand0=-scale)
+    st = (qa, qb, nb_st, l_st, acc, dt, scale)
+
+    # ── phase 1: paged prior keys, runtime fold count ──────────────────
+    if paged:
+        fold_pos = FB * bs
+        n_sc = (bs * FB) // KTP  # score tiles per fold
+        sp = KTP // FB  # block slots per score tile
+        cnt_sb = nl.ndarray((1, 1), dtype=nl.int32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=cnt_sb, src=n_iter)
+        thr = nl.ndarray((FB, 1), dtype=nl.float32, buffer=nl.sbuf)  # prior - fold start
+        nisa.dma_copy(dst=thr, src=prior.ap(pattern=[[0, FB], [1, 1]], offset=0))
+        rel = nl.ndarray((FB, bs), dtype=nl.float32, buffer=nl.sbuf)  # p * bs + j
+        nisa.iota(dst=rel, pattern=[[1, bs]], offset=0, channel_multiplier=bs)
+        col_off = nl.ndarray((1, 1), dtype=nl.int32, buffer=nl.sbuf)
+        nisa.memset(dst=col_off, value=0)
+        tg = max(1, min(bs, KT_MAX // FB))  # slots per transpose PSUM tile (<= 1 KB bf16)
+
+        def body(_it):
+            # fold buffers (allocated in the body, like attention_decode's fold)
+            k_ld = nl.ndarray((FB, bs, D), dtype=k_cache.dtype, buffer=nl.sbuf)
+            v_ld = nl.ndarray((FB, bs, Dv), dtype=v_cache.dtype, buffer=nl.sbuf)
+            kb_src = nl.ndarray((FB, bs, D1), dtype=k_cache.dtype, buffer=nl.sbuf)
+            kT_a = nl.ndarray((P_MAX, bs * FB), dtype=k_cache.dtype, buffer=nl.sbuf)
+            kT_b = nl.ndarray((D1, bs * FB), dtype=k_cache.dtype, buffer=nl.sbuf)
+            pen = nl.ndarray((FB, bs), dtype=nl.float32, buffer=nl.sbuf)
+            idx = nl.ndarray((FB, 1), dtype=nl.int32, buffer=nl.sbuf)
+            nisa.dma_copy(dst=idx, src=block_table.ap(
+                pattern=[[1, FB], [1, 1]], offset=0, scalar_offset=col_off, indirect_dim=1))
+            nisa.dma_copy(dst=k_ld, src=k_cache.ap(
+                pattern=[[bs * D, FB], [D, bs], [1, D]], offset=0, vector_offset=idx,
+                indirect_dim=0))
+            nisa.dma_copy(dst=v_ld, src=v_cache.ap(
+                pattern=[[bs * Dv, FB], [Dv, bs], [1, Dv]], offset=0, vector_offset=idx,
+                indirect_dim=0))
+            # keys at or past ``prior`` -> MASK_PENALTY in the extra contraction row
+            nisa.tensor_scalar(dst=pen, data=rel, op0=nl.greater_equal, operand0=thr,
+                               op1=nl.multiply, operand1=MASK_PENALTY)
+            nisa.tensor_copy(dst=kb_src[:, :, 0:D2], src=k_ld[:, :, P_MAX:D])
+            nisa.tensor_copy(dst=kb_src[:, :, D2], src=pen)
+            # K^T, key column c = j * FB + p (slot-major): [128, bs*FB], [D1, bs*FB]
+            for j0 in range(0, bs, tg):
+                tp_a = nl.ndarray((P_MAX, tg * FB), dtype=k_cache.dtype, buffer=nl.psum)
+                tp_b = nl.ndarray((D1, tg * FB), dtype=k_cache.dtype, buffer=nl.psum)
+                for jj in range(tg):
+                    nisa.nc_transpose(dst=tp_a[:, jj * FB:(jj + 1) * FB],
+                                      data=k_ld[:, j0 + jj, 0:P_MAX])
+                    nisa.nc_transpose(dst=tp_b[:, jj * FB:(jj + 1) * FB],
+                                      data=kb_src[:, j0 + jj, :])
+                nisa.tensor_copy(dst=kT_a[:, j0 * FB:(j0 + tg) * FB], src=tp_a,
+                                 engine=nisa.vector_engine)
+                nisa.tensor_copy(dst=kT_b[:, j0 * FB:(j0 + tg) * FB], src=tp_b,
+                                 engine=nisa.scalar_engine)
+            items = []
+            for g in range(n_sc):  # score tile outer, query tile inner: neighbours independent
+                c0 = g * KTP
+                v_chunks = [v_ld[:, g * sp + jj, :] for jj in range(sp)]
+                for li in range(n_own):
+                    items.append((li, kT_a[:, c0:c0 + KTP], kT_b[:, c0:c0 + KTP], KTP,
+                                  v_chunks, FB, None))
+            _pipeline(st, items)
+            nisa.tensor_scalar(dst=col_off, data=col_off, op0=nl.add, operand0=FB)
+            nisa.tensor_scalar(dst=thr, data=thr, op0=nl.add, operand0=float(-fold_pos))
+
+        it_reg = nisa.register_alloc()
+        nisa.register_load(it_reg, cnt_sb[0:1, 0:1])
+        nl.fori_loop(0, it_reg, body)
+
+    # ── phase 2: contiguous keys (window before the segment + the segment) ──
+    pen_tiles = {}
+    dif = None
+
+    def band_pen(delta, w):
+        """Additive mask of a straddling tile: key column c, query partition p is visible
+        iff c - p <= delta and (window) c - p > delta - window."""
+        nonlocal dif
+        key = (delta, w)
+        if key not in pen_tiles:
+            if dif is None:
+                dif = nl.ndarray((P_MAX, KT_MAX), dtype=nl.float32, buffer=nl.sbuf)
+                nisa.iota(dst=dif, pattern=[[1, KT_MAX]], offset=0, channel_multiplier=-1)
+            pt = nl.ndarray((P_MAX, w), dtype=nl.float32, buffer=nl.sbuf)
+            nisa.tensor_scalar(dst=pt, data=dif[:, 0:w], op0=nl.greater, operand0=float(delta),
+                               op1=nl.multiply, operand1=MASK_PENALTY)
+            if window:
+                lo = nl.ndarray((P_MAX, w), dtype=nl.float32, buffer=nl.sbuf)
+                nisa.tensor_scalar(dst=lo, data=dif[:, 0:w], op0=nl.less_equal,
+                                   operand0=float(delta - window), op1=nl.multiply,
+                                   operand1=MASK_PENALTY)
+                nisa.tensor_tensor(dst=pt, data1=pt, data2=lo, op=nl.add)
+            pen_tiles[key] = pt
+        return pen_tiles[key]
+
+    items = []
+    for j0 in range(0, L, KT_MAX):
+        w = min(KT_MAX, L - j0)
+        nch = w // P_MAX
+        kp_lo, kp_hi = j0 - n_pre, j0 + w - 1 - n_pre
+        work = []
+        for li, i in enumerate(own):
+            t0 = (i * P_MAX) % T
+            if kp_lo > t0 + P_MAX - 1:
+                continue  # every key after every query of the tile
+            if window and kp_hi <= t0 - window:
+                continue  # every key before every query's window
+            full = kp_hi <= t0 and (not window or kp_lo >= t0 + P_MAX - window)
+            work.append((li, None if full else t0 - kp_lo))
+        if not work:
+            continue
+        # K rows -> K^T (PE transposes), extra row = kpen; V rows with keys on partitions
+        k_ld = nl.ndarray((P_MAX, nch, D), dtype=k.dtype, buffer=nl.sbuf)
+        vc = nl.ndarray((P_MAX, nch, Dv), dtype=v.dtype, buffer=nl.sbuf)
+        nisa.dma_copy(dst=k_ld, src=k.ap(pattern=[[D, P_MAX], [P_MAX * D, nch], [1, D]],
+                                         offset=j0 * D))
+        nisa.dma_copy(dst=vc, src=v.ap(pattern=[[Dv, P_MAX], [P_MAX * Dv, nch], [1, Dv]],
+                                       offset=j0 * Dv))
+        ka = nl.ndarray((P_MAX, w), dtype=k.dtype, buffer=nl.sbuf)
+        kb = nl.ndarray((D1, w), dtype=k.dtype, buffer=nl.sbuf)
+        nisa.dma_copy(dst=kb[D2:D1, :], src=kpen.ap(pattern=[[L, 1], [1, w]], offset=j0))
+        tk_a = nl.ndarray((P_MAX, w), dtype=k.dtype, buffer=nl.psum)
+        tk_b = nl.ndarray((D2, w), dtype=k.dtype, buffer=nl.psum)
+        for c in range(nch):
+            nisa.nc_transpose(dst=tk_a[:, c * P_MAX:(c + 1) * P_MAX], data=k_ld[:, c, 0:P_MAX])
+            nisa.nc_transpose(dst=tk_b[:, c * P_MAX:(c + 1) * P_MAX], data=k_ld[:, c, P_MAX:D])
+        nisa.tensor_copy(dst=ka, src=tk_a, engine=nisa.vector_engine)
+        nisa.tensor_copy(dst=kb[0:D2, :], src=tk_b, engine=nisa.scalar_engine)
+        v_chunks = [vc[:, c, :] for c in range(nch)]
+        for li, delta in work:
+            items.append((li, ka, kb, w, v_chunks, P_MAX,
+                          None if delta is None else band_pen(delta, w)))
+    _pipeline(st, items)
+
+    # ── normalise and store ────────────────────────────────────────────
+    for li, i in enumerate(own):
+        lsafe = nl.ndarray((P_MAX, 1), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.tensor_scalar(dst=lsafe, data=l_st[:, li:li + 1], op0=nl.maximum, operand0=1e-30)
+        rinv = nl.ndarray((P_MAX, 1), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.reciprocal(dst=rinv, data=lsafe)
+        o_sb = nl.ndarray((P_MAX, Dv), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.tensor_scalar(dst=o_sb, data=acc[:, li, :], op0=nl.multiply, operand0=rinv)
+        nisa.dma_copy(dst=out.ap(pattern=[[Dv, P_MAX], [1, Dv]], offset=i * P_MAX * Dv),
+                      src=o_sb)
+    return out
+
+
+def _pipeline(st, items):
+    """Run (query tile, key tile) steps as a 3-stage software pipeline.
+
+    Program order per step ``i``: copies of P^T for ``i - 2`` (vector/scalar engines),
+    scores + softmax of ``i`` (PE, then vector/scalar), PV matmuls and the state update of
+    ``i - 2``, transposes of P for ``i - 1`` (PE). Each engine runs its instructions in
+    program order, so the PE computes the scores of ``i`` while the softmax of ``i - 1``
+    runs, and the PV of ``i - 2`` finds its P^T ready. Steps of one query tile only ever
+    follow each other in order (state updates are sequential per tile).
+    """
+    inflight = {}
+    n = len(items)
+    for i in range(n + 2):
+        if i - 2 >= 0:
+            _copies(inflight[i - 2])
+        if i < n:
+            inflight[i] = _scores_softmax(st, items[i])
+        if i - 2 >= 0:
+            _pv_update(st, inflight.pop(i - 2))
+        if 0 <= i - 1 < n:
+            _transposes(inflight[i - 1])
+
+
+def _scores_softmax(st, item):
+    """Scores, running max, exp of one step; returns the step's in-flight record."""
+    qa, qb, nb_st, l_st, acc, dt, scale = st
+    li, ka, kb, w, v_chunks, ck, pen = item
+    # scores s[q, k] = q . k (raw), Q stationary. accumulate=None (compiler-inferred: first
+    # write overwrites, second accumulates); explicit flags into PSUM slices dropped a
+    # d-tile on trn2 in T32's device probe (D-119).
+    s_ps = nl.ndarray((P_MAX, w), dtype=nl.float32, buffer=nl.psum)
+    nisa.nc_matmul(dst=s_ps, stationary=qa[:, li, :], moving=ka)
+    nisa.nc_matmul(dst=s_ps, stationary=qb[:, li, :], moving=kb)
+    if pen is not None:
+        s_sb = nl.ndarray((P_MAX, w), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.tensor_tensor(dst=s_sb, data1=s_ps, data2=pen, op=nl.add)
+        s_src = s_sb
+    else:
+        s_src = s_ps
+    mloc = nl.ndarray((P_MAX, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_reduce(dst=mloc, op=nl.maximum, data=s_src, axis=1)
+    # nb_new = -scale * max(m_old, mloc) = min(nb_old, -scale * mloc)
+    nb_new = nl.ndarray((P_MAX, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=nb_new, data=mloc, op0=nl.multiply, operand0=-scale,
+                       op1=nl.minimum, operand1=nb_st[:, li:li + 1])
+    # alpha = exp(scale * (m_old - m_new)) = exp(nb_new - nb_old)
+    alpha = nl.ndarray((P_MAX, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.activation(dst=alpha, op=nl.exp, data=nb_st[:, li:li + 1], bias=nb_new, scale=-1.0)
+    nisa.tensor_copy(dst=nb_st[:, li:li + 1], src=nb_new, engine=nisa.gpsimd_engine)
+    # p = exp(scale * s - scale * m_new) in bf16 for PV, row sums in fp32
+    p_sb = nl.ndarray((P_MAX, w), dtype=dt, buffer=nl.sbuf)
+    lsum = nl.ndarray((P_MAX, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.activation_reduce(dst=p_sb, op=nl.exp, data=s_src, reduce_op=nl.add,
+                           reduce_res=lsum, bias=nb_new, scale=scale)
+    return {"item": item, "p": p_sb, "alpha": alpha, "lsum": lsum}
+
+
+def _transposes(rec):
+    li, ka, kb, w, v_chunks, ck, pen = rec["item"]
+    pT_ps = nl.ndarray((ck, len(v_chunks) * P_MAX), dtype=rec["p"].dtype, buffer=nl.psum)
+    for c in range(len(v_chunks)):
+        nisa.nc_transpose(dst=pT_ps[:, c * P_MAX:(c + 1) * P_MAX],
+                          data=rec["p"][:, c * ck:(c + 1) * ck])
+    rec["pT_ps"] = pT_ps
+
+
+def _copies(rec):
+    li, ka, kb, w, v_chunks, ck, pen = rec["item"]
+    nc = len(v_chunks)
+    pT = nl.ndarray((ck, nc * P_MAX), dtype=rec["p"].dtype, buffer=nl.sbuf)
+    half = (nc + 1) // 2
+    nisa.tensor_copy(dst=pT[:, 0:half * P_MAX], src=rec["pT_ps"][:, 0:half * P_MAX],
+                     engine=nisa.vector_engine)
+    if half < nc:
+        nisa.tensor_copy(dst=pT[:, half * P_MAX:nc * P_MAX],
+                         src=rec["pT_ps"][:, half * P_MAX:nc * P_MAX], engine=nisa.scalar_engine)
+    rec["pT"] = pT
+
+
+def _pv_update(st, rec):
+    qa, qb, nb_st, l_st, acc, dt, scale = st
+    li, ka, kb, w, v_chunks, ck, pen = rec["item"]
+    Dv = acc.shape[2]
+    o_ps = nl.ndarray((P_MAX, Dv), dtype=nl.float32, buffer=nl.psum)
+    for c, vch in enumerate(v_chunks):
+        nisa.nc_matmul(dst=o_ps, stationary=rec["pT"][:, c * P_MAX:(c + 1) * P_MAX], moving=vch)
+    # acc = acc * alpha + o; l = l * alpha + lsum
+    nisa.scalar_tensor_tensor(dst=acc[:, li, :], data=acc[:, li, :], op0=nl.multiply,
+                              operand0=rec["alpha"], op1=nl.add, operand1=o_ps)
+    nisa.scalar_tensor_tensor(dst=l_st[:, li:li + 1], data=l_st[:, li:li + 1], op0=nl.multiply,
+                              operand0=rec["alpha"], op1=nl.add, operand1=rec["lsum"])
