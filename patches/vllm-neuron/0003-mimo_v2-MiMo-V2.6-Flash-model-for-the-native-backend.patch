--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/fp8_linear.py
@@ -0,0 +1,209 @@
+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 FP8 linear layers: FP8 weight x FP8 dynamic activation (design 6.2, D-083, D-102)
+=========================================================================================
+
+Covers the fused qkv projection of every decoder layer and the layer-0 dense MLP
+(``neuron_config.quantization="fp8"``). o_proj (``quantization_config.ignored_layers``),
+embedding, lm_head, router and the routed experts are not touched here (FP8 experts:
+T25; MTP layers: T36).
+
+Weights come from ``weight_loaders.load_rank_state(precision="fp8")``:
+``weight [K, N]`` float8_e4m3fn (in_out) and an FP32 ``weight_scale``.
+
+``mimo_fp8_linear="block"`` (default, the numerics baseline): the GPU block-FP8 GEMM.
+
+* Weight: checkpoint codes x 0.5 (``fp8_layout.halve_fp8_e4m3fn``: block max 448 ->
+  224, inside the trn2 e4m3 range 240; exact for ``|code| >= 2^-5``), block scale x 2,
+  ``weight_scale [K/128, N]`` (one scale per output row and 128-wide K block).
+* Activation: per token and 128 columns on the GPU grid, as vLLM
+  ``per_token_group_quant_fp8``: ``s = max(amax, 1e-10) / 448``, ``q = x / s``. The
+  stored code is ``q / 2`` (max 224) and the scale ``2 s``; for ``|q| >= 2^-5`` the code
+  is exactly half of the GPU code, so the dequantized activation is the GPU one (D-102).
+* Matmul per K block: ``y = sum_k (x_q[:, k] @ W_q[k]) * s_x[:, k] * s_w[k]``, the
+  partial products from ``bmm`` of BF16-upcast codes with FP32 output (D-083
+  ``bmm_upcast_fp32``): FP8 codes are exact in BF16, their products exact in FP32 and
+  the accumulation is FP32, so this is the FP8 x FP8 GEMM with FP32 accumulation, at
+  BF16 matmul speed. ``torch._scaled_mm``, FP8-input ``bmm(out_dtype)`` and FP8-output
+  ``matmul`` do not compile or round each partial to FP8 (D-083) and are not used.
+  Tokens are processed in chunks so the FP32 partials ``[K/128, Tc, N]`` stay within
+  ``BLOCK_PARTIAL_BYTES`` (T21 review N1). CPU: the same algorithm with an FP32 bmm
+  (``bmm`` with ``out_dtype`` has no CPU kernel); the values are identical.
+
+``mimo_fp8_linear="row"`` (per-channel weights + per-token activations through the nkilib
+ROW qkv kernel) is not supported (D-102): on device the FP8-input ROW CTE kernel hung the
+first real prefill (twice: ``[1, N]`` and ``[128, N]`` weight scale), and with the FP8
+codes passed as BF16 the compiler folded the FP32 -> FP8 -> BF16 casts, so the
+activations were no longer FP8-quantized. ``nki_block`` / ``bf16_compute`` (design 6.2
+fallbacks) are not implemented either; block compiles and is the serving mode.
+"""
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from .attention import MiMoV2Attention, apply_partial_rope
+from .config import MiMoV2NeuronConfig
+from .moe import MiMoV2MLP
+
+FP8 = torch.float8_e4m3fn
+BLOCK = 128
+GPU_FP8_MAX = 448.0  # e4m3fn max: the grid of the GPU activation quantization
+GPU_ACT_EPS = 1e-10  # vLLM per_token_group_quant_fp8 eps
+BLOCK_CODE_MAX = GPU_FP8_MAX / 2  # 224 <= 240 (trn2 e4m3)
+BLOCK_PARTIAL_BYTES = 64 << 20  # FP32 [K/128, Tc, N] partials per token chunk
+
+FP8_LINEAR_IMPLEMENTED = ("block",)
+
+
+# ---------------------------------------------------------------- block mode
+
+def quant_act_block(x: torch.Tensor):
+    """``x [T, K]`` -> codes ``[T, K/128, 128]`` FP8 (``|code| <= 224``), scales ``[T, K/128]`` FP32.
+
+    GPU grid: ``s = max(amax, 1e-10) / 448``, ``q = clamp(x / s, +-448)``; returns
+    ``(q / 2, 2 s)`` (module docstring).
+    """
+    T, K = x.shape
+    if K % BLOCK:
+        raise ValueError(f"FP8 block activation width {K} is not a multiple of {BLOCK}")
+    xb = x.to(torch.float32).reshape(T, K // BLOCK, BLOCK)
+    s = xb.abs().amax(dim=-1).clamp(min=GPU_ACT_EPS) / GPU_FP8_MAX
+    q = (xb / s.unsqueeze(-1)) * 0.5
+    codes = q.clamp(-BLOCK_CODE_MAX, BLOCK_CODE_MAX).to(FP8)
+    return codes, s * 2.0
+
+
+def block_token_chunk(kb: int, n: int) -> int:
+    """Tokens per chunk so that the FP32 partials ``[kb, Tc, n]`` fit ``BLOCK_PARTIAL_BYTES``."""
+    per = BLOCK_PARTIAL_BYTES // (kb * n * 4)
+    if per >= BLOCK:
+        per = per // BLOCK * BLOCK
+    return max(1, per)
+
+
+def _matmul_fp32(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    """Batched ``a @ b`` of FP8 codes with FP32 output (exact products, FP32 accumulation).
+
+    Device: BF16 upcast + ``bmm(out_dtype=float32)`` (D-083). CPU: FP32 bmm (the BF16
+    form has no CPU kernel); FP8 codes are exact in both.
+    """
+    if a.device.type == "cpu":
+        return torch.bmm(a.to(torch.float32), b.to(torch.float32))
+    return torch.bmm(a.to(torch.bfloat16), b.to(torch.bfloat16), out_dtype=torch.float32)
+
+
+def block_fp8_matmul(codes: torch.Tensor, scales: torch.Tensor, weight: torch.Tensor,
+                     weight_scale: torch.Tensor) -> torch.Tensor:
+    """``sum_k (codes[:, k] @ W[k]) * scales[:, k] * weight_scale[k]`` -> FP32 ``[T, N]``.
+
+    ``codes [T, KB, 128]`` FP8, ``scales [T, KB]``, ``weight [KB*128, N]`` FP8,
+    ``weight_scale [KB, N]``.
+    """
+    T, KB, _ = codes.shape
+    N = weight.shape[1]
+    w = weight.reshape(KB, BLOCK, N)
+    chunk = block_token_chunk(KB, N)
+    ys = []
+    for t0 in range(0, T, chunk):
+        t1 = min(T, t0 + chunk)
+        part = _matmul_fp32(codes[t0:t1].transpose(0, 1), w)  # [KB, tc, N]
+        part = part * scales[t0:t1].t().unsqueeze(-1) * weight_scale.unsqueeze(1)
+        ys.append(part.sum(dim=0))
+    return torch.cat(ys) if len(ys) > 1 else ys[0]
+
+
+class Fp8BlockLinear(nn.Module):
+    """``y = x @ W`` with block FP8 weight ``[K, N]`` + ``weight_scale [K/128, N]`` (block mode)."""
+
+    def __init__(self, in_features: int, out_features: int):
+        super().__init__()
+        if in_features % BLOCK:
+            raise ValueError(f"FP8 block linear input width {in_features} is not a multiple "
+                             f"of {BLOCK} (TP shards must cut whole 128-column blocks)")
+        self.weight = nn.Parameter(torch.empty(in_features, out_features, dtype=FP8),
+                                   requires_grad=False)
+        self.weight_scale = nn.Parameter(
+            torch.empty(in_features // BLOCK, out_features, dtype=torch.float32),
+            requires_grad=False)
+
+    def matmul_quantized(self, codes: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+        """FP32 output for activations already quantized by :func:`quant_act_block`."""
+        return block_fp8_matmul(codes, scales, self.weight, self.weight_scale)
+
+    def forward(self, x: torch.Tensor, decode: bool = False) -> torch.Tensor:
+        codes, scales = quant_act_block(x)
+        return self.matmul_quantized(codes, scales).to(x.dtype)
+
+
+# ---------------------------------------------------------------- layers
+
+class MiMoV2AttentionFp8(MiMoV2Attention):
+    """``MiMoV2Attention`` with an FP8 fused qkv projection; o_proj stays BF16."""
+
+    def __init__(self, config: MiMoV2NeuronConfig, layer_idx: int):
+        super().__init__(config, layer_idx)
+        del self.qkv_proj_weight
+        self.qkv_proj = Fp8BlockLinear(self.hidden_size, self.q_size + self.k_size + self.v_size)
+
+    def _project(self, hidden_states: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor,
+                 decode: bool = False):
+        """As ``MiMoV2Attention._project`` with the FP8 qkv projection."""
+        T = hidden_states.shape[0]
+        qkv = self.qkv_proj(hidden_states, decode=decode)
+        q, k, v = torch.split(qkv, [self.q_size, self.k_size, self.v_size], dim=-1)
+        q = q.reshape(T, self.num_heads_per_rank, self.head_dim)
+        k = k.reshape(T, self.num_kv_heads_per_rank, self.head_dim)
+        v = v.reshape(T, self.num_kv_heads_per_rank, self.v_head_dim)
+        # <-- MODEL-SPECIFIC: V is scaled before the cache write (HF / vLLM GPU).
+        v = v * self.v_scale
+        q = apply_partial_rope(q, cos, sin, self.rope_dim)
+        k = apply_partial_rope(k, cos, sin, self.rope_dim)
+        return q, k, v
+
+
+class MiMoV2MLPFp8(MiMoV2MLP):
+    """Dense SwiGLU MLP with block FP8 gate / up / down.
+
+    gate and up each quantize the same input (identical codes, as the single
+    quantization of the merged GPU gate_up GEMM; layer 0 only, so the second pass is
+    cheap, and every projection stays a module call that tensor capture hooks see).
+    gate / up are rounded to BF16 (GPU GEMM output), ``silu(gate) * up`` is computed in
+    FP32 and rounded to BF16, then quantized again for down.
+    """
+
+    def __init__(self, config: MiMoV2NeuronConfig):
+        super().__init__(config)
+        H = config.hidden_size
+        per = config.intermediate_size // self.world_size
+        del self.gate_proj_weight, self.up_proj_weight, self.down_proj_weight
+        self.gate_proj = Fp8BlockLinear(H, per)
+        self.up_proj = Fp8BlockLinear(H, per)
+        self.down_proj = Fp8BlockLinear(per, H)
+
+    def forward(self, hidden_states: torch.Tensor, positions: torch.Tensor,
+                is_decode: bool) -> torch.Tensor:
+        dtype = hidden_states.dtype
+        # >>> PARALLELISM: SP all-gather in prefill <<<
+        if not is_decode and self.world_size > 1:
+            hidden_states = self.tp_group.all_gather(hidden_states, dim=0)
+        gate = self.gate_proj(hidden_states)
+        up = self.up_proj(hidden_states)
+        act = (F.silu(gate.to(torch.float32)) * up.to(torch.float32)).to(dtype)
+        out = self.down_proj(act)
+        if self.world_size > 1:
+            if is_decode:
+                out = self.tp_group.all_reduce(out)
+            else:
+                out = self.tp_group.reduce_scatter(out, dim=0)
+        return out
+
+
+def fp8_layer_classes(mode: str):
+    """``(attention class, dense MLP class)`` for ``neuron_config.mimo_fp8_linear``."""
+    if mode not in FP8_LINEAR_IMPLEMENTED:
+        raise NotImplementedError(
+            f"neuron_config.mimo_fp8_linear={mode!r} is not implemented "
+            f"(implemented: {FP8_LINEAR_IMPLEMENTED}; row is not supported on device and "
+            "nki_block / bf16_compute are not implemented, D-102)")
+    return MiMoV2AttentionFp8, MiMoV2MLPFp8
