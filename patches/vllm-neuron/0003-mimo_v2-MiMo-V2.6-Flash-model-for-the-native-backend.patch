+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 text-backbone weight loading (design 3.3)
+=================================================
+
+Every checkpoint transform happens at load time, so a deployment only needs the
+original HF checkpoint. Two input formats are accepted (design 3.3, D-033):
+
+* ``fp8_mxfp4``: the original HF checkpoint. ``model.safetensors.index.json``
+  has ``*.weight_scale_inv`` keys; linear layers are block FP8 (128x128,
+  ``float8_e4m3fn``), the fused qkv is stored as 4 tp shards (layout B, D-061),
+  routed experts are MXFP4 (``weight`` uint8 + E8M0 ``weight_scale``).
+* ``bf16_reference``: the output of ``tools/mimo/dequant_checkpoint.py``. No
+  ``weight_scale_inv`` in the index; qkv is re-ordered to a contiguous
+  ``[Q_0..Q_63 | K_0.. | V_0..]``; experts are BF16.
+
+The format comes from the index file (main evidence) and is cross-checked
+against ``hf_config.quantization_config`` and, when known, the vLLM
+``model_config.quantization`` (``mimo_fp8_mxfp4`` / None). Any contradiction is
+a ``ValueError`` listing the three values.
+
+In BF16 mode both formats give element-wise identical tensors: FP8 rows are
+dequantized in FP32 with the layout-aware scale row map from ``fp8_layout.py``
+(the same function the reference generator uses) and rounded to BF16; MXFP4
+experts go through ``fp8_layout.unpack_mxfp4``.
+
+``load_rank_state`` is a pure function: it needs no distributed initialization
+and reads only the tensors (rows / columns / experts) one rank needs.
+
+Per-rank state (keys without the ``model.`` prefix; H = hidden_size):
+
+=====================================================  ===========================  =====
+key                                                    shape                        dtype
+=====================================================  ===========================  =====
+``embed_tokens.weight``                                ``[V/tp, H]``                bf16
+``norm.weight``                                        ``[H]``                      bf16
+``lm_head.weight``                                     ``[V/tp, H]``                bf16
+``layers.{i}.input_layernorm.weight``                  ``[H]``                      bf16
+``layers.{i}.post_attention_layernorm.weight``         ``[H]``                      bf16
+``layers.{i}.self_attn.qkv_proj.weight``               ``[H, q + k + v]`` (in_out)  bf16
+``layers.{i}.self_attn.o_proj.weight``                 ``[q_heads_rank*d_v, H]``    bf16
+``layers.{i}.self_attn.attention_sink_bias`` (SWA)     ``[q_heads_rank]``           fp32
+``layers.{i}.mlp.{gate,up}_proj.weight`` (dense)       ``[H, I/tp]``                bf16
+``layers.{i}.mlp.down_proj.weight`` (dense)            ``[I/tp, H]``                bf16
+``layers.{i}.mlp.gate.weight`` (MoE router)            ``[E, H]``                   fp32
+``layers.{i}.mlp.gate.e_score_correction_bias``        ``[E]``                      fp32
+``layers.{i}.mlp.experts.gate_up_proj`` (MoE)          ``[E_local, H, 2*I_e]``      bf16
+``layers.{i}.mlp.experts.down_proj`` (MoE)             ``[E_local, I_e, H]``        bf16
+=====================================================  ===========================  =====
+
+``gate_up_proj`` is chunked ``[gate | up]`` on the last dim (reshape to
+``[E, H, 2, I]`` for the MoE kernels), as in ``gpt_oss/weight_loaders_bf16.py``.
+MTP layers and the vision / audio towers (T38, T40) are not part of this state;
+their keys are ignored here. ``load_mtp_rank_state`` (T36) loads one MTP layer
+(``model.mtp.layers.<n>.*``) with the same per-layer transforms.
+
+``precision="fp8"`` (original checkpoint only; T24, T25) replaces the qkv, dense MLP
+and routed-expert entries with FP8 serving weights (``fp8_linear.py``, ``moe.py``),
+everything else unchanged:
+
+=====================================================  ===========================  =====
+key                                                    shape                        dtype
+=====================================================  ===========================  =====
+``layers.{i}.self_attn.qkv_proj.weight``               ``[H, q + k + v]`` (in_out)  fp8
+``layers.{i}.self_attn.qkv_proj.weight_scale``         ``[H/128, q + k + v]``       fp32
+``layers.{i}.mlp.{gate,up}_proj.weight`` (dense)       ``[H, I/tp]``                fp8
+``layers.{i}.mlp.{gate,up}_proj.weight_scale``         ``[H/128, I/tp]``            fp32
+``layers.{i}.mlp.down_proj.weight`` (dense)            ``[I/tp, H]``                fp8
+``layers.{i}.mlp.down_proj.weight_scale``              ``[I/tp/128, H]``            fp32
+``layers.{i}.mlp.experts.gate_up_proj`` (MoE)          ``[E_local, H, 2*I_e]``      fp8
+``layers.{i}.mlp.experts.gate_up_proj_scale``          ``[E_local, 1, 2*I_e]``      fp32
+``layers.{i}.mlp.experts.down_proj`` (MoE)             ``[E_local, I_e, H]``        fp8
+``layers.{i}.mlp.experts.down_proj_scale``             ``[E_local, 1, H]``          fp32
+=====================================================  ===========================  =====
+
+Block layout: checkpoint codes x 0.5 (``fp8_layout.halve_fp8_e4m3fn``) with 2 x the
+per-row expanded block scale (one scale per output row and 128-wide input block).
+o_proj must be listed in ``quantization_config.ignored_layers`` and stays BF16.
+Experts (design 6.3, lossless): MXFP4 rows re-encoded as e4m3 codes ``|v| <= 192`` with
+one power-of-two scale per output channel (``fp8_layout.encode_expert_fp8_rows``);
+``codes * scale`` equals the MXFP4 dequantized value bit for bit. MoE layers listed in
+``bf16_expert_layers`` keep the BF16 expert entries of the table above.
+
+Sharding rules (design 3.3; compared item by item with gpt_oss):
+
+* Q heads: ``n_q / tp`` contiguous heads per rank.
+* KV heads: ``kv_per_rank = max(1, n_kv // tp)``; ``tp < n_kv`` contiguous
+  blocks, ``tp >= n_kv`` replicated with ``kv_head = rank // (tp // n_kv)``
+  (gpt_oss ``fused_qkv_weight_loader``: ``kv_rank = rank // num_kv_replicas``).
+  Applied per layer type (SWA 8 KV heads, global 4).
+* FP8 block scales are expanded to per-row ``[R, C/128]`` before cutting rows,
+  because 192 / 128-row heads do not align to 128-row blocks.
+* ``o_proj``: input columns of the rank's Q (= V) heads (gpt_oss
+  ``o_proj_weight_loader``), stored ``[in, H]``.
+* sink bias: the rank's Q heads, FP32 (gpt_oss ``sinks_sharding_loader``).
+* router weight and correction bias: replicated, FP32 (gpt_oss replicates the
+  router; FP32 per design S10 / D-010); BF16 with ``router_dtype="bfloat16"`` (T49,
+  vLLM GPU's ``moe_router_dtype``; the FP32-stored bias is rounded to BF16 once).
+* experts: linear placement, EP rank k owns ``[k*E/ep, (k+1)*E/ep)`` (gpt_oss
+  ``expert_parallel_tensor_dim_loader``). ``ep_size == 1``: every expert local,
+  expert intermediate sharded across ``tp`` (gpt_oss no-EP path).
+  ``ep_size > 1``: pure EP (one rank per EP partition, intermediate not sharded),
+  which is what every planned configuration uses (ep = world = 64, D-047);
+  ``1 < ep_size < tp`` (EP-TP sub-groups) is rejected.
+  With ``expert_placement`` (T53b, ``expert_placement.py``) rank k loads the experts of its
+  slots instead, layer by layer (a replica slot reads the same checkpoint tensors as the
+  primary, so it is bit-identical to it): the primaries under the expert keys above, the replica
+  slots under ``<key>_rep`` (``[S - E/ep, ...]``), plus the slot tables
+  ``layers.{i}.mlp.experts.slot_ids`` / ``slot_copies`` / ``slot_copy`` (int32 ``[S]``).
+* No ``div_(ep_degree)``: gpt_oss shards attention and dense layers across the
+  full TP group, the same group its collectives reduce over, so nothing is
+  replicated-and-summed; its only rescale is ``scaled_bias_loader(scale=
+  tp_degree)`` on the expert ``down_proj`` bias, and MiMo has no biases. The
+  autoport ``o_proj.div_(ep_degree)`` rule is for ports whose attention uses a
+  TP sub-group smaller than the collective group.
+"""
+
+import json
+import os
+
+import torch
+from safetensors import safe_open
+
+from vllm_neuron.model.mimo_v2 import fp8_layout as fl
+from vllm_neuron.model.mimo_v2.config import (
+    CHECKPOINT_BF16_REFERENCE,
+    CHECKPOINT_FP8_MXFP4,
+    MiMoV2NeuronConfig,
+)
+from vllm_neuron.model.mimo_v2.quant_config import MIMO_QUANT_METHOD
+from vllm_neuron.model.neuron_config import NeuronConfig
+
+INDEX_FILE = "model.safetensors.index.json"
+CONFIG_FILE = "config.json"
+
+QKV_LAYOUT_SHARDED = "B"  # original checkpoint: 4 tp shards [Q_s | K_s | V_s] (D-061)
+QKV_LAYOUT_CONTIGUOUS = "contiguous"  # reference checkpoint: [Q | K | V]
+QKV_SHARDS = fl.FP8_SHARDS
+
+PRECISION_VALUES = ("bf16", "fp8")
+FP8_LINEAR_LOAD_VALUES = ("block",)
+
+_UNSET = object()  # model_quantization not known (offline tools)
+
+# Index key prefixes that are not part of the text-backbone state.
+_NON_BACKBONE_PREFIXES = (
+    "model.mtp.",
+    "visual.",
+    "audio_encoder.",
+    "speech_embeddings.",
+)
+
+
+# ---------------------------------------------------------------- format
+
+def _read_json(path: str) -> dict:
+    with open(path) as f:
+        return json.load(f)
+
+
+def read_weight_map(checkpoint_dir: str) -> dict:
+    """``weight_map`` of ``model.safetensors.index.json`` (key -> shard file)."""
+    path = os.path.join(checkpoint_dir, INDEX_FILE)
+    if not os.path.isfile(path):
+        raise ValueError(f"MiMo-V2 checkpoint has no {INDEX_FILE}: {checkpoint_dir}")
+    return _read_json(path)["weight_map"]
+
+
+def _config_dict(checkpoint_dir: str, hf_config) -> dict:
+    if hf_config is None:
+        return _read_json(os.path.join(checkpoint_dir, CONFIG_FILE))
+    if isinstance(hf_config, dict):
+        return hf_config
+    return hf_config.to_dict()
+
+
+def detect_checkpoint_format(checkpoint_dir: str, *, hf_config=None,
+                             model_quantization=_UNSET) -> str:
+    """Return ``"fp8_mxfp4"`` or ``"bf16_reference"``; ``ValueError`` on contradiction.
+
+    Main evidence: ``*.weight_scale_inv`` keys in the index. Cross-checks:
+    ``hf_config`` (dict, ``PretrainedConfig`` or None -> ``config.json``) has a
+    ``quantization_config``; ``model_quantization`` (vLLM
+    ``model_config.quantization``) is ``"mimo_fp8_mxfp4"`` for the original
+    checkpoint and None for the reference. Leave ``model_quantization`` unset
+    when no vLLM model config exists (offline tools); the check is then skipped.
+    """
+    weight_map = read_weight_map(checkpoint_dir)
+    has_scale_inv = any(k.endswith(".weight_scale_inv") for k in weight_map)
+    cfg = _config_dict(checkpoint_dir, hf_config)
+    has_qc = bool(cfg.get("quantization_config"))
+    fmt = CHECKPOINT_FP8_MXFP4 if has_scale_inv else CHECKPOINT_BF16_REFERENCE
+
+    contradictions = []
+    if has_qc != has_scale_inv:
+        contradictions.append("hf_config.quantization_config")
+    if model_quantization is not _UNSET:
+        expected = MIMO_QUANT_METHOD if has_scale_inv else None
+        if model_quantization != expected:
+            contradictions.append("model_config.quantization")
+    if contradictions:
+        mq = "<not given>" if model_quantization is _UNSET else repr(model_quantization)
+        raise ValueError(
+            "MiMo-V2 checkpoint format is inconsistent "
+            f"({', '.join(contradictions)} disagree with the index): "
+            f"index has weight_scale_inv={has_scale_inv}, "
+            f"hf_config has quantization_config={has_qc}, "
+            f"model_config.quantization={mq}; checkpoint {checkpoint_dir}"
+        )
+    return fmt
+
+
+# ---------------------------------------------------------------- head / row maps
+
+def q_heads_for_rank(n_q: int, tp_size: int, tp_rank: int) -> list[int]:
+    """Contiguous ``n_q / tp`` Q heads of ``tp_rank``."""
+    if n_q % tp_size:
+        raise ValueError(f"num Q heads {n_q} is not divisible by tp_size={tp_size}")
+    per = n_q // tp_size
+    return list(range(tp_rank * per, (tp_rank + 1) * per))
+
+
+def kv_heads_for_rank(n_kv: int, tp_size: int, tp_rank: int) -> list[int]:
+    """KV heads of ``tp_rank``: ``max(1, n_kv // tp)`` heads, replicated when ``tp >= n_kv``."""
+    if tp_size < n_kv:
+        if n_kv % tp_size:
+            raise ValueError(f"num KV heads {n_kv} is not divisible by tp_size={tp_size}")
+        per = n_kv // tp_size
+        return list(range(tp_rank * per, (tp_rank + 1) * per))
+    if tp_size % n_kv:
+        raise ValueError(f"tp_size={tp_size} is not a multiple of num KV heads {n_kv}")
+    return [tp_rank // (tp_size // n_kv)]
+
+
+def qkv_head_rows(n_q: int, n_kv: int, d_qk: int, d_v: int, layout: str,
+                  shards: int = QKV_SHARDS):
+    """Checkpoint row offsets ``(q_start(h), k_start(g), v_start(g))`` as callables.
+
+    ``layout="B"`` (design 3.3 table): shard ``s`` has ``P`` rows,
+    ``[Q heads (n_q/shards) | K heads m | V heads m]`` with ``m = n_kv/shards``.
+    ``layout="contiguous"``: ``[Q_0.. | K_0.. | V_0..]``.
+    """
+    if layout == QKV_LAYOUT_CONTIGUOUS:
+        k0 = n_q * d_qk
+        v0 = k0 + n_kv * d_qk
+        return (lambda h: h * d_qk, lambda g: k0 + g * d_qk, lambda g: v0 + g * d_v)
+    if layout != QKV_LAYOUT_SHARDED:
+        raise ValueError(f"unknown qkv layout {layout!r}")
+    if n_q % shards or n_kv % shards:
+        raise ValueError(f"n_q={n_q} / n_kv={n_kv} not divisible by qkv shards={shards}")
+    qs, m = n_q // shards, n_kv // shards
+    P = qs * d_qk + m * (d_qk + d_v)
+    return (
+        lambda h: (h // qs) * P + (h % qs) * d_qk,
+        lambda g: (g // m) * P + qs * d_qk + (g % m) * d_qk,
+        lambda g: (g // m) * P + qs * d_qk + m * d_qk + (g % m) * d_v,
+    )
+
+
+def qkv_rank_rows(n_q: int, n_kv: int, d_qk: int, d_v: int, tp_size: int, tp_rank: int,
+                  layout: str, shards: int = QKV_SHARDS):
+    """Checkpoint rows ``(q_rows, k_rows, v_rows)`` (int64) of ``tp_rank`` for one qkv tensor."""
+    q_start, k_start, v_start = qkv_head_rows(n_q, n_kv, d_qk, d_v, layout, shards)
+
+    def rows(starts, width):
+        return torch.cat([torch.arange(s, s + width, dtype=torch.int64) for s in starts])
+
+    q_rows = rows([q_start(h) for h in q_heads_for_rank(n_q, tp_size, tp_rank)], d_qk)
+    kv = kv_heads_for_rank(n_kv, tp_size, tp_rank)
+    return q_rows, rows([k_start(g) for g in kv], d_qk), rows([v_start(g) for g in kv], d_v)
+
+
+# ---------------------------------------------------------------- tensor reads
+
+class _Reader:
+    """Lazy safetensors reader over the index (one handle per shard file)."""
+
+    def __init__(self, checkpoint_dir: str, weight_map: dict):
+        self.dir, self.weight_map, self.handles = checkpoint_dir, weight_map, {}
+
+    def has(self, key: str) -> bool:
+        return key in self.weight_map
+
+    def _handle(self, key: str):
+        if key not in self.weight_map:
+            raise KeyError(f"MiMo-V2 checkpoint is missing tensor {key!r} ({self.dir})")
+        f = self.weight_map[key]
+        if f not in self.handles:
+            self.handles[f] = safe_open(os.path.join(self.dir, f), "pt")
+        return self.handles[f]
+
+    def get(self, key: str) -> torch.Tensor:
+        return self._handle(key).get_tensor(key)
+
+    def shape(self, key: str) -> list[int]:
+        return list(self._handle(key).get_slice(key).get_shape())
+
+    def rows(self, key: str, start: int, end: int) -> torch.Tensor:
+        return self._handle(key).get_slice(key)[start:end]
+
+    def cols(self, key: str, start: int, end: int) -> torch.Tensor:
+        return self._handle(key).get_slice(key)[:, start:end]
+
+
+def _expect_shape(key: str, tensor: torch.Tensor, shape) -> None:
+    if list(tensor.shape) != list(shape):
+        raise ValueError(
+            f"MiMo-V2 tensor {key!r} has shape {list(tensor.shape)}, expected {list(shape)}")
+
+
+def _expect_dtype(key: str, tensor: torch.Tensor, dtype: torch.dtype) -> None:
+    if tensor.dtype != dtype:
+        raise ValueError(f"MiMo-V2 tensor {key!r} has dtype {tensor.dtype}, expected {dtype}")
+
+
+def _linear_bf16(rd: _Reader, key: str, shape, *, rows: torch.Tensor | None = None,
+                 cols: tuple[int, int] | None = None) -> torch.Tensor:
+    """BF16 ``weight[rows][:, cols]`` of a linear layer, dequantizing block FP8 if present.
+
+    FP8: the block scale is expanded per row (``fp8_layout.expand_fp8_scale_rows``)
+    and the selected rows / columns are dequantized in FP32 (``w * s``), the same
+    element-wise product ``fp8_layout.dequant_fp8_block`` computes for the whole
+    tensor, then rounded to BF16. The 448-hit partition check runs on the whole
+    tensor (``ValueError`` below 99%).
+    """
+    scale_key = key + "_scale_inv"
+    if rd.has(scale_key):
+        w, s = rd.get(key), rd.get(scale_key)
+        _expect_shape(key, w, shape)
+        _expect_dtype(key, w, torch.float8_e4m3fn)
+        fl.check_fp8_block_hit(key, w, s)
+        R, C = w.shape
+        s_row = fl.expand_fp8_scale_rows(s, R, C)
+        cmap = fl.fp8_block_col_map(C, s_row.shape[1])
+        if rows is not None:
+            w, s_row = w.index_select(0, rows), s_row.index_select(0, rows)
+        if cols is not None:
+            w, cmap = w[:, cols[0]:cols[1]], cmap[cols[0]:cols[1]]
+        return (w.to(torch.float32) * s_row.index_select(1, cmap)).to(torch.bfloat16)
+
+    if cols is not None and rows is None:
+        if rd.shape(key) != list(shape):
+            raise ValueError(
+                f"MiMo-V2 tensor {key!r} has shape {rd.shape(key)}, expected {list(shape)}")
+        w = rd.cols(key, cols[0], cols[1])
+    else:
+        w = rd.get(key)
+        _expect_shape(key, w, shape)
+        if rows is not None:
+            w = w.index_select(0, rows)
+        if cols is not None:
+            w = w[:, cols[0]:cols[1]]
+    _expect_dtype(key, w, torch.bfloat16)
+    return w
+
+
+def _linear_fp8(rd: _Reader, key: str, shape, *, rows: torch.Tensor | None = None,
+                cols: tuple[int, int] | None = None, fp8_linear: str = "block"):
+    """FP8 serving weight ``(codes [in, out] float8_e4m3fn, scale FP32)`` of a block-FP8 linear.
+
+    The selected rows / columns of the checkpoint ``[out, in]`` tensor, transposed to
+    in_out: codes x 0.5 (``fp8_layout.halve_fp8_e4m3fn``), scale ``[in/128, out]`` =
+    2 x the per-row expanded block scale (``fp8_linear="block"``, the only layout).
+    Column cuts must be whole 128-column blocks. The 448-hit partition check runs on
+    the whole tensor (``ValueError`` below 99%).
+    """
+    scale_key = key + "_scale_inv"
+    if not rd.has(scale_key):
+        raise ValueError(f"MiMo-V2 tensor {key!r} has no weight_scale_inv; precision='fp8' "
+                         "expects a block-FP8 linear layer here")
+    w, s = rd.get(key), rd.get(scale_key)
+    _expect_shape(key, w, shape)
+    _expect_dtype(key, w, torch.float8_e4m3fn)
+    fl.check_fp8_block_hit(key, w, s)
+    R, C = w.shape
+    s_row = fl.expand_fp8_scale_rows(s, R, C)
+    if rows is not None:
+        w, s_row = w.index_select(0, rows), s_row.index_select(0, rows)
+    if cols is not None:
+        a, b = cols
+        if a % fl.FP8_BLOCK or (b % fl.FP8_BLOCK and b != C):
+            raise ValueError(f"MiMo-V2 tensor {key!r}: FP8 column cut [{a}, {b}) is not "
+                             f"aligned to {fl.FP8_BLOCK}-column scale blocks")
+        w = w[:, a:b]
+        s_row = s_row[:, a // fl.FP8_BLOCK:-(-b // fl.FP8_BLOCK)]
+    codes = fl.halve_fp8_e4m3fn(w)
+    return codes.T.contiguous(), (s_row * 2.0).T.contiguous()
+
+
+def _check_e8m0(name: str, scales: torch.Tensor) -> None:
+    n255 = int((scales == 255).sum())
+    if n255:
+        raise ValueError(f"MiMo-V2 expert {name}: {n255} E8M0 scales == 255 (NaN encoding)")
+
+
+def decode_expert_mxfp4(name: str, blocks: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+    """MXFP4 expert ``[out, in/2]`` + E8M0 ``[out, in/32]`` -> BF16 ``[out, in]``.
+
+    E8M0 == 255 (the NaN encoding) and non-finite results are ``ValueError``.
+    """
+    _check_e8m0(name, scales)
+    w = fl.unpack_mxfp4(blocks, scales, torch.bfloat16)
+    bad = int((~torch.isfinite(w)).sum())
+    if bad:
+        raise ValueError(f"MiMo-V2 expert {name}: {bad} non-finite values after MXFP4 decode")
+    return w
+
+
+def encode_expert_fp8(name: str, blocks: torch.Tensor, scales: torch.Tensor,
+                      max_span: int | None = None) -> fl.ExpertFp8Rows:
+    """Lossless MXFP4 -> FP8 row encoding (``fp8_layout.encode_expert_fp8_rows``) with checks.
+
+    E8M0 == 255 is a ``ValueError``. When not falling back, the FP8 weight must be
+    finite (no NaN) with ``max|w_fp8| <= 192`` and the row scale finite, else
+    ``ValueError``. Self-check (design 6.3): one row of the tensor (the row with the
+    largest in-row span, the first on ties) is rebuilt as ``w_fp8.float() * s_row``
+    and compared bit-exactly with ``fp8_layout.unpack_mxfp4``; a mismatch is a
+    ``RuntimeError``.
+    """
+    _check_e8m0(name, scales)
+    enc = fl.encode_expert_fp8_rows(blocks, scales, max_span)
+    if enc.fallback:
+        return enc
+    wf = enc.weight.to(torch.float32)
+    bad = int((~torch.isfinite(wf)).sum())
+    if bad:
+        raise ValueError(f"MiMo-V2 expert {name}: {bad} non-finite FP8 values")
+    wmax = float(wf.abs().max()) if wf.numel() else 0.0
+    if wmax > fl.EXPERT_FP8_MAX:
+        raise ValueError(
+            f"MiMo-V2 expert {name}: max|w_fp8|={wmax} > {fl.EXPERT_FP8_MAX}")
+    if not bool(torch.isfinite(enc.row_scale).all()):
+        raise ValueError(f"MiMo-V2 expert {name}: non-finite FP8 row scale")
+    if blocks.dim() == 2 and blocks.shape[0]:
+        _, span = fl.expert_row_exponent_span(blocks, scales)
+        r = int(torch.argmax(span))
+        got = wf[r] * enc.row_scale[r]
+        ref = fl.unpack_mxfp4(blocks[r:r + 1], scales[r:r + 1], torch.float32)[0]
+        if not torch.equal(got, ref):
+            raise RuntimeError(
+                f"MiMo-V2 expert {name}: FP8 row self-check failed on row {r} "
+                f"({int((got != ref).sum())} elements differ from the MXFP4 dequantized values)")
+    return enc
+
+
+def _expert_bf16(rd: _Reader, key: str, shape) -> torch.Tensor:
+    scale_key = key + "_scale"
+    if rd.has(scale_key):
+        blocks, scales = rd.get(key), rd.get(scale_key)
+        _expect_dtype(key, blocks, torch.uint8)
+        _expect_shape(key, blocks, [shape[0], shape[1] // 2])
+        w = decode_expert_mxfp4(key, blocks, scales)
+    else:
+        w = rd.get(key)
+        _expect_dtype(key, w, torch.bfloat16)
+    _expect_shape(key, w, shape)
+    return w
+
+
+def _expert_fp8(rd: _Reader, key: str, shape):
+    """FP8 row encoding ``(w_fp8 [out, in] float8_e4m3fn, row_scale [out] FP32)`` of an
+    MXFP4 expert, or ``None`` when some row needs the BF16 fallback (``encode_expert_fp8``)."""
+    scale_key = key + "_scale"
+    if not rd.has(scale_key):
+        raise ValueError(f"MiMo-V2 expert {key!r} has no MXFP4 weight_scale; precision='fp8' "
+                         "expects the original MXFP4 experts")
+    blocks, scales = rd.get(key), rd.get(scale_key)
+    _expect_dtype(key, blocks, torch.uint8)
+    _expect_shape(key, blocks, [shape[0], shape[1] // 2])
+    enc = encode_expert_fp8(key, blocks, scales)
+    if enc.fallback:
+        return None
+    _expect_shape(key, enc.weight, shape)
+    return enc.weight, enc.row_scale.squeeze(-1)
+
+
+# ---------------------------------------------------------------- key coverage
+
+def _backbone_keys(cfg: MiMoV2NeuronConfig, fmt: str) -> set:
+    """Every text-backbone index key the given format must contain (all experts)."""
+    keys = {"model.embed_tokens.weight", "model.norm.weight", "lm_head.weight"}
+    fp8 = fmt == CHECKPOINT_FP8_MXFP4
+    for i in range(cfg.num_hidden_layers):
+        p = f"model.layers.{i}."
+        keys |= {p + "input_layernorm.weight", p + "post_attention_layernorm.weight",
+                 p + "self_attn.qkv_proj.weight", p + "self_attn.o_proj.weight"}
+        if fp8:
+            keys.add(p + "self_attn.qkv_proj.weight_scale_inv")
+        if cfg.is_swa_layer(i) and cfg.add_swa_attention_sink_bias or \
+                not cfg.is_swa_layer(i) and cfg.add_full_attention_sink_bias:
+            keys.add(p + "self_attn.attention_sink_bias")
+        if cfg.is_moe_layer(i):
+            keys |= {p + "mlp.gate.weight", p + "mlp.gate.e_score_correction_bias"}
+            for e in range(cfg.n_routed_experts):
+                for proj in ("gate_proj", "up_proj", "down_proj"):
+                    k = f"{p}mlp.experts.{e}.{proj}.weight"
+                    keys.add(k)
+                    if fp8:
+                        keys.add(k + "_scale")
+        else:
+            for proj in ("gate_proj", "up_proj", "down_proj"):
+                k = f"{p}mlp.{proj}.weight"
+                keys.add(k)
+                if fp8:
+                    keys.add(k + "_scale_inv")
+    return keys
+
+
+def _check_key_coverage(weight_map: dict, cfg: MiMoV2NeuronConfig, fmt: str) -> None:
+    expected = _backbone_keys(cfg, fmt)
+    present = {k for k in weight_map if not k.startswith(_NON_BACKBONE_PREFIXES)}
+    missing = sorted(expected - present)
+    if missing:
+        raise KeyError(f"MiMo-V2 checkpoint ({fmt}) is missing {len(missing)} tensors, "
+                       f"e.g. {missing[:5]}")
+    extra = sorted(present - expected)
+    if extra:
+        raise ValueError(f"MiMo-V2 checkpoint ({fmt}) has {len(extra)} unmapped text tensors, "
+                         f"e.g. {extra[:5]}")
+
+
+# ---------------------------------------------------------------- per-rank state
+
+def _attn_dims(cfg: MiMoV2NeuronConfig, layer_idx: int, is_swa: bool | None = None):
+    if cfg.is_swa_layer(layer_idx) if is_swa is None else is_swa:
+        return (cfg.swa_num_attention_heads, cfg.swa_num_key_value_heads,
+                cfg.swa_head_dim, cfg.swa_v_head_dim)
+    return cfg.num_attention_heads, cfg.num_key_value_heads, cfg.head_dim, cfg.v_head_dim
+
+
+def _load_attention(rd: _Reader, cfg: MiMoV2NeuronConfig, i: int, layout: str,
+                    tp_size: int, tp_rank: int, out: dict, precision: str = "bf16",
+                    fp8_linear: str = "block", *, layer_prefix: str | None = None,
+                    is_swa: bool | None = None) -> None:
+    """Attention of decoder layer ``i``, or of ``model.<layer_prefix>`` (keys
+    ``<layer_prefix>.self_attn.*``) when ``layer_prefix`` is given; ``is_swa`` overrides
+    the layer type (the MTP layer is an SWA layer, design S14)."""
+    H = cfg.hidden_size
+    n_q, n_kv, d_qk, d_v = _attn_dims(cfg, i, is_swa)
+    p = f"layers.{i}" if layer_prefix is None else layer_prefix
+    src, dst = f"model.{p}.self_attn.", f"{p}.self_attn."
+    R = n_q * d_qk + n_kv * (d_qk + d_v)
+    q_rows, k_rows, v_rows = qkv_rank_rows(n_q, n_kv, d_qk, d_v, tp_size, tp_rank, layout)
+    qkv_rows = torch.cat([q_rows, k_rows, v_rows])
+    if precision == "fp8":
+        codes, scale = _linear_fp8(rd, src + "qkv_proj.weight", [R, H], rows=qkv_rows,
+                                   fp8_linear=fp8_linear)
+        out[dst + "qkv_proj.weight"] = codes
+        out[dst + "qkv_proj.weight_scale"] = scale
+    else:
+        qkv = _linear_bf16(rd, src + "qkv_proj.weight", [R, H], rows=qkv_rows)
+        out[dst + "qkv_proj.weight"] = qkv.T.contiguous()
+
+    heads = q_heads_for_rank(n_q, tp_size, tp_rank)
+    o_cols = (heads[0] * d_v, (heads[-1] + 1) * d_v)
+    o_key = src + "o_proj.weight"
+    if rd.has(o_key + "_scale_inv"):
+        raise ValueError(f"{o_key} must stay BF16 (quantization_config.ignored_layers)")
+    out[dst + "o_proj.weight"] = _linear_bf16(rd, o_key, [H, n_q * d_v], cols=o_cols).T.contiguous()
+
+    sink_key = src + "attention_sink_bias"
+    if rd.has(sink_key):
+        sink = rd.get(sink_key)
+        _expect_shape(sink_key, sink, [n_q])
+        out[dst + "attention_sink_bias"] = sink[heads[0]:heads[-1] + 1].to(torch.float32)
+
+
+def _load_dense_mlp(rd: _Reader, cfg: MiMoV2NeuronConfig, i: int, tp_size: int,
+                    tp_rank: int, out: dict, precision: str = "bf16", *,
+                    layer_prefix: str | None = None) -> None:
+    """Dense MLP of decoder layer ``i``, or of ``model.<layer_prefix>`` (see
+    ``_load_attention``)."""
+    H, I = cfg.hidden_size, cfg.intermediate_size
+    if I % tp_size:
+        raise ValueError(f"intermediate_size {I} is not divisible by tp_size={tp_size}")
+    per = I // tp_size
+    a, b = tp_rank * per, (tp_rank + 1) * per
+    rows = torch.arange(a, b, dtype=torch.int64)
+    p = f"layers.{i}" if layer_prefix is None else layer_prefix
+    src, dst = f"model.{p}.mlp.", f"{p}.mlp."
+    if precision == "fp8":
+        for proj in ("gate_proj", "up_proj"):
+            codes, scale = _linear_fp8(rd, src + proj + ".weight", [I, H], rows=rows)
+            out[dst + proj + ".weight"], out[dst + proj + ".weight_scale"] = codes, scale
+        codes, scale = _linear_fp8(rd, src + "down_proj.weight", [H, I], cols=(a, b))
+        out[dst + "down_proj.weight"], out[dst + "down_proj.weight_scale"] = codes, scale
+        return
+    for proj in ("gate_proj", "up_proj"):
+        w = _linear_bf16(rd, src + proj + ".weight", [I, H], rows=rows)
+        out[dst + proj + ".weight"] = w.T.contiguous()
+    w = _linear_bf16(rd, src + "down_proj.weight", [H, I], cols=(a, b))
+    out[dst + "down_proj.weight"] = w.T.contiguous()
+
+
+def _load_moe(rd: _Reader, cfg: MiMoV2NeuronConfig, i: int, experts: range,
+              moe_tp: int, moe_rank: int, out: dict, precision: str = "bf16",
+              bf16_expert_layers=(), router_dtype: torch.dtype = torch.float32) -> None:
+    H, I, E = cfg.hidden_size, cfg.moe_intermediate_size, cfg.n_routed_experts
+    src, dst = f"model.layers.{i}.mlp.", f"layers.{i}.mlp."
+    gw = rd.get(src + "gate.weight")
+    _expect_shape(src + "gate.weight", gw, [E, H])
+    out[dst + "gate.weight"] = gw.to(router_dtype)
+    gb = rd.get(src + "gate.e_score_correction_bias")
+    _expect_shape(src + "gate.e_score_correction_bias", gb, [E])
+    # BF16: the stored FP32 bias rounded once, as vLLM GPU copies it into its BF16 parameter
+    out[dst + "gate.e_score_correction_bias"] = gb.to(router_dtype)
+
+    per = I // moe_tp
+    a, b = moe_rank * per, (moe_rank + 1) * per
+    if precision == "fp8" and i not in bf16_expert_layers:
+        _load_moe_experts_fp8(rd, src, dst, i, experts, H, I, a, b, out)
+        return
+    gate_up, down = [], []
+    for e in experts:
+        p = f"{src}experts.{e}."
+        g = _expert_bf16(rd, p + "gate_proj.weight", [I, H])[a:b]
+        u = _expert_bf16(rd, p + "up_proj.weight", [I, H])[a:b]
+        d = _expert_bf16(rd, p + "down_proj.weight", [H, I])[:, a:b]
+        gate_up.append(torch.cat([g.T, u.T], dim=1))
+        down.append(d.T)
+    out[dst + "experts.gate_up_proj"] = torch.stack(gate_up).contiguous()
+    out[dst + "experts.down_proj"] = torch.stack(down).contiguous()
+
+
+def _load_moe_experts_fp8(rd: _Reader, src: str, dst: str, i: int, experts: range, H: int,
+                          I: int, a: int, b: int, out: dict) -> None:
+    """FP8 experts (design 6.3): ``gate_up_proj`` ``[E_l, H, 2*I_rank]`` / ``down_proj``
+    ``[E_l, I_rank, H]`` float8_e4m3fn codes plus per-output-channel power-of-two scales
+    ``gate_up_proj_scale [E_l, 1, 2*I_rank]`` (gate | up) / ``down_proj_scale [E_l, 1, H]``.
+
+    A local expert row that cannot be encoded exactly is a ``ValueError`` naming the
+    layer: the expert precision is part of the compiled graph and must be the same on
+    every rank, so a BF16 fallback layer has to be listed in
+    ``neuron_config.mimo_bf16_expert_layers``.
+    """
+    gate_up, gate_up_scale, down, down_scale = [], [], [], []
+    for e in experts:
+        p = f"{src}experts.{e}."
+        enc = {proj: _expert_fp8(rd, p + proj + ".weight", shape)
+               for proj, shape in (("gate_proj", [I, H]), ("up_proj", [I, H]),
+                                   ("down_proj", [H, I]))}
+        failed = [proj for proj, v in enc.items() if v is None]
+        if failed:
+            raise ValueError(
+                f"MiMo-V2 layer {i} expert {e} {failed}: some rows cannot be encoded as FP8 "
+                "exactly (a nonzero value below the e4m3 normal range); add layer "
+                f"{i} to neuron_config.mimo_bf16_expert_layers to run its experts in BF16")
+        (g, gs), (u, us), (d, ds) = enc["gate_proj"], enc["up_proj"], enc["down_proj"]
+        gate_up.append(torch.cat([g[a:b].T, u[a:b].T], dim=1))
+        gate_up_scale.append(torch.cat([gs[a:b], us[a:b]]).unsqueeze(0))
+        down.append(d[:, a:b].T)
+        down_scale.append(ds.unsqueeze(0))
+    out[dst + "experts.gate_up_proj"] = torch.stack(gate_up).contiguous()
+    out[dst + "experts.gate_up_proj_scale"] = torch.stack(gate_up_scale).contiguous()
+    out[dst + "experts.down_proj"] = torch.stack(down).contiguous()
+    out[dst + "experts.down_proj_scale"] = torch.stack(down_scale).contiguous()
+
+
+def _check_fp8_ignored_layers(cfg: MiMoV2NeuronConfig) -> None:
+    """FP8 serving: every text o_proj is in ``ignored_layers``, no FP8-path layer is."""
+    ignored = set(cfg.ignored_layers)
+    for i in range(cfg.num_hidden_layers):
+        p = f"model.layers.{i}."
+        if p + "self_attn.o_proj" not in ignored:
+            raise ValueError(f"{p}self_attn.o_proj is not in quantization_config.ignored_layers; "
+                             "MiMo-V2 FP8 serving keeps every o_proj in BF16")
+        fp8_path = [p + "self_attn.qkv_proj"]
+        if not cfg.is_moe_layer(i):
+            fp8_path += [p + f"mlp.{proj}" for proj in ("gate_proj", "up_proj", "down_proj")]
+        listed = [n for n in fp8_path if n in ignored]
+        if listed:
+            raise ValueError(f"{listed} are in quantization_config.ignored_layers but are FP8 "
+                             "linear layers in this checkpoint")
+
+
+def load_rank_state(checkpoint_dir: str, *, tp_size: int, tp_rank: int, ep_size: int,
+                    ep_rank: int, precision: str, model_quantization=_UNSET,
+                    fp8_linear: str = "block",
+                    bf16_expert_layers=(),
+                    router_dtype: str = "float32",
+                    expert_placement=None) -> dict[str, torch.Tensor]:
+    """Text-backbone parameters of one rank (see the module docstring for keys / shapes).
+
+    Pure function: no distributed state, reads only what the rank needs.
+    ``precision`` is the device precision (``neuron_config.quantization``):
+    ``"bf16"`` works on both checkpoint formats and gives element-wise identical
+    results; ``"fp8"`` needs the original checkpoint (``ValueError`` on the
+    reference): qkv and the dense MLP become FP8 serving weights (``_linear_fp8``,
+    layout by ``fp8_linear`` = ``neuron_config.mimo_fp8_linear``, only ``"block"``),
+    routed experts become FP8 row-encoded codes + scales (``_load_moe_experts_fp8``)
+    except in ``bf16_expert_layers`` (``neuron_config.mimo_bf16_expert_layers``, MoE
+    layer indices, BF16 fallback); everything else is as in BF16 mode.
+    ``router_dtype``: MoE router weight and correction bias dtype (``"float32"`` or
+    ``"bfloat16"``, ``MiMoV2NeuronConfig.mimo_router_dtype``).
+    ``model_quantization``: vLLM ``model_config.quantization`` for the format
+    cross-check (omit offline).
+    ``expert_placement``: ``expert_placement.ExpertPlacement`` (static EP placement, T53b;
+    ``neuron_config.mimo_expert_placement``) or None for the linear placement.
+    """
+    if precision not in PRECISION_VALUES:
+        raise ValueError(f"precision must be one of {PRECISION_VALUES}, got {precision!r}")
+    if router_dtype not in ("float32", "bfloat16"):
+        raise ValueError(f"router_dtype must be 'float32' or 'bfloat16', got {router_dtype!r}")
+    if precision == "fp8" and fp8_linear not in FP8_LINEAR_LOAD_VALUES:
+        raise NotImplementedError(
+            f"fp8_linear={fp8_linear!r} has no weight layout (implemented: "
+            f"{FP8_LINEAR_LOAD_VALUES})")
+    for name, size, rank in (("tp", tp_size, tp_rank), ("ep", ep_size, ep_rank)):
+        if not (isinstance(size, int) and isinstance(rank, int) and size >= 1
+                and 0 <= rank < size):
+            raise ValueError(f"invalid {name}_size={size!r} / {name}_rank={rank!r}")
+    if 1 < ep_size < tp_size:
+        raise ValueError(
+            f"ep_size={ep_size} < tp_size={tp_size} (EP-TP sub-groups) is not supported; "
+            "use ep_size=1 or pure EP (ep_size >= tp_size)")
+
+    fmt = detect_checkpoint_format(checkpoint_dir, model_quantization=model_quantization)
+    if fmt == CHECKPOINT_BF16_REFERENCE and precision == "fp8":
+        raise ValueError(
+            "precision='fp8' needs the original FP8/MXFP4 checkpoint; "
+            f"{checkpoint_dir} is the BF16 reference format")
+    cfg = MiMoV2NeuronConfig.from_configs(
+        os.path.join(checkpoint_dir, CONFIG_FILE), NeuronConfig(quantization=precision))
+    if cfg.checkpoint_format != fmt:
+        raise ValueError(f"config.json format {cfg.checkpoint_format} != index format {fmt}")
+    if precision == "fp8":
+        _check_fp8_ignored_layers(cfg)
+    bf16_expert_layers = tuple(bf16_expert_layers)
+    not_moe = [i for i in bf16_expert_layers
+               if not (isinstance(i, int) and 0 <= i < cfg.num_hidden_layers
+                       and cfg.is_moe_layer(i))]
+    if not_moe:
+        raise ValueError(f"bf16_expert_layers {not_moe} are not MoE layer indices")
+
+    E = cfg.n_routed_experts
+    if E % ep_size:
+        raise ValueError(f"n_routed_experts {E} is not divisible by ep_size={ep_size}")
+    n_local = E // ep_size
+    experts = range(ep_rank * n_local, (ep_rank + 1) * n_local)
+    if expert_placement is not None and (expert_placement.ep_size != ep_size
+                                         or expert_placement.n_experts != E):
+        raise ValueError(f"expert placement {expert_placement.path} is for ep_size "
+                         f"{expert_placement.ep_size} / {expert_placement.n_experts} experts, "
+                         f"loading ep_size {ep_size} / {E} experts")
+    moe_tp, moe_rank = (tp_size, tp_rank) if ep_size == 1 else (1, 0)
+    if cfg.moe_intermediate_size % moe_tp:
+        raise ValueError(f"moe_intermediate_size {cfg.moe_intermediate_size} is not "
+                         f"divisible by tp_size={moe_tp}")
+    V, H = cfg.vocab_size, cfg.hidden_size
+    if V % tp_size:
+        raise ValueError(f"vocab_size {V} is not divisible by tp_size={tp_size}")
+
+    weight_map = read_weight_map(checkpoint_dir)
+    _check_key_coverage(weight_map, cfg, fmt)
+    layout = QKV_LAYOUT_SHARDED if fmt == CHECKPOINT_FP8_MXFP4 else QKV_LAYOUT_CONTIGUOUS
+    rd = _Reader(checkpoint_dir, weight_map)
+    out: dict[str, torch.Tensor] = {}
+
+    vpr = V // tp_size
+    for src, dst in (("model.embed_tokens.weight", "embed_tokens.weight"),
+                     ("lm_head.weight", "lm_head.weight")):
+        if rd.shape(src) != [V, H]:
+            raise ValueError(f"MiMo-V2 tensor {src!r} has shape {rd.shape(src)}, "
+                             f"expected {[V, H]}")
+        t = rd.rows(src, tp_rank * vpr, (tp_rank + 1) * vpr)
+        _expect_dtype(src, t, torch.bfloat16)
+        out[dst] = t
+    norm = rd.get("model.norm.weight")
+    _expect_shape("model.norm.weight", norm, [H])
+    out["norm.weight"] = norm
+
+    for i in range(cfg.num_hidden_layers):
+        for nm in ("input_layernorm", "post_attention_layernorm"):
+            t = rd.get(f"model.layers.{i}.{nm}.weight")
+            _expect_shape(f"model.layers.{i}.{nm}.weight", t, [H])
+            out[f"layers.{i}.{nm}.weight"] = t
+        _load_attention(rd, cfg, i, layout, tp_size, tp_rank, out, precision, fp8_linear)
+        if cfg.is_moe_layer(i):
+            layer_experts = experts
+            if expert_placement is not None:
+                slots = expert_placement.rank_slots(i, ep_rank)
+                layer_experts = slots.experts
+                for name, v in (("slot_ids", slots.experts), ("slot_copies", slots.copies),
+                                ("slot_copy", slots.copy)):
+                    out[f"layers.{i}.mlp.experts.{name}"] = torch.tensor(v, dtype=torch.int32)
+            _load_moe(rd, cfg, i, layer_experts, moe_tp, moe_rank, out, precision,
+                      bf16_expert_layers, getattr(torch, router_dtype))
+            if expert_placement is not None and len(layer_experts) > n_local:
+                for name in ("gate_up_proj", "down_proj", "gate_up_proj_scale", "down_proj_scale"):
+                    k = f"layers.{i}.mlp.experts.{name}"
+                    if k in out:
+                        t = out[k]
+                        out[k], out[k + "_rep"] = t[:n_local].contiguous(), t[n_local:].contiguous()
+        else:
+            _load_dense_mlp(rd, cfg, i, tp_size, tp_rank, out, precision)
+    return out
+
+
+# ---------------------------------------------------------------- MTP layer (T36)
+
+MTP_NORMS = ("enorm", "hnorm", "input_layernorm", "pre_mlp_layernorm", "final_layernorm")
+
+
+def _mtp_keys(cfg: MiMoV2NeuronConfig, fmt: str, prefix: str) -> set:
+    """Every index key of one MTP layer (``prefix`` = ``model.mtp.layers.<n>.``)."""
+    fp8 = fmt == CHECKPOINT_FP8_MXFP4
+    keys = {prefix + nm + ".weight" for nm in MTP_NORMS}
+    keys |= {prefix + "eh_proj.weight", prefix + "self_attn.qkv_proj.weight",
+             prefix + "self_attn.o_proj.weight"}
+    if cfg.add_swa_attention_sink_bias:
+        keys.add(prefix + "self_attn.attention_sink_bias")
+    if fp8:
+        keys.add(prefix + "self_attn.qkv_proj.weight_scale_inv")
+    for proj in ("gate_proj", "up_proj", "down_proj"):
+        keys.add(f"{prefix}mlp.{proj}.weight")
+        if fp8:
+            keys.add(f"{prefix}mlp.{proj}.weight_scale_inv")
+    return keys
+
+
+def load_mtp_rank_state(checkpoint_dir: str, *, tp_size: int, tp_rank: int, precision: str,
+                        mtp_layer: int = 0, model_quantization=_UNSET,
+                        fp8_linear: str = "block") -> dict[str, torch.Tensor]:
+    """Parameters of MTP layer ``mtp_layer`` (``model.mtp.layers.<n>.*``) for one rank.
+
+    Design 8.2 / S14 (T36). Pure function like ``load_rank_state``. Keys carry the
+    prefix ``mtp.layers.<n>.``:
+
+    * ``enorm`` / ``hnorm`` / ``input_layernorm`` / ``pre_mlp_layernorm`` /
+      ``final_layernorm`` ``.weight`` ``[H]`` BF16;
+    * ``eh_proj.weight`` ``[2H, H]`` BF16 in_out, replicated on every rank (vLLM GPU
+      ``ReplicatedLinear``; BF16 in the checkpoint, kept BF16 in FP8 serving);
+    * ``self_attn.*`` as an SWA decoder layer (``_load_attention``: fused qkv by the
+      layout B / contiguous row table of design 3.3, FP8 per ``precision``; o_proj BF16;
+      sink bias of the rank's Q heads);
+    * ``mlp.*`` as the dense MLP (``_load_dense_mlp``, FP8 per ``precision``).
+
+    Embedding and lm_head are the target model's (shared, not loaded here).
+    """
+    if precision not in PRECISION_VALUES:
+        raise ValueError(f"precision must be one of {PRECISION_VALUES}, got {precision!r}")
+    if precision == "fp8" and fp8_linear not in FP8_LINEAR_LOAD_VALUES:
+        raise NotImplementedError(
+            f"fp8_linear={fp8_linear!r} has no weight layout (implemented: "
+            f"{FP8_LINEAR_LOAD_VALUES})")
+    if not (isinstance(tp_size, int) and isinstance(tp_rank, int) and tp_size >= 1
+            and 0 <= tp_rank < tp_size):
+        raise ValueError(f"invalid tp_size={tp_size!r} / tp_rank={tp_rank!r}")
+    fmt = detect_checkpoint_format(checkpoint_dir, model_quantization=model_quantization)
+    if fmt == CHECKPOINT_BF16_REFERENCE and precision == "fp8":
+        raise ValueError(
+            "precision='fp8' needs the original FP8/MXFP4 checkpoint; "
+            f"{checkpoint_dir} is the BF16 reference format")
+    cfg = MiMoV2NeuronConfig.from_configs(
+        os.path.join(checkpoint_dir, CONFIG_FILE), NeuronConfig(quantization=precision))
+    n_mtp = cfg.num_nextn_predict_layers
+    if not (type(mtp_layer) is int and 0 <= mtp_layer < n_mtp):
+        raise ValueError(f"mtp_layer={mtp_layer!r} not in [0, {n_mtp}) "
+                         "(config num_nextn_predict_layers)")
+
+    weight_map = read_weight_map(checkpoint_dir)
+    prefix = f"model.mtp.layers.{mtp_layer}."
+    expected = _mtp_keys(cfg, fmt, prefix)
+    present = {k for k in weight_map if k.startswith(prefix)}
+    missing = sorted(expected - present)
+    if missing:
+        raise KeyError(f"MiMo-V2 checkpoint ({fmt}) is missing {len(missing)} MTP tensors, "
+                       f"e.g. {missing[:5]}")
+    extra = sorted(present - expected)
+    if extra:
+        raise ValueError(f"MiMo-V2 checkpoint ({fmt}) has {len(extra)} unmapped MTP tensors, "
+                         f"e.g. {extra[:5]}")
+    layout = QKV_LAYOUT_SHARDED if fmt == CHECKPOINT_FP8_MXFP4 else QKV_LAYOUT_CONTIGUOUS
+    rd = _Reader(checkpoint_dir, weight_map)
+    H = cfg.hidden_size
+    dst = f"mtp.layers.{mtp_layer}"
+    out: dict[str, torch.Tensor] = {}
+    for nm in MTP_NORMS:
+        t = rd.get(f"{prefix}{nm}.weight")
+        _expect_shape(f"{prefix}{nm}.weight", t, [H])
+        _expect_dtype(f"{prefix}{nm}.weight", t, torch.bfloat16)
+        out[f"{dst}.{nm}.weight"] = t
+    eh_key = prefix + "eh_proj.weight"
+    if rd.has(eh_key + "_scale_inv"):
+        raise ValueError(f"{eh_key} must be BF16 (design 6.2: eh_proj stays BF16)")
+    out[f"{dst}.eh_proj.weight"] = _linear_bf16(rd, eh_key, [H, 2 * H]).T.contiguous()
+    _load_attention(rd, cfg, 0, layout, tp_size, tp_rank, out, precision, fp8_linear,
+                    layer_prefix=dst, is_swa=True)
+    _load_dense_mlp(rd, cfg, 0, tp_size, tp_rank, out, precision, layer_prefix=dst)
+    return out
