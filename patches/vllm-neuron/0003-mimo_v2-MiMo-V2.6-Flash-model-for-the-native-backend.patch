+    "num_attention_heads",
+    "num_key_value_heads",
+    "swa_num_attention_heads",
+    "swa_num_key_value_heads",
+    "head_dim",
+    "swa_head_dim",
+    "v_head_dim",
+    "swa_v_head_dim",
+    "intermediate_size",
+    "moe_intermediate_size",
+    "n_routed_experts",
+    "num_experts_per_tok",
+    "norm_topk_prob",
+    "scoring_func",
+    "topk_method",
+    "layernorm_epsilon",
+    "rope_theta",
+    "swa_rope_theta",
+    "partial_rotary_factor",
+    "sliding_window",
+    "attention_value_scale",
+    "add_swa_attention_sink_bias",
+    "add_full_attention_sink_bias",
+    "hybrid_layer_pattern",
+    "moe_layer_freq",
+)
+
+
+@dataclass
+class MiMoV2NeuronConfig:
+    """Model + precision config consumed by the MiMo-V2 Neuron model code."""
+
+    # ── Model architecture (MODEL-SPECIFIC) ──────────────────────────────
+    vocab_size: int = 152576
+    hidden_size: int = 4096
+    num_hidden_layers: int = 48
+    num_attention_heads: int = 64  # global-layer Q heads
+    num_key_value_heads: int = 4  # global-layer KV heads
+    swa_num_attention_heads: int = 64
+    swa_num_key_value_heads: int = 8
+    head_dim: int = 192  # global-layer QK head dim
+    swa_head_dim: int = 192
