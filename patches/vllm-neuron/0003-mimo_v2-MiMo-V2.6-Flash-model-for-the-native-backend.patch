@@ -0,0 +1,270 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 decode attention over the paged KV cache (NKI, design 8.4, T32).
+
+QK head_dim 192 and V head_dim 128 are above what the shared decode kernels take
+(``attention_tkg`` needs ``d % 128 == 0`` and one width for Q/K/V), so this kernel is
+written for MiMo, with nkilib ``attention_tkg``'s block-KV path as the template:
+indirect block loads with one block per partition, PE transposes of K, K-stationary
+QK^T (the 192-wide contraction is two partition tiles, 128 + 64, accumulated in PSUM),
+P-stationary PV against V in its natural layout (128 wide).
+
+Contract (one TP rank, one layer, ``nkv = 1`` KV head per rank, ``G = nq_rank * S``
+query columns per request, column ``c = h * S + s``):
+
+* the kernel attends only to the **prior** keys, i.e. the cache entries listed in the
+  block table; the ``S`` keys of this step and the per-head sink are folded in by the
+  caller together with the partial results of the programs
+  (``mimo_v2.attention_nki.combine``). Prior key at table column ``t``, slot ``j`` has
+  table-relative position ``rel = t * block_size + j`` and is visible to column ``c``
+  iff ``lo[b, c] < rel < hi[b, c]`` (``hi = q_start - offset``,
+  ``lo = q_pos - window - offset`` for SWA, a large negative number otherwise).
+* each program ``p`` of the LNC grid streams its own share of the table: folds of
+  ``FB`` consecutive table columns (one block per partition), fold ``f`` handled by
+  program ``f % n_prg``, and returns the unnormalised online-softmax state of its share:
+  ``acc = sum_k exp(scale * (s_k - m)) v_k``, ``l = sum_k exp(scale * (s_k - m))``,
+  ``m`` (raw score units, ``s = q . k``).
+* ``dynamic=True`` (global layers): the number of folds each program walks is read at
+  run time from ``n_iter[0, b]`` (``ceil(q_start / (block_size * FB * n_prg))``), so the
+  work grows with the request's real context, not with the table width
+  (max-model-len); both programs run the same trip count (rule P: LNC=2 programs must
+  agree on dynamic loop counts), the extra fold of an odd fold count is masked.
+  ``dynamic=False`` (SWA layers, the trimmed table of 8-16 blocks): one static pass.
+
+Inputs: ``q_t [B, D, G]`` bf16 (Q transposed, unscaled), ``k_cache [nb, 1, bs, D]``,
+``v_cache [nb, 1, bs, Dv]`` bf16, ``block_table [B, NB]`` int32 with every entry a
+valid block id (the caller clamps sentinels to the null block and pads ``NB`` to a
+multiple of ``FB * n_prg``), ``n_iter [1, B]`` int32, ``thr [B, 2 * G]`` fp32
+(``hi`` columns then ``lo`` columns).
+Outputs: ``acc [n_prg, B, G, Dv]`` fp32 and ``ml [n_prg, B, G, 2]`` fp32 (``m``, ``l``).
+"""
+
+import hashlib
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+
+P_MAX = 128
+# sha256 of this file: the launch passes it as ``rev`` (see mimo_decode_attn_prior)
+with open(__file__, "rb") as _f:
+    KERNEL_REV = hashlib.sha256(_f.read()).hexdigest()[:16]
+# Running max floor (raw score units). Finite so that a program or fold without any
+# visible key keeps l = 0 and acc = 0 exactly: masked scores get MASK_PENALTY added,
+# exp(scale * (MASK_PENALTY - M_FLOOR)) = 0, and the first real fold rescales the old
+# state by exp(scale * (M_FLOOR - m)) = 0.
+M_FLOOR = -1.0e20
+MASK_PENALTY = -1.0e30
+
+
+def kernel_assert(cond, msg):
+    if not cond:
+        raise AssertionError(f"[mimo_decode_attn] {msg}")
+
+
+@nki.jit
+def mimo_decode_attn_prior(q_t, k_cache, v_cache, block_table, n_iter, thr,
+                           scale=1.0, window=0, dynamic=True, fold_blocks=128, rev=""):
+    """Prior-key decode attention partials (see module docstring).
+
+    ``rev``: pass ``KERNEL_REV``. Unused by the kernel; it is part of the launch arguments,
+    so it enters libtorch_neuronx_lite's NKI compile-cache key, which otherwise hashes only
+    this function's own source and would reuse a stale compile after an edit of ``_fold``.
+    """
+    B, D, G = q_t.shape
+    nb, nkv, bs, Dk = k_cache.shape
+    Dv = v_cache.shape[3]
+    NB = block_table.shape[1]
+    kernel_assert(nkv == 1 and v_cache.shape[1] == 1, f"one KV head per rank, got {nkv}")
+    kernel_assert(Dk == D and P_MAX < D <= 2 * P_MAX, f"QK head dim {D} must be in (128, 256]")
+    kernel_assert(Dv <= P_MAX, f"V head dim {Dv} must be <= 128")
+    kernel_assert(bs * G <= 512, f"block_size {bs} x columns {G} must fit one PSUM bank")
+    kernel_assert(tuple(thr.shape) == (B, 2 * G), f"thr shape {thr.shape} != {(B, 2 * G)}")
+    D1 = D - P_MAX
+
+    n_prg = nl.num_programs(0) if nl.program_ndim() > 0 else 1
+    prg = nl.program_id(0) if nl.program_ndim() > 0 else 0
+    if dynamic:
+        FB = fold_blocks
+        kernel_assert(NB % (FB * n_prg) == 0,
+                      f"table width {NB} must be a multiple of {FB} x {n_prg} programs")
+        n_static = 0
+    else:
+        FB = min(P_MAX, NB // n_prg)
+        kernel_assert(FB > 0 and NB % (FB * n_prg) == 0,
+                      f"static table width {NB} must split over {n_prg} programs")
+        n_static = NB // (FB * n_prg)
+    kernel_assert(FB <= P_MAX, f"fold of {FB} blocks > {P_MAX}")
+    fold_pos = FB * bs  # table positions per fold
+
+    acc_out = nl.ndarray((n_prg, B, G, Dv), dtype=nl.float32, buffer=nl.shared_hbm)
+    ml_out = nl.ndarray((n_prg, B, G, 2), dtype=nl.float32, buffer=nl.shared_hbm)
+
+    # ── per-call constants ─────────────────────────────────────────────
+    # Q, split along d into the two contraction tiles: [128, B, G] and [D1, B, G]
+    q_a = nl.ndarray((P_MAX, B, G), dtype=q_t.dtype, buffer=nl.sbuf)
+    q_b = nl.ndarray((D1, B, G), dtype=q_t.dtype, buffer=nl.sbuf)
+    nisa.dma_copy(dst=q_a, src=q_t.ap(pattern=[[G, P_MAX], [D * G, B], [1, G]], offset=0))
+    nisa.dma_copy(dst=q_b, src=q_t.ap(pattern=[[G, D1], [D * G, B], [1, G]],
+                                      offset=P_MAX * G))
+    # thresholds broadcast to every partition: [FB, B, 2G]
+    thr_bc = nl.ndarray((FB, B, 2 * G), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=thr_bc, src=thr.ap(pattern=[[0, FB], [2 * G, B], [1, 2 * G]], offset=0))
+    # rel[p, j] = p * bs + j (position of slot j of the fold's p-th block)
+    rel = nl.ndarray((FB, bs), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.iota(dst=rel, pattern=[[1, bs]], offset=0, channel_multiplier=bs)
+    zeros_g = nl.ndarray((G, FB), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.memset(dst=zeros_g, value=0.0)
+    if dynamic:
+        cnt_sb = nl.ndarray((1, B), dtype=nl.int32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=cnt_sb, src=n_iter)
+
+    # per-request running state (columns on partitions)
+    m_st = nl.ndarray((G, B), dtype=nl.float32, buffer=nl.sbuf)
+    l_st = nl.ndarray((G, B), dtype=nl.float32, buffer=nl.sbuf)
+    acc_st = nl.ndarray((G, B, Dv), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.memset(dst=m_st, value=M_FLOOR)
+    nisa.memset(dst=l_st, value=0.0)
+    nisa.memset(dst=acc_st, value=0.0)
+
+    for b in range(B):
+        thr_cur = nl.ndarray((FB, 2 * G), dtype=nl.float32, buffer=nl.sbuf)
+        # fold of this program's first iteration starts at table position prg * fold_pos
+        nisa.tensor_scalar(dst=thr_cur, data=thr_bc[:, b, :], op0=nl.add,
+                           operand0=float(-prg * fold_pos))
+        if dynamic:
+            col_off = nl.ndarray((1, 1), dtype=nl.int32, buffer=nl.sbuf)
+            nisa.memset(dst=col_off, value=b * NB + prg * FB)
+
+            def body(_it, b=b, thr_cur=thr_cur, col_off=col_off):
+                idx = nl.ndarray((FB, 1), dtype=nl.int32, buffer=nl.sbuf)
+                nisa.dma_copy(dst=idx, src=block_table.ap(
+                    pattern=[[1, FB], [1, 1]], offset=0, scalar_offset=col_off,
+                    indirect_dim=1))
+                _fold(idx, b, thr_cur, q_a, q_b, rel, zeros_g, m_st, l_st, acc_st,
+                      k_cache, v_cache, scale, window, FB, bs, D, D1, Dv, G)
+                nisa.tensor_scalar(dst=col_off, data=col_off, op0=nl.add,
+                                   operand0=n_prg * FB)
+                nisa.tensor_scalar(dst=thr_cur, data=thr_cur, op0=nl.add,
+                                   operand0=float(-n_prg * fold_pos))
+
+            it_reg = nisa.register_alloc()
+            nisa.register_load(it_reg, cnt_sb[0:1, b:b + 1])
+            nl.fori_loop(0, it_reg, body)
+        else:
+            for f in range(n_static):
+                col0 = (f * n_prg + prg) * FB
+                idx = nl.ndarray((FB, 1), dtype=nl.int32, buffer=nl.sbuf)
+                nisa.dma_copy(dst=idx, src=block_table.ap(
+                    pattern=[[1, FB], [1, 1]], offset=b * NB + col0))
+                if f > 0:
+                    nisa.tensor_scalar(dst=thr_cur, data=thr_cur, op0=nl.add,
+                                       operand0=float(-n_prg * fold_pos))
+                _fold(idx, b, thr_cur, q_a, q_b, rel, zeros_g, m_st, l_st, acc_st,
+                      k_cache, v_cache, scale, window, FB, bs, D, D1, Dv, G)
+
+    # ── store this program's partials ──────────────────────────────────
+    ml_sb = nl.ndarray((G, B, 2), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=ml_sb[:, :, 0], src=m_st)
+    nisa.tensor_copy(dst=ml_sb[:, :, 1], src=l_st)
+    nisa.dma_copy(dst=acc_out.ap(pattern=[[Dv, G], [G * Dv, B], [1, Dv]],
+                                 offset=prg * B * G * Dv), src=acc_st)
+    nisa.dma_copy(dst=ml_out.ap(pattern=[[2, G], [G * 2, B], [1, 2]],
+                                offset=prg * B * G * 2), src=ml_sb)
+    return acc_out, ml_out
+
+
+def _fold(idx, b, thr_cur, q_a, q_b, rel, zeros_g, m_st, l_st, acc_st,
+          k_cache, v_cache, scale, window, FB, bs, D, D1, Dv, G):
+    """One fold: FB blocks (one per partition) of request b, merged into its state."""
+    # ── gather the fold's K / V blocks: partition p = block idx[p] ──────
+    k_ld = nl.ndarray((FB, bs * D), dtype=k_cache.dtype, buffer=nl.sbuf)
+    v_ld = nl.ndarray((FB, bs * Dv), dtype=v_cache.dtype, buffer=nl.sbuf)
+    nisa.dma_copy(dst=k_ld, src=k_cache.ap(pattern=[[bs * D, FB], [1, bs * D]], offset=0,
+                                          vector_offset=idx, indirect_dim=0))
+    nisa.dma_copy(dst=v_ld, src=v_cache.ap(pattern=[[bs * Dv, FB], [1, bs * Dv]], offset=0,
+                                          vector_offset=idx, indirect_dim=0))
+
+    # ── K^T per slot, d split 128 + D1: [128, bs, FB], [D1, bs, FB] ──────
+    kT_a = nl.ndarray((P_MAX, bs, FB), dtype=k_cache.dtype, buffer=nl.sbuf)
+    kT_b = nl.ndarray((D1, bs, FB), dtype=k_cache.dtype, buffer=nl.sbuf)
+    for j in range(bs):
+        tp_a = nl.ndarray((P_MAX, FB), dtype=k_cache.dtype, buffer=nl.psum)
+        nisa.nc_transpose(dst=tp_a, data=k_ld[:, j * D:j * D + P_MAX])
+        nisa.tensor_copy(dst=kT_a[:, j, :], src=tp_a,
+                         engine=nisa.vector_engine if j % 2 == 0 else nisa.scalar_engine)
+        tp_b = nl.ndarray((D1, FB), dtype=k_cache.dtype, buffer=nl.psum)
+        nisa.nc_transpose(dst=tp_b, data=k_ld[:, j * D + P_MAX:(j + 1) * D])
+        nisa.tensor_copy(dst=kT_b[:, j, :], src=tp_b,
+                         engine=nisa.scalar_engine if j % 2 == 0 else nisa.vector_engine)
+
+    # ── scores s[p, j, c] = k(p, j) . q_c (raw), K stationary ───────────
+    # accumulate=None (compiler-inferred: first write overwrites, the second accumulates).
+    # Explicit accumulate=False/True into column slices of one PSUM tile is exact in the
+    # simulator but drops the first d-tile on trn2 (T32 device probe, D-119), so do not.
+    s_ps = nl.ndarray((FB, bs, G), dtype=nl.float32, buffer=nl.psum)
+    for j in range(bs):
+        nisa.nc_matmul(dst=s_ps[:, j, :], stationary=kT_a[:, j, :], moving=q_a[:, b, :])
+        nisa.nc_matmul(dst=s_ps[:, j, :], stationary=kT_b[:, j, :], moving=q_b[:, b, :])
+
+    # ── mask: s += MASK_PENALTY where rel >= hi or rel <= lo ────────────
+    s_sb = nl.ndarray((FB, bs, G), dtype=nl.float32, buffer=nl.sbuf)
+    pen = nl.ndarray((FB, bs), dtype=nl.float32, buffer=nl.sbuf)
+    for c in range(G):
+        nisa.tensor_scalar(dst=pen, data=rel, op0=nl.greater_equal,
+                           operand0=thr_cur[:, c:c + 1], op1=nl.multiply,
+                           operand1=MASK_PENALTY)
+        nisa.tensor_tensor(dst=s_sb[:, :, c], data1=s_ps[:, :, c], data2=pen, op=nl.add)
+        if window:
+            nisa.tensor_scalar(dst=pen, data=rel, op0=nl.less_equal,
+                               operand0=thr_cur[:, G + c:G + c + 1], op1=nl.multiply,
+                               operand1=MASK_PENALTY)
+            nisa.tensor_tensor(dst=s_sb[:, :, c], data1=s_sb[:, :, c], data2=pen, op=nl.add)
+
+    # ── fold max per column: per-partition max, transpose, max ─────────
+    mloc = nl.ndarray((FB, G), dtype=nl.float32, buffer=nl.sbuf)
+    for c in range(G):
+        nisa.tensor_reduce(dst=mloc[:, c:c + 1], op=nl.maximum, data=s_sb[:, :, c], axis=1)
+    mloc_t = nl.ndarray((G, FB), dtype=nl.float32, buffer=nl.psum)
+    nisa.nc_transpose(dst=mloc_t, data=mloc)
+    m_f = nl.ndarray((G, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_reduce(dst=m_f, op=nl.maximum, data=mloc_t, axis=1)
+    m_new = nl.ndarray((G, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_tensor(dst=m_new, data1=m_st[:, b:b + 1], data2=m_f, op=nl.maximum)
+    # alpha = exp(scale * (m_old - m_new))
+    d_m = nl.ndarray((G, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_tensor(dst=d_m, data1=m_st[:, b:b + 1], data2=m_new, op=nl.subtract)
+    alpha = nl.ndarray((G, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.activation(dst=alpha, op=nl.exp, data=d_m, scale=scale)
+    nisa.tensor_copy(dst=m_st[:, b:b + 1], src=m_new)
+
+    # ── bias -scale * m_new on every partition: [G, FB] rows, exact transpose ─
+    nb_row = nl.ndarray((G, FB), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=nb_row, data=zeros_g, op0=nl.add, operand0=m_new,
+                       op1=nl.multiply, operand1=-scale)
+    nb_ps = nl.ndarray((FB, G), dtype=nl.float32, buffer=nl.psum)
+    nisa.nc_transpose(dst=nb_ps, data=nb_row)
+    nb_bc = nl.ndarray((FB, G), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=nb_bc, src=nb_ps)
+
+    # ── p = exp(scale * s - scale * m_new) (bf16 for PV), per-partition sums ─
+    p_sb = nl.ndarray((FB, bs, G), dtype=v_cache.dtype, buffer=nl.sbuf)
+    lloc = nl.ndarray((FB, G), dtype=nl.float32, buffer=nl.sbuf)
+    for c in range(G):
+        nisa.activation_reduce(dst=p_sb[:, :, c], op=nl.exp, data=s_sb[:, :, c],
+                               reduce_op=nl.add, reduce_res=lloc[:, c:c + 1],
+                               bias=nb_bc[:, c:c + 1], scale=scale)
+
+    # ── PV: o[c, :] = sum_{p, j} p[p, j, c] v(p, j), P stationary ───────
+    o_ps = nl.ndarray((G, Dv), dtype=nl.float32, buffer=nl.psum)
+    for j in range(bs):
+        nisa.nc_matmul(dst=o_ps, stationary=p_sb[:, j, :], moving=v_ld[:, j * Dv:(j + 1) * Dv])
+    lloc_t = nl.ndarray((G, FB), dtype=nl.float32, buffer=nl.psum)
+    nisa.nc_transpose(dst=lloc_t, data=lloc)
+    l_f = nl.ndarray((G, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_reduce(dst=l_f, op=nl.add, data=lloc_t, axis=1)
+
+    # ── state update: acc = acc * alpha + o; l = l * alpha + l_f ───────
+    nisa.scalar_tensor_tensor(dst=acc_st[:, b, :], data=acc_st[:, b, :], op0=nl.multiply,
+                              operand0=alpha, op1=nl.add, operand1=o_ps)
+    nisa.scalar_tensor_tensor(dst=l_st[:, b:b + 1], data=l_st[:, b:b + 1], op0=nl.multiply,
+                              operand0=alpha, op1=nl.add, operand1=l_f)
