+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 (MiMo-V2.6-Flash) model package.
+
+Exports are lazy: importing this package does not import any submodule, so
+light helpers such as ``fp8_layout`` stay cheap to use. Offline tools that must
+not import vllm at all load ``fp8_layout.py`` by file path instead.
+"""
+import importlib as _importlib
+
+# exported name -> submodule that defines it
+_LAZY_EXPORTS = {
+    "fp8_layout": None,  # the submodule itself
+    "MiMoV2OmniForCausalLM": "factory",  # registry entry (factory)
+    "MiMoV2ForCausalLM": "model",  # BF16 text backbone implementation
+    "MiMoV2MTPDraftModel": "mtp_model",  # MTP draft (T36)
+}
+
+__all__ = list(_LAZY_EXPORTS)
+
+
+def __getattr__(name):
+    if name not in _LAZY_EXPORTS:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    sub = _LAZY_EXPORTS[name]
+    if sub is None:
+        return _importlib.import_module(f".{name}", __name__)
+    return getattr(_importlib.import_module(f".{sub}", __name__), name)
