+++ b/vllm_neuron/model/mimo_v2/graph_constants.py
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 module constants in the compile fingerprint (T54a M2, D-211, upstream issue #10).
+
+The native route's torch_compile cache directory is keyed by a fingerprint of the vLLM config
+hash, the buckets, the compiler options and the versions (``inductor_cache.py``); inside it the
+precompile entries are found by the source of the traced functions. A commit that only changes
+the value of a module-level constant (a dtype, a threshold, a switch, a tile size) leaves both
+unchanged, so the next start loads the old graph (T48 8e4ba3a: new NEFF 0, logits bit-identical
+to the previous code).
+
+``resolve_graph_options`` closes that gap for MiMo-V2. It runs in
+``NeuronPlatform.check_and_update_config`` and writes into ``additional_config.neuron_config``
+(which vLLM's config hash covers, ``VllmConfig.compute_hash``):
+
+* the resolved values of the tunable kernel options (``mimo_moe_tkg_hits_max_rows``,
+  ``mimo_moe_prefill_accumulation_dtype``, ``mimo_expert_replica_min_tokens``), so a changed
+  default changes the hash too, and
+* ``mimo_graph_constants``: a digest of every module-level constant assignment of this package
+  and of its NKI kernels (names ``[_]UPPER_CASE``), taken from the source text with ``ast``
+  (nothing is imported). Any change of such a value gives a new fingerprint, so the graphs are
+  traced again and the NEFF cache (keyed by HLO) decides what has to be recompiled.
+"""
+
+import ast
+import hashlib
+import json
+import os
+import re
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+# The model package (with the vendored nki_moe_tkg kernels) and its NKI attention kernels.
+CONSTANT_DIRS = (_HERE, os.path.join(os.path.dirname(os.path.dirname(_HERE)), "_kernels",
+                                     "mimo_v2"))
+_CONSTANT_NAME = re.compile(r"^_?[A-Z][A-Z0-9_]*$")
+
+
+def module_constants(dirs=CONSTANT_DIRS) -> dict[str, str]:
+    """``{"<relative file>:<NAME>": "<value source>"}`` of the module-level ``NAME = value``
+    (and annotated) assignments of every ``.py`` file under ``dirs``."""
+    out: dict[str, str] = {}
+    for base in dirs:
+        for root, subdirs, files in os.walk(base):
+            subdirs[:] = sorted(d for d in subdirs if d != "__pycache__")
+            for name in sorted(f for f in files if f.endswith(".py")):
+                path = os.path.join(root, name)
+                with open(path, encoding="utf-8") as f:
+                    tree = ast.parse(f.read(), filename=path)
+                rel = os.path.relpath(path, os.path.dirname(os.path.dirname(base)))
+                for node in tree.body:
+                    if isinstance(node, ast.Assign):
+                        targets, value = node.targets, node.value
+                    elif isinstance(node, ast.AnnAssign) and node.value is not None:
+                        targets, value = [node.target], node.value
+                    else:
+                        continue
+                    for t in targets:
+                        if isinstance(t, ast.Name) and _CONSTANT_NAME.match(t.id):
+                            out[f"{rel}:{t.id}"] = ast.unparse(value)
+    return out
+
+
+def constants_digest(dirs=CONSTANT_DIRS) -> str:
+    """sha256 (first 16 hex digits) of ``module_constants(dirs)``."""
+    payload = json.dumps(module_constants(dirs), sort_keys=True).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()[:16]
+
+
+def resolve_graph_options(neuron_config: dict) -> dict:
+    """Write the resolved MiMo-V2 kernel options and the constants digest into the shared
+    ``neuron_config`` dict (explicit values are kept and checked later by MiMoV2NeuronConfig).
+    Returns the written entries."""
+    from .config import (
+        EXPERT_REPLICA_MIN_TOKENS_DEFAULT,
+        MOE_PREFILL_ACCUMULATION_DTYPE_DEFAULT,
+        MOE_TKG_HITS_MAX_ROWS_DEFAULT,
+    )
+
+    for key, default in (("mimo_moe_tkg_hits_max_rows", MOE_TKG_HITS_MAX_ROWS_DEFAULT),
+                         ("mimo_moe_prefill_accumulation_dtype",
+                          MOE_PREFILL_ACCUMULATION_DTYPE_DEFAULT),
+                         ("mimo_expert_replica_min_tokens", EXPERT_REPLICA_MIN_TOKENS_DEFAULT)):
+        if neuron_config.get(key) is None:
+            neuron_config[key] = default
+    neuron_config["mimo_graph_constants"] = constants_digest()
+    return {k: neuron_config[k] for k in ("mimo_moe_tkg_hits_max_rows",
+                                          "mimo_moe_prefill_accumulation_dtype",
+                                          "mimo_expert_replica_min_tokens",
+                                          "mimo_graph_constants")}
