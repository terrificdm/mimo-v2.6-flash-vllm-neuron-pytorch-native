@@ -0,0 +1,402 @@
+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 MTP draft model, multi-layer (design 8.2, T36 / T64)
+============================================================
+
+The checkpoint has three MTP layers (``model.mtp.layers.{0,1,2}``). Draft step ``i``
+(``i < k``, ``k = num_speculative_tokens`` <= 3) runs MTP layer ``i``, as the official
+MiMo deployment does (SGLang ``--speculative-algorithm EAGLE --enable-multi-layer-eagle``,
+``MultiLayerEagleWorkerV2``; decisions D-137). The target's embedding and lm_head are
+shared (loaded once). Each layer follows vLLM GPU ``MiMoV2MTPLayer.forward``
+(``mimo_v2_mtp.py``) and has its own norms, ``eh_proj``, attention and MLP::
+
+    h = eh_proj([enorm(embed(token)); hnorm(target_hidden)])
+    residual = h; h = self_attn(input_layernorm(h))           # SWA 128 + sink
+    residual = h + residual; h = mlp(pre_mlp_layernorm(residual))  # dense SwiGLU
+    out = final_layernorm(h + residual)                        # -> lm_head
+
+Input convention (SGLang, MiMoV2MTP is not a "chain" MTP, D-137): every layer takes
+the **target's** hidden states (after the target's final norm, D-127), never a previous
+draft output, at the target's own positions; only the token input moves: layer 0 reads
+row ``j``'s next token ``t[j+1]`` (the ids shifted by one, the accepted token patched in
+on device by ``extract_accepted_tokens``), and before layer ``i+1`` the ids shift by one
+more row and each request's last accepted row (``sampling_positions``) gets the draft
+of layer ``i`` (SGLang ``rotate_input_ids``). Every layer runs over all rows of the step
+(the whole prompt in prefill, the ``1+k`` verify rows in decode) and writes its own KV
+cache (layer index ``num_hidden_layers + i``, KV names ``layers.48`` .. ``layers.50``).
+The rows past a request's last accepted row are rewritten by the next step's window,
+like the single-layer draft; a layer ``i >= 1`` row next to the boundary keeps the KV of
+a draft token when that draft is later rejected, as in SGLang (its boundary-KV fix
+skips MiMoV2).
+
+Attention and MLP are the target's modules (``attention.py`` / ``moe.py``, FP8 by
+``fp8_layer_classes`` as in the decoder layers; o_proj and eh_proj stay BF16, design
+6.2), built as extra SWA layers, always on the torch attention core (128-key window).
+
+``forward`` has the EAGLE3 draft contract (``llama3/eagle3_model.py``), so
+``MTPProposer`` reuses the runner's EAGLE3 pipeline (all ``k`` layers in one graph).
+Returns ``(bonus + drafts [bs, 1+k], drafts [bs, k], logits)``.
+
+Parallelism: replicated tokens on every path (prefill included: the target hands over
+its all-gathered hidden states), Q heads / MLP columns over the TP group, o_proj and
+MLP partials all-reduced; eh_proj is replicated (vLLM GPU ``ReplicatedLinear``).
+
+``neuron_config.mtp_debug_random_draft`` (tests only, design 8.2 (b)) replaces every
+draft token by a deterministic pseudo-random token that differs from the greedy one
+(same on every rank, so the TP ranks stay consistent).
+"""
+
+import dataclasses
+import logging
+import os
+
+import torch
+from torch import nn
+from transformers import PretrainedConfig
+from vllm.distributed.parallel_state import get_tp_group
+
+import vllm_neuron.functional as NF
+import vllm_neuron.nn as neuron_nn
+from vllm_neuron.model.kv_cache import KVSpec, LayerSpec
+from vllm_neuron.model.llama3.eagle3_model import extract_accepted_tokens
+from vllm_neuron.model.neuron_config import NeuronConfig
+from vllm_neuron.nn.embedding import VocabDimShardedEmbedding
+from vllm_neuron.nn.sampler import Sampler
+
+from .attention import MiMoV2Attention, rope_cos_sin
+from .config import MiMoV2NeuronConfig
+from .model import (
+    _UNKNOWN,
+    MiMoV2RMSNorm,
+    _vllm_model_quantization,
+    check_serving_checkpoint_format,
+    rank_state_key_to_param,
+)
+from .moe import MiMoV2MLP
+from .weight_loaders import CONFIG_FILE, INDEX_FILE, load_mtp_rank_state
+
+logger = logging.getLogger(__name__)
+
+MTP_MAX_LAYERS = 3  # model.mtp.layers.{0,1,2} (num_nextn_predict_layers of the checkpoint)
+
+
+def mtp_config(cfg: MiMoV2NeuronConfig, num_layers: int = 1) -> MiMoV2NeuronConfig:
+    """``cfg`` with ``num_layers`` more layers (indices ``num_hidden_layers`` ...): SWA
+    attention + dense MLP each.
+
+    The MTP attention is the SWA configuration (8 KV heads, window, sink; design S14),
+    run with the torch core (module docstring).
+    """
+    return dataclasses.replace(
+        cfg,
+        layer_types=list(cfg.layer_types) + ["sliding_attention"] * num_layers,
+        mlp_types=list(cfg.mlp_types) + ["dense"] * num_layers,
+        mimo_attn_kernel="torch",
+    )
+
+
+def debug_random_draft(tokens: torch.Tensor, positions: torch.Tensor, vocab_size: int):
+    """Deterministic pseudo-random replacement of ``tokens`` (int32), never equal to them.
+
+    ``(t + 1 + (pos % 997) * 151) % V``: the offset is in ``[1, V - 1]`` for V > 150397, so
+    the result differs from ``t``; int32 arithmetic, identical on every rank.
+    """
+    off = 1 + torch.remainder(positions.to(torch.int32), 997) * 151
+    return torch.remainder(tokens.to(torch.int32) + off, vocab_size).to(torch.int32)
+
+
+class MiMoV2MTPLayer(nn.Module):
+    """vLLM GPU ``MiMoV2MTPLayer`` on the Neuron modules (module docstring)."""
+
+    def __init__(self, config: MiMoV2NeuronConfig, layer_idx: int):
+        super().__init__()
+        self.layer_idx = layer_idx
+        H, dtype, eps = config.hidden_size, config.torch_dtype, config.layernorm_epsilon
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        self.enorm = MiMoV2RMSNorm(H, eps, dtype)
+        self.hnorm = MiMoV2RMSNorm(H, eps, dtype)
+        self.eh_proj_weight = nn.Parameter(torch.empty(2 * H, H, dtype=dtype),
+                                           requires_grad=False)
+        self.input_layernorm = MiMoV2RMSNorm(H, eps, dtype)
+        attn_cls, mlp_cls = MiMoV2Attention, MiMoV2MLP
+        if config.mimo_precision == "fp8":
+            from .fp8_linear import fp8_layer_classes
+
+            attn_cls, mlp_cls = fp8_layer_classes(config.mimo_fp8_linear)
+        self.self_attn = attn_cls(config, layer_idx)
+        if not self.self_attn.sliding_window:
+            raise ValueError(f"MTP layer {layer_idx} must be an SWA layer")
+        self.pre_mlp_layernorm = MiMoV2RMSNorm(H, eps, dtype)
+        self.mlp = mlp_cls(config)
+        self.final_layernorm = MiMoV2RMSNorm(H, eps, dtype)
+        self.rope_dim = self.self_attn.rope_dim
+        self.rope_theta = self.self_attn.rope_theta
+
+    def forward(self, inputs_embeds: torch.Tensor, positions: torch.Tensor,
+                previous_hidden_states: torch.Tensor, attn_metadata: dict,
+                is_decode: bool) -> torch.Tensor:
+        """``[T, H]`` embeddings of the next tokens + previous hidden states -> ``[T, H]``."""
+        dtype = self.eh_proj_weight.dtype
+        x = torch.cat([self.enorm(inputs_embeds.to(dtype)),
+                       self.hnorm(previous_hidden_states.to(dtype))], dim=-1)
+        h = torch.matmul(x, self.eh_proj_weight)
+        residual = h
+        h = self.input_layernorm(h)
+        cos_sin = rope_cos_sin(positions, self.rope_dim, self.rope_theta)
+        if is_decode:
+            h = self.self_attn.forward_decode(h, positions, cos_sin, attn_metadata)
+        else:
+            # replicated tokens: the whole prefill on every rank, o_proj partials summed
+            h = self.self_attn.forward_prefill(h, cos_sin, attn_metadata)
+            if self.world_size > 1:
+                h = self.tp_group.all_reduce(h)
+        h = residual + h
+        residual = h
+        h = self.pre_mlp_layernorm(h)
+        # replicated tokens: the decode-style MLP (no SP gather, all-reduce of partials)
+        h = self.mlp(h, positions, True)
+        return self.final_layernorm(residual + h)
+
+
+class MiMoV2MTPDraftModel(nn.Module):
+    """MTP draft for ``MTPProposer`` (registry: ``MiMoV2MTPModel`` / ``MiMoV2OmniMTPModel``).
+
+    ``num_speculative_tokens`` MTP layers (``config.num_speculative_tokens``, 1 when the
+    config has none, e.g. offline use); draft step ``i`` uses layer ``i`` (module docstring).
+    """
+
+    def __init__(self, config: MiMoV2NeuronConfig, start_layer_idx: int | None = None):
+        super().__init__()
+        n = max(1, config.num_speculative_tokens)
+        available = min(MTP_MAX_LAYERS, config.num_nextn_predict_layers)
+        if available < 1:
+            raise ValueError("MiMo-V2 checkpoint has no MTP layer (num_nextn_predict_layers=0)")
+        if n > available:
+            raise ValueError(f"num_speculative_tokens={n}: draft step i uses MTP layer i, the "
+                             f"checkpoint has {available} MTP layer(s)")
+        idx = config.num_hidden_layers if start_layer_idx is None else start_layer_idx
+        if idx != config.num_hidden_layers:
+            raise ValueError(f"MTP draft layer index {idx} != num_hidden_layers "
+                             f"{config.num_hidden_layers}")
+        nc = config.neuron_config
+        self.config = mtp_config(config, n)
+        self.hf_config = None  # target hf_config (from_configs), for the format check
+        self.layer_idx = idx
+        self.layer_names = [f"layers.{idx + i}.self_attn" for i in range(n)]
+        self.num_speculative_tokens = n
+        self.kv_fill_only = False  # set by the proposer (pure KV producer)
+        self._return_logits = nc is not None and nc.debug_logits_dir is not None
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        self.rank = self.tp_group.rank_in_group
+
+        # Replaced by the target's modules (share_target_modules); built so that the
+        # draft also runs stand-alone (unit tests, CPU compile).
+        self.embed_tokens = VocabDimShardedEmbedding(
+            vocab_size=config.vocab_size, embed_dim=config.hidden_size,
+            dtype=config.torch_dtype, tp_group=self.tp_group.device_group)
+        self.mtp_layers = nn.ModuleList(MiMoV2MTPLayer(self.config, idx + i) for i in range(n))
+        self.on_device_sampling_config = nc.on_device_sampling_config if nc else None
+        self.lm_head = neuron_nn.ColumnParallelLinear(
+            config.hidden_size, config.vocab_size, bias=False, dtype=config.torch_dtype,
+            gather_output=not self.on_device_sampling_config,
+            tp_group=self.tp_group.device_group)
+        if self.on_device_sampling_config is not None:
+            if not self.on_device_sampling_config.all_greedy:
+                raise ValueError("MTP draft sampling must be greedy (all_greedy=True)")
+            self.sampler = Sampler(self.on_device_sampling_config,
+                                   process_group=self.tp_group.device_group)
+
+    @classmethod
+    def from_configs(cls, hf_config: PretrainedConfig, neuron_config: NeuronConfig | None,
+                     start_layer_idx: int | None = None):
+        """``hf_config`` of the TARGET (vLLM's draft config has ``num_hidden_layers=0``)."""
+        model = cls(MiMoV2NeuronConfig.from_configs(hf_config, neuron_config), start_layer_idx)
+        model.hf_config = hf_config
+        return model
+
+    def share_target_modules(self, target: nn.Module) -> None:
+        """Use the target's embedding and lm_head modules (same parameters, design 8.2)."""
+        for name, mod in (("embed_tokens", target.model.embed_tokens),
+                          ("lm_head", target.lm_head)):
+            mine = getattr(self, name).weight
+            if tuple(mod.weight.shape) != tuple(mine.shape):
+                raise ValueError(f"MTP {name}: target weight {tuple(mod.weight.shape)} != draft "
+                                 f"{tuple(mine.shape)}")
+        if target.lm_head.gather_output != self.lm_head.gather_output:
+            raise ValueError("MTP draft and target disagree on on-device sampling "
+                             "(lm_head gather_output)")
+        self.embed_tokens = target.model.embed_tokens
+        self.lm_head = target.lm_head
+
+    # ── forward ───────────────────────────────────────────────────────────
+
+    def _embed(self, ids: torch.Tensor, rank: torch.Tensor | None) -> torch.Tensor:
+        return self.embed_tokens(ids, scatter_tokens=False, rank=rank)
+
+    def _draft_token(self, hidden: torch.Tensor, positions: torch.Tensor,
+                     rank: torch.Tensor | None):
+        logits = self.lm_head(hidden.to(self.config.torch_dtype))
+        if self.on_device_sampling_config is not None:
+            tokens = self.sampler(logits, tp_rank=rank).to(torch.int32)
+        else:
+            tokens = torch.argmax(logits, dim=-1).to(torch.int32)
+        if self.config.mtp_debug_random_draft:
+            tokens = debug_random_draft(tokens, positions, self.config.vocab_size)
+        return tokens, logits
+
+    @torch.no_grad()
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        initial_target_hidden_states: torch.Tensor,
+        attn_metadata: dict | None = None,
+        sampling_positions: torch.Tensor | None = None,
+        rank: torch.Tensor | None = None,
+        raw_sampled_token_ids: torch.Tensor | None = None,
+        prev_sampled_token_ids: torch.Tensor | None = None,
+        prev_num_draft_tokens: torch.Tensor | None = None,
+        req_indices_per_token: torch.Tensor | None = None,
+    ):
+        """All ``k`` MTP layers over the step's rows (module docstring).
+
+        Args as ``Eagle3LlamaForCausalLM.forward``; ``initial_target_hidden_states`` is
+        the target's final-norm hidden states ``[T, H]``, the hidden input of every layer.
+        """
+        if self.num_speculative_tokens != len(self.mtp_layers):
+            raise ValueError(f"num_speculative_tokens={self.num_speculative_tokens} but the "
+                             f"draft has {len(self.mtp_layers)} MTP layers")
+        if (prev_sampled_token_ids is not None and prev_num_draft_tokens is not None
+                and req_indices_per_token is not None):
+            positions, attn_metadata = NF.correct_spec_decode_positions_and_slot_mapping(
+                positions, attn_metadata, prev_sampled_token_ids, prev_num_draft_tokens,
+                req_indices_per_token, self.config.vocab_size)
+        bonus = None
+        if raw_sampled_token_ids is not None:
+            input_ids, sampling_positions, bonus = extract_accepted_tokens(
+                input_ids, sampling_positions, raw_sampled_token_ids,
+                self.config.vocab_size, self.num_speculative_tokens)
+
+        meta = attn_metadata[self.layer_names[0]]
+        is_decode = meta["max_query_len"] <= meta["decode_token_threshold"]
+        positions = positions.to(torch.int32)
+        cur_pos = torch.index_select(positions, 0, sampling_positions)
+        ids = input_ids
+        tokens = [bonus] if bonus is not None else []
+        all_logits = [] if self._return_logits else None
+        last = len(self.mtp_layers) - 1
+        for i, layer in enumerate(self.mtp_layers):
+            hidden = layer(self._embed(ids, rank), positions, initial_target_hidden_states,
+                           attn_metadata, is_decode)
+            hidden = torch.index_select(hidden, 0, sampling_positions)
+            draft, logits = self._draft_token(hidden, cur_pos + i, rank)
+            tokens.append(draft)
+            if all_logits is not None:
+                all_logits.append(logits)
+            if i < last:
+                # <-- MODEL-SPECIFIC: next layer reads one token further ahead (SGLang
+                # rotate_input_ids): shift by one row, this draft at the last accepted row
+                ids = torch.cat([ids[1:], ids[-1:]]).index_put(
+                    (sampling_positions,), draft.to(ids.dtype))
+
+        if self.kv_fill_only:
+            placeholder = torch.zeros((sampling_positions.shape[0], self.num_speculative_tokens),
+                                      dtype=torch.int32, device=input_ids.device)
+            return placeholder, placeholder, None
+        stacked = torch.stack(tokens, dim=1)
+        drafts_only = torch.stack(tokens[1:] if bonus is not None else tokens, dim=1)
+        stacked_logits = torch.stack(all_logits, dim=1) if all_logits is not None else None
+        return stacked, drafts_only, stacked_logits
+
+    # ── KV cache ──────────────────────────────────────────────────────────
+
+    def get_kv_spec(self) -> KVSpec:
+        """One SWA (window 128) KV layer per MTP layer, K 192 / V 128 (D-074 N5, D-076)."""
+        layers = []
+        for name, layer in zip(self.layer_names, self.mtp_layers):
+            attn = layer.self_attn
+            layers.append(LayerSpec(
+                name=name,
+                num_kv_heads=attn.num_kv_heads_per_rank,
+                head_size=attn.head_dim,
+                head_size_v=attn.v_head_dim,
+                dtype=attn.dtype,
+                sliding_window_size=attn.sliding_window,
+                chunk_size=None,
+            ))
+        return KVSpec(layers=layers)
+
+    def bind_kv_cache(self, kv_caches: dict) -> None:
+        for name, layer in zip(self.layer_names, self.mtp_layers):
+            if name not in kv_caches:
+                raise KeyError(f"KV cache for layer {name} not initialized")
+            k_cache, v_cache = kv_caches[name]
+            attn = layer.self_attn
+            expect_k = (attn.num_kv_heads_per_rank, attn.head_dim)
+            expect_v = (attn.num_kv_heads_per_rank, attn.v_head_dim)
+            if (k_cache.dim() != 4 or v_cache.dim() != 4
+                    or (k_cache.shape[1], k_cache.shape[3]) != expect_k
+                    or (v_cache.shape[1], v_cache.shape[3]) != expect_v):
+                raise ValueError(
+                    f"{name}: KV cache shapes K {tuple(k_cache.shape)} V "
+                    f"{tuple(v_cache.shape)} do not match [nb, {expect_k[0]}, bs, {expect_k[1]}] "
+                    f"/ [nb, {expect_v[0]}, bs, {expect_v[1]}]")
+            attn.k_cache = k_cache
+            attn.v_cache = v_cache
+
+    # ── weights ───────────────────────────────────────────────────────────
+
+    def map_rank_state(self, state: dict, mtp_layer: int = 0) -> dict:
+        """``load_mtp_rank_state(mtp_layer=i)`` keys -> parameters of ``mtp_layers[i]``
+        (all covered)."""
+        prefix = f"mtp.layers.{mtp_layer}."
+        params = dict(self.mtp_layers[mtp_layer].named_parameters())
+        fp8_linear = self.config.mimo_precision == "fp8"
+        mapped = {}
+        for key, tensor in state.items():
+            if not key.startswith(prefix):
+                raise KeyError(f"MiMo-V2 MTP state key {key!r} is not under {prefix!r}")
+            rest = key[len(prefix):]
+            if rest == "eh_proj.weight":
+                name = "eh_proj_weight"
+            else:
+                name = rank_state_key_to_param("layers.0." + rest, fp8_linear)
+                name = name[len("model.layers.0."):]
+            if name not in params:
+                raise KeyError(f"MiMo-V2 MTP state key {key!r} -> {name!r} has no parameter")
+            p = params[name]
+            if tuple(p.shape) != tuple(tensor.shape) or p.dtype != tensor.dtype:
+                raise ValueError(f"MTP {name}: parameter {tuple(p.shape)} {p.dtype} vs loaded "
+                                 f"{tuple(tensor.shape)} {tensor.dtype}")
+            mapped[name] = tensor
+        missing = sorted(set(params) - set(mapped))
+        if missing:
+            raise KeyError(f"MiMo-V2 MTP layer {mtp_layer}: {len(missing)} parameters not "
+                           f"loaded, e.g. {missing[:5]}")
+        return mapped
+
+    def load_weights(self, checkpoint_path: str, device: torch.device,
+                     cache_dir: str | None = None) -> None:
+        """Load ``model.mtp.layers.{0..k-1}`` (embedding / lm_head come from the target)."""
+        ckpt = checkpoint_path
+        if not os.path.isdir(ckpt):
+            from huggingface_hub import snapshot_download
+
+            ckpt = snapshot_download(ckpt, cache_dir=cache_dir, allow_patterns=[
+                INDEX_FILE, CONFIG_FILE, "model_mtp.safetensors", "model-*.safetensors"])
+        model_quantization = _vllm_model_quantization()
+        if self.hf_config is not None:
+            check_serving_checkpoint_format(ckpt, self.hf_config, model_quantization)
+        for i, layer in enumerate(self.mtp_layers):
+            kwargs = dict(tp_size=self.world_size, tp_rank=self.rank,
+                          precision=self.config.mimo_precision, mtp_layer=i)
+            if self.config.mimo_precision == "fp8":
+                kwargs["fp8_linear"] = self.config.mimo_fp8_linear
+            if model_quantization is not _UNKNOWN:
+                kwargs["model_quantization"] = model_quantization
+            logger.info("MiMo-V2 MTP load_weights: %s %s", ckpt, kwargs)
+            state = load_mtp_rank_state(ckpt, **kwargs)
+            mapped = {k: v.to(device) for k, v in self.map_rank_state(state, i).items()}
+            layer.load_state_dict(mapped, strict=True, assign=True)
diff --git a/vllm_neuron/model/mimo_v2/prompt_logprobs.py b/vllm_neuron/model/mimo_v2/prompt_logprobs.py
new file mode 100644
index 0000000..25625f5
--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/prompt_logprobs.py
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: Apache-2.0
+"""On-device prompt logprobs for MiMo-V2 (T62).
+
+vLLM's GPU runner scores every prompt position on the host side of the model:
+``gpu_model_runner._get_prompt_logprobs_dict`` runs ``compute_logits`` on the
+prompt hidden states, then ``Sampler.compute_logprobs`` (``log_softmax`` in
+FP32 over the BF16 lm_head logits) and ``Sampler.gather_logprobs`` (top-k,
+the logprob of the next prompt token, and that token's rank). On the Neuron
+route only the sampling rows' logits leave the device, so the prefill graph
+does the same reduction itself and returns ``[T, 2k + 2]`` FP32 per step
+instead of ``[T, vocab]`` logits.
+
+The lm_head is column-parallel over the TP group (each rank holds
+``vocab / tp`` columns). The reduction needs three small cross-rank steps
+(row max with the target logit, sum of exponentials, rank count) plus the
+distributed top-k of ``vllm_neuron.functional.topk``.
+"""
+
+import torch
+from torch import Tensor
+from torch.distributed import ProcessGroup
+from torch.distributed._functional_collectives import all_gather_tensor
+
+from vllm_neuron.functional.topk import topk
+
+
+def packed_width(k: int) -> int:
+    """Columns of the packed result: k ids, the target logprob, k logprobs, the rank."""
+    return 2 * k + 2
+
+
+def _reduce_over_ranks(t: Tensor, tp: int, group: ProcessGroup | None, op: str) -> Tensor:
+    """Max or sum of ``t`` [T, c] over the TP ranks (all-gather, then reduce on every rank)."""
+    if tp == 1:
+        return t
+    rows, cols = t.shape
+    gathered = all_gather_tensor(t, 1, group=group).reshape(rows, tp, cols)
+    return gathered.amax(dim=1) if op == "max" else gathered.sum(dim=1)
+
+
+def prompt_logprobs_topk(
+    logits: Tensor,
+    target_ids: Tensor,
+    k: int,
+    process_group: ProcessGroup | None = None,
+    rank: Tensor | None = None,
+) -> Tensor:
+    """Top-k prompt logprobs of every row, in vLLM's ``gather_logprobs`` layout.
+
+    Args:
+        logits: This rank's lm_head logits ``[T, vocab / tp]`` (BF16, the
+            lm_head dtype; vocab-sharded when ``process_group`` is set).
+        target_ids: ``[T]`` int32, the token whose logprob each row reports
+            (the next prompt token). Rows the caller does not need may hold
+            any id in ``[0, vocab)``.
+        k: Top-k width (vLLM ``max_logprobs``).
+        process_group: TP group of the column-parallel lm_head, or None.
+        rank: This rank's index in ``process_group`` as an int32 scalar
+            tensor (a tensor, so the rank is not baked into the graph).
+
+    Returns:
+        ``[T, 2k + 2]`` FP32: columns ``[0, k)`` the top-k token ids (exact in
+        FP32, ids < 2**24), column ``k`` the target logprob, ``[k + 1, 2k + 1)``
+        the top-k logprobs (descending), column ``2k + 1`` the target rank
+        (number of tokens whose logprob is >= the target's, as in vLLM's
+        ``batched_count_greater_than``).
+    """
+    tp = 1 if process_group is None else torch.distributed.get_world_size(group=process_group)
+    x = logits.to(torch.float32)  # vLLM: logits.log_softmax(dim=-1, dtype=torch.float32)
+    shard = x.shape[-1]
+    local = target_ids.to(torch.int32)
+    if tp > 1:
+        local = local - rank.to(torch.int32) * shard
+    in_shard = (local >= 0) & (local < shard)
+    # Keep the indirect load in range: Neuron needs an explicit bound for a runtime index.
+    idx = local.clamp(min=0, max=shard - 1).to(torch.int64).unsqueeze(-1)
+    target_local = torch.gather(x, -1, idx).squeeze(-1)
+    lowest = torch.full_like(target_local, torch.finfo(torch.float32).min)
+    target_local = torch.where(in_shard, target_local, lowest)
+
+    row_max_and_target = _reduce_over_ranks(
+        torch.stack([x.amax(dim=-1), target_local], dim=-1), tp, process_group, "max")
+    row_max = row_max_and_target[:, 0]
+    target_logit = row_max_and_target[:, 1]
+    sum_exp = _reduce_over_ranks(
+        torch.exp(x - row_max.unsqueeze(-1)).sum(dim=-1, keepdim=True), tp, process_group, "sum")
+    lse = row_max + torch.log(sum_exp[:, 0])
+
+    logprobs = x - lse.unsqueeze(-1)
+    target_logprob = target_logit - lse
+    count = (logprobs >= target_logprob.unsqueeze(-1)).to(torch.float32).sum(dim=-1, keepdim=True)
+    count = _reduce_over_ranks(count, tp, process_group, "sum")
+
+    # Top-k is a selection, so it runs on the BF16 logits (the NKI kernels' dtype); the
+    # order equals that of the FP32 logprobs, and the values are re-based exactly below.
+    values, ids = topk(logits, k, dim=1, gather_dim=1, process_group=process_group, rank=rank)
+    top_logprobs = values.to(torch.float32) - lse.unsqueeze(-1)
+    return torch.cat([ids.to(torch.float32), target_logprob.unsqueeze(-1), top_logprobs, count],
+                     dim=-1)
+
+
+def unpack(packed: Tensor, k: int) -> tuple[Tensor, Tensor, Tensor, Tensor]:
+    """Split the packed result (host side): (top-k ids int64, target logprob,
+    top-k logprobs, target rank int64)."""
+    ids = packed[:, :k].round().to(torch.int64)
+    target = packed[:, k]
+    top = packed[:, k + 1:2 * k + 1]
+    ranks = packed[:, 2 * k + 1].round().to(torch.int64)
+    return ids, target, top, ranks
diff --git a/vllm_neuron/model/mimo_v2/quant_config.py b/vllm_neuron/model/mimo_v2/quant_config.py
new file mode 100644
index 0000000..60096b5
--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/quant_config.py
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: Apache-2.0
+"""``mimo_fp8_mxfp4``: lets the original MiMo-V2 checkpoint pass vLLM's quantization check.
+
+The original checkpoint declares ``quantization_config.quant_method = "fp8"``
+(block FP8 linear layers, ``weight_block_size=[128, 128]``, MXFP4 experts with
+``store_dtype="mxfp4"``). ``fp8`` is not in the Neuron platform's
+``supported_quantization``, so ``ModelConfig`` rejects it. This config claims that
+exact checkpoint format through ``override_quantization_method`` and does nothing
+else: ``get_quant_method`` returns None because the Neuron native MiMo model does
+all numeric handling in its own weight loader. Device precision is selected by
+``neuron_config.quantization`` ("bf16" / "fp8"), not by this config.
+
+Depends only on vLLM's quantization base classes and torch.
+"""
+
+from typing import Any
+
+import torch
+from vllm.model_executor.layers.quantization import register_quantization_config
+from vllm.model_executor.layers.quantization.base_config import QuantizationConfig
+
+MIMO_QUANT_METHOD = "mimo_fp8_mxfp4"
+
+_registered = False
+
+
+class MiMoFp8Mxfp4Config(QuantizationConfig):
+    """Marker quantization config for the original MiMo-V2 FP8 + MXFP4 checkpoint."""
+
+    def __init__(self, raw_config: dict[str, Any]):
+        super().__init__()
+        # The checkpoint's quantization_config, kept verbatim.
+        self.raw_config = raw_config
+
+    def get_name(self) -> str:
+        return MIMO_QUANT_METHOD
+
+    def get_supported_act_dtypes(self) -> list[torch.dtype]:
+        return [torch.bfloat16]
+
+    @classmethod
+    def get_min_capability(cls) -> int:
+        return 0
+
+    @staticmethod
+    def get_config_filenames() -> list[str]:
+        return []
+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> "MiMoFp8Mxfp4Config":
+        return cls(dict(config))
+
+    def get_quant_method(self, layer: torch.nn.Module, prefix: str):
+        return None
+
+    @classmethod
+    def override_quantization_method(
+        cls,
+        hf_quant_cfg: dict[str, Any],
+        user_quant: str | None,
+        hf_config: Any = None,
+    ) -> str | None:
+        if (
+            hf_quant_cfg.get("quant_method") == "fp8"
+            and list(hf_quant_cfg.get("weight_block_size") or []) == [128, 128]
+            and hf_quant_cfg.get("store_dtype") == "mxfp4"
+            and user_quant in (None, MIMO_QUANT_METHOD)
+        ):
+            return MIMO_QUANT_METHOD
+        return None
+
+
+def register_mimo_quant_config() -> None:
+    """Register ``mimo_fp8_mxfp4`` with vLLM once per process (idempotent)."""
+    global _registered
+    if _registered:
+        return
+    register_quantization_config(MIMO_QUANT_METHOD)(MiMoFp8Mxfp4Config)
+    _registered = True
diff --git a/vllm_neuron/model/mimo_v2/vision_encoder.py b/vllm_neuron/model/mimo_v2/vision_encoder.py
new file mode 100644
index 0000000..9b9167d
--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/vision_encoder.py
@@ -0,0 +1,888 @@
+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 vision encoder, BF16 (design 9.1)
+=========================================
+
+Reference: HF remote code ``modeling_mimo_v2.py`` (snapshot b12f557)
+``MiMoVisionTransformer`` L783-916 and the vLLM GPU port
+``vllm/model_executor/models/mimo_v2_omni.py`` ``MiMoVisionTransformer``.
+
+* patch embed (Conv3d with kernel == stride, as a matmul) -> 28 blocks -> merger.
+* Block: RMSNorm -> attention -> +res -> RMSNorm -> SwiGLU MLP (with bias) -> +res.
+  Attention: 32 Q heads / 8 KV heads, head_dim 64, scale 64^-0.5, 2D RoPE on
+  all 64 dims (neox rotate_half, FP32 like HF).
+* ``fullatt_block_indexes`` (0/9/18/27): full attention inside each frame group,
+  no sink -> ``NF.flash_attention(causal_mask=False, bound_min, bound_max)``.
+* Other blocks: window ``|i-j| <= 64`` inside each frame group + per-head sink
+  added to the logit of each frame group's key 0 (HF L669-723) -> banded torch
+  attention (``window_attention``: 64-token chunks, query chunk c sees key chunks
+  c-1, c, c+1; mask from the host ``grp``/``loc`` tensors; BF16 q.k with FP32
+  accumulation, FP32 scores/softmax, as the GPU's Triton kernel).
+* ``vit_window_attn_types`` 1 = column order: the hidden states are re-indexed at
+  spatial-merge-unit granularity when entering a type-1 run and restored when
+  leaving it (same rule as HF / vLLM).
+* merger: ``ln_q`` -> view(-1, 4 * hidden) -> Linear -> GELU(erf, in FP32 like ``nn.GELU``)
+  -> Linear, no
+  bias (the checkpoint has no merger bias, vLLM uses ``bias=False``; F-MERGER).
+  ``ln_q`` is an RMSNorm by default, as in the vLLM GPU port (the checkpoint has
+  only ``ln_q.weight``); ``merger_norm="layer"`` gives the HF remote-code
+  ``nn.LayerNorm`` with a zero bias (decisions D-089).
+
+Layout: one encoder call works on a packed sequence of ``bucket`` patches
+(``VISION_BUCKETS``). Each frame group (an image, or ``temporal_patch_size``
+frames of a video; HF ``cu_seqlens`` L893) starts at a multiple of the window
+size (64) and the rest is padding. All per-token index tensors (RoPE cos/sin,
+column order, frame-group masks) are built on the host by ``build_vision_inputs``;
+the device graph has static shapes per bucket and no data-dependent control flow.
+Attention never crosses a frame group, so a video can be split into several
+encoder calls at frame-group boundaries (``pack_frame_groups``/``encode_vision``).
+
+Serving (T39, D-147): ``MiMoVisionCacheEncoder`` is the compiled graph per bucket; it
+writes the merged rows straight into the runner's on-device encoder cache
+(``plan_cache_writes`` gives each row its cache block and row), and the text prefill
+graph scatters them over the image / video pad tokens.
+
+Parallelism (serving, decisions D-153): sequence parallel over the TP group for every
+bucket whose per-rank share is a multiple of 64 rows (4096 / 16384 / 32768 on TP 64):
+each rank runs the tower on its rows and all-gathers k/v per block, ``x`` at the
+column-order switches and the merged rows at the end. Other buckets (1024 on TP 64),
+and offline use without a group, run replicated (all 32 heads local, no collectives).
+"""
+
+import json
+import math
+import os
+from dataclasses import dataclass
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+import vllm_neuron.functional as NF
+from vllm_neuron.utils.dynamo_graph import allow_in_graph_cacheable
+
+# Patch-count buckets of one encoder call (design 9.1). 32768 = processor upper
+# bound for one image / one video frame group (image_max_pixels 8,388,608 / 16^2).
+VISION_BUCKETS = (1024, 4096, 16384, 32768)
+
+# Processor pixel bounds (design 15.2): image/video min and max pixels per frame.
+MM_MIN_PIXELS = 8192
+MM_MAX_PIXELS = 8388608
+_MM_PIXEL_KEYS = ("image_max_pixels", "video_max_pixels")
+
+_MERGER_NORMS = ("rms", "layer")
+
+# Longest packed sequence for which the full-attention blocks call NF.flash_attention
+# (NKI attention_cte) on the whole sequence. In the vision shapes (32 / 8 heads,
+# head_dim 64, bounds) the kernel builds and runs at 16384 and 24576 and fails at
+# 32768 with "BIR emission failed", while 8192 queries x 32768 keys works (T39 probe
+# reports/tasks/T39/tests/flash_len_probe.json). Longer buckets call the kernel on
+# query chunks of FLASH_Q_CHUNK against all keys (decisions D-150).
+FLASH_MAX_LEN = 24576
+FLASH_Q_CHUNK = 8192
+# attention_cte reads the per-query bounds in 128-row query groups (decisions D-164):
+# the query count of every bound-path call must be a multiple of this.
+FLASH_Q_GROUP = 128
+
+
+# =============================================================================
+# Section 1: config
+# =============================================================================
+def _get(cfg, key, default=None):
+    if isinstance(cfg, dict):
+        return cfg.get(key, default)
+    return getattr(cfg, key, default)
+
+
+@dataclass(frozen=True)
+class MiMoVisionSpec:
+    depth: int
+    hidden_size: int
+    intermediate_size: int
+    num_heads: int
+    num_kv_heads: int
+    head_dim: int
+    out_hidden_size: int
+    patch_size: int
+    temporal_patch_size: int
+    in_channels: int
+    spatial_merge_size: int
+    fullatt_block_indexes: tuple
+    window_attn_types: tuple
+    window: int
+    use_sink: bool
+    rms_norm_eps: float
+
+    @property
+    def patch_dim(self) -> int:
+        return self.in_channels * self.temporal_patch_size * self.patch_size * self.patch_size
+
+    @property
+    def merge_unit(self) -> int:
+        return self.spatial_merge_size * self.spatial_merge_size
+
+    @classmethod
+    def from_hf(cls, vision_config) -> "MiMoVisionSpec":
+        """``hf_config.vision_config`` (dict in the HF config, object in vLLM) -> spec.
+
+        Defaults follow the HF remote code (``qk_channels`` 64, ``rms_norm_eps``
+        1e-6, ``in_chans``). Raises ``ValueError`` on values this implementation
+        does not support.
+        """
+        if vision_config is None:
+            raise ValueError("vision_config is missing")
+        depth = int(_get(vision_config, "depth"))
+        num_heads = int(_get(vision_config, "num_heads"))
+        num_kv_heads = int(_get(vision_config, "num_key_value_heads", num_heads))
+        types = _get(vision_config, "vit_window_attn_types") or [-1] * depth
+        spec = cls(
+            depth=depth,
+            hidden_size=int(_get(vision_config, "hidden_size")),
+            intermediate_size=int(_get(vision_config, "intermediate_size")),
+            num_heads=num_heads,
+            num_kv_heads=num_kv_heads,
+            head_dim=int(_get(vision_config, "qk_channels", 64)),
+            out_hidden_size=int(_get(vision_config, "out_hidden_size")),
+            patch_size=int(_get(vision_config, "patch_size")),
+            temporal_patch_size=int(_get(vision_config, "temporal_patch_size")),
+            in_channels=int(_get(vision_config, "in_channels", None)
+                            or _get(vision_config, "in_chans", 3)),
+            spatial_merge_size=int(_get(vision_config, "spatial_merge_size", 2)),
+            fullatt_block_indexes=tuple(int(i) for i in
+                                        (_get(vision_config, "fullatt_block_indexes") or [])),
+            window_attn_types=tuple(int(t) for t in types),
+            window=int(_get(vision_config, "visual_token_window_size", -1)),
+            use_sink=bool(_get(vision_config, "use_sink", False)),
+            rms_norm_eps=float(_get(vision_config, "rms_norm_eps", 1e-6)),
+        )
+        act = _get(vision_config, "hidden_act", "silu")
+        if act != "silu":
+            raise ValueError(f"vision hidden_act={act!r}: only 'silu' (SwiGLU) is supported")
+        if len(spec.window_attn_types) != depth or set(spec.window_attn_types) - {-1, 0, 1}:
+            raise ValueError(f"vit_window_attn_types={list(spec.window_attn_types)}: "
+                             f"need {depth} values in {{-1, 0, 1}}")
+        if any(not 0 <= i < depth for i in spec.fullatt_block_indexes):
+            raise ValueError(f"fullatt_block_indexes={list(spec.fullatt_block_indexes)} "
+                             f"out of range for depth {depth}")
+        if len(spec.fullatt_block_indexes) < depth and spec.window <= 0:
+            raise ValueError(f"visual_token_window_size={spec.window}: window blocks need a "
+                             "positive window")
+        if num_heads % num_kv_heads:
+            raise ValueError(f"num_heads={num_heads} not a multiple of "
+                             f"num_key_value_heads={num_kv_heads}")
+        if spec.head_dim % 4:
+            raise ValueError(f"qk_channels={spec.head_dim} must be a multiple of 4 (2D RoPE)")
+        return spec
+
+    @property
+    def group_align(self) -> int:
+        """Frame groups start at multiples of this (the window chunk, 64)."""
+        return self.window if self.window > 0 else 64
+
+
+# =============================================================================
+# Section 2: building blocks
+# =============================================================================
+@allow_in_graph_cacheable
+def gelu(x: torch.Tensor) -> torch.Tensor:
+    """Exact (erf) GELU, traceable on Neuron (libtorch_neuronx_lite patches F.gelu)."""
+    return 0.5 * x * (1.0 + torch.erf(x / 1.4142135623730951))
+
+
+class _GELU(nn.Module):
+    """Merger GELU in the GPU dtype path (rule AA): ``nn.GELU`` on a BF16 input computes
+    in FP32 and rounds once to BF16, so the erf form runs in FP32 here."""
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return gelu(x.to(torch.float32)).to(x.dtype)
+
+
+class MiMoVisionRMSNorm(nn.Module):
+    """RMSNorm in the GPU dtype path (vLLM ``RMSNorm``, rule AA): FP32 statistics, the
+    normalised input rounded back to the activation dtype, then multiplied by the weight
+    in that dtype. HF uses ``nn.RMSNorm``."""
+
+    def __init__(self, hidden_size: int, eps: float, dtype: torch.dtype):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size, dtype=dtype), requires_grad=False)
+        self.eps = eps
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        h = x.to(torch.float32)
+        h = h * torch.rsqrt(h.pow(2).mean(-1, keepdim=True) + self.eps)
+        return h.to(x.dtype) * self.weight.to(x.dtype)
+
+
+class MiMoVisionLayerNorm(nn.Module):
+    """``nn.LayerNorm`` with a zero bias (HF ``MiMoVisionPatchMerger.ln_q``; the
+    checkpoint has no bias), FP32 statistics."""
+
+    def __init__(self, hidden_size: int, eps: float, dtype: torch.dtype):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size, dtype=dtype), requires_grad=False)
+        self.eps = eps
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        h = F.layer_norm(x.to(torch.float32), (x.shape[-1],),
+                         self.weight.to(torch.float32), None, self.eps)
+        return h.to(x.dtype)
+
+
+def apply_vision_rope(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """HF ``_apply_rotary_pos_emb_vision``: FP32, rotate_half over all dims.
+
+    x ``[n, heads, d]``; cos/sin ``[n, d]`` FP32."""
+    xf = x.to(torch.float32)
+    half = xf.shape[-1] // 2
+    rot = torch.cat((-xf[..., half:], xf[..., :half]), dim=-1)
+    out = xf * cos.unsqueeze(-2) + rot * sin.unsqueeze(-2)
+    return out.to(x.dtype)
+
+
+def _band_index(n_chunks: int, chunk: int, start, device) -> torch.Tensor:
+    """``[n_chunks, 3*chunk]`` row index of the key band of ``n_chunks`` query chunks whose
+    first row is ``start`` (int, or a 1-element tensor for the sequence-parallel shard):
+    for chunk c the rows of chunks c-1, c, c+1 (may fall outside the sequence)."""
+    return (start - chunk) + (torch.arange(n_chunks, device=device) * chunk).unsqueeze(1) + \
+        torch.arange(3 * chunk, device=device).unsqueeze(0)
+
+
+def _gather_band(x: torch.Tensor, raw: torch.Tensor, fill) -> torch.Tensor:
+    """Rows ``raw`` of ``x`` (``fill`` outside ``[0, len(x))``): ``[*raw.shape, ...]``.
+
+    Gathered with one clamped index (index_select + where), not concatenated: the T38
+    form (a padding chunk concatenated before / after, three shifted slices) fails in
+    neuronx-cc with NCC_IXRO002 "Undefined SB Memloc ... deconcat" inside a vision
+    block (T39 probe ``reports/tasks/T39/tests/window_block_probe_row.json``); the two
+    forms give bit-identical results on CPU."""
+    n = x.shape[0]
+    inside = ((raw >= 0) & (raw < n)).reshape(tuple(raw.shape) + (1,) * (x.dim() - 1))
+    rows = x.index_select(0, raw.clamp(0, n - 1).reshape(-1))
+    rows = rows.reshape(tuple(raw.shape) + tuple(x.shape[1:]))
+    return torch.where(inside, rows, torch.full_like(rows, fill))
+
+
+def _band(x: torch.Tensor, chunk: int, fill) -> torch.Tensor:
+    """``[n, ...]`` -> ``[n/chunk, 3*chunk, ...]``: for chunk c the rows of chunks
+    c-1, c, c+1 (``fill`` for the rows before the first / after the last chunk)."""
+    n = x.shape[0]
+    return _gather_band(x, _band_index(n // chunk, chunk, 0, x.device), fill)
+
+
+def _bmm_fp32(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    """``a [B, M, K] @ b [B, K, N]`` with FP32 accumulation and FP32 output.
+
+    Device: BF16 inputs, ``bmm(out_dtype=float32)`` (the form the FP8 linear layers use,
+    D-083). CPU (and FP32 inputs): the inputs upcast to FP32, since ``bmm`` with
+    ``out_dtype`` has no CPU kernel; BF16 products are exact in FP32, so the values are
+    the same."""
+    if a.device.type == "cpu" or a.dtype == torch.float32:
+        return torch.bmm(a.to(torch.float32), b.to(torch.float32))
+    return torch.bmm(a, b, out_dtype=torch.float32)
+
+
+def window_attention(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor,
+                     grp: torch.Tensor, loc: torch.Tensor, sinks, scale: float,
+                     window: int, q_start=None) -> torch.Tensor:
+    """Window attention ``|loc_i - loc_j| <= window`` inside a frame group, with the
+    per-head sink added to the logit of each frame group's key 0 (HF L669-723).
+
+    q ``[m, H, D]``, k/v ``[n, KV, D]`` (Q head h uses KV head ``h // (H/KV)``);
+    ``grp`` ``[n]`` int32 frame-group id (-1 = padding), ``loc`` ``[n]`` int32
+    position inside the frame group (padding: packed position); ``sinks`` ``[H]``
+    or None. The queries are rows ``[q_start, q_start + m)`` of the sequence (``q_start``
+    None: all ``n`` rows; a 1-element tensor: the sequence-parallel shard, D-153); ``m``
+    must be a multiple of ``window``. Memory O(m * 3w).
+
+    Arithmetic of the GPU path (vLLM ``mimo_v2_omni.py`` -> Triton
+    ``context_attention_fwd``, rule AA): q / k in the activation dtype (BF16) with FP32
+    accumulation and FP32 scores (``_bmm_fp32``), FP32 sink / mask / softmax,
+    probabilities cast to ``v.dtype`` for the value product.
+    """
+    m, H, D = q.shape
+    KV = k.shape[1]
+    G = H // KV
+    W = window
+    C = m // W
+    raw = _band_index(C, W, 0 if q_start is None else q_start, q.device)   # [C, 3W]
+    qc = q.reshape(C, W, KV, G, D)
+    kb = _gather_band(k, raw, 0)                    # [C, 3W, KV, D]
+    vb = _gather_band(v, raw, 0)                    # [C, 3W, KV, D]
+    gb = _gather_band(grp, raw, -2)                 # [C, 3W]; -2 = outside the sequence
+    lb = _gather_band(loc, raw, 0)
+    if q_start is None:
+        gq, lq = grp.reshape(C, W), loc.reshape(C, W)
+    else:
+        rows = q_start + torch.arange(m, device=q.device)
+        gq, lq = grp.index_select(0, rows).reshape(C, W), loc.index_select(0, rows).reshape(C, W)
+    visible = (gq.unsqueeze(-1) == gb.unsqueeze(1)) & \
+              ((lq.unsqueeze(-1) - lb.unsqueeze(1)).abs() <= W)       # [C, W, 3W]
+    qm = qc.permute(0, 2, 3, 1, 4).reshape(C * KV, G * W, D)
+    km = kb.permute(0, 2, 3, 1).reshape(C * KV, D, 3 * W)
+    scores = _bmm_fp32(qm, km).reshape(C, KV, G, W, 3 * W) * scale   # [C, KV, G, W, 3W]
+    if sinks is not None:
+        sink_key = ((lb == 0) & (gb >= 0)).to(torch.float32)          # [C, 3W]
+        bias = sinks.to(torch.float32).reshape(1, KV, G, 1, 1) * sink_key.reshape(C, 1, 1, 1, 3 * W)
+        scores = scores + bias
+    scores = scores.masked_fill(~visible.reshape(C, 1, 1, W, 3 * W),
+                                torch.finfo(torch.float32).min)
+    probs = torch.softmax(scores, dim=-1).to(v.dtype)
+    out = torch.einsum("ckgqj,cjkd->cqkgd", probs, vb)                 # [C, W, KV, G, D]
+    return out.reshape(m, H, D)
+
+
+def full_attention(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor,
+                   bound_min: torch.Tensor, bound_max: torch.Tensor, scale: float) -> torch.Tensor:
+    """Full attention inside each frame group via ``NF.flash_attention`` bounds.
+
+    q ``[m, H, D]``, k/v ``[n, KV, D]`` (``m == n``, or the sequence-parallel shard's
+    ``m`` queries against all ``n`` keys, D-153); bound_min/bound_max ``[m]`` int32 (key
+    range ``[min, max)`` of each query). Native GQA (KV batch < Q batch). More than
+    ``FLASH_MAX_LEN`` queries run the kernel on query chunks of ``FLASH_Q_CHUNK`` against
+    all keys; each query's softmax is over its whole key range either way.
+
+    The kernel reads ``bound_min``/``bound_max`` in groups of ``FLASH_Q_GROUP`` (128) query
+    rows per batch (nkilib ``attention_cte._setup_range_select_bounds``, decisions D-164),
+    so the bound path needs a query count that is a multiple of 128. A shard with fewer
+    rows (the 4096 bucket sequence parallel on TP 64: 64 queries, D-153) is padded to 128
+    with copies of its last query and bounds, and the extra rows are dropped."""
+    m, H, D = q.shape
+    pad = -m % FLASH_Q_GROUP
+    if pad:
+        idx = torch.arange(m + pad, device=q.device).clamp(max=m - 1)
+        q = q.index_select(0, idx)
+        bound_min = bound_min.index_select(0, idx)
+        bound_max = bound_max.index_select(0, idx)
+    mp = m + pad
+    qh = q.permute(1, 0, 2).contiguous()           # [H, mp, D]
+    kh = k.permute(1, 0, 2).contiguous()           # [KV, n, D]  (tp_k=True)
+    vh = v.permute(1, 0, 2).contiguous()           # [KV, n, D]
+    bmin = bound_min.reshape(1, mp, 1).expand(H, mp, 1).contiguous()
+    bmax = bound_max.reshape(1, mp, 1).expand(H, mp, 1).contiguous()
+    step = mp if mp <= FLASH_MAX_LEN else FLASH_Q_CHUNK
+    outs = [NF.flash_attention(qh[:, s:s + step], kh, vh, scale=scale, causal_mask=False,
+                               tp_q=True, tp_k=True, tp_out=False,
+                               bound_min=bmin[:, s:s + step], bound_max=bmax[:, s:s + step])
+            for s in range(0, mp, step)]   # each [H, step, D]
+    out = outs[0] if len(outs) == 1 else torch.cat(outs, dim=1)
+    if pad:
+        out = out[:, :m]
+    return out.permute(1, 0, 2)
+
+
+class MiMoVisionAttention(nn.Module):
+    def __init__(self, spec: MiMoVisionSpec, full_attn: bool, use_sinks: bool,
+                 dtype: torch.dtype):
+        super().__init__()
+        self.num_heads = spec.num_heads
+        self.num_kv_heads = spec.num_kv_heads
+        self.head_dim = spec.head_dim
+        self.scale = spec.head_dim ** -0.5
+        self.window = spec.window
+        self.full_attn = full_attn
+        qkv_dim = (spec.num_heads + 2 * spec.num_kv_heads) * spec.head_dim
+        self.qkv = nn.Linear(spec.hidden_size, qkv_dim, bias=True, dtype=dtype)
+        self.proj = nn.Linear(spec.num_heads * spec.head_dim, spec.hidden_size, bias=True,
+                              dtype=dtype)
+        self.sinks = (nn.Parameter(torch.zeros(spec.num_heads, dtype=torch.float32),
+                                   requires_grad=False) if use_sinks else None)
+
+    def forward(self, x, cos, sin, grp, loc, bound_min, bound_max, group=None, q_start=None):
+        """``x``/``cos``/``sin``/``bound_*`` are this rank's rows; with ``group`` (sequence
+        parallel, D-153) ``x`` is the shard starting at row ``q_start`` and k/v are
+        all-gathered to the whole sequence; ``grp``/``loc`` always cover the whole sequence."""
+        m = x.shape[0]
+        qkv = self.qkv(x)
+        qd = self.num_heads * self.head_dim
+        kd = self.num_kv_heads * self.head_dim
+        q = qkv[:, :qd].reshape(m, self.num_heads, self.head_dim)
+        k = qkv[:, qd:qd + kd].reshape(m, self.num_kv_heads, self.head_dim)
+        v = qkv[:, qd + kd:].reshape(m, self.num_kv_heads, self.head_dim)
+        q = apply_vision_rope(q, cos, sin)
+        k = apply_vision_rope(k, cos, sin)
+        if group is not None:
+            # >>> PARALLELISM: sequence parallel, keys / values of all ranks <<<
+            k = group.all_gather(k.contiguous(), dim=0)
+            v = group.all_gather(v.contiguous(), dim=0)
+        if self.full_attn:
+            out = full_attention(q, k, v, bound_min, bound_max, self.scale)
+        else:
+            out = window_attention(q, k, v, grp, loc, self.sinks, self.scale, self.window,
+                                   q_start=q_start)
+        return self.proj(out.reshape(m, self.num_heads * self.head_dim))
+
+
+class MiMoVisionMLP(nn.Module):
+    def __init__(self, spec: MiMoVisionSpec, dtype: torch.dtype):
+        super().__init__()
+        self.gate_proj = nn.Linear(spec.hidden_size, spec.intermediate_size, bias=True, dtype=dtype)
+        self.up_proj = nn.Linear(spec.hidden_size, spec.intermediate_size, bias=True, dtype=dtype)
+        self.down_proj = nn.Linear(spec.intermediate_size, spec.hidden_size, bias=True, dtype=dtype)
+
+    def forward(self, x):
+        return self.down_proj(F.silu(self.gate_proj(x)) * self.up_proj(x))
+
+
+class MiMoVisionBlock(nn.Module):
+    def __init__(self, spec: MiMoVisionSpec, index: int, dtype: torch.dtype):
+        super().__init__()
+        full_attn = index in spec.fullatt_block_indexes
+        self.norm1 = MiMoVisionRMSNorm(spec.hidden_size, spec.rms_norm_eps, dtype)
+        self.norm2 = MiMoVisionRMSNorm(spec.hidden_size, spec.rms_norm_eps, dtype)
+        # <-- MODEL-SPECIFIC: sinks only on window blocks (HF L821)
+        self.attn = MiMoVisionAttention(spec, full_attn, spec.use_sink and not full_attn, dtype)
+        self.mlp = MiMoVisionMLP(spec, dtype)
+
+    def forward(self, x, cos, sin, grp, loc, bound_min, bound_max, group=None, q_start=None):
+        x = x + self.attn(self.norm1(x), cos, sin, grp, loc, bound_min, bound_max,
+                          group, q_start)
+        return x + self.mlp(self.norm2(x))
+
+
+class MiMoVisionMerger(nn.Module):
+    def __init__(self, spec: MiMoVisionSpec, merger_norm: str, dtype: torch.dtype):
+        super().__init__()
+        norm_cls = MiMoVisionRMSNorm if merger_norm == "rms" else MiMoVisionLayerNorm
+        self.ln_q = norm_cls(spec.hidden_size, 1e-6, dtype)
+        self.merged = spec.hidden_size * spec.merge_unit
+        # <-- MODEL-SPECIFIC: no bias (F-MERGER); names mlp.0 / mlp.2 as in the checkpoint
+        self.mlp = nn.Sequential(
+            nn.Linear(self.merged, self.merged, bias=False, dtype=dtype),
+            _GELU(),
+            nn.Linear(self.merged, spec.out_hidden_size, bias=False, dtype=dtype),
+        )
+
+    def forward(self, x):
+        return self.mlp(self.ln_q(x).reshape(-1, self.merged))
+
+
+# =============================================================================
+# Section 3: encoder
+# =============================================================================
+class MiMoVisionEncoder(nn.Module):
+    """Vision tower for one packed bucket. Inputs (all from ``build_vision_inputs``):
+
+    * ``pixel_values`` ``[n, patch_dim]`` (row order, frame groups 64-aligned)
+    * ``cos``/``sin`` ``[n, head_dim]`` FP32 RoPE for the row order
+    * ``col_index``/``row_index`` ``[n]`` int32: gather index into column order and back
+    * ``grp``/``loc`` ``[n]`` int32 window-block masks, ``bound_min``/``bound_max``
+      ``[n]`` int32 full-block key ranges
+
+    Returns ``[n / merge_unit, out_hidden_size]`` merged tokens (row order; rows of
+    padding are garbage and dropped by the host).
+    """
+
+    def __init__(self, spec: MiMoVisionSpec, dtype: torch.dtype = torch.bfloat16,
+                 merger_norm: str = "rms"):
+        super().__init__()
+        if merger_norm not in _MERGER_NORMS:
+            raise ValueError(f"merger_norm={merger_norm!r} not in {_MERGER_NORMS}")
+        self.spec = spec
+        self.merger_norm = merger_norm
+        self.patch_embed = nn.Linear(spec.patch_dim, spec.hidden_size, bias=False, dtype=dtype)
+        self.blocks = nn.ModuleList(MiMoVisionBlock(spec, i, dtype) for i in range(spec.depth))
+        self.merger = MiMoVisionMerger(spec, merger_norm, dtype)
+        self.group = None  # serving TP group of the sequence-parallel buckets (D-153)
+
+    @property
+    def dtype(self) -> torch.dtype:
+        return self.patch_embed.weight.dtype
+
+    def set_sequence_group(self, group) -> None:
+        """Serving: run buckets whose per-rank share is a multiple of ``seq_align`` rows
+        sequence parallel over ``group`` (the TP group, decisions D-153); None (offline,
+        tests) keeps every bucket replicated."""
+        self.group = group
+
+    @property
+    def seq_align(self) -> int:
+        """Shard granularity: whole window chunks (64) and whole merge units (4)."""
+        return math.lcm(self.spec.group_align, self.spec.merge_unit)
+
+    def _seq_group(self, n: int):
+        g = self.group
+        if g is None or g.world_size <= 1 or n % (g.world_size * self.seq_align):
+            return None
+        return g
+
+    def forward(self, pixel_values, cos, sin, col_index, row_index, grp, loc,
+                bound_min, bound_max):
+        group = self._seq_group(pixel_values.shape[0])
+        if group is not None:
+            return self._forward_seq_parallel(group, pixel_values, cos, sin, col_index,
+                                              row_index, grp, loc, bound_min, bound_max)
+        types = self.spec.window_attn_types
+        x = self.patch_embed(pixel_values.to(self.dtype))
+        col_cos = cos.index_select(0, col_index)
+        col_sin = sin.index_select(0, col_index)
+        for i, blk in enumerate(self.blocks):
+            # <-- MODEL-SPECIFIC: enter / leave the column order (HF L899-905)
+            if types[i] == 1 and (i == 0 or types[i - 1] != 1):
+                x = x.index_select(0, col_index)
+            if i > 0 and types[i] != 1 and types[i - 1] == 1:
+                x = x.index_select(0, row_index)
+            c, s = (col_cos, col_sin) if types[i] == 1 else (cos, sin)
+            x = blk(x, c, s, grp, loc, bound_min, bound_max)
+        if types[-1] == 1:
+            x = x.index_select(0, row_index)
+        return self.merger(x)
+
+    def _forward_seq_parallel(self, group, pixel_values, cos, sin, col_index, row_index,
+                              grp, loc, bound_min, bound_max):
+        """Same result as the replicated forward, each rank on ``n / world_size`` rows
+        (decisions D-153).
+
+        Rank ``r`` owns packed positions ``[r*m, (r+1)*m)`` in whichever order (row or
+        column) the current block uses. Everything per row (patch embed, norms, qkv,
+        RoPE, proj, MLP, merger) runs on the shard; attention gathers k/v of all ranks
+        (``MiMoVisionAttention``). Entering / leaving the column order gathers ``x`` and
+        picks this shard's rows of ``col_index`` / ``row_index``. ``grp``/``loc``/bounds
+        are per position and the same in both orders (the column order permutes inside a
+        frame group). The merged rows of all ranks are gathered at the end; the shard
+        is a multiple of the merge unit, so merge units never cross ranks."""
+        types = self.spec.window_attn_types
+        n = pixel_values.shape[0]
+        m = n // group.world_size
+        # >>> PARALLELISM: sequence parallel over the TP group (rank tensor, SPMD) <<<
+        start = group.rank_in_group_tensor.to(torch.int64) * m           # [1]
+        rows = start + torch.arange(m, device=pixel_values.device, dtype=torch.int64)
+        col_rows = col_index.index_select(0, rows)
+        row_rows = row_index.index_select(0, rows)
+        x = self.patch_embed(pixel_values.index_select(0, rows).to(self.dtype))
+        row_cos, row_sin = cos.index_select(0, rows), sin.index_select(0, rows)
+        col_cos, col_sin = cos.index_select(0, col_rows), sin.index_select(0, col_rows)
+        bmin, bmax = bound_min.index_select(0, rows), bound_max.index_select(0, rows)
+        for i, blk in enumerate(self.blocks):
+            # <-- MODEL-SPECIFIC: enter / leave the column order (HF L899-905)
+            if types[i] == 1 and (i == 0 or types[i - 1] != 1):
+                x = group.all_gather(x, dim=0).index_select(0, col_rows)
+            if i > 0 and types[i] != 1 and types[i - 1] == 1:
+                x = group.all_gather(x, dim=0).index_select(0, row_rows)
+            c, s = (col_cos, col_sin) if types[i] == 1 else (row_cos, row_sin)
+            x = blk(x, c, s, grp, loc, bmin, bmax, group, start)
+        if types[-1] == 1:
+            x = group.all_gather(x, dim=0).index_select(0, row_rows)
+        return group.all_gather(self.merger(x), dim=0)
+
+
+class MiMoVisionCacheEncoder(MiMoVisionEncoder):
+    """Serving graph of the vision tower (T39, decisions D-147): the encoder of one
+    bucket plus the scatter of its merged rows into the runner's on-device encoder
+    cache, so the embeddings never leave the device (same contract as the qwen3_vl
+    encoder: the runner compiles this module as ``model.visual``, the worker warms
+    it up per bucket with ``encoder_cache_buffer`` / ``write_block_ids``).
+
+    Extra inputs (``plan_cache_writes``): ``dst_block`` / ``dst_row`` ``[n / merge_unit]``
+    int64, the cache block and row of every merged row (padding rows go to the
+    scratch block). ``write_block_ids`` is the worker's per-bucket block-id tensor;
+    the destinations here are per row, so it is accepted for the shared warmup
+    signature and not used. Returns the updated cache buffer (aliased)."""
+
+    def forward(self, pixel_values, cos, sin, col_index, row_index, grp, loc, bound_min,
+                bound_max, dst_block, dst_row, encoder_cache_buffer, write_block_ids=None):
+        merged = super().forward(pixel_values, cos, sin, col_index, row_index, grp, loc,
+                                 bound_min, bound_max)
+        encoder_cache_buffer.index_put_((dst_block, dst_row),
+                                        merged.to(encoder_cache_buffer.dtype))
+        return encoder_cache_buffer
+
+
+# =============================================================================
+# Section 4: weights
+# =============================================================================
+def load_vision_state(checkpoint_dir: str, dtype: torch.dtype = torch.bfloat16) -> dict:
+    """``visual.*`` tensors of a checkpoint (original or BF16 reference) -> encoder
+    state dict (``MiMoVisionEncoder.load_state_dict(strict=True)``).
+
+    The patch-embed Conv3d weight ``[hidden, C, T, P, P]`` becomes a matmul weight
+    ``[hidden, C*T*P*P]`` (the processor flattens each patch in (C, T, P, P) order).
+    Merger biases (present only in the BF16 reference checkpoint, added as zeros)
+    must be zero and are dropped; any other value raises ``ValueError``. Sinks are
+    kept in FP32.
+    """
+    from safetensors import safe_open
+
+    index_path = os.path.join(checkpoint_dir, "model.safetensors.index.json")
+    with open(index_path) as f:
+        weight_map = json.load(f)["weight_map"]
+    names = sorted(k for k in weight_map if k.startswith("visual."))
+    if not names:
+        raise KeyError(f"no visual.* tensors in {index_path}")
+    by_file: dict = {}
+    for name in names:
+        by_file.setdefault(weight_map[name], []).append(name)
+    state = {}
+    for fname, keys in sorted(by_file.items()):
+        with safe_open(os.path.join(checkpoint_dir, fname), framework="pt") as f:
+            for name in keys:
+                key = name[len("visual."):]
+                t = f.get_tensor(name)
+                if key.startswith("merger.") and key.endswith(".bias"):
+                    if torch.count_nonzero(t):
+                        raise ValueError(f"{name}: non-zero merger bias; the encoder has no "
+                                         "merger bias (F-MERGER)")
+                    continue
+                if key == "patch_embed.proj.weight":
+                    key = "patch_embed.weight"
+                    t = t.reshape(t.shape[0], -1)
+                state[key] = t.to(torch.float32 if key.endswith(".sinks") else dtype)
+    return state
+
+
+# =============================================================================
+# Section 5: host-side inputs, packing, validation
+# =============================================================================
+def _align(x: int, a: int) -> int:
+    return (x + a - 1) // a * a
+
+
+def _ceil_div(x: int, a: int) -> int:
+    return (x + a - 1) // a
+
+
+def vision_rope(spec: MiMoVisionSpec, h: int, w: int):
+    """RoPE cos/sin ``[h*w, head_dim]`` (FP32) of one frame group, HF ``rot_pos_emb``."""
+    m = spec.spatial_merge_size
+    rd = spec.head_dim // 2
+    inv_freq = 1.0 / (10000.0 ** (torch.arange(0, rd, 2, dtype=torch.float32) / rd))
+    table = torch.outer(torch.arange(max(h, w), dtype=torch.float32), inv_freq)
+    hpos = torch.arange(h).unsqueeze(1).expand(-1, w)
+    hpos = hpos.reshape(h // m, m, w // m, m).permute(0, 2, 1, 3).flatten()
+    wpos = torch.arange(w).unsqueeze(0).expand(h, -1)
+    wpos = wpos.reshape(h // m, m, w // m, m).permute(0, 2, 1, 3).flatten()
+    rot = table[torch.stack([hpos, wpos], dim=-1)].flatten(1)
+    emb = torch.cat((rot, rot), dim=-1)
+    return emb.cos(), emb.sin()
+
+
+def column_order(spec: MiMoVisionSpec, h: int, w: int) -> torch.Tensor:
+    """Patch-level gather index (row order -> column order) of one frame group,
+    HF ``get_window_index_1d(col=True)`` expanded from merge units to patches."""
+    m = spec.spatial_merge_size
+    unit = spec.merge_unit
+    units = torch.arange((h // m) * (w // m)).reshape(h // m, w // m).transpose(0, 1).reshape(-1)
+    return (units.unsqueeze(1) * unit + torch.arange(unit)).reshape(-1)
+
+
+@dataclass
+class VisionBatch:
+    """One encoder call: ``bucket`` patches, frame groups ``units[i]`` at ``offsets[i]``."""
+    bucket: int
+    units: list
+    offsets: list
+    used: int
+
+
+def frame_groups(grid_thw):
+    """``[num_items, 3]`` (t, h, w) -> list of (item, h, w) frame groups in order."""
+    out = []
+    for item, (t, h, w) in enumerate(torch.as_tensor(grid_thw).tolist()):
+        out.extend((item, int(h), int(w)) for _ in range(int(t)))
+    return out
+
+
+def pack_frame_groups(sizes, buckets=VISION_BUCKETS, align: int = 64):
+    """Greedy, order-preserving packing of frame groups (patch counts ``sizes``) into
+    encoder calls. Each group starts at a multiple of ``align``; a call closes when
+    the next group does not fit the largest bucket; the call uses the smallest
+    bucket that holds it. A single group larger than the largest bucket raises
+    ``ValueError`` (the request is rejected, design 15.1)."""
+    buckets = sorted(buckets)
+    largest = buckets[-1]
+    for b in buckets:
+        if b % align:
+            raise ValueError(f"vision bucket {b} is not a multiple of {align}")
+    batches = []
+    units, offsets, used = [], [], 0
+    for i, s in enumerate(sizes):
+        span = _align(int(s), align)
+        if span > largest:
+            raise ValueError(f"frame group {i} has {s} patches; one image or video frame "
+                             f"group may have at most {largest} patches (largest vision bucket)")
+        if used + span > largest:
+            batches.append((units, offsets, used))
+            units, offsets, used = [], [], 0
+        units.append(i)
+        offsets.append(used)
+        used += span
+    if units:
+        batches.append((units, offsets, used))
+    return [VisionBatch(bucket=next(b for b in buckets if b >= used), units=u, offsets=o, used=used)
+            for u, o, used in batches]
+
+
+def build_vision_inputs(spec: MiMoVisionSpec, batch: VisionBatch, unit_pixels, unit_hw,
+                        dtype: torch.dtype = torch.bfloat16) -> dict:
+    """Host tensors of one encoder call (keyword arguments of ``MiMoVisionEncoder``).
+
+    ``unit_pixels[i]`` ``[h*w, patch_dim]`` and ``unit_hw[i]`` = (h, w) for the
+    groups in ``batch.units`` (same order). Padding: zero pixels, identity column
+    order, ``grp = -1``, ``loc`` = packed position, key range = itself."""
+    n = batch.bucket
+    pos = torch.arange(n, dtype=torch.int32)
+    pixels = torch.zeros(n, spec.patch_dim, dtype=dtype)
+    cos = torch.ones(n, spec.head_dim, dtype=torch.float32)
+    sin = torch.zeros(n, spec.head_dim, dtype=torch.float32)
+    col = pos.clone()
+    grp = torch.full((n,), -1, dtype=torch.int32)
+    loc = pos.clone()
+    bmin = pos.clone()
+    bmax = pos + 1
+    for g, (off, px, (h, w)) in enumerate(zip(batch.offsets, unit_pixels, unit_hw)):
+        s = h * w
+        if px.shape != (s, spec.patch_dim):
+            raise ValueError(f"frame group {g}: pixel_values {tuple(px.shape)} != {(s, spec.patch_dim)}")
+        if h % spec.spatial_merge_size or w % spec.spatial_merge_size:
+            raise ValueError(f"frame group {g}: grid {h}x{w} not divisible by spatial_merge_size")
+        sl = slice(off, off + s)
+        pixels[sl] = px.to(dtype)
+        cos[sl], sin[sl] = vision_rope(spec, h, w)
+        col[sl] = (off + column_order(spec, h, w)).to(torch.int32)
+        grp[sl] = g
+        loc[sl] = torch.arange(s, dtype=torch.int32)
+        bmin[sl] = off
+        bmax[sl] = off + s
+    return dict(pixel_values=pixels, cos=cos, sin=sin, col_index=col,
+                row_index=torch.argsort(col).to(torch.int32), grp=grp, loc=loc,
+                bound_min=bmin, bound_max=bmax)
+
+
+def encode_vision(encoder: MiMoVisionEncoder, pixel_values: torch.Tensor, grid_thw,
+                  buckets=VISION_BUCKETS) -> torch.Tensor:
+    """Images / videos -> merged embeddings ``[sum(t*h*w) / merge_unit, out_hidden]``
+    in the HF order (same result as HF ``visual(pixel_values, grid_thw)``).
+
+    Frame groups are packed by ``pack_frame_groups`` and each call runs the encoder
+    on one bucket; outputs are concatenated in the original order."""
+    spec = encoder.spec
+    groups = frame_groups(grid_thw)
+    sizes = [h * w for _, h, w in groups]
+    if pixel_values.shape[0] != sum(sizes):
+        raise ValueError(f"pixel_values has {pixel_values.shape[0]} rows, grid_thw needs {sum(sizes)}")
+    starts = [0]
+    for s in sizes:
+        starts.append(starts[-1] + s)
+    device = encoder.patch_embed.weight.device
+    out = [None] * len(groups)
+    for batch in pack_frame_groups(sizes, buckets, spec.group_align):
+        inputs = build_vision_inputs(
+            spec, batch,
+            [pixel_values[starts[u]:starts[u + 1]] for u in batch.units],
+            [groups[u][1:] for u in batch.units], dtype=encoder.dtype)
+        merged = encoder(**{k: t.to(device) for k, t in inputs.items()})
+        for u, off in zip(batch.units, batch.offsets):
+            out[u] = merged[off // spec.merge_unit:(off + sizes[u]) // spec.merge_unit]
+    return torch.cat(out, dim=0)
+
+
+def validate_mm_processor_kwargs(mm_processor_kwargs, spec: MiMoVisionSpec,
+                                 buckets=VISION_BUCKETS) -> None:
+    """``--mm-processor-kwargs`` check (design 15.2): ``image_max_pixels`` and
+    ``video_max_pixels`` must be ints in [8192, 8388608] whose largest frame group
+    fits the largest compiled bucket. Raises ``ValueError`` (at startup)."""
+    if not mm_processor_kwargs:
+        return
+    largest = max(buckets)
+    for key in _MM_PIXEL_KEYS:
+        if key not in mm_processor_kwargs:
+            continue
+        val = mm_processor_kwargs[key]
+        if isinstance(val, bool) or not isinstance(val, int):
+            raise ValueError(f"--mm-processor-kwargs {key}={val!r}: must be an integer")
+        if not MM_MIN_PIXELS <= val <= MM_MAX_PIXELS:
+            raise ValueError(f"--mm-processor-kwargs {key}={val}: must be in "
+                             f"[{MM_MIN_PIXELS}, {MM_MAX_PIXELS}]")
+        patches = _align(val // (spec.patch_size * spec.patch_size), spec.group_align)
+        if patches > largest:
+            raise ValueError(f"--mm-processor-kwargs {key}={val}: up to {patches} patches per "
+                             f"frame group, largest compiled vision bucket is {largest}")
+
+
+# =============================================================================
+# Section 6: serving -- on-device encoder cache (T39, decisions D-147)
+# =============================================================================
+def cache_write_block_count(bucket: int, encoder_neuron_config) -> int:
+    """Length of the worker's ``write_block_ids`` for ``bucket`` (the shape the encoder
+    warmup traces; ``NeuronWorker._build_encoder_trace_jobs`` / ``_warmup_encoder``)."""
+    block = encoder_neuron_config.encoder_attention_block_size
+    dp = max(int(encoder_neuron_config.dp_size or 1), 1)
+    return _ceil_div(_ceil_div(bucket, block), dp) * dp
+
+
+def vision_synthetic_inputs(spec: MiMoVisionSpec, bucket: int, dtype: torch.dtype,
+                            device) -> dict:
+    """Warmup inputs of ``MiMoVisionCacheEncoder`` for ``bucket`` (all padding), with the
+    same shapes and dtypes as ``plan_cache_writes`` produces for that bucket. The cache
+    destinations are block 0 (the worker passes the real buffer; real items overwrite
+    the rows they own)."""
+    inputs = build_vision_inputs(spec, VisionBatch(bucket=bucket, units=[], offsets=[], used=0),
+                                 [], [], dtype=dtype)
+    m = bucket // spec.merge_unit
+    inputs["dst_block"] = torch.zeros(m, dtype=torch.int64)
+    inputs["dst_row"] = torch.zeros(m, dtype=torch.int64)
+    return {k: t.to(device) for k, t in inputs.items()}
+
+
+def plan_cache_writes(spec: MiMoVisionSpec, pixel_values: torch.Tensor, grid_thw,
+                      item_block_ids, cache_block_size: int, scratch_block_id: int,
+                      buckets=VISION_BUCKETS, dtype: torch.dtype = torch.bfloat16):
+    """Host side of one ``embed_multimodal`` call: frame groups of all items (images, or
+    videos of one modality, in order) packed into encoder calls (``pack_frame_groups``),
+    and for each call the inputs of ``MiMoVisionCacheEncoder`` except the cache tensors.
+
+    Item ``i`` owns ``item_block_ids[i]``; its merged tokens (frame groups in order) are
+    stored densely, token ``k`` at block ``item_block_ids[i][k // cache_block_size]`` row
+    ``k % cache_block_size`` -- the layout ``EncoderCacheBlocks.dense_tokens_per_block``
+    describes, which ``NeuronModelRunner._gather_mm_embeddings`` reads. Padding rows of a
+    call write to ``scratch_block_id``. Returns ``[(VisionBatch, inputs), ...]``."""
+    grid = torch.as_tensor(grid_thw).reshape(-1, 3)
+    groups = frame_groups(grid)
+    sizes = [h * w for _, h, w in groups]
+    if pixel_values.shape[0] != sum(sizes):
+        raise ValueError(f"pixel_values has {pixel_values.shape[0]} rows, grid_thw needs {sum(sizes)}")
+    if len(item_block_ids) != grid.shape[0]:
+        raise ValueError(f"{len(item_block_ids)} block lists for {grid.shape[0]} items")
+    mu = spec.merge_unit
+    starts = [0]
+    for s in sizes:
+        starts.append(starts[-1] + s)
+    item_tokens = [0] * grid.shape[0]
+    token_off = []
+    for item, h, w in groups:
+        token_off.append(item_tokens[item])
+        item_tokens[item] += h * w // mu
+    for i, (blocks, n) in enumerate(zip(item_block_ids, item_tokens)):
+        if len(blocks) * cache_block_size < n:
+            raise ValueError(f"item {i}: {n} merged tokens do not fit {len(blocks)} cache "
+                             f"blocks of {cache_block_size}")
+    plans = []
+    for batch in pack_frame_groups(sizes, buckets, spec.group_align):
+        inputs = build_vision_inputs(
+            spec, batch, [pixel_values[starts[u]:starts[u + 1]] for u in batch.units],
+            [groups[u][1:] for u in batch.units], dtype=dtype)
+        m = batch.bucket // mu
+        dst_block = torch.full((m,), scratch_block_id, dtype=torch.int64)
+        dst_row = torch.arange(m, dtype=torch.int64) % cache_block_size
+        for u, off in zip(batch.units, batch.offsets):
+            blocks = torch.as_tensor(item_block_ids[groups[u][0]], dtype=torch.int64)
+            k = token_off[u] + torch.arange(sizes[u] // mu, dtype=torch.int64)
+            sl = slice(off // mu, off // mu + sizes[u] // mu)
+            dst_block[sl] = blocks[k // cache_block_size]
+            dst_row[sl] = k % cache_block_size
+        inputs["dst_block"] = dst_block
+        inputs["dst_row"] = dst_row
+        plans.append((batch, inputs))
+    return plans
+
+
+def item_merged_tokens(spec: MiMoVisionSpec, grid_thw) -> list:
+    """Merged tokens per item (``t * h * w / merge_unit``)."""
+    return [int(t) * int(h) * int(w) // spec.merge_unit
+            for t, h, w in torch.as_tensor(grid_thw).reshape(-1, 3).tolist()]
+
+
+def encoder_blocks_per_request(max_model_len: int, cache_block_size: int, max_items: int) -> int:
+    """Upper bound of the encoder-cache blocks one request reads in a prefill step: the
+    vision tokens of a request are at most ``max_model_len`` and every item stores its
+    tokens densely from a fresh block, so it wastes at most one partial block."""
+    return _ceil_div(max_model_len, cache_block_size) + max_items
