+++ b/vllm_neuron/model/mimo_v2/model.py
@@ -0,0 +1,804 @@
+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 (MiMo-V2.6-Flash) text backbone, BF16 (design 3.1-3.4)
+===============================================================
+
+Structural template: ``gpt_oss/model_bf16.py`` (MoE + EP + SWA + sink, SP
+prefill). ``# >>> PARALLELISM <<<`` blocks follow gpt_oss; ``# <-- MODEL-SPECIFIC``
+blocks follow the HF remote code ``modeling_mimo_v2.py`` (snapshot b12f557).
+
+* embed -> 48 x [RMSNorm -> attention -> +res -> RMSNorm -> dense MLP | MoE -> +res]
+  -> final RMSNorm -> lm_head -> on-device sampler.
+* Attention: ``attention.py`` (torch core; QK 192 / V 128 exceed the shared
+  kernels' 128 cap). MoE / dense MLP: ``moe.py``.
+* Parallelism: TP over the full TP group, sequence parallel in prefill
+  (``T / tp`` tokens per rank between layers), optional pure EP for the routed
+  experts; every collective uses the one TP group (unified sp_group rule).
+  Attention-DP, MLP-DP, embedding/lm_head-DP and cross-DP EP are not supported
+  (``ValueError``).
+* Weights come from ``weight_loaders.load_rank_state`` (pure function shared with
+  the offline checks); ``load_weights`` renames its keys to parameters and
+  checks that every parameter is covered.
+* Vision (T39, D-147): with image / video inputs enabled the model also holds the
+  vision tower ``visual`` (``vision_encoder.MiMoVisionCacheEncoder``, replicated);
+  ``embed_multimodal`` writes its output into the runner's on-device encoder cache and
+  the prefill graph merges it over the pad tokens (``merge_multimodal_embeddings``).
+* Audio (T41, D-162..D-165): with audio inputs enabled the model also holds the two
+  audio towers ``audio_towers`` (``audio_encoder.MiMoAudioCacheEncoder``, BF16 with the RVQ in
+  FP32 as on GPU,
+  replicated), compiled by the runner as an auxiliary encoder tower
+  (``get_aux_encoder_attrs``); ``embed_multimodal`` runs one call per audio segment and
+  writes the embeddings into the same encoder cache (``<|audio_pad|>`` positions).
+"""
+
+import logging
+import os
+import time
+
+import torch
+from torch import nn
+from transformers import PretrainedConfig
+from vllm.distributed.parallel_state import get_tp_group
+from vllm.model_executor.models.interfaces import SupportsEagle3
+
+import vllm_neuron.functional as NF
+import vllm_neuron.nn as neuron_nn
+from vllm_neuron.functional.merge_multimodal_embeddings import merge_multimodal_embeddings
+from vllm_neuron.model.kv_cache import KVSpec, LayerSpec
+from vllm_neuron.model.neuron_config import EncoderNeuronConfig, NeuronConfig
+from vllm_neuron.nn.embedding import VocabDimShardedEmbedding
+from vllm_neuron.nn.sampler import Sampler
+from vllm_neuron.vllm.spec_decode.decorator import async_speculative_decoding
+
+from .attention import MiMoV2Attention, rope_cos_sin
+from .audio_encoder import (MiMoAudioCacheEncoder, audio_item_mels, audio_synthetic_inputs,
+                            audio_token_count, load_audio_cache_encoder_state,
+                            plan_audio_cache_writes)
+from .config import MiMoV2NeuronConfig
+from .moe import MiMoV2MLP, MiMoV2MoE, MiMoV2MoEFp8, round_to_bf16
+from .vision_encoder import (MiMoVisionCacheEncoder, cache_write_block_count,
+                             item_merged_tokens, load_vision_state, plan_cache_writes,
+                             vision_synthetic_inputs)
+from .weight_loaders import CONFIG_FILE, INDEX_FILE, detect_checkpoint_format, load_rank_state
+
+logger = logging.getLogger(__name__)
+
+# neuronx-cc backend limit on unrolled instructions for the vision encoder graphs (the
+# default is 5 M; the 32768-patch bucket needs about 5.84 M, NCC_ELUR015, D-151).
+ENCODER_MAX_INSTRUCTIONS = 10_000_000
+
+_UNKNOWN = object()  # vLLM model_config.quantization not available
+
+
+def _aux_output(hidden_states: torch.Tensor) -> torch.Tensor:
+    """DFlash auxiliary hidden state as a tensor of its own (T54a D-277).
+
+    Returning the residual stream itself as a graph output while the next layer keeps using it
+    changed the target's numerics on device (the DFlash server's prefill logprobs differed from
+    the off server's, MTP's did not; upstream #3 is the same kind of output aliasing). The values
+    are the same BF16 numbers: ``round_to_bf16`` of the FP32 upcast is exact, and its arithmetic
+    form (a Veltkamp split) is not folded back into an alias by the compiler."""
+    return round_to_bf16(hidden_states.to(torch.float32)).to(hidden_states.dtype)
+
+
+# =============================================================================
+# Section 1: RMSNorm
+# <-- MODEL-SPECIFIC: HF MiMoV2RMSNorm (FP32 variance). The weight multiply is
+# also done in FP32 (HF multiplies after casting back to BF16).
+# =============================================================================
+class MiMoV2RMSNorm(nn.Module):
+    def __init__(self, hidden_size: int, eps: float, dtype: torch.dtype):
+        super().__init__()
+        self.weight = nn.Parameter(torch.empty(hidden_size, dtype=dtype), requires_grad=False)
+        self.variance_epsilon = eps
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        x = hidden_states.to(torch.float32)
+        variance = x.pow(2).mean(-1, keepdim=True)
+        x = x * torch.rsqrt(variance + self.variance_epsilon)
+        return (self.weight.to(torch.float32) * x).to(hidden_states.dtype)
+
+
+# =============================================================================
+# Section 2: Decoder layer
+# =============================================================================
+class MiMoV2DecoderLayer(nn.Module):
+    def __init__(self, config: MiMoV2NeuronConfig, layer_idx: int):
+        super().__init__()
+        self.layer_idx = layer_idx
+        self.is_swa = config.is_swa_layer(layer_idx)
+        self.input_layernorm = MiMoV2RMSNorm(
+            config.hidden_size, config.layernorm_epsilon, config.torch_dtype)
+        self.post_attention_layernorm = MiMoV2RMSNorm(
+            config.hidden_size, config.layernorm_epsilon, config.torch_dtype)
+        attn_cls, mlp_cls, moe_cls = MiMoV2Attention, MiMoV2MLP, MiMoV2MoE
+        if config.mimo_precision == "fp8":
+            # FP8 qkv and dense MLP (design 6.2), FP8 experts (design 6.3) except the
+            # BF16 fallback layers; o_proj and router unchanged
+            from .fp8_linear import fp8_layer_classes
+
+            attn_cls, mlp_cls = fp8_layer_classes(config.mimo_fp8_linear)
+            if layer_idx not in config.mimo_bf16_expert_layers:
+                moe_cls = MiMoV2MoEFp8
+        self.self_attn = attn_cls(config, layer_idx)
+        # <-- MODEL-SPECIFIC: moe_layer_freq 0 = dense (layer 0), 1 = MoE
+        self.mlp = moe_cls(config) if config.is_moe_layer(layer_idx) else mlp_cls(config)
+
+    def forward(self, hidden_states: torch.Tensor, positions: torch.Tensor, rope: dict,
+                attn_metadata: dict, is_decode: bool) -> torch.Tensor:
+        residual = hidden_states
+        hidden_states = self.input_layernorm(hidden_states)
+        hidden_states = self.self_attn(
+            hidden_states, positions, rope[self.is_swa], attn_metadata, is_decode)
+        hidden_states = residual + hidden_states
+
+        residual = hidden_states
+        hidden_states = self.post_attention_layernorm(hidden_states)
+        hidden_states = self.mlp(hidden_states, positions, is_decode)
+        return residual + hidden_states
+
+
+# =============================================================================
+# Section 3: Backbone
+# >>> PARALLELISM: SP in prefill (embedding reduce-scatters to T/tp tokens,
+# final all-gather), replicated tokens in decode. <<<
+# =============================================================================
+class MiMoV2Model(nn.Module):
+    def __init__(self, config: MiMoV2NeuronConfig):
+        super().__init__()
+        self.config = config
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        self.embed_tokens = VocabDimShardedEmbedding(
+            vocab_size=config.vocab_size,
+            embed_dim=config.hidden_size,
+            dtype=config.torch_dtype,
+            tp_group=self.tp_group.device_group,
+        )
+        self.layers = nn.ModuleList(
+            [MiMoV2DecoderLayer(config, i) for i in range(config.num_hidden_layers)])
+        self.norm = MiMoV2RMSNorm(config.hidden_size, config.layernorm_epsilon,
+                                  config.torch_dtype)
+        # <-- MODEL-SPECIFIC: one RoPE table per layer type (theta 1e7 / 1e4)
+        self.rope_params = {
+            False: (int(config.head_dim * config.partial_rotary_factor), config.rope_theta),
+            True: (int(config.swa_head_dim * config.partial_rotary_factor),
+                   config.swa_rope_theta),
+        }
+        # DFlash (T63): capture layer indices, the input of layer i (= output of layer
+        # i - 1, the residual stream before any norm); i == num_hidden_layers is the last
+        # layer's output before the final norm (vLLM GPU ``_maybe_add_hidden_state``).
+        self.aux_hidden_state_layers: tuple[int, ...] = ()
+
+    def forward(self, input_ids: torch.Tensor, positions: torch.Tensor, attn_metadata: dict,
+                rank: torch.Tensor | None = None, inputs_embeds: torch.Tensor | None = None,
+                is_token_ids: torch.Tensor | None = None,
+                encoder_embedding_buffer: torch.Tensor | None = None,
+                encoder_block_ids: torch.Tensor | None = None,
+                encoder_positions: torch.Tensor | None = None):
+        """``[T, H]`` final-norm hidden states; with ``aux_hidden_state_layers`` set,
+        ``(hidden, [aux [T, H], ...])`` in the order of the layer indices.
+
+        Prefill with ``encoder_embedding_buffer`` (vision, T39): the image / video
+        embeddings in the on-device encoder cache replace the token embeddings at
+        ``encoder_positions`` (``NeuronModelRunner._gather_mm_embeddings``)."""
+        first = attn_metadata["layers.0.self_attn"]
+        is_decode = first["max_query_len"] <= first["decode_token_threshold"]
+
+        hidden_states = self.embed_tokens(input_ids, scatter_tokens=not is_decode, rank=rank)
+        if (not is_decode and self.world_size > 1 and inputs_embeds is not None
+                and is_token_ids is not None):
+            local_len = hidden_states.shape[0]
+            start = self.tp_group.rank_in_group * local_len
+            inputs_embeds = inputs_embeds[start:start + local_len]
+            is_token_ids = is_token_ids[start:start + local_len]
+        hidden_states = NF.merge_prompt_embeds(hidden_states, inputs_embeds, is_token_ids)
+        if not is_decode and encoder_embedding_buffer is not None:
+            # >>> PARALLELISM: SP prefill -- global positions mapped to this rank's
+            # T / tp rows (rows of other ranks are dropped). The NKI merge kernel reads
+            # the rank from the SPMD rank tensor (as qwen3_vl), not the scalar ``rank`` <<<
+            hidden_states, _ = merge_multimodal_embeddings(
+                hidden_states, encoder_embedding_buffer, encoder_block_ids, encoder_positions,
+                self.tp_group.rank_in_group_tensor)
+
+        rope = {is_swa: rope_cos_sin(positions, dim, theta)
+                for is_swa, (dim, theta) in self.rope_params.items()}
+        aux = {}
+        for idx, layer in enumerate(self.layers):
+            if idx in self.aux_hidden_state_layers:
+                aux[idx] = _aux_output(hidden_states)
+            hidden_states = layer(hidden_states, positions, rope, attn_metadata, is_decode)
+        if len(self.layers) in self.aux_hidden_state_layers:
+            aux[len(self.layers)] = _aux_output(hidden_states)
+        hidden_states = self.norm(hidden_states)
+
+        if not is_decode and self.world_size > 1:
+            hidden_states = self.tp_group.all_gather(hidden_states, dim=0)
+            aux = {i: self.tp_group.all_gather(a, dim=0) for i, a in aux.items()}
+        if not self.aux_hidden_state_layers:
+            return hidden_states
+        return hidden_states, [aux[i] for i in self.aux_hidden_state_layers]
+
+
+# =============================================================================
+# Section 4: LM head, sampling, KV spec, weight loading
+# =============================================================================
+def _vllm_model_quantization():
+    """vLLM ``model_config.quantization`` of the current config, or ``_UNKNOWN``."""
+    from vllm.config import get_current_vllm_config
+
+    model_config = get_current_vllm_config().model_config
+    if model_config is None:
+        return _UNKNOWN
+    return model_config.quantization
+
+
+def resolve_checkpoint_dir(model_name_or_path: str, cache_dir: str | None) -> str:
+    """Local directory of the checkpoint (HF id -> local snapshot of the needed files)."""
+    if os.path.isdir(model_name_or_path):
+        return model_name_or_path
+    from huggingface_hub import snapshot_download
+
+    return snapshot_download(
+        model_name_or_path,
+        cache_dir=cache_dir,
+        allow_patterns=[INDEX_FILE, CONFIG_FILE, "model-*.safetensors", "model.safetensors",
+                        "audio_tokenizer/*"],
+    )
+
+
+def check_serving_checkpoint_format(checkpoint_dir: str, hf_config, model_quantization) -> str:
+    """Three-way format check on the serving path (T12 review N3).
+
+    Uses vLLM's ``hf_config`` (not the file on disk) and ``model_config.quantization``;
+    ``model_quantization is _UNKNOWN`` skips the latter (offline use).
+    """
+    kwargs = {"hf_config": hf_config}
+    if model_quantization is not _UNKNOWN:
+        kwargs["model_quantization"] = model_quantization
+    return detect_checkpoint_format(checkpoint_dir, **kwargs)
+
+
+FP8_LINEAR_KEY_SUFFIXES = tuple(
+    f"{module}.{tensor}"
+    for module in (".self_attn.qkv_proj", ".mlp.gate_proj", ".mlp.up_proj", ".mlp.down_proj")
+    for tensor in ("weight", "weight_scale"))
+
+
+def rank_state_key_to_param(key: str, fp8_linear: bool = False) -> str:
+    """``load_rank_state`` key -> parameter name of ``MiMoV2ForCausalLM``.
+
+    ``fp8_linear``: FP8 precision, where qkv and the dense MLP are ``fp8_linear``
+    submodules whose parameter names equal the state keys.
+    """
+    if key == "lm_head.weight":
+        return key
+    if key.startswith("visual."):  # vision tower (T39): parameter names equal the keys
+        return key
+    if key.startswith("audio_towers."):  # audio towers (T41): names equal the keys
+        return key
+    if fp8_linear and key.endswith(FP8_LINEAR_KEY_SUFFIXES):
+        return "model." + key
+    renames = (
+        (".self_attn.qkv_proj.weight", ".self_attn.qkv_proj_weight"),
+        (".self_attn.o_proj.weight", ".self_attn.o_proj_weight"),
+        (".mlp.gate_proj.weight", ".mlp.gate_proj_weight"),
+        (".mlp.up_proj.weight", ".mlp.up_proj_weight"),
+        (".mlp.down_proj.weight", ".mlp.down_proj_weight"),
+        (".mlp.gate.weight", ".mlp.router_weight"),
+        (".mlp.gate.e_score_correction_bias", ".mlp.router_correction_bias"),
+        # static placement replicas (T53b)
+        (".mlp.experts.gate_up_proj_scale_rep", ".mlp.gate_up_proj_scale_rep"),
+        (".mlp.experts.down_proj_scale_rep", ".mlp.down_proj_scale_rep"),
+        (".mlp.experts.gate_up_proj_rep", ".mlp.gate_up_proj_weight_rep"),
+        (".mlp.experts.down_proj_rep", ".mlp.down_proj_weight_rep"),
+        (".mlp.experts.gate_up_proj_scale", ".mlp.gate_up_proj_scale"),
+        (".mlp.experts.down_proj_scale", ".mlp.down_proj_scale"),
+        (".mlp.experts.gate_up_proj", ".mlp.gate_up_proj_weight"),
+        (".mlp.experts.down_proj", ".mlp.down_proj_weight"),
+        (".mlp.experts.slot_ids", ".mlp.expert_slot_ids"),  # static placement (T53b)
+        (".mlp.experts.slot_copies", ".mlp.expert_slot_copies"),
+        (".mlp.experts.slot_copy", ".mlp.expert_slot_copy"),
+    )
+    for old, new in renames:
+        if key.endswith(old):
+            key = key[: -len(old)] + new
+            break
+    return "model." + key
+
+
+@async_speculative_decoding
+class MiMoV2ForCausalLM(nn.Module, SupportsEagle3):
+    """MiMo-V2 text model with LM head and on-device sampling (BF16; FP8 qkv / dense MLP
+    and FP8 experts when ``neuron_config.quantization="fp8"``, see ``fp8_linear.py`` and
+    ``moe.MiMoV2MoEFp8``)."""
+
+    def __init__(self, config: MiMoV2NeuronConfig, batch_size: int = 1,
+                 vision: dict | None = None,
+                 encoder_neuron_config: EncoderNeuronConfig | None = None,
+                 audio: dict | None = None):
+        super().__init__()
+        nc = config.neuron_config
+        if nc is not None:
+            for name in ("attention_dp_size", "mlp_dp_size", "embedding_dp_size",
+                         "lm_head_dp_size"):
+                if getattr(nc, name) != 1:
+                    raise ValueError(f"MiMo-V2 does not support neuron_config.{name}="
+                                     f"{getattr(nc, name)} (only 1)")
+        if config.tie_word_embeddings:
+            raise ValueError("MiMo-V2 tie_word_embeddings=True is not supported")
+        self.config = config
+        self.hf_config = None  # set by from_configs (vLLM's hf_config)
+        self.model = MiMoV2Model(config)
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        self.rank = self.tp_group.rank_in_group
+
+        self.on_device_sampling_config = nc.on_device_sampling_config if nc else None
+        debug_logits = nc is not None and nc.debug_logits_dir is not None
+        self._gather_logits = (nc is not None and nc.max_logprobs != 0) or debug_logits
+
+        # >>> PARALLELISM: column-parallel LM head over the TP group <<<
+        self.lm_head = neuron_nn.ColumnParallelLinear(
+            config.hidden_size,
+            config.vocab_size,
+            bias=False,
+            dtype=config.torch_dtype,
+            gather_output=not self.on_device_sampling_config,
+            tp_group=self.tp_group.device_group,
+        )
+        if self.on_device_sampling_config is not None:
+            self.sampler = Sampler(self.on_device_sampling_config,
+                                   process_group=self.tp_group.device_group)
+        from vllm_neuron.nn.rejection_sampler import resolve_synthetic_conditional_rates
+
+        self._synthetic_conditional_rates = resolve_synthetic_conditional_rates()
+        # MTP speculative decoding (T36): also return the final-norm hidden states
+        self.mtp_hidden_states = False
+        # Vision tower (T39, D-147): BF16, replicated on every rank (no collectives),
+        # compiled by the runner as its own graph per bucket (``model.visual``) and run
+        # from ``embed_multimodal``; None when image / video inputs are off.
+        self.vision = vision
+        self.encoder_neuron_config = encoder_neuron_config
+        self.visual = (None if vision is None else
+                       MiMoVisionCacheEncoder(vision["spec"], dtype=torch.bfloat16))
+        if self.visual is not None:
+            # buckets >= 4096 on TP 64: sequence parallel over the TP group (D-153)
+            self.visual.set_sequence_group(self.tp_group)
+        # Audio towers (T41, D-162..D-165): BF16 with the RVQ in FP32 (the vLLM GPU dtype
+        # path, mimo_audio.py), replicated on every rank (no
+        # collectives), one graph per segment bucket; None when audio inputs are off.
+        self.audio = audio
+        self.audio_towers = (None if audio is None else
+                             MiMoAudioCacheEncoder(audio["tokenizer_spec"], audio["encoder_spec"],
+                                                   dtype=torch.bfloat16))
+
+    def enable_mtp_hidden_states(self) -> None:
+        """Return the final-norm hidden states of every token as well (MTP, T36).
+
+        The MTP draft layer takes the target's hidden state after the final norm as
+        ``previous_hidden_states`` (vLLM GPU: ``MiMoV2Model.forward`` returns
+        ``self.norm(hidden_states, residual)``, which ``gpu_model_runner`` hands to the
+        drafter; D-127). With this set every graph returns
+        ``(tokens, hidden [T, H], gathered_logits)`` (``(logits, hidden)`` without
+        on-device sampling), the layout the runner's EAGLE3 path reads; ``T`` is the
+        full (all-gathered in prefill) token count.
+        """
+        self.mtp_hidden_states = True
+
+    # ── DFlash auxiliary hidden states (T63) ───────────────────────────────
+
+    # The runner may ask for index num_hidden_layers (the last layer's output before
+    # the final norm), which DFlash checkpoints use for their last target layer.
+    supports_final_layer_aux_hidden_state = True
+
+    def set_aux_hidden_state_layers(self, layers: tuple[int, ...]) -> None:
+        """Capture the residual stream entering each layer in ``layers`` (``num_hidden_layers``
+        = the last layer's output before the final norm), returned in the hidden slot of
+        every graph as one ``[T, len(layers) * H]`` tensor (DFlash, T63; vLLM GPU
+        ``MiMoV2Model._maybe_add_hidden_state`` adds ``hidden + residual`` at ``idx + 1``)."""
+        if layers is None:
+            return
+        layers = tuple(int(i) for i in layers)
+        n = len(self.model.layers)
+        if not layers or any(i < 0 or i > n for i in layers):
+            raise ValueError(f"aux hidden state layers {layers} must be in [0, {n}]")
+        if self.mtp_hidden_states:
+            raise ValueError("aux hidden states (DFlash) and MTP hidden states are exclusive")
+        self.model.aux_hidden_state_layers = layers
+
+    def get_eagle3_aux_hidden_state_layers(self) -> tuple[int, ...]:
+        if not self.model.aux_hidden_state_layers:
+            raise ValueError("MiMo-V2 has no default auxiliary layers; the DFlash draft "
+                             "config gives them (target_layer_ids)")
+        return tuple(self.model.aux_hidden_state_layers)
+
+    @classmethod
+    def from_configs(cls, hf_config: PretrainedConfig, neuron_config: NeuronConfig | None,
+                     vision: dict | None = None,
+                     encoder_neuron_config: EncoderNeuronConfig | None = None,
+                     audio: dict | None = None):
+        config = MiMoV2NeuronConfig.from_configs(hf_config, neuron_config)
+        model = cls(config, batch_size=1, vision=vision,
+                    encoder_neuron_config=encoder_neuron_config, audio=audio)
+        model.hf_config = hf_config
+        return model
+
+    @torch.no_grad()
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        inputs_embeds: torch.Tensor | None = None,
+        is_token_ids: torch.Tensor | None = None,
+        attn_metadata: dict | None = None,
+        sampling_positions: torch.Tensor | None = None,
+        sampling_params: torch.Tensor | None = None,
+        spec_decode_metadata=None,
+        logit_mask: torch.Tensor | None = None,
+        rank: torch.Tensor | None = None,
+        encoder_embedding_buffer: torch.Tensor | None = None,
+        encoder_block_ids: torch.Tensor | None = None,
+        encoder_positions: torch.Tensor | None = None,
+        **kwargs,  # @async_speculative_decoding injects async-spec args
+    ):
+        positions = positions.to(torch.int32)
+        first = attn_metadata["layers.0.self_attn"]
+        is_prefill = first["max_query_len"] > first["decode_token_threshold"]
+        T = input_ids.shape[0]
+        # >>> PARALLELISM: SP length validation <<<
+        if is_prefill and self.world_size > 1 and (T <= self.world_size or T % self.world_size):
+            raise ValueError(
+                f"Prompt length ({T}) must be > world_size ({self.world_size}) and a multiple "
+                "of it for sequence parallelism.")
+
+        hidden_all = self.model(input_ids, positions, attn_metadata, rank=rank,
+                                inputs_embeds=inputs_embeds, is_token_ids=is_token_ids,
+                                encoder_embedding_buffer=encoder_embedding_buffer,
+                                encoder_block_ids=encoder_block_ids,
+                                encoder_positions=encoder_positions)
+        aux_hidden = None
+        if self.model.aux_hidden_state_layers:
+            # DFlash (T63): the drafter's context features as 5 [T, H] outputs; the drafter's
+            # graph concatenates them (T54 D-313: the in-graph concat hung the verify graph)
+            hidden_all, aux_list = hidden_all
+            aux_hidden = tuple(aux_list)
+        if self.mtp_hidden_states and not is_prefill and sampling_positions.shape[0] == T:
+            # MTP decode / verify graph (T63): every token is a sampling row, so the gather
+            # is the identity on every real row (fake bucket-padding rows are discarded).
+            # Skip it: on device, with T <= 16 rows (num_seqs bucket 1 or 4), index_select
+            # over hidden_all, which this graph also returns as the MTP hidden output,
+            # gave NaN / near-zero rows for every row but 0 (T63 bucketdbg-fwd).
+            hidden_states = hidden_all
+        else:
+            hidden_states = torch.index_select(hidden_all, 0, sampling_positions)
+        logits = self.lm_head(hidden_states.to(self.config.torch_dtype))
+        mtp_hidden = hidden_all if self.mtp_hidden_states else aux_hidden
+
+        gathered_logits = None
+        if self._gather_logits:
+            gathered_logits = self.tp_group.all_gather(logits, dim=1)
+
+        if self.on_device_sampling_config is None:
+            return logits if mtp_hidden is None else (logits, mtp_hidden)
+
+        sampled_tokens = self.sampler(logits, sampling_params, logit_mask=logit_mask,
+                                      tp_rank=rank)
+        if spec_decode_metadata is not None:
+            from vllm_neuron.nn.rejection_sampler import rejection_sampler
+
+            rejection_sampled = rejection_sampler(
+                spec_decode_metadata,
+                sampled_tokens,
+                synthetic_conditional_rates=self._synthetic_conditional_rates,
+            )
+            if mtp_hidden is None:
+                return rejection_sampled
+            return rejection_sampled, mtp_hidden, gathered_logits
+        if mtp_hidden is None:
+            return self._plp((sampled_tokens, gathered_logits), hidden_all, rank, kwargs)
+        return self._plp((sampled_tokens, mtp_hidden, gathered_logits), hidden_all, rank, kwargs)
+
+    # ── vision tower (T39, D-147) ──────────────────────────────────────────
+
+    def compiler_args_for(self, graph_type, example_inputs, base):
+        """Per-graph neuronx-cc arguments (the runner's policy hook, as qwen3_vl): the vision
+        encoder graphs raise the backend's unrolled-instruction limit to
+        ``ENCODER_MAX_INSTRUCTIONS`` -- the 32768-patch bucket unrolls to about 5.8 M
+        instructions, above the default 5 M (NCC_ELUR015, D-151); every other graph keeps
+        the base arguments."""
+        args = list(base or [])
+        if graph_type != "encoder":
+            return args
+        flag = f"--max-instruction-limit={ENCODER_MAX_INSTRUCTIONS}"
+        for i, a in enumerate(args):
+            if a.startswith("--internal-backend-options="):
+                args[i] = f"{a} {flag}"   # a second --internal-backend-options would replace it
+                return args
+        return args + [f"--internal-backend-options={flag}"]
+
+    def _scoped_compiler_args(self, graph_type):
+        """Scope this graph's compiler arguments for an in-process call (the runner stamps
+        ``_neuron_base_compiler_args`` when the per-graph policy is on), so the served
+        encoder call hashes to the graph the warmup compiled."""
+        from libtorch_neuronx_lite.compile.compiler_args import scoped_compiler_args
+
+        base = getattr(self, "_neuron_base_compiler_args", None)
+        return scoped_compiler_args(None if base is None else
+                                    self.compiler_args_for(graph_type, None, base))
+
+    def get_encoder(self) -> nn.Module | None:
+        """The vision tower the worker warms up per bucket (None: vision off)."""
+        return self.visual
+
+    def build_encoder_synthetic_inputs(self, bucket: int,
+                                       encoder_neuron_config: EncoderNeuronConfig,
+                                       device: torch.device) -> dict:
+        """Warmup inputs of ``visual`` for ``bucket``; the worker adds the cache buffer and
+        ``write_block_ids`` (the same tensors ``embed_multimodal`` passes)."""
+        return vision_synthetic_inputs(self.vision["spec"], bucket, torch.bfloat16, device)
+
+    @torch.no_grad()
+    def embed_multimodal(self, encoder_cache=None, mm_hashes=None, pixel_values=None,
+                         image_grid_thw=None, pixel_values_videos=None, video_grid_thw=None,
+                         **kwargs) -> None:
+        """Encode the images or the videos of one runner call (one modality, items in
+        order) into the on-device encoder cache (``NeuronModelRunner._execute_mm_encoder``).
+
+        Each item gets dense cache blocks for its ``t*h*w/4`` merged tokens; its frame
+        groups are packed with the other items' into encoder calls of the compiled
+        buckets (a video longer than one bucket takes several calls, attention never
+        crosses a frame group, design 9.1), and every call writes its rows into the
+        cache on the device. ``second_per_grid_ts`` / ``video_start_times`` only shape
+        the prompt (timestamp tokens) and are not needed here.
+
+        Audio items (``audio_features``, T41) go to ``_embed_audio``."""
+        if kwargs.get("va_audio_features") is not None:
+            raise ValueError("MiMo-V2: video-with-audio inputs are not supported yet (T42)")
+        if kwargs.get("audio_features") is not None:
+            if pixel_values is not None or pixel_values_videos is not None:
+                raise ValueError("embed_multimodal: one modality per call (audio or vision)")
+            return self._embed_audio(encoder_cache, mm_hashes, kwargs["audio_features"],
+                                     kwargs.get("audio_token_lens"))
+        if self.visual is None:
+            raise ValueError("MiMo-V2: image / video input but the vision tower is off")
+        if pixel_values is not None and pixel_values_videos is not None:
+            raise ValueError("embed_multimodal: one modality per call (images or videos)")
+        modality = "video" if pixel_values is None else "image"
+        pixels = pixel_values_videos if pixel_values is None else pixel_values
+        grid = video_grid_thw if pixel_values is None else image_grid_thw
+        if pixels is None or grid is None:
+            raise ValueError("embed_multimodal needs (pixel_values, image_grid_thw) or "
+                             "(pixel_values_videos, video_grid_thw)")
+        spec = self.vision["spec"]
+        cbs = encoder_cache.block_size
+        t0 = time.perf_counter()
+        tokens = item_merged_tokens(spec, grid)
+        if len(tokens) != len(mm_hashes):
+            raise ValueError(f"{len(tokens)} {modality} items, {len(mm_hashes)} mm_hashes")
+        blocks = [encoder_cache.allocate(h, encoder_cache.dense_tokens_per_block(n, cbs))
+                  for h, n in zip(mm_hashes, tokens)]
+        plans = plan_cache_writes(spec, pixels, grid, blocks, cbs, encoder_cache.scratch_block_id,
+                                  self.vision["buckets"], dtype=torch.bfloat16)
+        device = next(self.visual.parameters()).device
+        t1 = time.perf_counter()
+        with self._scoped_compiler_args("encoder"):
+            for batch, inputs in plans:
+                kw = {k: t.to(device) for k, t in inputs.items()}
+                kw["write_block_ids"] = torch.zeros(
+                    cache_write_block_count(batch.bucket, self.encoder_neuron_config),
+                    dtype=torch.int64, device=device)
+                self.visual(encoder_cache_buffer=encoder_cache.buffer, **kw)
+        logger.info("[mimo_v2] vision %s: items=%d tokens=%s frame_groups=%d calls=%s "
+                    "device=%s host_ms=%.1f dispatch_ms=%.1f", modality, len(tokens), tokens,
+                    sum(len(b.units) for b, _ in plans), [b.bucket for b, _ in plans],
+                    device, (t1 - t0) * 1e3, (time.perf_counter() - t1) * 1e3)
+
+    # ── audio towers (T41, D-162..D-165) ───────────────────────────────────
+
+    # Segment calls dispatched before ``_embed_audio`` waits for one to finish (D-162).
+    AUDIO_SYNC_EVERY = 16
+
+    def get_aux_encoder_attrs(self) -> tuple[str, ...]:
+        """Encoder towers besides ``visual`` that the runner compiles and the worker warms
+        up (``build_aux_encoder_warmup_inputs``): the audio towers when audio is on."""
+        return () if self.audio_towers is None else ("audio_towers",)
+
+    def build_aux_encoder_warmup_inputs(self, encoder_cache, device) -> list:
+        """``[(attr, label, kwargs)]``: one ``audio_towers`` call per segment bucket (largest
+        first), the inputs ``_embed_audio`` passes for that bucket plus the cache buffer."""
+        if self.audio_towers is None:
+            return []
+        a = self.audio
+        out = []
+        for bucket in sorted(a["buckets"], reverse=True):
+            kw = audio_synthetic_inputs(a["tokenizer_spec"], a["encoder_spec"], bucket, device)
+            kw["encoder_cache_buffer"] = encoder_cache.buffer
+            out.append(("audio_towers", f"audio segment bucket {bucket} mel frames", kw))
+        return out
+
+    @torch.no_grad()
+    def _embed_audio(self, encoder_cache, mm_hashes, audio_features, audio_token_lens) -> None:
+        """Encode the audio items of one runner call into the on-device encoder cache.
+
+        Each item (the processor's log-mel, ``[frames, 128]``) gets dense cache blocks for
+        its ``<|audio_pad|>`` tokens and one ``audio_towers`` call per segment
+        (``plan_audio_cache_writes``: 6000-frame segments and the remainder, each in the
+        smallest segment bucket), so any length that fits the prompt runs, as on GPU. The
+        token count must equal the processor's ``audio_token_lens``."""
+        if self.audio_towers is None:
+            raise ValueError("MiMo-V2: audio input but the audio towers are off")
+        a = self.audio
+        tspec, espec = a["tokenizer_spec"], a["encoder_spec"]
+        mels = audio_item_mels(audio_features)
+        if len(mels) != len(mm_hashes):
+            raise ValueError(f"{len(mels)} audio items, {len(mm_hashes)} mm_hashes")
+        tokens = [audio_token_count(m.shape[0], tspec, espec.group_size, espec.segment_size)
+                  for m in mels]
+        if audio_token_lens is not None:
+            want = [int(x) for x in torch.as_tensor(audio_token_lens).reshape(-1).tolist()]
+            if want != tokens:
+                raise ValueError(f"audio token counts {tokens} differ from the processor's "
+                                 f"audio_token_lens {want}")
+        cbs = encoder_cache.block_size
+        device = next(self.audio_towers.parameters()).device
+        t0 = time.perf_counter()
+        calls = []
+        with self._scoped_compiler_args("encoder"):
+            for h, mel, n in zip(mm_hashes, mels, tokens):
+                blocks = encoder_cache.allocate(h, encoder_cache.dense_tokens_per_block(n, cbs))
+                for seg, inputs in plan_audio_cache_writes(
+                        tspec, espec, mel, blocks, cbs, encoder_cache.scratch_block_id,
+                        a["buckets"]):
+                    kw = {k: t.to(device) for k, t in inputs.items()}
+                    _, codes = self.audio_towers(encoder_cache_buffer=encoder_cache.buffer, **kw)
+                    calls.append(seg.bucket)
+                    if len(calls) % self.AUDIO_SYNC_EVERY == 0:
+                        # bound the runtime's queue of in-flight executions: 88 back-to-back
+                        # calls (an 87 min item) failed with "Execution Queue Full" (D-162)
+                        codes.cpu()
+        logger.info("[mimo_v2] audio: items=%d mel_frames=%s tokens=%s calls=%s device=%s "
+                    "dispatch_ms=%.1f", len(mels), [m.shape[0] for m in mels], tokens, calls,
+                    device, (time.perf_counter() - t0) * 1e3)
+
+    # ── KV cache ──────────────────────────────────────────────────────────
+
+    def get_kv_spec(self) -> KVSpec:
+        """Per-layer KV spec: K 192 wide, V 128 wide (``head_size_v``); SWA layers windowed."""
+        layers = []
+        for i, layer in enumerate(self.model.layers):
+            attn = layer.self_attn
+            layers.append(LayerSpec(
+                name=f"layers.{i}.self_attn",
+                num_kv_heads=attn.num_kv_heads_per_rank,
+                head_size=attn.head_dim,
+                head_size_v=attn.v_head_dim,
+                dtype=attn.dtype,
+                sliding_window_size=attn.sliding_window,
+                chunk_size=None,
+            ))
+        return KVSpec(layers=layers)
+
+    def bind_kv_cache(self, kv_caches: dict) -> None:
+        for i, layer in enumerate(self.model.layers):
+            name = f"layers.{i}.self_attn"
+            if name not in kv_caches:
+                raise KeyError(f"KV cache for layer {name} not initialized")
+            k_cache, v_cache = kv_caches[name]
+            attn = layer.self_attn
+            expect_k = (attn.num_kv_heads_per_rank, attn.head_dim)
+            expect_v = (attn.num_kv_heads_per_rank, attn.v_head_dim)
+            if (k_cache.dim() != 4 or v_cache.dim() != 4
+                    or (k_cache.shape[1], k_cache.shape[3]) != expect_k
+                    or (v_cache.shape[1], v_cache.shape[3]) != expect_v):
+                raise ValueError(
+                    f"{name}: KV cache shapes K {tuple(k_cache.shape)} V {tuple(v_cache.shape)} "
+                    f"do not match [nb, {expect_k[0]}, bs, {expect_k[1]}] / "
+                    f"[nb, {expect_v[0]}, bs, {expect_v[1]}]")
