+# SPDX-License-Identifier: Apache-2.0
+"""
+MiMo-V2 feed-forward blocks (design 3.2)
+========================================
+
+* ``MiMoV2MLP``: dense SwiGLU (layer 0, intermediate 16384) via ``NF.mlp``.
+* ``MiMoV2MoE``: 256 routed experts, top-8, no shared expert.
+
+Routing (HF ``MiMoV2MoEGate``, ``noaux_tc`` with ``n_group = topk_group = 1``):
+``scores = sigmoid(x_fp32 @ W_fp32^T)`` (``router_logits``: multiply + sum for small inputs,
+matmul otherwise); experts are SELECTED by top-8 of
+``scores + e_score_correction_bias``; their WEIGHTS are the unbiased
+``scores`` of the selected experts, renormalized (``norm_topk_prob``) and
+multiplied by ``routed_scaling_factor``. All in FP32 (router weight and bias
+are FP32 parameters, replicated on every rank), or, with ``mimo_router_dtype="bfloat16"``
+(T49, D-215; the default for a checkpoint whose ``moe_router_dtype`` is bfloat16, as on
+vLLM GPU), BF16 weight and bias and BF16 logits, with sigmoid / selection / weights in FP32.
+
+``NF.router`` has no "bias for selection only, weights from unbiased scores"
+mode (``RouterComputationOrder`` offers only pre-norm -> linear -> {topk, act}
+orderings), so the router is hand-rolled; top-k goes through
+``vllm_neuron.functional.topk.topk``. Experts use ``NF.build_blockwise_mapping``
++ ``NF.moe_cte`` for both prefill and decode in ``MiMoV2MoE`` (BF16 experts; the routing
+is computed outside the kernel, so ``NF.moe_block_tkg``, whose routing is internal
+SOFTMAX/SIGMOID top-k, does not apply).
+
+``MiMoV2MoEFp8`` (``neuron_config.quantization="fp8"``, design 6.3, T25): experts are
+FP8 codes (``float8_e4m3fn``, ``|v| <= 192``) with one power-of-two scale per output
+channel, the lossless row encoding of the MXFP4 checkpoint; activations stay BF16.
+Each FP8 weight tile is copied to BF16 in SBUF, multiplied with the BF16 activations
+on the TensorEngine (FP32 PSUM), and the PSUM result is multiplied by the FP32 scale.
+A power-of-two scale commutes with every rounding, so this equals the BF16 kernel on
+the MXFP4-dequantized weights (the GPU W4A16 algorithm). On device (T48):
+
+* prefill: ``NF.moe_cte`` with nkilib's ``shard_on_I_hybrid`` kernel and per-channel
+  scales. ``build_blockwise_mapping`` reserves blocks for the worst case (every token
+  on every local expert: N = T*4/256 + 3, e.g. 131 blocks at T = 8192), but only the
+  first ``sum(conditions)`` blocks hold tokens; the hybrid kernel loops over exactly
+  those (a hardware loop with a runtime bound; both LNC programs read the same bound),
+  while ``shard_on_I`` read a full expert weight for every reserved block (T47:
+  90-94 % empty blocks). Per block the computation is that of ``shard_on_I``.
+* decode (``is_decode``: plain decode and speculative verify graphs): nkilib
+  ``moe_tkg`` all-expert with FP8 row quantization, through ``wrap_nki`` (the
+  functional ``NF.moe_tkg`` accepts only BF16/MX weights). Every local expert's
+  weights are read once for all rows, with no block mapping and no padding to 128 rows
+  (rows are padded only to a row count the kernel computes correctly, ``moe_tkg_rows``;
+  T47: the 5 fixed ``shard_on_I`` blocks read 5.7 expert weights per layer).
+
+``shard_on_block`` ignores FP8 scales (its scale tiles are placeholders), so it cannot
+be used for FP8. The CPU torch fallback of ``NF.moe_cte`` ignores scales too, so
+off-device the codes are dequantized to BF16 in the graph (exact) and the BF16 path
+runs, for prefill and decode.
+
+>>> PARALLELISM <<< (gpt_oss pattern, single collective group)
+* No EP: every rank holds all experts, expert intermediate sharded across TP.
+* EP: pure EP only (``ep_degree == tp``, one rank per EP partition, expert
+  intermediate not sharded, linear placement ``[r*E/ep, (r+1)*E/ep)``, or the static
+  placement of ``neuron_config.mimo_expert_placement``: remapped primaries plus replicas of
+  hot experts for prefill, ``expert_placement.py``, T53b).
+* Prefill: router on the sequence-parallel tokens, all-gather affinities and
+  hidden states, experts, reduce-scatter. Decode: tokens replicated, experts,
+  all-reduce. Every collective uses the full TP group.
+"""
+
+import nki.language as nl
+import torch
+from nkilib.core.moe.moe_cte.moe_cte import MoECTEImplementation
+from nkilib.core.utils.common_types import ActFnType, ExpertAffinityScaleMode
+from torch import nn
+from vllm.distributed.parallel_state import get_tp_group
+
+import vllm_neuron.functional as NF
+from vllm_neuron.functional.topk import topk
+from vllm_neuron.utils.neuron_utils import can_run_kernel
+
+from .config import MOE_TKG_HITS_MAX_ROWS_DEFAULT, MiMoV2NeuronConfig
+
+MOE_BLOCK_SIZE = 256
+# The NF.moe_cte NKI kernel tiles tokens by 128 partitions: a token count that is not a
+# multiple of 128 fails its shape trace with an out-of-bound access (T15 meta-device
+# probe: T = 1, 16, 127, 200 fail; 128, 256, 512, 4096 pass). Decode (T = num_seqs) and
+# prefill buckets that are not multiples of 128 are padded with zero rows (zero affinity:
+# no expert selected, no block) and the output is sliced back to T.
+MOE_TOKEN_TILE = 128
+# Cross-block (cross-expert) accumulator and LNC partial-sum dtype of the FP8 prefill expert
+# kernel (shard_on_I_hybrid ``accumulation_dtype``; None = its I/O dtype, BF16), chosen by
+# ``neuron_config.mimo_moe_prefill_accumulation_dtype`` (T54a M2; "bfloat16" -> None, "float32"
+# -> nl.float32). FP32 (as GPU vLLM sums the top-k outputs, rule AA) lowered the op R_iso but
+# raised the small-TL error (RMS 1.27x this BF16 setting, prompt 15 group 1.59 vs the GPU dtype
+# path, T48 diag), so BF16 is the default (rule AA supplement, D-210; bit-identical to
+# shard_on_I with BF16, T48 bench).
+MOE_PREFILL_ACCUMULATION_KERNEL_DTYPES = {"bfloat16": None, "float32": nl.float32}
+# Decode rows for moe_tkg all-expert (the vendored copy with the FP8 row-scale bank offset fixed,
+# nki_moe_tkg/__init__.py; root cause in reports/tasks/T48/moe-tkg-row-count-root-cause.md). With
+# the fix every row count is computed correctly. 2..7 rows take twice as long as 8 (1.0-1.2 vs
+# 0.51 ms per layer, T48 bench5), so they are padded with zero rows (zero affinity) to
+# MOE_TKG_MIN_ROWS and sliced back: a speed choice, not a kernel requirement.
+MOE_TKG_MIN_ROWS = 8
+
+
+def moe_tkg_rows(T: int) -> int:
+    """Rows the decode ``moe_tkg`` call runs ``T`` tokens at (see MOE_TKG_MIN_ROWS)."""
+    return T if T == 1 or T >= MOE_TKG_MIN_ROWS else MOE_TKG_MIN_ROWS
+# Decode graphs with at most this many rows (decode bucket x (1 + k)) run ``moe_tkg_hits_batch``
+# (vllm-neuron PR #67, vendored in nki_moe_tkg/ on the fixed down projection): a runtime loop over
+# only the local experts some row routed to, each expert's weights read once for all rows. T48
+# bench6 per layer: 1 row with 1 / 2 / 4 hit experts 0.322 / 0.378 / 0.582 ms against 0.51 ms
+# all-expert; at 8 rows and more all-expert is as fast or faster (D-209). Larger graphs keep the
+# all-expert path. T53 measured 4 end to end (D-251). The MoE takes the threshold from
+# ``neuron_config.mimo_moe_tkg_hits_max_rows`` (T54a M2, in the compile fingerprint); this is
+# its default.
+MOE_TKG_HITS_MAX_ROWS = MOE_TKG_HITS_MAX_ROWS_DEFAULT
+
+
+def use_moe_tkg_hits(T: int, max_rows: int = MOE_TKG_HITS_MAX_ROWS) -> bool:
+    """Whether a decode graph of ``T`` rows runs ``moe_tkg_hits_batch`` (``T <= max_rows``,
+    ``neuron_config.mimo_moe_tkg_hits_max_rows``)."""
+    return T <= max_rows
+
+
+def pack_hit_experts(affinities: torch.Tensor):
+    """Pack the local experts that any row routed to first, for ``moe_tkg_hits_batch``.
+
+    ``affinities`` ``[T, E_L]`` (zero where a row did not route to the expert). Returns the
+    affinities with columns reordered ``[T, E_L]`` FP32, the local expert ids in that order
+    ``[1, E_L]`` int32 (hit experts first, in index order) and the hit count ``[1, 1]`` int32.
+    Built from element-wise products and sums of 0/1 values (exact on device; no sort, which
+    neuronx-cc rejects on trn2, and no FP32 matmul, which compiled to ~1e-3 relative error, T61)
+    and a column gather, so the reordered affinities are bit-identical to the input columns.
+    """
+    E_L = affinities.shape[1]
+    dev = affinities.device
+    hit = (affinities != 0).any(dim=0)  # [E_L]
+    k = hit.to(torch.float32)
+    lower = torch.tril(torch.ones(E_L, E_L, dtype=torch.float32, device=dev), diagonal=-1)
+    kept_before = (lower * k.view(1, E_L)).sum(dim=1)  # kept entries before i
+    dropped_before = (lower * (1 - k).view(1, E_L)).sum(dim=1)
+    pos = torch.where(hit, kept_before, k.sum() + dropped_before)  # target slot of expert i
+    slots = torch.arange(E_L, dtype=torch.float32, device=dev)
+    perm = (pos.view(E_L, 1) == slots.view(1, E_L)).to(torch.float32)  # [expert i, slot j]
+    order = (slots.view(E_L, 1) * perm).sum(dim=0).to(torch.int64)  # expert in slot j
+    packed = affinities.to(torch.float32).index_select(1, order)
+    return packed, order.to(torch.int32).view(1, E_L), hit.sum(dtype=torch.int32).view(1, 1)
+
+
+def placed_local_affinities(affinities: torch.Tensor, slot_ids: torch.Tensor,
+                            slot_copies: torch.Tensor, slot_copy: torch.Tensor, num_primary: int,
+                            is_decode: bool, width: int | None = None) -> torch.Tensor:
+    """This rank's ``[T, width]`` affinities under a static expert placement (T53b,
+    ``expert_placement.py``): column ``j < S`` is the affinity of expert ``slot_ids[j]``, columns
+    ``S .. width - 1`` (the empty slot that makes the mapping's expert count even) are zero.
+
+    Slots ``[0, num_primary)`` hold primary copies (every expert on exactly one rank), the
+    others replicas. Prefill: row ``t`` keeps expert ``e`` only in its copy
+    ``t mod slot_copies[j] == slot_copy[j]``, so over all ranks each (row, expert) affinity
+    appears exactly once. Decode: the primary copies take every row, replica columns are zero.
+    The row index is split in FP32 (``floor((t + 0.5) / c)``, exact for the integer rows and copy
+    counts here, no integer division on device); only 0/1 factors multiply the affinities, so the
+    kept values are the router's values bit for bit."""
+    local = NF.get_local_expert_affinities(affinities, slot_ids)
+    T, S = local.shape
+    width = S if width is None else width
+    if S == num_primary:
+        return local
+    dev = local.device
+    if is_decode:
+        keep = (torch.arange(S, device=dev) < num_primary).view(1, S)
+    else:
+        row = torch.arange(local.shape[0], dtype=torch.float32, device=dev).view(-1, 1)
+        c = slot_copies.to(torch.float32).view(1, S)
+        rem = row - torch.floor((row + 0.5) / c) * c
+        keep = rem == slot_copy.to(torch.float32).view(1, S)
+    local = local * keep.to(local.dtype)
+    if width > S:
+        local = torch.cat([local, local.new_zeros(T, width - S)], dim=1)
+    return local
+# Router inputs with at most this many rows (decode graphs: B x (1+k) tokens; small prefill
+# buckets: T/tp rows per rank) compute the logits as an FP32 multiply + sum over the hidden
+# dim. On device the FP32 [M, H] x [H, E] matmul of the M=1 decode graph compiled to about
+# 1e-3 relative error (T61: 3.4e-4..1.7e-3, near one BF16 output rounding; a bf16-operand
+# bmm with FP32 output compiled to the same result), while the multiply + sum form and the
+# 64-row prefill matmul are FP32-accurate (~1e-7), like the FP32 router of HF and vLLM GPU.
+# The [M, E, H] FP32 product is 4 MB per row, so larger inputs keep the matmul.
+# (FP32 router only: a BF16 router, ``mimo_router_dtype="bfloat16"``, is one BF16 matmul.)
+ROUTER_ELEMENTWISE_MAX_TOKENS = 16
+
+
+def round_to_bf16(x: torch.Tensor) -> torch.Tensor:
+    """FP32 ``x`` rounded to the nearest BF16 value (ties to even), kept in FP32. On device a
+    ``.to(bfloat16).to(float32)`` pair after a BF16 matmul is folded away (excess precision: T49
+    cap16 router logits had rel_l2 9e-8, not the 1.7e-3 of one BF16 rounding), so the rounding
+    is written out as a Veltkamp split with 2^16 + 1 (three FP32 ops, round-to-nearest-even
+    arithmetic keeps 8 significant bits; T49 D-219). The earlier int32 bit-pattern form
+    (763a68f) cost about 3 ms per decode step on device. Finite ``|x| < 2^111`` only."""
+    c = x * 65537.0
+    return c - (c - x)
+
+
+def router_logits(hidden_states: torch.Tensor, router_weight: torch.Tensor) -> torch.Tensor:
+    """Router logits ``[T, E]`` = ``hidden [T, H] @ weight [E, H]^T``, returned as FP32.
+
+    FP32 ``router_weight``: FP32 logits (see above). BF16 ``router_weight`` (the GPU dtype path,
+    vLLM ``nn.Linear(dtype=moe_router_dtype)``): one BF16 matmul with FP32 accumulation whose
+    result is rounded to BF16 (``round_to_bf16``) and kept as FP32; sigmoid, bias and top-k then
+    run in FP32 as in vLLM's ``grouped_topk`` CUDA kernel (``preprocess_score``)."""
+    if router_weight.dtype == torch.bfloat16:
+        logits = torch.matmul(hidden_states.to(torch.bfloat16), router_weight.T)
+        return round_to_bf16(logits.to(torch.float32))
+    x = hidden_states.to(torch.float32)
+    w = router_weight.to(torch.float32)
+    if x.shape[0] <= ROUTER_ELEMENTWISE_MAX_TOKENS:
+        return (x.unsqueeze(1) * w.unsqueeze(0)).sum(dim=-1)
+    return torch.matmul(x, w.T)
+
+
+def select_topk_lowest_index(choice: torch.Tensor, k: int) -> torch.Tensor:
+    """Bool ``[T, E]``: the top-``k`` of ``choice`` per row; experts tied at the k-th value are
+    taken in increasing expert index, as vLLM GPU's ``reduceTopK`` (``moeTopKFuncs.cuh``: the
+    compare key packs ``65535 - idx`` under the value, so a smaller index wins a tie).
+
+    ``vllm_neuron.functional.topk`` (and CPU ``torch.topk``) break ties arbitrarily; with the BF16
+    router exact ties of ``sigmoid(logit) + bias`` (same BF16 logit and same BF16 bias) are common
+    (T49 D-217: up to 15 % of the tokens of layer 1), so only the k-th VALUE is taken from top-k
+    and the set is rebuilt: every expert above it, then the tied ones by a running count
+    (``eq @ upper-triangular ones``, exact small integers)."""
+    vals, _ = topk(choice, k=k, dim=1, gather_dim=1)
+    thr = vals.min(dim=1, keepdim=True).values
+    above = choice > thr
+    tied = choice == thr
+    E = choice.shape[1]
+    tri = torch.ones(E, E, dtype=torch.float32, device=choice.device).triu()
+    rank = torch.matmul(tied.to(torch.float32), tri)
+    need = k - above.to(torch.float32).sum(dim=1, keepdim=True)
+    return above | (tied & (rank <= need))
+
+
+def route_from_logits(logits: torch.Tensor, correction_bias: torch.Tensor, top_k: int,
+                      norm_topk_prob: bool, routed_scaling_factor: float) -> torch.Tensor:
+    """Dense ``[T, E]`` FP32 expert affinities from FP32 router logits (zero if not selected)."""
+    scores = torch.sigmoid(logits)
+    choice = scores + correction_bias.to(torch.float32).unsqueeze(0)
+    weights = scores * select_topk_lowest_index(choice, top_k).to(scores.dtype)
+    if top_k > 1 and norm_topk_prob:
+        weights = weights / (weights.sum(dim=-1, keepdim=True) + 1e-20)
+    return weights * routed_scaling_factor
+
+
+def mimo_route(hidden_states: torch.Tensor, router_weight: torch.Tensor,
+               correction_bias: torch.Tensor, top_k: int, norm_topk_prob: bool,
+               routed_scaling_factor: float) -> torch.Tensor:
+    """Dense ``[T, E]`` FP32 expert affinities (zero for experts not selected)."""
+    logits = router_logits(hidden_states, router_weight)
+    return route_from_logits(logits, correction_bias, top_k, norm_topk_prob,
+                             routed_scaling_factor)
+
+
+class MiMoV2MLP(nn.Module):
+    """Dense SwiGLU MLP (layer 0). Weights ``gate/up [H, I/tp]``, ``down [I/tp, H]``."""
+
+    def __init__(self, config: MiMoV2NeuronConfig):
+        super().__init__()
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        H, I = config.hidden_size, config.intermediate_size
+        if I % self.world_size:
+            raise ValueError(f"intermediate_size {I} not divisible by tp={self.world_size}")
+        if config.hidden_act != "silu":
+            raise ValueError(f"MiMo-V2 hidden_act must be silu, got {config.hidden_act!r}")
+        per = I // self.world_size
+        dtype = config.torch_dtype
+        self.gate_proj_weight = nn.Parameter(torch.empty(H, per, dtype=dtype), requires_grad=False)
+        self.up_proj_weight = nn.Parameter(torch.empty(H, per, dtype=dtype), requires_grad=False)
+        self.down_proj_weight = nn.Parameter(torch.empty(per, H, dtype=dtype), requires_grad=False)
+
+    def forward(self, hidden_states: torch.Tensor, positions: torch.Tensor,
+                is_decode: bool) -> torch.Tensor:
+        # >>> PARALLELISM: SP all-gather in prefill <<<
+        if not is_decode and self.world_size > 1:
+            hidden_states = self.tp_group.all_gather(hidden_states, dim=0)
+        out = NF.mlp(
+            hidden_states,
+            self.gate_proj_weight,
+            self.up_proj_weight,
+            self.down_proj_weight,
+            act_fn=ActFnType.SiLU,
+        )
+        if self.world_size > 1:
+            if is_decode:
+                out = self.tp_group.all_reduce(out)
+            else:
+                out = self.tp_group.reduce_scatter(out, dim=0)
+        return out
+
+
+class MiMoV2MoE(nn.Module):
+    """Routed-expert MoE (see module docstring)."""
+
+    def __init__(self, config: MiMoV2NeuronConfig):
+        super().__init__()
+        from vllm.config import get_current_vllm_config
+
+        if config.n_group != 1 or config.topk_group != 1:
+            raise ValueError(
+                f"MiMo-V2 MoE supports n_group=topk_group=1, got {config.n_group}/{config.topk_group}")
+        if config.scoring_func != "sigmoid" or config.topk_method != "noaux_tc":
+            raise ValueError(
+                f"MiMo-V2 MoE needs sigmoid + noaux_tc, got {config.scoring_func}/{config.topk_method}")
+        if config.hidden_act != "silu":
+            raise ValueError(f"MiMo-V2 hidden_act must be silu, got {config.hidden_act!r}")
+
+        # >>> PARALLELISM: TP / pure-EP setup (gpt_oss) <<<
+        self.tp_group = get_tp_group()
+        self.world_size = self.tp_group.world_size
+        parallel = get_current_vllm_config().parallel_config
+        self.ep_enabled = parallel.enable_expert_parallel
+        if self.ep_enabled:
+            from vllm_neuron.parallel.neuron_parallel_state import (
+                get_neuron_ep_degree,
+                get_neuron_ep_tp_group,
+            )
+
+            self.ep_degree = get_neuron_ep_degree()
+            self.ep_tp_group = get_neuron_ep_tp_group()
+            self.tp_degree = self.ep_tp_group.world_size
+            if (parallel.data_parallel_size != 1 or self.tp_degree != 1
+                    or self.ep_degree != self.world_size):
+                raise ValueError(
+                    "MiMo-V2 EP supports pure EP over the TP group only "
+                    f"(ep_degree == tp, dp == 1); got ep_degree={self.ep_degree}, "
+                    f"ep_tp={self.tp_degree}, tp={self.world_size}, "
+                    f"dp={parallel.data_parallel_size}")
+        else:
+            self.ep_degree = 1
+            self.ep_tp_group = self.tp_group
+            self.tp_degree = self.world_size
+
+        self.num_experts = config.n_routed_experts
+        if self.num_experts % self.ep_degree:
+            raise ValueError(f"{self.num_experts} experts not divisible by ep={self.ep_degree}")
+        self.num_local_experts = self.num_experts // self.ep_degree
+        # >>> PARALLELISM: static expert placement (T53b, expert_placement.py) <<<
+        # num_primary_experts: primary copies (E/ep), the gate_up / down parameters; decode runs
+        #   these only. num_expert_slots: + replicas, separate *_rep parameters used in prefill
+        #   (two tensors, so decode reads the primaries without slicing a larger tensor: a slice
+        #   [:4] of a [6, ...] parameter compiled to an HBM copy, T53b slice_bench).
+        # num_local_experts: experts of the prefill block mapping and kernel = slots rounded up to
+        #   even (find_nonzero_indices needs an even count, moe_blockwise.py), the extra slot
+        #   gets no tokens.
+        self.num_primary_experts = self.num_expert_slots = self.num_local_experts
+        self.num_replica_slots = 0
+        self.expert_slot_ids = self.expert_slot_copies = self.expert_slot_copy = None
+        if config.mimo_expert_slots:
+            if self.ep_degree != config.mimo_expert_placement_ep:
+                raise ValueError(
+                    f"neuron_config.mimo_expert_placement {config.mimo_expert_placement} is for "
+                    f"ep_size {config.mimo_expert_placement_ep}, the MoE runs ep_degree "
+                    f"{self.ep_degree} (expert parallelism needed)")
+            S = config.mimo_expert_slots
+            self.num_expert_slots = S
+            self.num_replica_slots = S - self.num_primary_experts
+            self.num_local_experts = S + S % 2
+            # this rank's slots (loaded per rank): expert id, copies of that expert, copy index
+            self.expert_slot_ids = nn.Parameter(torch.empty(S, dtype=torch.int32), requires_grad=False)
+            self.expert_slot_copies = nn.Parameter(torch.empty(S, dtype=torch.int32),
+                                                   requires_grad=False)
+            self.expert_slot_copy = nn.Parameter(torch.empty(S, dtype=torch.int32), requires_grad=False)
+        # MoE kernel options from neuron_config (T54a M2, D-211)
+        self.moe_tkg_hits_max_rows = config.mimo_moe_tkg_hits_max_rows
+        self.moe_prefill_accumulation_dtype = MOE_PREFILL_ACCUMULATION_KERNEL_DTYPES[
+            config.mimo_moe_prefill_accumulation_dtype]
+        # prefill graphs of fewer tokens skip the replicas (T54a O9)
+        self.replica_min_tokens = config.mimo_expert_replica_min_tokens
+        self.top_k = config.num_experts_per_tok
+        self.norm_topk_prob = config.norm_topk_prob
+        self.routed_scaling_factor = config.routed_scaling_factor
+        H = config.hidden_size
+        I = config.moe_intermediate_size
+        if I % self.tp_degree:
+            raise ValueError(f"moe_intermediate_size {I} not divisible by tp={self.tp_degree}")
+        self.hidden_size = H
+        self.intermediate_size_per_rank = I // self.tp_degree
+        dtype = config.torch_dtype
+
+        # >>> PARALLELISM: router replicated on every rank, FP32 or BF16 (mimo_router_dtype) <<<
+        router_dtype = getattr(torch, config.mimo_router_dtype)
+        self.router_weight = nn.Parameter(
+            torch.empty(self.num_experts, H, dtype=router_dtype), requires_grad=False)
+        self.router_correction_bias = nn.Parameter(
+            torch.empty(self.num_experts, dtype=router_dtype), requires_grad=False)
+        # gate_up [E_local, H, 2*I] = [gate | up] on the last dim (E_local = primary copies;
+        # replicas of a static placement in the *_rep parameters [replica slots, ...])
+        for suffix, n in (("", self.num_primary_experts), ("_rep", self.num_replica_slots)):
+            if n:
+                setattr(self, "gate_up_proj_weight" + suffix, nn.Parameter(
+                    torch.empty(n, H, 2 * self.intermediate_size_per_rank, dtype=dtype),
+                    requires_grad=False))
+                setattr(self, "down_proj_weight" + suffix, nn.Parameter(
+                    torch.empty(n, self.intermediate_size_per_rank, H, dtype=dtype),
+                    requires_grad=False))
+
+    def _route(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return mimo_route(hidden_states, self.router_weight, self.router_correction_bias,
+                          self.top_k, self.norm_topk_prob, self.routed_scaling_factor)
+
+    def uses_replicas(self, num_tokens: int, is_decode: bool) -> bool:
+        """Whether a graph of ``num_tokens`` rows routes to the placement's replicas: prefill
+        graphs of at least ``mimo_expert_replica_min_tokens`` tokens (T54a O9). Shorter
+        prefill graphs run the primary copies only, like decode: no ``[slots, ...]`` weight
+        concatenation (+0.9-1.3 ms per layer at 1,024-4,096 tokens, D-263)."""
+        return (bool(self.num_replica_slots) and not is_decode
+                and num_tokens >= self.replica_min_tokens)
+
+    def _local_affinities(self, affinities: torch.Tensor, is_decode: bool = False) -> torch.Tensor:
+        if self.ep_degree == 1:
+            return affinities
+        if self.expert_slot_ids is not None:
+            if not is_decode and not self.uses_replicas(affinities.shape[0], is_decode):
+                # primaries only: every row of each primary expert, [T, num_primary_experts]
+                # (an even count, E / ep); the mapping and the kernel then take that many
+                # experts (_experts, _slot_weights; rule Z 5, D-264)
+                return NF.get_local_expert_affinities(
+                    affinities, self.expert_slot_ids[:self.num_primary_experts])
+            return placed_local_affinities(affinities, self.expert_slot_ids, self.expert_slot_copies,
+                                           self.expert_slot_copy, self.num_primary_experts,
+                                           is_decode, self.num_local_experts)
+        from vllm_neuron.parallel.neuron_parallel_state import get_neuron_ep_group
+
+        # SPMD: rank offset from the stamped rank tensor (no per-rank constant).
+        ep_rank = get_neuron_ep_group().rank_in_group_tensor.to(torch.int32)
+        local = torch.arange(self.num_local_experts, device=affinities.device,
+                             dtype=torch.int32) + ep_rank * self.num_local_experts
+        return NF.get_local_expert_affinities(affinities, local)
+
+    def _experts(self, hidden_states: torch.Tensor, affinities: torch.Tensor,
+                 padding_mask: torch.Tensor | None, is_decode: bool = False) -> torch.Tensor:
+        # is_decode is unused here; MiMoV2MoEFp8 picks its decode kernel with it
+        T = hidden_states.shape[0]
+        pad = -T % MOE_TOKEN_TILE
+        if pad:
+            hidden_states = torch.cat([hidden_states, hidden_states.new_zeros(pad, self.hidden_size)])
+            affinities = torch.cat([affinities, affinities.new_zeros(pad, affinities.shape[1])])
+            if padding_mask is not None:
+                padding_mask = torch.cat([padding_mask, padding_mask.new_zeros(pad)])
+        affinities_masked, token_position_to_id, block_to_expert, conditions = (
+            NF.build_blockwise_mapping(
+                expert_affinities=affinities,
+                num_local_experts=affinities.shape[1],
+                num_experts_per_token=self.top_k,
+                block_size=MOE_BLOCK_SIZE,
+                moe_group=self.ep_tp_group,
+                tp_degree=self.tp_degree,
+                padding_mask=padding_mask,
+            )
+        )
+        out = self._expert_kernel(hidden_states, affinities_masked, token_position_to_id,
+                                  block_to_expert, conditions)
+        return out[:T] if pad else out
+
+    def _expert_kernel(self, hidden_states: torch.Tensor, affinities_masked: torch.Tensor,
+                       token_position_to_id: torch.Tensor, block_to_expert: torch.Tensor,
+                       conditions: torch.Tensor) -> torch.Tensor:
+        """BF16 experts: ``NF.moe_cte`` shard_on_block (torch fallback on CPU)."""
+        I = self.intermediate_size_per_rank
+        E = self._mapped_experts(hidden_states, affinities_masked)
+        gate_up, down = self._slot_weights("gate_up_proj_weight", "down_proj_weight", n_slots=E)
+        return NF.moe_cte(
+            implementation=MoECTEImplementation.shard_on_block,
+            conditions=conditions,
+            hidden_states=hidden_states,
+            expert_affinities_masked=affinities_masked,
+            gate_up_proj_weight=gate_up.reshape(E, self.hidden_size, 2, I),
+            down_proj_weight=down,
+            activation_function=ActFnType.SiLU,
+            block_size=MOE_BLOCK_SIZE,
+            token_position_to_id=token_position_to_id.to(dtype=torch.int32),
+            block_to_expert=block_to_expert.to(dtype=torch.int32),
+            expert_affinities_scaling_mode=ExpertAffinityScaleMode.POST_SCALE,
+            skip_token=True,
+            is_tensor_update_accumulating=True,
+            compute_dtype=nl.bfloat16,
+        )
+
+    def _mapped_experts(self, hidden_states: torch.Tensor, affinities_masked: torch.Tensor) -> int:
+        """Experts of the block mapping: ``affinities_masked`` is ``[T * E, 1]`` for the
+        ``[T, H]`` (padded) hidden states. The kernel's weights must have the same expert count
+        (it reads affinity rows at ``t * E + e`` with E from the weights, D-264)."""
+        T = hidden_states.shape[0]
+        E, rem = divmod(affinities_masked.shape[0], T)
+        if rem or E not in (self.num_primary_experts, self.num_local_experts):
+            raise ValueError(f"expert mapping of {affinities_masked.shape[0]} rows for {T} tokens "
+                             f"is not {self.num_primary_experts} or {self.num_local_experts} experts")
+        return E
+
+    def _slot_weights(self, *names: str, n_slots: int | None = None) -> list:
+        """Expert tensors of every mapping slot ``[n_slots, ...]`` for the block-mapped
+        kernels: the primaries alone (no replicas, or ``n_slots`` = the primary count: a
+        prefill graph below ``mimo_expert_replica_min_tokens``, T54a O9), or (static placement
+        with replicas, T53b) primaries | replicas | the last replica once more when the slot
+        count is odd (an empty slot: no row routes to it). One concatenation (an HBM copy) per
+        call in that case."""
+        out = []
+        for n in names:
+            w = getattr(self, n)
+            if self.num_replica_slots and n_slots != self.num_primary_experts:
+                r = getattr(self, n + "_rep")
+                pad = [r[-1:]] if self.num_local_experts > self.num_expert_slots else []
+                w = torch.cat([w, r, *pad])
+            out.append(w)
+        return out
+
+    def forward(self, hidden_states: torch.Tensor, positions: torch.Tensor,
+                is_decode: bool) -> torch.Tensor:
+        affinities = self._route(hidden_states)
+        padding_mask = None
+        if not is_decode:
+            # >>> PARALLELISM: SP all-gather (affinities + hidden) <<<
+            if self.world_size > 1:
+                affinities = self.tp_group.all_gather(affinities, dim=0)
+                hidden_states = self.tp_group.all_gather(hidden_states, dim=0)
+            if positions is not None:
+                last_real = torch.argmax(positions)
+                token_idx = torch.arange(positions.shape[0], device=positions.device)
+                padding_mask = token_idx <= last_real
+        affinities = self._local_affinities(affinities, is_decode)
+        out = self._experts(hidden_states, affinities, padding_mask, is_decode)
+        if self.world_size > 1:
+            if is_decode:
+                out = self.tp_group.all_reduce(out)
+            else:
+                out = self.tp_group.reduce_scatter(out, dim=0)
+        return out.to(hidden_states.dtype)
+
+
+class MiMoV2MoEFp8(MiMoV2MoE):
+    """Routed-expert MoE with FP8 row-encoded experts and BF16 activations (see module
+    docstring). Router, routing and collectives: unchanged from ``MiMoV2MoE``; on device
+    decode runs ``moe_tkg`` without the 128-row padding and the block mapping."""
+
+    def __init__(self, config: MiMoV2NeuronConfig):
+        super().__init__(config)
+        H, I = self.hidden_size, self.intermediate_size_per_rank
+        fp8 = torch.float8_e4m3fn
+        # primaries, and the replicas of a static placement (T53b) in the *_rep parameters
+        for suffix, E in (("", self.num_primary_experts), ("_rep", self.num_replica_slots)):
+            if not E:
+                continue
+            setattr(self, "gate_up_proj_weight" + suffix, nn.Parameter(
+                torch.empty(E, H, 2 * I, dtype=fp8), requires_grad=False))
+            setattr(self, "down_proj_weight" + suffix, nn.Parameter(
+                torch.empty(E, I, H, dtype=fp8), requires_grad=False))
+            # per output channel, power of two: gate | up on the last dim, down per hidden channel
+            setattr(self, "gate_up_proj_scale" + suffix, nn.Parameter(
+                torch.empty(E, 1, 2 * I, dtype=torch.float32), requires_grad=False))
+            setattr(self, "down_proj_scale" + suffix, nn.Parameter(
+                torch.empty(E, 1, H, dtype=torch.float32), requires_grad=False))
+
+    def _experts(self, hidden_states: torch.Tensor, affinities: torch.Tensor,
+                 padding_mask: torch.Tensor | None, is_decode: bool = False) -> torch.Tensor:
+        if is_decode and can_run_kernel(hidden_states):
+            return self._experts_tkg(hidden_states, affinities)
+        return super()._experts(hidden_states, affinities, padding_mask, is_decode)
+
+    def _experts_tkg(self, hidden_states: torch.Tensor, affinities: torch.Tensor) -> torch.Tensor:
+        """Decode on device, FP8 row quantization: ``moe_tkg_hits_batch`` for graphs of at most
+        ``mimo_moe_tkg_hits_max_rows`` rows (T53), otherwise nkilib ``moe_tkg`` all-expert (T48).
+
+        ``affinities`` are this rank's ``[T, E_local]`` FP32 affinities (zero for experts
+        not selected), so the kernel's rank slice ``[rank_id*E_L, (rank_id+1)*E_L)`` is
+        taken with ``rank_id`` 0 (a rank-invariant constant). ``expert_index`` is read only
+        with ``mask_unselected_experts=True``; the zero affinities already mask, so a zero
+        ``[T, top_k]`` tensor fills the argument. Scales: gate/up ``[E, 1, 2I]`` ->
+        ``[E, 2, I]`` (gate | up on the last dim), down ``[E, 1, H]`` -> ``[E, H]``.
+
+        With replica slots (static placement, T53b) decode runs the primary copies only (the
+        weight parameters; the replicas live in the *_rep parameters): the replica columns of
+        the affinities are zero here (``placed_local_affinities``) and are dropped."""
+        E, H, I = self.num_primary_experts, self.hidden_size, self.intermediate_size_per_rank
+        T = hidden_states.shape[0]
+        dev = hidden_states.device
+        if self.num_local_experts > E:
+            affinities = affinities[:, :E]
+        if use_moe_tkg_hits(T, self.moe_tkg_hits_max_rows):
+            packed, order, num_hits = pack_hit_experts(affinities)
+            return launch_moe_tkg_hits(
+                hidden_input=hidden_states,
+                expert_gate_up_weights=self.gate_up_proj_weight.reshape(E, H, 2, I),
+                expert_down_weights=self.down_proj_weight,
+                expert_affinities=packed,
+                expert_index=order,
+                num_hits=num_hits,
+                expert_gate_up_weights_scale=self.gate_up_proj_scale.reshape(E, 2, I),
+                expert_down_weights_scale=self.down_proj_scale.reshape(E, H),
+                activation_fn=ActFnType.SiLU,
+            )
+        pad = moe_tkg_rows(T) - T
+        if pad:
+            hidden_states = torch.cat([hidden_states, hidden_states.new_zeros(pad, H)])
+            affinities = torch.cat([affinities, affinities.new_zeros(pad, affinities.shape[1])])
+        out = launch_moe_tkg(
+            hidden_input=hidden_states,
+            expert_gate_up_weights=self.gate_up_proj_weight.reshape(E, H, 2, I),
+            expert_down_weights=self.down_proj_weight,
+            expert_affinities=affinities,
+            expert_index=torch.zeros(T + pad, self.top_k, dtype=torch.int32, device=dev),
+            is_all_expert=True,
+            rank_id=torch.zeros(1, 1, dtype=torch.int32, device=dev),
+            expert_gate_up_weights_scale=self.gate_up_proj_scale.reshape(E, 2, I),
+            expert_down_weights_scale=self.down_proj_scale.reshape(E, H),
+            expert_affinities_scaling_mode=ExpertAffinityScaleMode.POST_SCALE,
+            activation_fn=ActFnType.SiLU,
+        )
+        return out[:T] if pad else out
+
+    def _expert_kernel(self, hidden_states: torch.Tensor, affinities_masked: torch.Tensor,
+                       token_position_to_id: torch.Tensor, block_to_expert: torch.Tensor,
+                       conditions: torch.Tensor) -> torch.Tensor:
+        E = self._mapped_experts(hidden_states, affinities_masked)
+        H, I = self.hidden_size, self.intermediate_size_per_rank
+        common = dict(
+            conditions=conditions,
+            hidden_states=hidden_states,
+            expert_affinities_masked=affinities_masked,
+            activation_function=ActFnType.SiLU,
+            block_size=MOE_BLOCK_SIZE,
+            token_position_to_id=token_position_to_id.to(dtype=torch.int32),
+            block_to_expert=block_to_expert.to(dtype=torch.int32),
+            expert_affinities_scaling_mode=ExpertAffinityScaleMode.POST_SCALE,
+            skip_token=True,
+            is_tensor_update_accumulating=True,
+            compute_dtype=nl.bfloat16,
+        )
+        gu_w, gu_s, dn_w, dn_s = self._slot_weights("gate_up_proj_weight", "gate_up_proj_scale",
+                                                    "down_proj_weight", "down_proj_scale",
+                                                    n_slots=E)
+        if not can_run_kernel(hidden_states):
+            # CPU: the torch fallback ignores scales; dequantize (exact) and run BF16
+            gate_up = (gu_w.to(torch.float32) * gu_s).to(hidden_states.dtype)
+            down = (dn_w.to(torch.float32) * dn_s).to(hidden_states.dtype)
+            return NF.moe_cte(implementation=MoECTEImplementation.shard_on_block,
+                              gate_up_proj_weight=gate_up.reshape(E, H, 2, I),
+                              down_proj_weight=down, **common)
+        # Device (prefill; decode goes through _experts_tkg): shard_on_I_hybrid. The mapping
+        # puts every non-empty block first (expert e owns blocks [cumsum_e, cumsum_{e+1})),
+        # so with no static blocks the kernel's runtime loop over [0, sum(conditions))
+        # covers exactly the blocks that hold tokens; zero iterations when this rank has
+        # none. conditions get the two trailing zeros of the NF.moe_cte contract ([N+2]).
+        common["conditions"] = torch.cat([conditions.to(torch.int32),
+                                          conditions.new_zeros(2, dtype=torch.int32)])
+        return NF.moe_cte(
+            implementation=MoECTEImplementation.shard_on_i_hybrid,
+            num_static_block=0,
+            gate_up_proj_weight=gu_w.reshape(E, H, 2, I),
+            down_proj_weight=dn_w,
+            gate_up_proj_scale=gu_s,
+            down_proj_scale=dn_s,
+            accumulation_dtype=self.moe_prefill_accumulation_dtype,
+            **common,
+        )
+
+
+def launch_moe_tkg(**kwargs) -> torch.Tensor:
+    """``wrap_nki`` launch of the vendored, fixed ``moe_tkg`` on the LNC grid (tests replace this)."""
+    from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+
+    from vllm_neuron.utils.hardware_config import get_logical_nc_config
+
+    from .nki_moe_tkg import mimo_moe_tkg_wrapper
+
+    return wrap_nki(mimo_moe_tkg_wrapper)[int(get_logical_nc_config())](**kwargs)
+
+
+def launch_moe_tkg_hits(**kwargs) -> torch.Tensor:
+    """``wrap_nki`` launch of the vendored ``moe_tkg_hits_batch`` on the LNC grid (tests replace this)."""
+    from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+
+    from vllm_neuron.utils.hardware_config import get_logical_nc_config
+
+    from .nki_moe_tkg.moe_tkg_hits_batch import moe_tkg_hits_batch
+
+    return wrap_nki(moe_tkg_hits_batch)[int(get_logical_nc_config())](**kwargs)
