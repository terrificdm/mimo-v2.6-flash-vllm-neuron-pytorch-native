@@ -0,0 +1,303 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 checkpoint numeric layout helpers (FP8 block scales and MXFP4 experts).
+
+Single source of truth shared by the Neuron weight loader, the BF16 reference
+checkpoint generator (``tools/mimo/dequant_checkpoint.py``) and the proof
+scripts. Those offline tools load this file by path with
+``importlib.util.spec_from_file_location`` so that ``vllm`` / ``vllm_neuron``
+are never imported; keep the dependencies to ``math`` and ``torch`` only.
+
+FP8 linear layers: ``weight`` is ``float8_e4m3fn`` ``[R, C]`` and
+``weight_scale_inv`` is FP32 ``[S_rows, ceil(C/128)]`` (128x128 blocks,
+``scale = absmax / 448``). Rows are partitioned either globally
+(``S_rows == ceil(R/128)``) or per TP shard of the original tp=4 export, each
+shard padded to whole blocks (``S_rows == 4 * ceil(R/4/128)``; global-attention
+``qkv_proj``). FP8 serving (T24) halves the codes (``halve_fp8_e4m3fn``, max 224
+for trn2 e4m3) and doubles the scale.
+
+MXFP4 experts: ``weight`` is uint8 ``[..., K/2]`` (two E2M1 nibbles per byte,
+low nibble = even index) and ``weight_scale`` is uint8 E8M0 ``[..., K/32]``
+(value ``2^(e - 127)``).
+
+Expert FP8 row encoding (lossless): per row ``e_max`` = largest E8M0 exponent,
+``s_row = 2^(e_max - 127 - 5)``, ``w_fp8 = E2M1 * 2^(e_blk - e_max + 5)``.
+``|w_fp8| <= 6 * 2^5 = 192``. Element-level criterion (D-085 option 2, T25): a
+row is encoded when every nonzero element is an e4m3 normal number
+(``|w_fp8| >= 2^-6``); E2M1 has one mantissa bit, so ``w_fp8.float() * s_row``
+is then bit-exact to the MXFP4 dequantized value. This always holds for an
+in-row exponent span ``e_max - e_blk <= 10`` and, depending on the values, for
+spans 11..13. A row with a nonzero element below ``2^-6`` (an e4m3 subnormal or
+zero code) returns a fallback marker.
+"""
+
+import math
+from typing import NamedTuple, Optional
+
+import torch
+
+FP8_BLOCK = 128
+FP8_E4M3FN_MAX = 448.0
+FP8_SHARDS = 4
+FP8_MIN_HIT_FRAC = 0.99
+FP8_HALVE_EXACT_MIN = 2.0 ** -5  # |q| >= 2^-5: q/2 >= 2^-6 is an e4m3 normal number
+TRN2_FP8_MAX = 240.0  # trn2 float8_e4m3 (non-OCP) largest finite value
+
+MXFP4_BLOCK = 32
+E8M0_BIAS = 127
+E2M1_VALUES = (
+    0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
+    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0,
+)
+EXPERT_FP8_EXP_OFFSET = 5  # 6 * 2^5 = 192 <= 240 (trn2 e4m3 max)
+EXPERT_FP8_MAX = 192.0
+EXPERT_MAX_SPAN = 10  # every span <= 10 is in the e4m3 normal range; 11..13 depends on values
+FP8_E4M3_MIN_NORMAL = 2.0 ** -6
+
+LAYOUT_GLOBAL = "global"
+
+
+def fp8_scale_row_layout(R: int, S_rows: int, shards: int = FP8_SHARDS,
+                         blk: int = FP8_BLOCK) -> str:
+    """Return ``"global"`` or ``"per_shard<shards>"``; ``ValueError`` otherwise.
+
+    The global check comes first: when ``R/shards`` is a multiple of ``blk``
+    both partitions give the same mapping.
+    """
+    if S_rows == math.ceil(R / blk):
+        return LAYOUT_GLOBAL
+    if R % shards == 0 and S_rows == shards * math.ceil(R // shards / blk):
+        return f"per_shard{shards}"
+    raise ValueError(f"unknown fp8 scale layout R={R} S={S_rows}")
+
+
+def fp8_block_row_map(R: int, S_rows: int, shards: int = FP8_SHARDS,
+                      blk: int = FP8_BLOCK) -> torch.Tensor:
+    """Scale row index for every weight row, int64 ``[R]``."""
+    layout = fp8_scale_row_layout(R, S_rows, shards, blk)
+    r = torch.arange(R, dtype=torch.int64)
+    if layout == LAYOUT_GLOBAL:
+        return r // blk
+    per = R // shards
+    nb = math.ceil(per / blk)
+    return (r // per) * nb + (r % per) // blk
+
+
+def fp8_block_col_map(C: int, S_cols: int, blk: int = FP8_BLOCK) -> torch.Tensor:
+    """Scale column index for every weight column, int64 ``[C]``."""
+    if S_cols != math.ceil(C / blk):
+        raise ValueError(f"unknown fp8 scale col layout C={C} S={S_cols}")
+    return torch.arange(C, dtype=torch.int64) // blk
+
+
+def expand_fp8_scale_rows(scale_inv: torch.Tensor, R: int, C: int,
+                          shards: int = FP8_SHARDS) -> torch.Tensor:
+    """Expand a block scale ``[S_rows, ceil(C/128)]`` to per-row FP32 ``[R, ceil(C/128)]``.
+
+    Row slices of the result line up with row slices of the weight, so per-head
+    TP sharding can cut weight and scale with the same row indices.
+    """
+    if scale_inv.dim() != 2:
+        raise ValueError(f"fp8 scale must be 2-D, got shape {tuple(scale_inv.shape)}")
+    S_rows, S_cols = scale_inv.shape
+    fp8_block_col_map(C, S_cols)
+    rmap = fp8_block_row_map(R, S_rows, shards)
+    return scale_inv.to(torch.float32).index_select(0, rmap)
+
+
+def dequant_fp8_block(weight: torch.Tensor, scale_inv: torch.Tensor,
+                      shards: int = FP8_SHARDS) -> torch.Tensor:
+    """Block FP8 ``[R, C]`` -> FP32 ``[R, C]`` (``w * scale``) with the layout-aware row map."""
+    if weight.dim() != 2:
+        raise ValueError(f"fp8 weight must be 2-D, got shape {tuple(weight.shape)}")
+    R, C = weight.shape
+    s_row = expand_fp8_scale_rows(scale_inv, R, C, shards)
+    cmap = fp8_block_col_map(C, s_row.shape[1])
+    return weight.to(torch.float32) * s_row.index_select(1, cmap)
+
+
+def fp8_block_hit_stats(weight: torch.Tensor, scale_inv: torch.Tensor,
+                        shards: int = FP8_SHARDS) -> dict:
+    """Fraction of blocks whose ``max|q| == 448`` under the layout-aware partition.
+
+    Block scaling defines ``scale = absmax / 448``, so a correct partition hits
+    448 in (almost) every block. Scale rows that no weight row maps to (none for
+    the two supported layouts) are excluded.
+    """
+    if weight.dim() != 2:
+        raise ValueError(f"fp8 weight must be 2-D, got shape {tuple(weight.shape)}")
+    R, C = weight.shape
+    S_rows, S_cols = scale_inv.shape
+    layout = fp8_scale_row_layout(R, S_rows, shards)
+    rmap = fp8_block_row_map(R, S_rows, shards)
+    cmap = fp8_block_col_map(C, S_cols)
+    a = weight.to(torch.float32).abs()
+    row_blk = torch.zeros(S_rows, C, dtype=torch.float32).index_reduce_(
+        0, rmap, a, "amax", include_self=True)
+    blk_max = torch.zeros(S_rows, S_cols, dtype=torch.float32).index_reduce_(
+        1, cmap, row_blk, "amax", include_self=True)
+    used = torch.zeros(S_rows, dtype=torch.bool)
+    used[rmap] = True
+    bm = blk_max[used]
+    hit = int((bm == FP8_E4M3FN_MAX).sum())
+    blocks = int(bm.numel())
+    return {"layout": layout, "hit": hit, "blocks": blocks, "frac": hit / blocks}
+
+
+def check_fp8_block_hit(name: str, weight: torch.Tensor, scale_inv: torch.Tensor,
+                        min_frac: float = FP8_MIN_HIT_FRAC,
+                        shards: int = FP8_SHARDS) -> dict:
+    """``fp8_block_hit_stats`` that raises ``ValueError`` when ``frac < min_frac``."""
+    stats = fp8_block_hit_stats(weight, scale_inv, shards)
+    if stats["frac"] < min_frac:
+        raise ValueError(
+            f"fp8 block partition check failed for {name}: layout={stats['layout']} "
+            f"hit_frac={stats['frac']:.6f} < {min_frac} "
+            f"({stats['hit']}/{stats['blocks']} blocks with max|q|==448)")
+    return stats
+
+
+def halve_fp8_e4m3fn(weight: torch.Tensor) -> torch.Tensor:
+    """FP8 linear weight ``w * 0.5`` rounded to e4m3fn (design 6.2, D-008).
+
+    trn2 reads ``float8_e4m3fn`` bits as e4m3 (max 240, exponent 15 = inf/NaN), so
+    the checkpoint codes (block max 448) are halved to at most 224 and the block
+    scale is doubled. Halving only lowers the exponent by one, so every
+    ``|w| >= FP8_HALVE_EXACT_MIN`` (2^-5) stays exact; smaller codes are rounded
+    to the e4m3 subnormal grid (2^-9), see :func:`fp8_halve_stats`.
+    """
+    if weight.dtype != torch.float8_e4m3fn:
+        raise ValueError(f"fp8 linear weight must be float8_e4m3fn, got {weight.dtype}")
+    return (weight.to(torch.float32) * 0.5).to(torch.float8_e4m3fn)
+
+
+def fp8_halve_stats(weight: torch.Tensor, halved: torch.Tensor,
+                    scale_rows: Optional[torch.Tensor] = None) -> dict:
+    """Changed elements and error of :func:`halve_fp8_e4m3fn` for one tensor.
+
+    ``changed``: elements with ``2 * halved != weight``. ``changed_ge_exact_min`` must
+    be 0 (exactness of ``|w| >= 2^-5``). Errors are in checkpoint code units
+    (``|halved - w/2|``, so the dequantized error is ``2 * scale`` times that) and
+    relative to the block maximum 448 (``2 * err / 448``, scale-free).
+    ``scale_rows``: optional per-row expanded scale ``[R, ceil(C/128)]`` (FP32) for the
+    largest dequantized error ``2 * err * scale``.
+    """
+    w = weight.to(torch.float32)
+    h = halved.to(torch.float32)
+    err = (h - w * 0.5).abs()
+    changed = (h * 2.0) != w
+    out = {
+        "elements": int(w.numel()),
+        "changed": int(changed.sum()),
+        "changed_frac": float(changed.sum()) / max(1, w.numel()),
+        "changed_ge_exact_min": int((changed & (w.abs() >= FP8_HALVE_EXACT_MIN)).sum()),
+        "below_exact_min": int((w.abs() < FP8_HALVE_EXACT_MIN).sum()),
+        "max_abs_err_code": float(err.max()) if err.numel() else 0.0,
+        "max_rel_err_vs_block_max": float(err.max()) * 2.0 / FP8_E4M3FN_MAX if err.numel() else 0.0,
+        "max_abs_halved": float(h.abs().max()) if h.numel() else 0.0,
+        "nonfinite": int((~torch.isfinite(w)).sum()) + int((~torch.isfinite(h)).sum()),
+    }
+    if scale_rows is not None:
+        R, C = w.shape
+        cmap = fp8_block_col_map(C, scale_rows.shape[1])
+        val = err * 2.0 * scale_rows.to(torch.float32).index_select(1, cmap)
+        out["max_abs_err_value"] = float(val.max()) if val.numel() else 0.0
+    return out
+
+
+def _check_mxfp4_shapes(blocks: torch.Tensor, scales: torch.Tensor) -> None:
+    if blocks.dtype != torch.uint8 or scales.dtype != torch.uint8:
+        raise ValueError(
+            f"mxfp4 blocks/scales must be uint8, got {blocks.dtype}/{scales.dtype}")
+    if blocks.shape[:-1] != scales.shape[:-1] or \
+            blocks.shape[-1] * 2 != scales.shape[-1] * MXFP4_BLOCK:
+        raise ValueError(
+            f"mxfp4 shape mismatch: blocks {tuple(blocks.shape)} scales "
+            f"{tuple(scales.shape)} (expected blocks[-1]*2 == scales[-1]*{MXFP4_BLOCK})")
+
+
+def unpack_e2m1(blocks: torch.Tensor, dtype: torch.dtype = torch.float32) -> torch.Tensor:
+    """uint8 ``[..., N]`` -> E2M1 values ``[..., 2N]`` (low nibble -> even index)."""
+    lut = torch.tensor(E2M1_VALUES, dtype=dtype)
+    out = torch.empty(*blocks.shape[:-1], blocks.shape[-1] * 2, dtype=dtype)
+    out[..., 0::2] = lut[(blocks & 0x0F).long()]
+    out[..., 1::2] = lut[(blocks >> 4).long()]
+    return out
+
+
+def unpack_mxfp4(blocks: torch.Tensor, scales: torch.Tensor,
+                 dtype: torch.dtype = torch.float32) -> torch.Tensor:
+    """MXFP4 ``blocks [..., K/2]`` + E8M0 ``scales [..., K/32]`` -> ``[..., K]``.
+
+    Value = E2M1 * 2^(scale - 127). Exact in FP32; exact in BF16 for the
+    exponent range of real checkpoints.
+    """
+    _check_mxfp4_shapes(blocks, scales)
+    vals = unpack_e2m1(blocks, torch.float32)
+    exp = (scales.to(torch.int32) - E8M0_BIAS).repeat_interleave(MXFP4_BLOCK, dim=-1)
+    return torch.ldexp(vals, exp.to(torch.float32)).to(dtype)
+
+
+class ExpertFp8Rows(NamedTuple):
+    """Result of :func:`encode_expert_fp8_rows`.
+
+    ``fallback=False``: ``weight`` is ``float8_e4m3fn [..., K]`` and ``row_scale``
+    FP32 ``[..., 1]``; ``weight.float() * row_scale`` equals ``unpack_mxfp4``.
+    ``fallback=True``: ``fallback_rows`` rows cannot be encoded exactly (a nonzero
+    element below ``2^-6``, or a span above the optional ``max_span``); ``weight``
+    and ``row_scale`` are ``None`` and the caller must keep that tensor in BF16.
+    ``max_span`` / ``rows_over_span``: largest in-row span and rows with span > 10
+    (statistics; they do not decide the fallback unless ``max_span`` is given).
+    """
+    weight: Optional[torch.Tensor]
+    row_scale: Optional[torch.Tensor]
+    fallback: bool
+    max_span: int
+    rows_over_span: int
+    fallback_rows: int
+
+
+def expert_row_exponent_span(blocks: torch.Tensor, scales: torch.Tensor):
+    """Per-row ``(e_max, span)`` over 32-blocks that contain a nonzero element.
+
+    All-zero blocks are exact for any shift, so they do not constrain the span.
+    A row with no nonzero block gets ``e_max = max(scales)`` and span 0.
+    """
+    _check_mxfp4_shapes(blocks, scales)
+    e = scales.to(torch.int32)
+    nz = (blocks & 0x77) != 0  # magnitude bits of both nibbles (-0 counts as zero)
+    nz_blk = nz.reshape(*blocks.shape[:-1], scales.shape[-1], MXFP4_BLOCK // 2).any(dim=-1)
+    big, small = torch.iinfo(torch.int32).max, torch.iinfo(torch.int32).min
+    e_hi = torch.where(nz_blk, e, torch.full_like(e, small)).amax(dim=-1)
+    e_lo = torch.where(nz_blk, e, torch.full_like(e, big)).amin(dim=-1)
+    any_nz = nz_blk.any(dim=-1)
+    e_max = torch.where(any_nz, e_hi, e.amax(dim=-1))
+    span = torch.where(any_nz, e_hi - e_lo, torch.zeros_like(e_hi))
+    return e_max, span
+
+
+def encode_expert_fp8_rows(blocks: torch.Tensor, scales: torch.Tensor,
+                           max_span: Optional[int] = None) -> ExpertFp8Rows:
+    """Lossless MXFP4 -> FP8 (e4m3fn storage, |v| <= 192) + per-row power-of-two scale.
+
+    Element-level criterion (module docstring): rows whose nonzero values all stay
+    e4m3 normal numbers are encoded; ``max_span`` (optional) additionally treats rows
+    with a larger in-row span as fallback rows.
+    """
+    e_max, span = expert_row_exponent_span(blocks, scales)
+    worst = int(span.max()) if span.numel() else 0
+    over = int((span > EXPERT_MAX_SPAN).sum())
+    vals = unpack_e2m1(blocks, torch.float32)
+    shift = (scales.to(torch.int32) - e_max.unsqueeze(-1) + EXPERT_FP8_EXP_OFFSET)
+    shift = shift.repeat_interleave(MXFP4_BLOCK, dim=-1)
+    vals = torch.ldexp(vals, shift.to(torch.float32))  # exact in FP32
+    below_normal = ((vals != 0) & (vals.abs() < FP8_E4M3_MIN_NORMAL)).any(dim=-1)
+    if max_span is not None:
+        below_normal = below_normal | (span > max_span)
+    n_fallback = int(below_normal.sum())
+    if n_fallback:
+        return ExpertFp8Rows(None, None, True, worst, over, n_fallback)
+    w = vals.to(torch.float8_e4m3fn)
+    row_exp = (e_max - E8M0_BIAS - EXPERT_FP8_EXP_OFFSET).unsqueeze(-1)
+    row_scale = torch.ldexp(torch.ones(row_exp.shape, dtype=torch.float32),
+                            row_exp.to(torch.float32))
+    return ExpertFp8Rows(w, row_scale, False, worst, over, 0)
