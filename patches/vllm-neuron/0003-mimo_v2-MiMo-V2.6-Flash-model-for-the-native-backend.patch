+            attn.v_cache = v_cache
+            attn.check_kv_block_size(k_cache.shape[2])
+
+    # ── weights ───────────────────────────────────────────────────────────
+
+    def _ep_size_rank(self) -> tuple[int, int]:
+        moe = next((l.mlp for l in self.model.layers if isinstance(l.mlp, MiMoV2MoE)), None)
+        if moe is None or moe.ep_degree == 1:
+            return 1, 0
+        from vllm_neuron.parallel.neuron_parallel_state import get_neuron_ep_rank
+
+        return moe.ep_degree, get_neuron_ep_rank()
+
+    def map_rank_state(self, state: dict) -> dict:
+        """Rename ``load_rank_state`` keys to parameters; every parameter must be covered.
+        The audio tokenizer's RVQ codebooks are (persistent) buffers and count too."""
+        params = dict(self.named_parameters())
+        params.update((n, b) for n, b in self.named_buffers() if n.startswith("audio_towers."))
+        fp8_linear = self.config.mimo_precision == "fp8"
+        mapped = {}
+        for key, tensor in state.items():
+            name = rank_state_key_to_param(key, fp8_linear)
+            if name not in params:
+                raise KeyError(f"MiMo-V2 rank state key {key!r} -> {name!r} has no parameter")
+            p = params[name]
+            if tuple(p.shape) != tuple(tensor.shape) or p.dtype != tensor.dtype:
+                raise ValueError(
+                    f"{name}: parameter {tuple(p.shape)} {p.dtype} vs loaded "
+                    f"{tuple(tensor.shape)} {tensor.dtype}")
+            mapped[name] = tensor
+        missing = sorted(set(params) - set(mapped))
+        if missing:
+            raise KeyError(f"MiMo-V2: {len(missing)} parameters not loaded, e.g. {missing[:5]}")
+        return mapped
+
+    def load_weights(self, checkpoint_path: str, device: torch.device,
+                     cache_dir: str | None = None) -> None:
+        ckpt = resolve_checkpoint_dir(checkpoint_path, cache_dir)
+        model_quantization = _vllm_model_quantization()
+        check_serving_checkpoint_format(ckpt, self.hf_config, model_quantization)
+        ep_size, ep_rank = self._ep_size_rank()
+        kwargs = dict(tp_size=self.world_size, tp_rank=self.rank, ep_size=ep_size, ep_rank=ep_rank,
+                      precision=self.config.mimo_precision, router_dtype=self.config.mimo_router_dtype)
+        if self.config.mimo_precision == "fp8":
+            kwargs["fp8_linear"] = self.config.mimo_fp8_linear
+            kwargs["bf16_expert_layers"] = self.config.mimo_bf16_expert_layers
+        if model_quantization is not _UNKNOWN:
+            kwargs["model_quantization"] = model_quantization
+        if self.config.mimo_expert_placement:  # static EP expert placement (T53b)
+            from .expert_placement import load_expert_placement
+
+            kwargs["expert_placement"] = load_expert_placement(
+                self.config.mimo_expert_placement, n_experts=self.config.n_routed_experts,
+                moe_layers=[i for i in range(self.config.num_hidden_layers)
+                            if self.config.is_moe_layer(i)])
+        logger.info("MiMo-V2 load_weights: %s %s", ckpt, kwargs)
+        state = load_rank_state(ckpt, **kwargs)
+        if self.visual is not None:
+            # vision tower (T39): BF16, the same full copy on every rank
+            state.update({"visual." + k: v
+                          for k, v in load_vision_state(ckpt, torch.bfloat16).items()})
+        if self.audio_towers is not None:
+            # audio towers (T41): BF16 (RVQ codebooks FP32), the same full copy on every rank
+            state.update({"audio_towers." + k: v
+                          for k, v in load_audio_cache_encoder_state(ckpt, torch.bfloat16).items()})
