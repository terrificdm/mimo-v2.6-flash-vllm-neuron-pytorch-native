index 0000000..0d52192
--- /dev/null
+++ b/vllm_neuron/model/mimo_v2/expert_placement.py
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MiMo-V2 static EP expert placement (T53b): which experts each EP rank holds, per MoE layer.
+
+Without a placement, EP rank ``r`` holds experts ``[r*E/ep, (r+1)*E/ep)`` (linear). Prefill
+experts run nkilib ``shard_on_I_hybrid``, which computes only the blocks that hold tokens, so a
+rank's MoE time follows the tokens routed to its experts and every rank waits for the busiest
+one in the MoE reduce-scatter (T51 profile-r02: 1M prefill, 290 ms per 8192-token segment, the
+busiest rank 5.4x the mean, D-231). ``neuron_config.mimo_expert_placement`` names a JSON file
+(``FORMAT``) that rebalances it:
+
+* every rank has ``slots_per_rank`` expert slots per MoE layer; slots ``0 .. E/ep - 1`` hold the
+  primary copies (every expert exactly once over all ranks), the remaining slots hold replicas
+  of hot experts (vLLM EPLB's redundant experts); ``slots_per_rank == E/ep`` is a pure static
+  remap (no extra HBM);
+* ``layers[str(i)]["slot_expert"][r][j]`` is the expert in slot ``j`` of rank ``r``, and
+  ``layers[str(i)]["slot_copy"][r][j]`` which copy of that expert it is (``0 .. copies - 1``);
+  a rank never holds two copies of one expert;
+* prefill row ``t`` of a forward (after the sequence-parallel all-gather) is sent to copy
+  ``t mod copies(e)`` of expert ``e``; decode graphs use the primary copies only (the decode
+  kernels read every local expert or every hit expert's weights, so a replica would only add
+  reads there).
+
+Each copy loads the same checkpoint tensors (``weight_loaders.load_rank_state``; primaries in
+the expert parameters, replicas in separate ``*_rep`` parameters so decode reads the primaries
+without slicing), so a replica is bit-identical to its primary, the routing (top-k on the router scores in expert-index order)
+is unchanged, and a token's expert outputs are the same values summed in a different order
+(per-rank BF16 partial sums, then the collective). The slot tables are loaded per rank as
+int32 parameters (graph inputs), so all ranks share one graph; the graph depends only on
+``slots_per_rank``.
+
+On device the block mapping's ``find_nonzero_indices`` kernel needs an even local expert count
+(``vllm_neuron/functional/moe/moe_blockwise.py`` ``_can_use_find_nonzero_indices_kernel``,
+divisible by the logical core count 2), so an odd ``slots_per_rank`` gets one more, empty
+mapping slot in prefill (no row routes to it; ``moe.MiMoV2MoE._slot_weights``). The planner is
+neuron-agentic-development ``tools/mimo/t53b/ep_placement.py``.
+"""
+
+import json
+import os
+from dataclasses import dataclass
+
+FORMAT = "mimo-expert-placement-v1"
+
+
+@dataclass(frozen=True)
+class RankSlots:
+    """One rank's slots of one MoE layer: expert id, copies of that expert, copy index."""
+
+    experts: tuple[int, ...]
+    copies: tuple[int, ...]
+    copy: tuple[int, ...]
+
+
+@dataclass(frozen=True, repr=False)
+class ExpertPlacement:
+    path: str
+    n_experts: int
+    ep_size: int
+    slots_per_rank: int
+    layers: dict  # layer -> (slot_expert [ep][S], slot_copy [ep][S]) as tuples
+
+    def __repr__(self) -> str:  # short: load_weights logs its kwargs
+        return (f"ExpertPlacement({self.path!r}, ep_size={self.ep_size}, "
+                f"slots_per_rank={self.slots_per_rank}, layers={len(self.layers)})")
+
+    @property
+    def primary_per_rank(self) -> int:
+        return self.n_experts // self.ep_size
+
+    def rank_slots(self, layer: int, rank: int) -> RankSlots:
+        if layer not in self.layers:
+            raise KeyError(f"{self.path}: no placement for MoE layer {layer}")
+        if not 0 <= rank < self.ep_size:
+            raise ValueError(f"{self.path}: EP rank {rank} outside 0..{self.ep_size - 1}")
+        se, sc = self.layers[layer]
+        count = {}
+        for row in se:
+            for e in row:
+                count[e] = count.get(e, 0) + 1
+        return RankSlots(tuple(se[rank]), tuple(count[e] for e in se[rank]), tuple(sc[rank]))
+
+
+def load_expert_placement(path: str, *, n_experts: int, moe_layers) -> ExpertPlacement:
+    """Read and check a placement file (see the module docstring). ValueError on any problem."""
+    if not isinstance(path, str) or not path:
+        raise ValueError(f"neuron_config.mimo_expert_placement must be a file path, got {path!r}")
+    if not os.path.isfile(path):
+        raise ValueError(f"neuron_config.mimo_expert_placement: {path} is not a file")
+    with open(path) as f:
+        doc = json.load(f)
+    if doc.get("format") != FORMAT:
+        raise ValueError(f"{path}: format {doc.get('format')!r}, expected {FORMAT!r}")
+    if doc.get("n_routed_experts") != n_experts:
+        raise ValueError(f"{path}: n_routed_experts {doc.get('n_routed_experts')} != model {n_experts}")
+    ep, S = doc.get("ep_size"), doc.get("slots_per_rank")
+    if not (isinstance(ep, int) and ep > 1 and n_experts % ep == 0):
+        raise ValueError(f"{path}: ep_size {ep!r} must be > 1 and divide {n_experts}")
+    P = n_experts // ep
+    if not (isinstance(S, int) and S >= P):
+        raise ValueError(f"{path}: slots_per_rank {S!r} must be an integer >= {P}")
+    want = sorted(int(i) for i in moe_layers)
+    got = doc.get("layers") or {}
+    if sorted(int(k) for k in got) != want:
+        raise ValueError(f"{path}: layers {sorted(int(k) for k in got)} != MoE layers {want}")
+    layers = {}
+    for i in want:
+        se, sc = got[str(i)].get("slot_expert"), got[str(i)].get("slot_copy")
+        bad = f"{path}: layer {i}"
+        if not (isinstance(se, list) and isinstance(sc, list) and len(se) == ep and len(sc) == ep
+                and all(isinstance(r, list) and len(r) == S for r in se + sc)):
+            raise ValueError(f"{bad}: slot_expert / slot_copy must be [{ep}][{S}] lists")
+        if not all(type(v) is int for r in se + sc for v in r):
+            raise ValueError(f"{bad}: slot entries must be integers")
+        if any(not 0 <= e < n_experts for r in se for e in r):
+            raise ValueError(f"{bad}: expert id outside 0..{n_experts - 1}")
+        if sorted(e for r in se for e in r[:P]) != list(range(n_experts)):
+            raise ValueError(f"{bad}: the primary slots 0..{P - 1} must hold every expert exactly once")
+        for r, row in enumerate(se):
+            if len(set(row)) != S:
+                raise ValueError(f"{bad}: rank {r} holds an expert more than once")
+        copies = {}
+        for r in range(ep):
+            for j in range(S):
+                copies.setdefault(se[r][j], []).append(sc[r][j])
+        for e, ks in copies.items():
+            if sorted(ks) != list(range(len(ks))):
+                raise ValueError(f"{bad}: expert {e} copy indices {sorted(ks)} are not 0..{len(ks) - 1}")
+        layers[i] = (tuple(tuple(r) for r in se), tuple(tuple(r) for r in sc))
+    return ExpertPlacement(path=path, n_experts=n_experts, ep_size=ep, slots_per_rank=S, layers=layers)
diff --git a/vllm_neuron/model/mimo_v2/factory.py b/vllm_neuron/model/mimo_v2/factory.py
