+
+        packed = prompt_logprobs_topk(
+            self.lm_head(hidden_all.to(self.config.torch_dtype)), target_ids,
+            self.prompt_logprobs_width(), process_group=self.tp_group.device_group, rank=rank)
+        return (*outputs, packed)
