+            for req_id in list(self._host_logits_history):
+                if req_id not in self.requests:
+                    del self._host_logits_history[req_id]
+        return rows
+
+    def _host_output_history(
+        self, req_id: str, req: CachedRequestState, num_output: int
+    ) -> list[int]:
+        """The request's first ``num_output`` output tokens (T65).
+
+        Normally the runner's own record, extended by ``_apply_host_sampling``
+        on every host-processed step, so it is the same on every rank. It is
+        (re)built from ``req.output_token_ids`` when it does not exist yet or
+        has the wrong length: a new request (0 tokens), a resumed request
+        (``_update_states`` sets the list from the scheduler on every rank), or
+        tokens the scheduler dropped.
+        """
+        history = self._host_logits_history.get(req_id)
+        if history is not None and len(history) == num_output:
+            return history
+        if history is not None and len(history) > num_output:
+            history = history[:num_output]
+        elif len(req.output_token_ids) >= num_output:
+            history = list(req.output_token_ids[:num_output])
+        else:
+            logger.warning(
+                "host logits processing: request %s has %d output tokens on "
+                "record but %d were generated; penalties and min_tokens use "
+                "the shorter history",
+                req_id,
+                len(req.output_token_ids),
+                num_output,
+            )
+            history = list(req.output_token_ids)
+        self._host_logits_history[req_id] = history
+        return history
+
+    def _apply_host_sampling(
+        self, plan: dict, output_token_ids: list[list[int]]
+    ) -> LogprobsTensors | None:
+        """Re-draw the seeded and host-processed rows in place, then compute logprobs.
+
+        ``output_token_ids`` is modified in place: each such row's token is
+        replaced by the host draw (the device's draw for that row is dropped).
+        Returns the logprobs of the emitted tokens, or None when the step did
+        not ask for logprobs.
+        """
+        logits_cpu = plan["logits"].to("cpu").to(torch.float32)
+        limit = min(len(output_token_ids), logits_cpu.shape[0])
+        keep = [j for j, i in enumerate(plan["seed_rows"]) if i < limit]
+        if keep:
+            rows = [plan["seed_rows"][j] for j in keep]
+            sel = torch.tensor(keep, dtype=torch.long)
+            drawn = _host_sample_rows(
+                logits_cpu[torch.tensor(rows, dtype=torch.long)],
+                plan["temperature"][sel],
+                plan["top_p"][sel],
+                plan["top_k"][sel],
+                {n: plan["generators"][j] for n, j in enumerate(keep)},
+            )
+            for n, i in enumerate(rows):
+                output_token_ids[i] = [int(drawn[n])]
+            logger.debug("host-sampled seeded rows %s -> %s", rows, drawn.tolist())
+        proc = plan.get("proc")
+        if proc:
+            # Penalties, allowed_token_ids, bad_words, min_tokens, logit_bias,
+            # min_p: vLLM's Sampler on the CPU over the full vocabulary (T65).
+            rows = [i for i in sorted(proc) if i < limit]
+            # Structured outputs: the grammar bitmask first, in place, as GPU vLLM
+            # applies it to the logits before its Sampler; the logprobs below are
+            # then those of the masked logits, as on GPU (T66).
+            apply_grammar_rows(
+                logits_cpu,
+                {i: proc[i][1].grammar_bitmask for i in rows
+                 if proc[i][1].grammar_bitmask is not None},
+                vocab_size=self.input_batch.vocab_size,
+            )
+            if rows:
+                vocab = self.input_batch.vocab_size
+                drawn = host_logits_sample(
+                    self._host_sampler,
+                    logits_cpu[torch.tensor(rows, dtype=torch.long), :vocab],
+                    [proc[i][1] for i in rows],
+                    vocab_size=vocab,
+                    vllm_config=self.vllm_config,
+                    logitsproc_types=self._host_logitsproc_types,
+                    fallback_generator=self._host_logits_rng,
+                )
+                for i, token in zip(rows, drawn):
+                    output_token_ids[i] = [token]
+                    self._host_logits_history[proc[i][0]].append(token)
+                logger.debug("host-processed rows %s -> %s", rows, drawn)
+        if plan["num_logprobs"] == 0:
+            return None
+        return self._compute_on_device_logprobs(
+            logits_cpu, output_token_ids, plan["num_logprobs"]
+        )
+
+    def _compute_on_device_logprobs(
