+    def _build_host_sampling_plan(self, num_logprobs: int) -> dict | None:
+        """What the host still has to do for this step's on-device sampling.
+
+        Returns None when the device result needs no host work. Otherwise a
+        snapshot: the gathered logits (possibly still a device future), the
+        seeded rows with their sampling params, and how many logprobs were
+        asked for. Snapshotting matters under async scheduling, where the plan
+        is consumed one step later, after ``_update_states`` may have added,
+        removed or reordered requests (T30, D-110).
+        """
+        if self._on_device_logits is None:
+            return None
+        seed_rows = sorted(self.input_batch.generators)
+        proc = self._host_logits_rows()
+        if not seed_rows and not proc and num_logprobs == 0:
+            return None
+        plan: dict = {
+            "logits": self._on_device_logits,
+            "num_logprobs": num_logprobs,
+            # Every row the host draws; the async path writes these back into
+            # the device sampling tensor.
+            "rows": sorted(set(seed_rows) | set(proc)),
+        }
+        # Seeded rows without other host processing keep the T30 draw.
+        seed_rows = [i for i in seed_rows if i not in proc]
+        plan["seed_rows"] = seed_rows
+        if seed_rows:
+            idx = torch.tensor(seed_rows, dtype=torch.long)
+            plan["temperature"] = self.input_batch.temperature_cpu_tensor[idx].clone()
+            plan["top_p"] = self.input_batch.top_p_cpu_tensor[idx].clone()
+            plan["top_k"] = self.input_batch.top_k_cpu_tensor[idx].clone()
+            plan["generators"] = {
+                j: self.input_batch.generators[i] for j, i in enumerate(seed_rows)
+            }
+        if proc:
+            plan["proc"] = proc
+        return plan
+
+    def _host_grammar_bitmask_rows(
+        self,
+        scheduler_output: SchedulerOutput,
+        grammar_output: GrammarOutput | None,
+    ) -> dict[int, torch.Tensor]:
+        """Batch row -> packed grammar bitmask row of this step (host mask, T66).
+
+        ``grammar_output`` is what vLLM's engine core hands to sample_tokens: one
+        packed int32 row per scheduled position of each structured-output request
+        (1 + its draft count), in ``structured_output_request_ids`` order, the
+        layout ``vllm.v1.structured_output.utils.apply_grammar_bitmask`` reorders
+        on GPU. Only the first row of each request is used: on a verify step such
+        a request emits the one token drawn from its first verify position
+        (``_apply_host_spec_rows``). The draft counts are the engine core's, from
+        before ``_drop_transition_spec_decode_if_cache_incomplete``. A row that
+        allows every token (``-1`` everywhere: the request is still in its
+        reasoning section, ``StructuredOutputManager.should_fill_bitmask``) is
+        left out, so the row keeps the device draw like any other request;
+        except on a speculative-decoding server: there the grammar can start in
+        the middle of a verify window (the reasoning end is one of the accepted
+        drafts), and GPU vLLM then constrains the rest of the window with
+        bitmask rows built from the real drafts, which the Neuron scheduler does
+        not see under async scheduling (they stay -1 placeholders). So there every
+        structured-output request emits one host token per step, and the grammar
+        constrains the token right after the reasoning end.
+        """
+        if (
+            grammar_output is None
+            or grammar_output.grammar_bitmask is None
+            or self.neuron_config.structured_outputs_mask != "host"
+            or not self.on_device_sampling
+        ):
+            return {}
+        packed = torch.from_numpy(grammar_output.grammar_bitmask).to(torch.int32)
+        batch_row = {req_id: i for i, req_id in enumerate(self.input_batch.req_ids)}
+        counts = getattr(self, "_grammar_spec_counts", None) or {}
+        keep_unconstrained = bool(getattr(self, "is_spec_decode", False))
+        rows: dict[int, torch.Tensor] = {}
+        start = 0
+        for req_id in grammar_output.structured_output_request_ids:
+            i = batch_row.get(req_id)
+            if i is not None and start < packed.shape[0]:
+                row = packed[start]
+                if keep_unconstrained or not bool((row == -1).all()):
+                    rows[i] = row.clone()
+            start += 1 + counts.get(req_id, 0)
+        if start != packed.shape[0]:
+            raise RuntimeError(
+                f"Bitmask alignment error: the engine core's grammar bitmask has "
+                f"{packed.shape[0]} rows, the scheduled positions of its "
+                f"structured-output requests are {start}."
+            )
+        return rows
+
+    def _host_logits_rows(self) -> dict[int, tuple[str, HostRow]]:
+        """Rows of this step that need the host logits processing (T65, D-188).
+
+        A row qualifies when its request carries a sampling parameter that the
+        on-device sampler ignores (``needs_host_logits``), or when this step's
+        grammar bitmask constrains it (structured outputs with the host mask,
+        T66: ``_host_grammar_rows``). Rows of a chunked
+        prefill that is not final are skipped, because their draw is discarded
+        (GPU vLLM rewinds the generator of those rows, so they do not consume
+        it either). On a speculative-decoding server min_p and logit_bias do not
+        count (vLLM's frontend rejects them there and GPU vLLM's worker builds
+        only the min-tokens processor), and the number of output
+        tokens comes from the runner's own record: the scheduler's
+        num_computed_tokens is optimistic under async speculative decoding.
+
+        Returns:
+            batch row -> (request id, snapshot of the row's sampler inputs).
+        """
+        if not self.on_device_sampling:
+            return {}
+        spec = self.is_spec_decode
+        # Structured-output rows with a constraining bitmask this step (T66).
+        grammar = getattr(self, "_host_grammar_rows", None) or {}
+        rows: dict[int, tuple[str, HostRow]] = {}
+        ib = self.input_batch
+        for i, req_id in enumerate(ib.req_ids):
+            req = self.requests.get(req_id)
+            if req is None or req.sampling_params is None:
+                continue
+            num_output = (
+                int(ib.num_computed_tokens_cpu[i])
+                + self._host_num_scheduled.get(req_id, 0)
+                - req.num_prompt_tokens
+            )
+            if num_output < 0:
+                continue
+            if spec:
+                known = self._host_logits_history.get(req_id)
+                num_output = len(req.output_token_ids if known is None else known)
+            if not needs_host_logits(
+                req.sampling_params, num_output, min_p_and_logit_bias=not spec
+            ) and i not in grammar:
+                continue
+            history = self._host_output_history(req_id, req, num_output)
+            prompt = req.prompt_token_ids
+            if prompt is None:  # prompt embeds: the ids InputBatch holds, as GPU uses
+                prompt = ib.token_ids_cpu[i, : req.num_prompt_tokens].tolist()
+            rows[i] = (
+                req_id,
+                HostRow(
+                    params=req.sampling_params,
+                    prompt_token_ids=prompt,
+                    output_token_ids=list(history),
+                    temperature=float(ib.temperature_cpu[i]),
+                    top_p=float(ib.top_p_cpu[i]),
+                    top_k=int(ib.top_k_cpu[i]),
+                    generator=ib.generators.get(i),
+                    grammar_bitmask=grammar.get(i),
+                ),
+            )
