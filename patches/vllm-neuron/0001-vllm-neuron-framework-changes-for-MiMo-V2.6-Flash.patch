+    @staticmethod
+    def _finish_prompt_logprobs(plan: dict) -> dict[str, LogprobsTensors]:
+        """Copy the device result into each request's tensors; returns the
+        ``prompt_logprobs_dict`` entries of the requests whose prefill finished."""
+        from vllm_neuron.model.mimo_v2.prompt_logprobs import unpack
