+    @staticmethod
+    def _spec_sample_row_starts(spec_decode_metadata: SpecDecodeMetadata) -> list[int]:
+        """First gathered-logits row of each request in a verify step.
+
+        The verify graph samples ``num_draft_tokens[i] + 1`` positions per
+        request, request after request (``logits_indices`` from
+        ``_build_spec_decode_metadata``, padded fake requests included), so
+        the t-th token request i emits (its accepted drafts, then the
+        correction or bonus token) was sampled from row ``start_i + t``;
+        with k drafts everywhere that is row ``i * (1 + k) + t`` (T37, D-129).
+        """
+        starts: list[int] = []
+        row = 0
+        for n in spec_decode_metadata.num_draft_tokens:
+            starts.append(row)
+            row += int(n) + 1
+        return starts
+
+    def _compute_spec_logprobs(
+        self,
+        gathered_logits: torch.Tensor,
+        output_token_ids: list[list[int]],
+        row_starts: list[int],
+        num_logprobs: int,
+    ) -> LogprobsTensors | None:
+        """Logprobs of the tokens a speculative step emitted, computed on CPU.
+
+        Same scoring as ``_compute_on_device_logprobs`` (raw logprobs, GPU
+        ``logprobs_mode="raw_logprobs"``), one row per emitted token, flattened
+        request after request like vLLM's rejection sampler output; the
+        per-request boundaries go in ``cu_num_generated_tokens`` so the
+        scheduler's ``slice_request`` finds each request's rows (T37, D-129).
+        Returns None when the step emitted no token.
+        """
+        rows: list[int] = []
+        tokens: list[list[int]] = []
+        cu = [0]
+        for i, emitted in enumerate(output_token_ids):
+            for t, tok in enumerate(emitted):
+                rows.append(row_starts[i] + t)
+                tokens.append([int(tok)])
+            cu.append(len(rows))
+        if not rows:
+            return None
+        selected = gathered_logits.to("cpu").index_select(
+            0, torch.tensor(rows, dtype=torch.long)
+        )
+        lp = self._compute_on_device_logprobs(selected, tokens, num_logprobs)
+        return lp._replace(cu_num_generated_tokens=cu)
