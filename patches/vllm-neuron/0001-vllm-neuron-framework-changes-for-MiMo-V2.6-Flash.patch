+            raw_logprobs = logits_cpu
+        else:
+            raw_logprobs = Sampler.compute_logprobs(logits_cpu)
+        if num_logprobs == -1:
+            # Full unsorted/unranked logprobs, same shape contract as vLLM.
+            return LogprobsTensors(torch.empty(0), raw_logprobs, torch.empty(0))
+        sampled = torch.tensor(
+            [row[0] if row else 0 for row in output_token_ids[:num_rows]],
+            dtype=torch.int64,
+        )
+        return _gather_logprobs_eager(raw_logprobs, num_logprobs, sampled)
