+        done: dict[str, LogprobsTensors] = {}
+        for r, tensors in plan["entries"]:
+            n = r["num_logits"]
+            if n > 0:
+                if packed is None:
+                    packed = plan["out"].to("cpu")
+                ids, target, top, ranks = unpack(
+                    packed[r["offset"]:r["offset"] + n], plan["k"]
+                )
+                k = r["k"]
+                rows = slice(r["start"], r["start"] + n)
+                tensors.logprob_token_ids[rows, 0] = torch.tensor(r["targets"])
+                tensors.logprob_token_ids[rows, 1:] = ids[:, :k]
+                tensors.logprobs[rows, 0] = target
+                tensors.logprobs[rows, 1:] = top[:, :k]
+                tensors.selected_token_ranks[rows] = ranks
+            if r["completed"]:
