+def golden_model_id(model_checkpoint: str) -> str:
+    """Model id used in the golden cache key for a reference checkpoint.
+
+    A local checkpoint directory is keyed by its real path (symlinks resolved),
+    so a symlinked alias and its target share goldens and every consumer
+    (writer, accuracy debugger, cache precheck) derives the same key. Anything
+    that is not an existing path (e.g. a HuggingFace model id) is returned
+    unchanged.
+    """
+    if os.path.exists(model_checkpoint):
+        return os.path.realpath(model_checkpoint)
+    return model_checkpoint
+
+
+def build_reference_goldens_key_config(
+    model_id: str,
+    dtype: Any,
+    output_length: int,
+    prompts: list[str],
+    kv_cache_dtype: str = "auto",
+    golden_variant: Optional[str] = None,
+) -> dict:
+    """Build the golden-cache ``key_config`` used by :func:`get_cached_reference_goldens`.
+
+    Exposed so read-only consumers (e.g. a cache precheck) hash goldens exactly
+    the way the writer does.
+
+    Args:
+        model_id: Model id or checkpoint path (slashes are replaced with
+            underscores).
+        dtype: Target dtype, as a ``torch.dtype`` or its name
+            (``"bfloat16"`` / ``"torch.bfloat16"``).
+        output_length: Number of generated tokens.
+        prompts: List of prompt strings.
+        kv_cache_dtype: Included only when != "auto".
+        golden_variant: Included only when set.
+    """
+    # Build the cache key. The field set and ordering are a contract shared by
+    # every consumer — changing it invalidates existing cached goldens.
+    key_config = {
+        "model": model_id.replace("/", "_"),
+        "dtype": str(dtype).split(".")[-1],
+        "output_length": output_length,
+        "prompts": prompts,
+        # Every input that affects the computed goldens is part of this key,
+        # and the prompts are fixed text with no runtime RNG, so a cached
+        # payload stays valid across torch versions. Opting out of
+        # torch-version keying lets previously cached goldens keep resolving
+        # instead of forcing a multi-hour CPU recompute of the reference
+        # model on every torch uplift.
+        "torch_independent": True,
+    }
+
+    # Include kv_cache_dtype only when non-default, so the default key is stable.
+    if kv_cache_dtype != "auto":
+        key_config["kv_cache_dtype"] = kv_cache_dtype
+
+    # Namespace incompatible golden formats onto distinct keys. Included only
+    # when set, so the default bf16-baseline key is unaffected (see golden_variant).
+    if golden_variant:
+        key_config["golden_variant"] = golden_variant
+    return key_config
+
+
 def get_cached_reference_goldens(
     model_id: str,
     model_checkpoint: str,
@@ -353,30 +418,14 @@ def get_cached_reference_goldens(
 
