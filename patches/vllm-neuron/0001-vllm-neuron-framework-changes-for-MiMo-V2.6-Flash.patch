+    """Sample one token per row with vLLM's ``Sampler`` on the CPU.
+
+    Args:
+        sampler: A ``vllm.v1.sample.sampler.Sampler`` (``make_host_sampler``).
+        logits: ``[len(rows), vocab_size]`` raw lm_head logits of the rows (CPU,
+            any float dtype; changed in place).
+        rows, vocab_size, vllm_config, logitsproc_types, fallback_generator: see
+            ``build_host_metadata``.
+
+    Returns:
+        The sampled token id of each row.
+    """
+    metadata = build_host_metadata(
+        rows,
+        vocab_size=vocab_size,
+        vllm_config=vllm_config,
+        logitsproc_types=logitsproc_types,
+        fallback_generator=fallback_generator,
+    )
+    out = sampler(logits, metadata)
+    return out.sampled_token_ids.view(-1).tolist()
