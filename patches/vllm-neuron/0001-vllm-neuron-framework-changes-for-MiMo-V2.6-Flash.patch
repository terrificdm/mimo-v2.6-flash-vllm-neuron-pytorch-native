new file mode 100644
index 0000000..ce07da8
--- /dev/null
+++ b/vllm_neuron/vllm/core/encoder_cache_manager.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Scheduler-side encoder cache that counts every item in whole device blocks.
+
+The upstream ``EncoderCacheManager`` sizes and evicts by merged-token counts. The
+worker's on-device cache (``EncoderCacheBlocks``) stores each item from a fresh
+block of ``block_size`` rows, so an item of ``n`` tokens occupies
+``ceil(n / block_size)`` blocks. With token counting the scheduler can keep more items
+cached than the device has blocks for (each item wastes up to ``block_size - 1``
+rows), and the worker then fails in ``EncoderCacheBlocks.allocate``.
+
+``BlockAlignedEncoderCacheManager`` keeps the upstream logic (cache hits, freeable
+entries, LRU eviction) and only changes the unit: an item counts as its token count
+rounded up to whole blocks, and the capacity is rounded up to whole blocks (the
+runner sizes the device cache as ``ceil(encoder_cache_size / block_size)`` blocks
+plus one scratch block). The compute budget still uses the real token count.
+
+Models opt in through the ``get_encoder_cache_manager_cls`` model hook
+(``vllm_neuron.utils.mm_utils``); the platform then sets
+``vllm_config.ec_manager_config`` with ``manager_config={"block_size": ...}``.
+"""
+
+import sys
+
+from vllm.v1.core.encoder_cache_manager import EncoderCacheManager
+
+
+def _round_up(n: int, block_size: int) -> int:
+    return -(-int(n) // block_size) * block_size
+
+
+class _BlockRoundedRequest:
+    """View of a request whose ``get_num_encoder_embeds`` is rounded up to whole
+    blocks; every other attribute is the request's own."""
+
+    __slots__ = ("_request", "_block_size")
+
+    def __init__(self, request, block_size: int):
+        self._request = request
+        self._block_size = block_size
+
+    def __getattr__(self, name):
+        return getattr(self._request, name)
+
+    def get_num_encoder_embeds(self, input_id: int) -> int:
+        return _round_up(self._request.get_num_encoder_embeds(input_id), self._block_size)
+
+
+class BlockAlignedEncoderCacheManager(EncoderCacheManager):
+    """``EncoderCacheManager`` in whole blocks of ``block_size`` merged tokens."""
+
+    @classmethod
+    def create_manager(cls, *, cache_size: int, vllm_config) -> "BlockAlignedEncoderCacheManager":
+        block_size = vllm_config.ec_manager_config.manager_config.get("block_size")
+        if not block_size:
+            raise ValueError("BlockAlignedEncoderCacheManager needs "
+                             "ec_manager_config.manager_config['block_size']")
+        return cls(cache_size=cache_size, block_size=int(block_size))
+
+    def __init__(self, cache_size: int, block_size: int):
+        if block_size <= 0:
+            raise ValueError(f"block_size={block_size} must be positive")
+        super().__init__(_round_up(cache_size, block_size))
+        self.block_size = block_size
+        # request_id -> block-rounded embeds this request has had approved by
+        # can_allocate in the current scheduling call but not allocated yet (the
+        # scheduler passes the same quantity in real tokens as num_embeds_to_schedule).
+        self._pending: dict[str, int] = {}
+
+    def _view(self, request) -> _BlockRoundedRequest:
+        return _BlockRoundedRequest(request, self.block_size)
+
+    def can_allocate(self, request, input_id: int, encoder_compute_budget: int,
+                     num_embeds_to_schedule: int) -> bool:
+        num_embeds = request.get_num_encoder_embeds(input_id)
+        if num_embeds > encoder_compute_budget:
+            return False
+        # The scheduler starts each request's call with num_embeds_to_schedule == 0.
+        pending = self._pending.get(request.request_id, 0) if num_embeds_to_schedule else 0
+        if not super().can_allocate(self._view(request), input_id, sys.maxsize, pending):
+            return False
+        self._pending[request.request_id] = pending + _round_up(num_embeds, self.block_size)
+        return True
+
+    def allocate(self, request, input_id: int) -> None:
+        super().allocate(self._view(request), input_id)
+
+    def free_encoder_input(self, request, input_id: int) -> None:
+        super().free_encoder_input(self._view(request), input_id)
+
+    def free(self, request) -> None:
+        super().free(request)
+        self._pending.pop(request.request_id, None)
+
+    def reset(self) -> None:
+        super().reset()
+        self._pending.clear()
