+            req = self.requests[r["req_id"]]
+            tensors = req.in_progress_prompt_logprobs_cpu
+            if tensors is None:
+                tensors = LogprobsTensors.empty_cpu(r["num_prompt"] - 1, r["k"] + 1)
+                req.in_progress_prompt_logprobs_cpu = tensors
+            entries.append((r, tensors))
