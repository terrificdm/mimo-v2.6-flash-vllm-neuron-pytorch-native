diff --git a/vllm_neuron/accuracy/goldens/precheck_cache.py b/vllm_neuron/accuracy/goldens/precheck_cache.py
new file mode 100644
index 0000000..4f43612
--- /dev/null
+++ b/vllm_neuron/accuracy/goldens/precheck_cache.py
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Check that reference goldens are already in the disk golden cache.
+
+Read-only companion of ``VLLM_NEURON_GOLDEN_CACHE_ONLY=1``: run it before a
+device job whose goldens must come from the cache, so a missing key is caught
+before the job starts instead of the job trying to load the HF reference.
+
+Keys are built with
+:func:`~vllm_neuron.accuracy.goldens.reference_logits.build_reference_goldens_key_config`
+and the model id rule of
+:func:`~vllm_neuron.accuracy.goldens.reference_logits.golden_model_id`, i.e.
+exactly what ``get_cached_reference_goldens`` / ``LogitValPlugin`` use. Only the
+disk tier (``VLLM_NEURON_GOLDEN_CACHE_DIR``) is checked; S3 is never contacted.
+
+By default one key per prompt is checked (``run_prompt_analysis`` runs the
+plugins one prompt at a time). ``--whole-list`` checks the single key of the
+full prompt list instead (callers that pass all prompts in one call).
+
+Usage::
+
+    python -m vllm_neuron.accuracy.goldens.precheck_cache \\
+        --model-id /path/to/reference_checkpoint \\
+        --prompts-file prompts.json --output-length 32 --dtype bfloat16
+
+Exit codes: 0 all keys present; 3 one or more keys missing (listed on
+stdout); 2 invalid arguments or prompts file.
+"""
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+EXIT_OK = 0
+EXIT_BAD_ARGS = 2
+EXIT_MISSING = 3
+
+
+def _load_prompts(path: str) -> list[str]:
+    prompts = json.loads(Path(path).read_text())
+    if isinstance(prompts, dict) and "prompts" in prompts:
+        prompts = prompts["prompts"]
+    if (
+        not isinstance(prompts, list)
+        or not prompts
+        or not all(isinstance(p, str) for p in prompts)
+    ):
+        raise ValueError(
+            "prompts file must hold a non-empty JSON list of strings "
+            '(or an object with a "prompts" list)'
+        )
+    return prompts
+
+
+def check_keys(
+    model_id: str,
+    prompts: list[str],
+    output_length: int,
+    dtype: str,
+    whole_list: bool = False,
+) -> list[dict]:
+    """Return one record per checked key: ``prompts``, ``dir``, ``present``."""
+    from vllm_neuron.accuracy.goldens.reference_logits import (
+        build_reference_goldens_key_config,
+        golden_model_id,
+    )
+    from vllm_neuron.utils.golden_cache import _golden_dir, _golden_pt_path
+
+    resolved_id = golden_model_id(model_id)
+    groups = [prompts] if whole_list else [[p] for p in prompts]
+    records = []
+    for group in groups:
+        key_config = build_reference_goldens_key_config(
+            resolved_id, dtype, output_length, group
+        )
+        pt = _golden_pt_path(key_config)
+        records.append(
+            {
+                "prompts": group,
+                "dir": str(_golden_dir(key_config)),
+                "present": pt.is_file() and pt.stat().st_size > 0,
+            }
+        )
+    return records
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    parser.add_argument("--model-id", required=True,
+                        help="reference checkpoint path (resolved to its real path) or model id")
+    parser.add_argument("--prompts-file", required=True,
+                        help="JSON list of prompt strings")
+    parser.add_argument("--output-length", type=int, required=True)
+    parser.add_argument("--dtype", default="bfloat16",
+                        help="target dtype name in the key (default bfloat16)")
+    parser.add_argument("--whole-list", action="store_true",
+                        help="check the single key of the whole prompt list")
+    args = parser.parse_args(argv)
+
+    from vllm_neuron import envs
+
+    try:
+        prompts = _load_prompts(args.prompts_file)
+    except (OSError, ValueError) as e:
+        print(f"[precheck] invalid prompts file {args.prompts_file}: {e}")
+        return EXIT_BAD_ARGS
+    if args.output_length < 1:
+        print("[precheck] --output-length must be >= 1")
+        return EXIT_BAD_ARGS
+
+    records = check_keys(
+        args.model_id, prompts, args.output_length, args.dtype, args.whole_list
+    )
+    missing = [r for r in records if not r["present"]]
+    print(
+        f"[precheck] cache_dir={envs.VLLM_NEURON_GOLDEN_CACHE_DIR} "
+        f"model_id={args.model_id} output_length={args.output_length} "
+        f"dtype={args.dtype} keys={len(records)} present={len(records) - len(missing)} "
+        f"missing={len(missing)}"
+    )
+    for r in missing:
+        preview = r["prompts"][0][:60] if len(r["prompts"]) == 1 else f"<{len(r['prompts'])} prompts>"
+        print(f"[precheck] MISSING {r['dir']} prompt={preview!r}")
+    return EXIT_MISSING if missing else EXIT_OK
+
+
+if __name__ == "__main__":
+    sys.exit(main())
