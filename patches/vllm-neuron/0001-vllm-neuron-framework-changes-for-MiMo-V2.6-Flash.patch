@@ -0,0 +1,322 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Host-side logits processing for the sampling parameters the on-device sampler ignores (T65).
+
+The NEFF's sampler applies temperature, top_k (capped at ``max_top_k``) and top_p
+only. GPU vLLM's ``Sampler`` (``vllm/v1/sample/sampler.py``) also applies, in this
+order: allowed_token_ids, bad_words, the logits processors that can change the
+argmax (min_tokens, logit_bias), the repetition / frequency / presence penalties,
+then temperature, min_p and top-k / top-p. A request that carries any of those is
+sampled again here, on the CPU, from the step's gathered lm_head logits, with
+vLLM's own ``Sampler`` and logits processors (the top-k / top-p step uses vLLM's
+PyTorch implementation, see ``HostTopKTopPSampler``), so its tokens follow the
+GPU semantics (full vocabulary, no ``max_top_k`` cap). The runner then writes
+the token into the device sampling tensor, the same way as for seeded requests
+(T30, D-110).
+
+Every step builds the ``SamplingMetadata`` for just these rows, the way
+``vllm.v1.worker.gpu_input_batch.InputBatch`` builds it for its batch, with fresh
+logits processors fed one ``BatchUpdate`` in which every row is "added". So nothing
+here keeps state between steps; each request's output history is owned by the
+runner (``NeuronModelRunner._host_logits_history``).
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+import torch
+from vllm.sampling_params import SamplingParams
+from vllm.v1.sample.logits_processor import BatchUpdate, LogitsProcessors
+from vllm.v1.sample.metadata import SamplingMetadata
+from vllm.v1.sample.ops.topk_topp_sampler import (
+    TopKTopPSampler,
+    apply_top_k_top_p_pytorch,
+    random_sample,
+)
+from vllm.v1.sample.sampler import Sampler
+
+# vllm.v1.sample.sampler._SAMPLING_EPS: a temperature below this is greedy.
+_SAMPLING_EPS = 1e-5
+
+
+class HostTopKTopPSampler(TopKTopPSampler):
+    """``TopKTopPSampler.forward_native`` with the PyTorch top-k / top-p.
+
+    On the Neuron platform vLLM's ``apply_top_k_top_p`` picks its Triton kernel
+    for 8 or more rows, and that kernel needs a GPU (it raised
+    ``num_compute_units is not implemented`` here). The PyTorch implementation
+    with ``allow_cpu_sync=True`` is the one vLLM itself runs on a CPU platform
+    without Triton; it has the same top-k / top-p semantics.
+    """
+
+    def __init__(self, logprobs_mode="raw_logprobs", use_fp64_gumbel=False):
+        super().__init__(logprobs_mode, use_fp64_gumbel)
+        self.forward = self.forward_host
+
+    def forward_host(self, logits, generators, k, p):
+        logits = apply_top_k_top_p_pytorch(logits, k, p, allow_cpu_sync=True)
+        logits_to_return = None
+        if self.logprobs_mode == "processed_logits":
+            logits_to_return = logits
+        elif self.logprobs_mode == "processed_logprobs":
+            logits_to_return = logits.log_softmax(dim=-1, dtype=torch.float32)
+        probs = logits.softmax(dim=-1, dtype=torch.float32)
+        return random_sample(probs, generators, self.use_fp64_gumbel), logits_to_return
+
+
+def make_host_sampler(logprobs_mode="raw_logprobs") -> Sampler:
+    """vLLM's ``Sampler`` with ``HostTopKTopPSampler`` for the top-k / top-p step."""
+    sampler = Sampler(logprobs_mode=logprobs_mode)
+    sampler.topk_topp_sampler = HostTopKTopPSampler(logprobs_mode)
+    return sampler
+
+
+def needs_host_logits(
+    params: SamplingParams | None,
+    num_output_tokens: int,
+    *,
+    min_p_and_logit_bias: bool = True,
+) -> bool:
+    """True when a request's next token needs the host logits processing.
+
+    The tests are the ones ``InputBatch.add_request`` and vLLM's builtin logits
+    processors use to decide that a request takes part in each step: a penalty
+    away from its neutral value, a non-empty allowed_token_ids / bad_words, a
+    min_tokens that is not reached yet, a non-zero min_p or a logit_bias.
+
+    Args:
+        params: The request's sampling params (None for a pooling request).
+        num_output_tokens: Tokens the request has generated before this step.
+        min_p_and_logit_bias: False on a speculative-decoding server, where GPU
+            vLLM builds only the min-tokens processor
+            (``vllm/v1/sample/logits_processor/__init__.py``) and its frontend
+            rejects min_p and logit_bias (``SamplingParams._validate_spec_decode``).
+
+    Returns:
+        Whether the request's row must be sampled on the host this step.
+
+    Example:
+        >>> needs_host_logits(SamplingParams(min_tokens=4), 4)
+        False
+    """
+    if params is None:
+        return False
+    if (
+        params.presence_penalty != 0.0
+        or params.frequency_penalty != 0.0
+        or params.repetition_penalty != 1.0
+    ):
+        return True
+    if params.allowed_token_ids or params.bad_words_token_ids:
+        return True
+    if params.min_tokens and num_output_tokens < params.min_tokens:
+        return True
+    return min_p_and_logit_bias and bool(params.min_p or params.logit_bias)
+
+
+@dataclass
+class HostRow:
+    """One request's inputs to the host sampler, snapshotted at sampling time.
+
+    ``temperature``, ``top_p`` and ``top_k`` are the values ``InputBatch`` stores for
+    the request (temperature 0.0 for a greedy request, top_k = vocab size when
+    top-k is off). ``generator`` is the request's own generator (seeded request) or
+    None.
+    """
+
+    params: SamplingParams
+    prompt_token_ids: list[int]
+    output_token_ids: list[int]
+    temperature: float
+    top_p: float
+    top_k: int
+    generator: torch.Generator | None
+    # Packed int32 grammar bitmask row of a structured-output request (T66), or
+    # None. The runner applies it to the row's logits (apply_grammar_rows) before
+    # calling host_logits_sample.
+    grammar_bitmask: torch.Tensor | None = None
+
+
+def apply_grammar_rows(
+    logits: torch.Tensor, rows: dict[int, torch.Tensor], *, vocab_size: int
+) -> None:
+    """Apply packed grammar bitmask rows to ``logits`` in place (T66).
+
+    The same operation as ``vllm.v1.structured_output.utils.apply_grammar_bitmask``
+    on a CPU tensor: xgrammar's ``apply_token_bitmask_inplace`` sets the logit of
+    every token whose bit is 0 to -inf. Bit ``j`` of word ``w`` is token
+    ``32 * w + j`` (xgrammar's layout, the one vLLM's backends produce).
+
+    Args:
+        logits: ``[num_rows, width]`` float32 CPU logits; only the first
+            ``vocab_size`` columns are tokens of the grammar's vocabulary.
+        rows: Logits row -> packed bitmask row (int32, ``ceil(vocab / 32)`` words).
+        vocab_size: Number of real tokens (``InputBatch.vocab_size``).
+    """
+    if not rows:
+        return
+    import xgrammar as xgr
+
+    idx = sorted(rows)
+    width = rows[idx[0]].shape[-1]
+    bitmask = torch.full((logits.shape[0], width), -1, dtype=torch.int32)
+    for i in idx:
+        bitmask[i] = rows[i]
+    xgr.apply_token_bitmask_inplace(
+        logits, bitmask, vocab_size=min(vocab_size, logits.shape[-1]), indices=idx
+    )
+
+
+def build_host_metadata(
+    rows: Sequence[HostRow],
+    *,
+    vocab_size: int,
+    vllm_config,
+    logitsproc_types: Sequence[type],
+    fallback_generator: torch.Generator,
+) -> SamplingMetadata:
+    """``SamplingMetadata`` (CPU tensors) for a batch made of exactly ``rows``.
+
+    Same fields and the same "is this feature in use" tests as
+    ``InputBatch._make_sampling_metadata``; the logits processors are fresh
+    instances of ``logitsproc_types`` (what ``build_logitsprocs`` gives the
+    server) updated with every row added.
+
+    One difference, on purpose: a row without its own generator draws from
+    ``fallback_generator`` instead of the process-wide RNG. Every TP rank runs
+    this code on the same inputs and writes the token back into its own copy of
+    the device sampling tensor, so the draw must be the same on every rank; a
+    generator seeded the same everywhere guarantees that. GPU vLLM's unseeded
+    draws are random too, so the distribution is unchanged.
+
+    Args:
+        rows: The rows to sample, in batch order.
+        vocab_size: Width of the logits (``InputBatch.vocab_size``).
+        vllm_config: Passed to the logits processor constructors.
+        logitsproc_types: Logits processor classes to instantiate.
+        fallback_generator: Generator for the rows that carry no seed.
+
+    Returns:
+        Metadata for ``vllm.v1.sample.sampler.Sampler.forward``.
+    """
+    n = len(rows)
+    cpu = torch.device("cpu")
+    greedy = [r.temperature < _SAMPLING_EPS for r in rows]
+    all_greedy = all(greedy)
+    all_random = not any(greedy)
+    temperature = torch.tensor([r.temperature for r in rows], dtype=torch.float32)
+    no_top_p = all(r.top_p >= 1 for r in rows)
+    no_top_k = all(not 0 < r.top_k < vocab_size for r in rows)
+    top_p = torch.tensor([r.top_p for r in rows], dtype=torch.float32)
+    top_k = torch.tensor(
+        [r.top_k if 0 < r.top_k < vocab_size else vocab_size for r in rows],
+        dtype=torch.int32,
+    )
+
+    params = [r.params for r in rows]
+    frequency = torch.tensor([p.frequency_penalty for p in params], dtype=torch.float32)
+    presence = torch.tensor([p.presence_penalty for p in params], dtype=torch.float32)
+    repetition = torch.tensor(
+        [p.repetition_penalty for p in params], dtype=torch.float32
+    )
+    no_penalties = all(
+        p.frequency_penalty == 0.0
+        and p.presence_penalty == 0.0
+        and p.repetition_penalty == 1.0
+        for p in params
+    )
+    prompt_token_ids = None
+    if not no_penalties:
+        # InputBatch._make_prompt_token_ids_cpu_tensor: pad with vocab_size, a
+        # token id that does not exist, so the penalty counts drop the padding.
+        width = max(len(r.prompt_token_ids) for r in rows)
+        prompt_token_ids = torch.full((n, width), vocab_size, dtype=torch.int64)
+        for j, r in enumerate(rows):
+            if r.prompt_token_ids:
+                prompt_token_ids[j, : len(r.prompt_token_ids)] = torch.as_tensor(
+                    r.prompt_token_ids, dtype=torch.int64
+                )
+
+    bad_words = {
+        j: p.bad_words_token_ids for j, p in enumerate(params) if p.bad_words_token_ids
+    }
+    output_token_ids = (
+        [r.output_token_ids for r in rows] if (not no_penalties or bad_words) else []
+    )
+
+    allowed_mask = None
+    if any(p.allowed_token_ids for p in params):
+        # True = masked out, as in InputBatch.allowed_token_ids_mask.
+        allowed_mask = torch.zeros((n, vocab_size), dtype=torch.bool)
+        for j, p in enumerate(params):
+            if p.allowed_token_ids:
+                allowed_mask[j] = True
+                allowed_mask[j][p.allowed_token_ids] = False
+
