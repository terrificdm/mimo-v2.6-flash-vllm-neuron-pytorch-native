+        prompt_token_ids=prompt_token_ids,
+        frequency_penalties=frequency,
+        presence_penalties=presence,
+        repetition_penalties=repetition,
+        output_token_ids=output_token_ids,
+        allowed_token_ids_mask=allowed_mask,
+        bad_words_token_ids=bad_words,
+        logitsprocs=logitsprocs,
+    )
+
+
+def host_logits_sample(
+    sampler,
+    logits: torch.Tensor,
+    rows: Sequence[HostRow],
+    *,
+    vocab_size: int,
+    vllm_config,
+    logitsproc_types: Sequence[type],
+    fallback_generator: torch.Generator,
