+++ b/vllm_neuron/vllm/spec_decode/mtp.py
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+"""MTP proposer for MiMo-V2 (design 8.2, T36).
+
+vLLM resolves ``--speculative-config '{"method": "mtp", ...}'`` on a MiMo-V2 checkpoint
+to a draft config of the same checkpoint with architecture ``MiMoV2MTPModel`` (or
+``MiMoV2OmniMTPModel``) and ``num_hidden_layers=0`` (``config/speculative.py``).
+``MTPProposer`` builds the Neuron draft ``MiMoV2MTPDraftModel`` from the TARGET hf_config
+and the target's NeuronConfig (precision, FP8 mode, ``mtp_debug_random_draft``) with
+greedy on-device sampling, shares the target's embedding and lm_head, and loads
+``model.mtp.layers.{0..k-1}`` (draft step i uses MTP layer i, T64 / D-137).
+
+Everything else is ``EagleProposer``: the draft model has the EAGLE3 draft forward
+contract, the target returns its hidden states the way an EAGLE3 target returns the
+auxiliary ones (``MiMoV2ForCausalLM.enable_mtp_hidden_states``: the final-norm hidden
+states, ``[T, H]`` instead of ``[T, 3H]``), and the runner's EAGLE3 path does the rest
+(1+k verify graph with the on-device rejection sampler in the target, draft NEFF fed
+by device futures, async correction). Each MTP layer has its own KV layer
+(``layers.48`` .. ``layers.48+k-1``), a ``SlidingWindowSpec`` with ``head_size_v``
+(``NeuronModelRunner.get_kv_cache_spec``, D-076); vLLM may put them in different SWA
+groups, and each layer reads its own entry of the step's attention metadata.
+"""
+
+import dataclasses
+import logging
+import time
+
+import torch
+import torch.nn as nn
+from libtorch_neuronx_lite import envs as libtorch_envs
+from vllm.config import VllmConfig
+from vllm.distributed.parallel_state import get_world_group
+from vllm.v1.kv_cache_interface import KVCacheConfig
+
+from vllm_neuron import envs
+from vllm_neuron.metrics import MODEL_LOAD_SIZE, MODEL_LOAD_TIME
+from vllm_neuron.model.neuron_config import NeuronConfig, OnDeviceSamplingConfig
+from vllm_neuron.model.registry import get_models
+from vllm_neuron.vllm.spec_decode.eagle import EagleProposer
+
+logger = logging.getLogger(__name__)
+
+
+class MTPProposer(EagleProposer):
+    """``EagleProposer`` with the MiMo-V2 MTP draft (module docstring)."""
+
+    def __init__(self, vllm_config: VllmConfig, device: torch.device,
+                 on_device_sampling: bool = True):
+        # EagleProposer.__init__ asserts method == "eagle3"; same fields otherwise.
+        self.vllm_config = vllm_config
+        self.speculative_config = vllm_config.speculative_config
+        assert self.speculative_config is not None
+        self.draft_model_config = self.speculative_config.draft_model_config
+        self.method = self.speculative_config.method
+        assert self.method == "mtp"
+        self.device = device
+        self.on_device_sampling = on_device_sampling
+        self.num_speculative_tokens = self.speculative_config.num_speculative_tokens
+        kv_cfg = vllm_config.kv_transfer_config
+        self.kv_fill_only = bool(
+            kv_cfg is not None and kv_cfg.is_kv_producer and not kv_cfg.is_kv_consumer)
+        self.attn_layer_names: list[str] = []
+        self.capture_backend_model = None
+        self.model = None
+        self._target_model: nn.Module | None = None
+        world_group = get_world_group()
+        world_rank = world_group.rank if world_group else 0
+        self.rank_tensor = torch.tensor(world_rank, dtype=torch.int32, device=self.device)
+
+    def set_target_model(self, target_model: nn.Module) -> None:
+        """The loaded target (uncompiled module): embedding, lm_head and NeuronConfig source."""
+        self._target_model = getattr(target_model, "_orig_mod", target_model)
+
+    def load_model(self, target_hidden_size: int, target_hidden_pad_groups: int = 1,
+                   compile_options: dict | None = None) -> None:
+        start = self.vllm_config.model_config.hf_config.num_hidden_layers
+        self.model = self.compile_and_load_draft_model(start, compile_options)
+        self.attn_layer_names = [f"layers.{start + i}.self_attn"
+                                 for i in range(self.num_speculative_tokens)]
+        logger.info("Completed compilation for MTP draft model (layers %s, k=%d).",
+                    self.attn_layer_names, self.num_speculative_tokens)
+
+    def validate_same_kv_cache_group(self, kv_cache_config: KVCacheConfig) -> None:
+        """Every MTP layer must have a KV cache group; unlike EAGLE3 they need not share
+        one, since each layer reads its own attention metadata (module docstring)."""
+        groups = {name: i for i, g in enumerate(kv_cache_config.kv_cache_groups)
+                  for name in g.layer_names}
+        missing = [name for name in self.attn_layer_names if name not in groups]
+        if missing:
+            raise ValueError(f"MTP draft layers {missing} have no KV cache group")
+        logger.info("MTP draft KV cache groups: %s",
+                    {name: groups[name] for name in self.attn_layer_names})
+
+    def _build_synthetic_inputs(self, num_tokens: int, num_reqs: int,
+                                device: torch.device | None = None) -> dict:
+        """EAGLE3 synthetic inputs with ``[T, H]`` target hidden states (not ``[T, 3H]``)."""
+        kwargs = super()._build_synthetic_inputs(num_tokens, num_reqs, device=device)
+        h3 = kwargs["target_hidden_states"]
+        kwargs["target_hidden_states"] = h3.new_ones(h3.shape[0], self.model.config.hidden_size)
+        return kwargs
+
+    def compile_and_load_draft_model(self, start_layer_idx: int,
+                                     compile_options: dict | None = None) -> nn.Module:
+        target = self._target_model
+        if target is None:
+            raise RuntimeError("MTPProposer.set_target_model() must run before load_model()")
+        arch = self.draft_model_config.architecture
+        models = dict(get_models())
+        if arch not in models:
+            raise ValueError(f"Draft model architecture {arch!r} not found in the vLLM Neuron "
+                             f"model registry. Supported architectures: {list(models)}")
+        model_cls = models[arch]
+
+        target_nc = getattr(target.config, "neuron_config", None)
+        sampling = OnDeviceSamplingConfig(all_greedy=True) if self.on_device_sampling else None
+        if target_nc is None:
+            neuron_config = NeuronConfig(on_device_sampling_config=sampling)
+        else:
+            neuron_config = dataclasses.replace(target_nc, on_device_sampling_config=sampling)
+        target_hf_config = self.vllm_config.model_config.hf_config
+
+        with torch.device("meta"):
+            model = model_cls.from_configs(target_hf_config, neuron_config,
+                                           start_layer_idx=start_layer_idx)
+        model.num_speculative_tokens = self.num_speculative_tokens
+        model.kv_fill_only = self.kv_fill_only
+        model.share_target_modules(target)
+
+        load_start = time.perf_counter()
+        if not envs.VLLM_NEURON_CPU_COMPILE:
+            model.load_weights(self.speculative_config.model, self.device,
+                               self.vllm_config.load_config.download_dir)
+            model = model.to(self.device)
+            name = self.speculative_config.model
+            MODEL_LOAD_TIME.labels(model_name=name).set(time.perf_counter() - load_start)
+            MODEL_LOAD_SIZE.labels(model_name=name).set(
+                sum(p.nbytes for p in model.mtp_layers.parameters()))
+        else:
+            logger.info("CPU Compilation is enabled. Skipping MTP draft weight loading.")
+            model = model.to("meta")
+        self.model = model
+
+        # torch.compile wrappers as in EagleProposer.compile_and_load_draft_model
+        debug_mode = envs.VLLM_NEURON_DEBUG_MODE
+        compile_kwargs: dict = {"fullgraph": not debug_mode}
+        if compile_options is not None:
+            compile_kwargs["options"] = compile_options
+        if (self.vllm_config.model_config.enforce_eager or envs.VLLM_NEURON_CPU_MODE
+                or debug_mode or libtorch_envs.NEURON_LIBTORCH_DISABLE_GRAPH_CAPTURE_BACKEND):
+            self.capture_backend_model = None
+        else:
+            self.capture_backend_model = torch.compile(
+                model, backend="neuron_libtorch_graph_capture", **compile_kwargs)
+        # Kept so the runner can wrap the draft model again after the package flush.
+        self.compile_kwargs = {"backend": envs.get_compile_backend_name(), **compile_kwargs}
+        return torch.compile(model, **self.compile_kwargs)
