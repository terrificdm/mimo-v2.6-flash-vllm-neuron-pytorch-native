+        gathered_logits: torch.Tensor,
+        output_token_ids: list[list[int]],
+        num_logprobs: int,
+    ) -> LogprobsTensors:
+        """Logprobs of on-device-sampled tokens, computed on CPU.
+
+        The tokens were drawn inside the NEFF, so only the logprobs are left to
+        produce. Running the vLLM ``Sampler`` here does not work: the gathered
+        logits must be read back to CPU first, while the sampling metadata it
+        reads stays on the Neuron device, and ``apply_temperature`` then raised
+        "Expected all tensors to be on the same device" in every worker and
+        took the engine down on the first logprobs request (T26, D-106). Use
+        the Sampler's two stateless helpers on CPU instead. The result matches
+        what the GPU runner reports for ``logprobs_mode="raw_logprobs"``:
+        logprobs of the unmodified logits (before temperature, top-k and
+        top-p) plus the rank of the sampled token (T30, D-110).
+        """
+        num_rows = min(len(output_token_ids), gathered_logits.shape[0])
+        logits_cpu = gathered_logits[:num_rows].to("cpu").to(torch.float32)
