diff --git a/vllm_neuron/accuracy/goldens/reference_model.py b/vllm_neuron/accuracy/goldens/reference_model.py
index e25794c..a8a9df3 100644
--- a/vllm_neuron/accuracy/goldens/reference_model.py
+++ b/vllm_neuron/accuracy/goldens/reference_model.py
@@ -11,10 +11,70 @@ Shared by the accuracy debugger prompt plugins
 full-model logit tests.
 """
 
+import json
+import os
 from typing import Any, Optional
 
 import torch
 
+# safetensors dtype strings above BF16 precision
+_HIGH_PRECISION = ("F32", "F64")
+
+
+def restore_checkpoint_precision(model: Any, model_checkpoint: str) -> dict:
+    """Copy the tensors a local safetensors checkpoint stores in FP32 / FP64 into ``model``.
+
+    ``init_hf_model`` loads in BF16 and casts afterwards, so a tensor the checkpoint
+    keeps in FP32 (for example a MoE router ``e_score_correction_bias``) is rounded to
+    BF16 before the cast. An FP32 reference must use the stored values. Each such
+    checkpoint tensor whose name is a parameter or buffer of ``model`` with an FP32 /
+    FP64 dtype gets the stored values (shape mismatch -> ``ValueError``); names that are
+    not in the model (e.g. ignored MTP layers) are counted as unmatched.
+
+    Args:
+        model: the loaded model, already cast to the target dtype.
+        model_checkpoint: checkpoint directory; anything else (a hub id) is left alone.
+
+    Returns:
+        ``{"restored": n, "n_unmatched": m, "unmatched": [first 20 names], "skipped": reason}``.
+    """
+    stats = {"restored": 0, "n_unmatched": 0, "unmatched": [], "skipped": None}
+    if not os.path.isdir(model_checkpoint):
+        stats["skipped"] = "not a local directory"
+        return stats
+    index = os.path.join(model_checkpoint, "model.safetensors.index.json")
+    if os.path.isfile(index):
+        with open(index) as f:
+            files = sorted(set(json.load(f)["weight_map"].values()))
+    elif os.path.isfile(os.path.join(model_checkpoint, "model.safetensors")):
+        files = ["model.safetensors"]
+    else:
+        stats["skipped"] = "no safetensors files"
+        return stats
+    from safetensors import safe_open
+
+    targets = dict(model.named_parameters())
+    targets.update(dict(model.named_buffers()))
+    with torch.no_grad():
+        for fname in files:
+            with safe_open(os.path.join(model_checkpoint, fname), "pt") as fh:
+                for key in fh.keys():
+                    if fh.get_slice(key).get_dtype() not in _HIGH_PRECISION:
+                        continue
